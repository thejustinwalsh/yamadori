# Refuse to install on an unsupported Node instead of warning.
#
# Without this, npm treats an engine mismatch on an OPTIONAL dependency as
# "skip it": on Node 20.15.0 it silently left out
# @rolldown/binding-win32-x64-msvc (engines ^20.19.0 || >=22.12.0), reported
# a successful install, and Vite then died at startup with "Cannot find
# module". A failure moved from install time to run time with nothing in
# between -- see web/PHASE0.md.
engine-strict=true
