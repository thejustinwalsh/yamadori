     } res;
 
     // 0029: bytes of the used-experts copy path (the one every offloaded MUL_MAT_ID takes without the slots)
@@ -1849,6 +1857,11 @@ static bool ggml_backend_sched_prefetch_init(ggml_backend_sched_t sched, ggml_ba
 
 // ---- 0029: weight-stationary expert slots (layer-major prefill) ----
 static void ggml_backend_sched_resident_release(ggml_backend_sched_t sched) {
+    if (sched->res.stager) {
+        ggml_stager_free(sched->res.stager);   // drains: every queued request has landed
+        sched->res.stager = NULL;
+    }
+    sched->res.stager_tried = false;
     if (sched->res.backend) {
         ggml_backend_synchronize(sched->res.backend);
     }
@@ -1924,9 +1937,38 @@ static bool ggml_backend_sched_resident_init(ggml_backend_sched_t sched, ggml_ba
         sched->res.on = false;
         return false;
     }
+
+    // 0030: the staging ring for weights in pageable host memory (off unless LLAMA_STAGER=1). Created here, on the thread that
+    // launches the compute, after the backend instance's stream has been made to exist (its first use is a synchronise)
+    if (!sched->res.stager_tried) {
+        sched->res.stager_tried = true;
+        bool enabled = false;
+        const ggml_stager_params sp = ggml_stager_params_from_env(&enabled);
+        if (enabled) {
+            sched->res.stager = ggml_stager_new_backend(sched->res.backend, dev, &sp);
+            if (sched->res.stager == NULL) {
+                GGML_LOG_WARN("%s: LLAMA_STAGER=1 but the staging ring could not be made (%d x %zu MiB): uploads stay direct\n",
+                        "ggml_backend_sched_resident", sp.n_chunks, sp.chunk_bytes >> 20);
+            } else {
+                GGML_LOG_INFO("%s: staging ring: %d x %zu MiB (%s), %d memcpy threads, OS read-ahead %s\n", "ggml_backend_sched_resident",
+                        sp.n_chunks, sp.chunk_bytes >> 20, ggml_stager_ring_pinned(sched->res.stager) ? "pinned" : "NOT pinned: copies are synchronous",
+                        sp.n_workers, sp.will_need ? "on" : "off");
+            }
+        }
+    }
     return true;
 }
 
+// 0030: is this host weight in the device's own pinned host buffer (LLAMA_PIN_EXPERTS=1)? Then a direct cudaMemcpyAsync is
+// already asynchronous and the ring would only add a copy. Anything else (an mmapped file, plain malloc) is pageable.
+static bool ggml_backend_sched_resident_pageable(ggml_backend_sched_t sched, const struct ggml_tensor * w) {
+    if (w == NULL || w->buffer == NULL || sched->res.dev == NULL) {
+        return false;
+    }
+    ggml_backend_buffer_type_t host = ggml_backend_dev_host_buffer_type(sched->res.dev);
+    return host == NULL || ggml_backend_buffer_get_type(w->buffer) != host;
+}
+
 // the slot holding `key`, else -1
 static int ggml_backend_sched_resident_find(ggml_backend_sched_t sched, const struct ggml_tensor * key) {
     for (int i = 0; i < sched->res.n_slots; i++) {
@@ -1957,13 +1999,25 @@ static int ggml_backend_sched_resident_victim(ggml_backend_sched_t sched) {
 // slot's ready event is recorded behind the copy
 static void ggml_backend_sched_resident_upload(ggml_backend_sched_t sched, int i, const struct ggml_tensor * weight, uint64_t epoch) {
     auto & s = sched->res.slot[i];
-    if (s.used) {
-        ggml_backend_event_wait(sched->res.backend, s.free);
-    }
     const size_t nbytes = ggml_nbytes(weight);
     GGML_ASSERT(nbytes <= sched->res.slot_bytes);
-    ggml_backend_tensor_set_async(sched->res.backend, s.t, weight->data, 0, nbytes);
-    ggml_backend_event_record(s.ready, sched->res.backend);
+    if (sched->res.stager != NULL && ggml_backend_sched_resident_pageable(sched, weight)) {
+        // 0030: the ring's issuer queues the copy chunk by chunk (after the last reader of the slot, `free`) and records
+        // `ready` behind it; the launch that reads the slot waits for the request to be QUEUED first (compute_splits)
+        s.ticket = ggml_stager_submit(sched->res.stager, s.t, weight->data, nbytes, s.used ? (void *) s.free : NULL, (void *) s.ready);
+        sched->res.staged_bytes += nbytes;
+        sched->res.staged_n++;
+    } else {
+        s.ticket = 0;
+        if (sched->res.stager != NULL) {
+            sched->res.direct_pinned_n++;
+        }
+        if (s.used) {
+            ggml_backend_event_wait(sched->res.backend, s.free);
+        }
+        ggml_backend_tensor_set_async(sched->res.backend, s.t, weight->data, 0, nbytes);
+        ggml_backend_event_record(s.ready, sched->res.backend);
+    }
     s.key    = weight;
     s.nbytes = nbytes;
     s.epoch  = epoch;
@@ -2056,6 +2110,17 @@ void ggml_backend_sched_resident_prefetch(ggml_backend_sched_t sched, struct ggm
     }
 }
 
+// 0030: the layer after the next: ask the OS to read its pageable weights into memory now (the stager's hint thread).
+void ggml_backend_sched_resident_hint(ggml_backend_sched_t sched, struct ggml_tensor * const * weights, int n) {
+    if (sched == NULL || !sched->res.on || sched->res.stager == NULL) { return; }
+    for (int k = 0; k < n; k++) {
+        const struct ggml_tensor * w = weights[k];
+        if (w != NULL && w->buffer != NULL && ggml_backend_buffer_is_host(w->buffer) && ggml_backend_sched_resident_pageable(sched, w)) {
+            ggml_stager_will_need(sched->res.stager, w->data, ggml_nbytes(w));
+        }
+    }
+}
