diff --git a/ggml/src/ggml-stager.cpp b/ggml/src/ggml-stager.cpp
new file mode 100644
index 000000000..4e713b79d
--- /dev/null
+++ b/ggml/src/ggml-stager.cpp
@@ -0,0 +1,603 @@
+// 0030: the staging ring. See ggml/include/ggml-stager.h.
+//
+// Strata's `Stager` (Niko1221/Strata src/prefill/prefill.cpp @ d551edf :122-239), MIT, Copyright (c) 2026 Niko1221 and
+// the Strata contributors (engines/patches/llama-upstream-flash/LICENSE.strata): kRing pinned buffers, worker threads
+// that memcpy a pageable source into them in launch order, a buffer reused only once the DMA that read it is done (the
+// issuing side records an event per buffer, the worker waits for it before overwriting), claims taken in order. What is
+// changed is listed in the header: chunks of a tensor instead of expert blobs, an issuer thread, request events.
+
+#include "ggml-stager.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#ifdef _WIN32
+#  ifndef NOMINMAX
+#    define NOMINMAX
+#  endif
+#  include <windows.h>
+#elif defined(__unix__) || defined(__APPLE__)
+#  include <sys/mman.h>
+#  include <unistd.h>
+#endif
+
+using clk = std::chrono::steady_clock;
+
+static uint64_t us_since(clk::time_point t) {
+    return (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(clk::now() - t).count();
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the OS read-ahead
+
+void ggml_stager_will_need_now(const void * src, size_t n) {
+    if (src == nullptr || n == 0) {
+        return;
+    }
+    const uintptr_t page  = 4096;
+    const uintptr_t start = (uintptr_t) src & ~(page - 1);
+    const uintptr_t end   = ((uintptr_t) src + n + page - 1) & ~(page - 1);
+#ifdef _WIN32
+    // PrefetchVirtualMemory (Windows 8 and later), looked up so the build does not depend on the SDK's target version
+    struct range_entry { PVOID addr; SIZE_T size; };
+    typedef BOOL (WINAPI * prefetch_fn)(HANDLE, ULONG_PTR, range_entry *, ULONG);
+    static const prefetch_fn fn = [] {
+        HMODULE k = GetModuleHandleW(L"kernel32.dll");
+        return k ? (prefetch_fn) (void *) GetProcAddress(k, "PrefetchVirtualMemory") : (prefetch_fn) nullptr;
+    }();
+    if (fn) {
+        range_entry e = { (PVOID) start, (SIZE_T) (end - start) };
+        fn(GetCurrentProcess(), 1, &e, 0);
+    }
+#elif defined(__unix__) || defined(__APPLE__)
+    madvise((void *) start, (size_t) (end - start), MADV_WILLNEED);
+#else
+    (void) start; (void) end;
+#endif
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// parameters
+
+struct ggml_stager_params ggml_stager_params_default(void) {
+    struct ggml_stager_params p;
+    // Strata's: 16 ring buffers (prefill.cpp:123 kRing) and max(2, min(4, hw / 4)) threads (:451). The chunk is ours: 16 MiB
+    // is 1.2 ms of a 14 GB/s link (Strata's probe of this card on x8, docs/FLASH-NEXT.md 10.2), so one copy call's cost
+    // (tens of microseconds) is under 2% of it; a ring of 16 is 256 MiB of pinned memory. Starting values: the probe's sweep
+    // (bench/fn_probe/) decides them on this machine.
+    const unsigned hw = std::thread::hardware_concurrency();
+    p.n_workers            = (int) std::max(2u, std::min(4u, hw / 4));
+    p.chunk_bytes          = (size_t) 16 << 20;
+    p.n_chunks             = 16;
+    p.will_need            = true;
+    p.unsafe_skip_dma_wait = false;
+    return p;
+}
+
+static long env_long(const char * name, long def) {
+    const char * v = getenv(name);
+    if (v == nullptr || *v == '\0') {
+        return def;
+    }
+    char * end = nullptr;
+    const long x = strtol(v, &end, 10);
+    return end == v ? def : x;
+}
+
+struct ggml_stager_params ggml_stager_params_from_env(bool * enabled) {
+    struct ggml_stager_params p = ggml_stager_params_default();
+    if (enabled) {
+        *enabled = env_long("LLAMA_STAGER", 0) != 0;
+    }
+    p.n_workers = (int) std::max(1L, std::min(64L, env_long("LLAMA_STAGER_THREADS", p.n_workers)));
+    p.chunk_bytes = (size_t) std::max(1L, std::min(1024L, env_long("LLAMA_STAGER_CHUNK_MIB", (long) (p.chunk_bytes >> 20)))) << 20;
+    p.n_chunks = (int) std::max(2L, std::min(256L, env_long("LLAMA_STAGER_RING", p.n_chunks)));
+    p.will_need = env_long("LLAMA_STAGER_WILLNEED", 1) != 0;
+    return p;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the default hooks: a ggml backend (GGML_STAGER_NO_BACKEND: compiled without them, for the standalone probe in
+// bench/fn_probe/, which links this file with its own hooks and no ggml library)
+
+#ifndef GGML_STAGER_NO_BACKEND
+
+namespace {
+
+struct backend_ops_ctx {
+    ggml_backend_t             backend    = nullptr;
+    ggml_backend_dev_t         dev        = nullptr;
+    ggml_backend_buffer_type_t host_buft  = nullptr;
+    bool                       has_events = false;
+    void                    (* bind)(ggml_backend_t) = nullptr;
+    std::mutex                 mu;
+    std::unordered_map<void *, ggml_backend_buffer_t> bufs;
+    std::unordered_map<void *, void *> plain;   // host_alloc without a pinned buffer type: the pointer to free
+};
+
+void be_bind(void * c) {
+    auto * x = (backend_ops_ctx *) c;
+    if (x->bind) {
+        x->bind(x->backend);
+    }
+}
+
+void * be_host_alloc(void * c, size_t size, bool * pinned) {
+    auto * x = (backend_ops_ctx *) c;
+    *pinned = false;
+    if (x->host_buft != nullptr) {
+        ggml_backend_buffer_t b = ggml_backend_buft_alloc_buffer(x->host_buft, size);
+        if (b != nullptr) {
+            void * p = ggml_backend_buffer_get_base(b);
+            std::lock_guard<std::mutex> lk(x->mu);
+            x->bufs[p] = b;
+            *pinned = true;
+            return p;
+        }
+    }
+    void * p = malloc(size);
+    if (p != nullptr) {
+        std::lock_guard<std::mutex> lk(x->mu);
+        x->plain[p] = p;
+    }
+    return p;
+}
+
+void be_host_free(void * c, void * ptr) {
+    auto * x = (backend_ops_ctx *) c;
+    std::lock_guard<std::mutex> lk(x->mu);
+    auto it = x->bufs.find(ptr);
+    if (it != x->bufs.end()) {
+        ggml_backend_buffer_free(it->second);
+        x->bufs.erase(it);
+        return;
+    }
+    auto jt = x->plain.find(ptr);
+    if (jt != x->plain.end()) {
+        free(jt->second);
+        x->plain.erase(jt);
+    }
+}
+
+void be_copy_async(void * c, void * dst, size_t off, const void * src, size_t n) {
+    auto * x = (backend_ops_ctx *) c;
+    ggml_backend_tensor_set_async(x->backend, (ggml_tensor *) dst, src, off, n);
+}
+
+void * be_event_new(void * c) {
+    auto * x = (backend_ops_ctx *) c;
+    return x->has_events ? (void *) ggml_backend_event_new(x->dev) : nullptr;
+}
+
+void be_event_free(void *, void * ev) {
+    if (ev) {
+        ggml_backend_event_free((ggml_backend_event_t) ev);
+    }
+}
+
+void be_event_record(void * c, void * ev) {
+    if (ev) {
+        ggml_backend_event_record((ggml_backend_event_t) ev, ((backend_ops_ctx *) c)->backend);
+    }
+}
+
+void be_stream_wait(void * c, void * ev) {
+    if (ev) {
+        ggml_backend_event_wait(((backend_ops_ctx *) c)->backend, (ggml_backend_event_t) ev);
+    }
+}
+
+void be_event_sync(void *, void * ev) {
+    if (ev) {
+        ggml_backend_event_synchronize((ggml_backend_event_t) ev);
+    }
+}
+
+void be_sync(void * c) {
+    ggml_backend_synchronize(((backend_ops_ctx *) c)->backend);
+}
+
+} // namespace
+
+#endif // GGML_STAGER_NO_BACKEND
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the stager
+
+namespace {
+
+#ifdef GGML_STAGER_NO_BACKEND
+struct backend_ops_ctx {};
+#endif
+
+struct req {
+    uint64_t        ticket;
+    void *          dst;
+    const uint8_t * src;
+    size_t          n;
+    void *          wait_ev;
+    void *          done_ev;
+    int64_t         j0;       // the first chunk's global index
+    int64_t         nchunks;
+};
+
+} // namespace
+
+struct ggml_stager {
+    ggml_stager_ops    ops;
+    ggml_stager_params params;
+    std::unique_ptr<backend_ops_ctx> own;   // the default hooks' context
+
+    std::vector<uint8_t *> buf;
+    std::vector<void *>    dma_done;        // one event per ring buffer: the DMA that read it has landed
+    bool                   pinned = false;
+
+    std::mutex              mu;
+    std::condition_variable cv_work;        // workers: a chunk to claim
+    std::condition_variable cv_ring;        // workers: the issuer has queued another chunk's DMA
+    std::condition_variable cv_fill;        // issuer: a chunk has been copied into its ring buffer / a request arrived
+    std::condition_variable cv_done;        // callers: a request has been queued
+    std::condition_variable cv_hint;        // the hint thread
+
+    // under mu
+    std::deque<req>        reqs;            // submitted, not yet fully queued
+    std::vector<int64_t>   filled;          // per ring buffer: the chunk whose bytes it holds (memcpy complete), else -1
+    int64_t                total_chunks = 0;
+    int64_t                next_claim   = 0;
+    int64_t                dma_issued   = 0; // chunks whose DMA has been queued: [0, dma_issued)
+    uint64_t               next_ticket  = 1;
+    uint64_t               enqueued     = 0; // every request up to this ticket is queued
+    bool                   quit         = false;
+    std::deque<std::pair<const void *, size_t>> hints;
+
+    std::vector<std::thread> workers;
+    std::thread              issuer;
+    std::thread              hinter;
+
+    ggml_stager_stats stats = {};
+    std::atomic<uint64_t> s_worker_copy_us{0}, s_worker_ring_us{0};
+
+    void worker_main();
+    void issuer_main();
+    void hinter_main();
+};
+
+void ggml_stager::worker_main() {
+    ops.bind_thread ? ops.bind_thread(ops.ctx) : (void) 0;
+    const int64_t K = (int64_t) buf.size();
+    for (;;) {
+        int64_t j;
+        const uint8_t * src;
+        size_t len;
+        {
+            std::unique_lock<std::mutex> lk(mu);
+            cv_work.wait(lk, [&] { return quit || next_claim < total_chunks; });
+            if (next_claim >= total_chunks) {
+                return; // quit, and nothing left to claim
+            }
+            j = next_claim++;
+            const req * r = nullptr;
+            for (const req & q : reqs) {
+                if (j >= q.j0 && j < q.j0 + q.nchunks) {
+                    r = &q;
+                    break;
+                }
+            }
+            if (r == nullptr) {
+                fprintf(stderr, "ggml_stager: no request holds chunk %lld\n", (long long) j);
+                abort();
+            }
+            const size_t off = (size_t) (j - r->j0) * params.chunk_bytes;
+            src = r->src + off;
+            len = std::min(params.chunk_bytes, r->n - off);
+
+            // the ring buffer of chunk j was read by the DMA of chunk j - K: it must have been queued (the issuer records
+            // dma_done after queueing it; always waited for, the issuer would otherwise wait for a chunk that was
+            // overwritten) and then must have landed (the event below; the one wait the tests' control leaves out)
+            if (j >= K) {
+                const auto t0 = clk::now();
+                cv_ring.wait(lk, [&] { return dma_issued > j - K; });
+                s_worker_ring_us += us_since(t0);
+            }
+        }
+        const int b = (int) (j % K);
+        if (j >= K && !params.unsafe_skip_dma_wait && dma_done[(size_t) b] != nullptr) {
+            const auto t0 = clk::now();
+            ops.event_sync(ops.ctx, dma_done[(size_t) b]);
+            s_worker_ring_us += us_since(t0);
+        }
+        const auto t1 = clk::now();
+        memcpy(buf[(size_t) b], src, len);
+        s_worker_copy_us += us_since(t1);
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            filled[(size_t) b] = j;
+        }
+        cv_fill.notify_all();
+    }
+}
+
+void ggml_stager::issuer_main() {
+    ops.bind_thread ? ops.bind_thread(ops.ctx) : (void) 0;
+    const int64_t K = (int64_t) buf.size();
+    uint64_t fill_us = 0;
+    for (;;) {
+        req r;
+        {
+            std::unique_lock<std::mutex> lk(mu);
+            cv_fill.wait(lk, [&] { return quit || !reqs.empty(); });
+            if (reqs.empty()) {
+                return;
+            }
+            r = reqs.front();
+        }
+        if (r.wait_ev != nullptr) {
+            ops.stream_wait(ops.ctx, r.wait_ev);
+        }
+        for (int64_t c = 0; c < r.nchunks; ++c) {
+            const int64_t j = r.j0 + c;
+            const int b = (int) (j % K);
+            {
+                const auto t0 = clk::now();
+                std::unique_lock<std::mutex> lk(mu);
+                cv_fill.wait(lk, [&] { return filled[(size_t) b] == j; });
+                fill_us += us_since(t0);
+            }
+            const size_t off = (size_t) c * params.chunk_bytes;
+            const size_t len = std::min(params.chunk_bytes, r.n - off);
+            ops.copy_async(ops.ctx, r.dst, off, buf[(size_t) b], len);
+            if (dma_done[(size_t) b] != nullptr) {
+                ops.event_record(ops.ctx, dma_done[(size_t) b]);
+            }
+            {
+                std::lock_guard<std::mutex> lk(mu);
+                dma_issued = j + 1;
+            }
+            cv_ring.notify_all();
+        }
+        if (r.done_ev != nullptr) {
+            ops.event_record(ops.ctx, r.done_ev);
+        }
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            reqs.pop_front();
+            enqueued = r.ticket;
+            stats.issuer_fill_us = fill_us;
+        }
+        cv_done.notify_all();
+    }
+}
+
+void ggml_stager::hinter_main() {
+    for (;;) {
+        std::pair<const void *, size_t> h;
+        {
+            std::unique_lock<std::mutex> lk(mu);
+            cv_hint.wait(lk, [&] { return quit || !hints.empty(); });
+            if (hints.empty()) {
+                return;
+            }
+            h = hints.front();
+            hints.pop_front();
+        }
+        const auto t0 = clk::now();
+        ggml_stager_will_need_now(h.first, h.second);
+        const uint64_t us = us_since(t0);
+        std::lock_guard<std::mutex> lk(mu);
+        stats.hint_us += us;
+    }
+}
+
+ggml_stager_t ggml_stager_new(const struct ggml_stager_ops * ops, const struct ggml_stager_params * params) {
+    if (ops == nullptr || params == nullptr || ops->copy_async == nullptr || ops->host_alloc == nullptr) {
+        return nullptr;
+    }
+    std::unique_ptr<ggml_stager> st(new ggml_stager());
+    st->ops    = *ops;
+    st->params = *params;
+    st->params.n_workers   = std::max(1, st->params.n_workers);
+    st->params.n_chunks    = std::max(2, st->params.n_chunks);
+    st->params.chunk_bytes = std::max<size_t>(4096, st->params.chunk_bytes);
+
+    const int K = st->params.n_chunks;
+    st->buf.assign((size_t) K, nullptr);
+    st->dma_done.assign((size_t) K, nullptr);
+    st->filled.assign((size_t) K, -1);
+    bool all_pinned = true;
+    for (int i = 0; i < K; ++i) {
+        bool p = false;
+        st->buf[(size_t) i] = (uint8_t *) st->ops.host_alloc(st->ops.ctx, st->params.chunk_bytes, &p);
+        if (st->buf[(size_t) i] == nullptr) {
+            for (int k = 0; k < i; ++k) {
+                st->ops.host_free(st->ops.ctx, st->buf[(size_t) k]);
+            }
+            return nullptr;
+        }
+        all_pinned = all_pinned && p;
+        st->dma_done[(size_t) i] = st->ops.event_new ? st->ops.event_new(st->ops.ctx) : nullptr;
+    }
+    st->pinned = all_pinned;
+
+    // the stream of the backend instance is created lazily by its first call: make that happen on this thread
+    if (st->ops.sync) {
+        st->ops.sync(st->ops.ctx);
+    }
+
+    ggml_stager * raw = st.get();
+    raw->issuer = std::thread([raw] { raw->issuer_main(); });
+    for (int i = 0; i < raw->params.n_workers; ++i) {
+        raw->workers.emplace_back([raw] { raw->worker_main(); });
+    }
+    if (raw->params.will_need) {
+        raw->hinter = std::thread([raw] { raw->hinter_main(); });
+    }
+    return st.release();
+}
+
+#ifndef GGML_STAGER_NO_BACKEND
+ggml_stager_t ggml_stager_new_backend(ggml_backend_t backend, ggml_backend_dev_t dev, const struct ggml_stager_params * params) {
+    if (backend == nullptr || dev == nullptr) {
+        return nullptr;
+    }
+    auto ctx = std::make_unique<backend_ops_ctx>();
+    ctx->backend   = backend;
+    ctx->dev       = dev;
+    ctx->host_buft = ggml_backend_dev_host_buffer_type(dev);
+    ggml_backend_dev_props props;
+    ggml_backend_dev_get_props(dev, &props);
+    ctx->has_events = props.caps.events && props.caps.async;
+    if (ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev)) {
+        ctx->bind = (void (*)(ggml_backend_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_bind_thread");
+    }
+
+    ggml_stager_ops ops = {};
+    ops.ctx          = ctx.get();
+    ops.bind_thread  = be_bind;
+    ops.host_alloc   = be_host_alloc;
+    ops.host_free    = be_host_free;
+    ops.copy_async   = be_copy_async;
+    ops.event_new    = be_event_new;
+    ops.event_free   = be_event_free;
+    ops.event_record = be_event_record;
+    ops.stream_wait  = be_stream_wait;
+    ops.event_sync   = be_event_sync;
+    ops.sync         = be_sync;
+
+    ggml_stager_t st = ggml_stager_new(&ops, params);
+    if (st == nullptr) {
+        return nullptr;
+    }
+    st->own = std::move(ctx);
+    return st;
+}
+#endif // GGML_STAGER_NO_BACKEND
+
+void ggml_stager_free(ggml_stager_t st) {
+    if (st == nullptr) {
+        return;
+    }
+    ggml_stager_drain(st);
+    {
+        std::lock_guard<std::mutex> lk(st->mu);
+        st->quit = true;
+    }
+    st->cv_work.notify_all();
+    st->cv_fill.notify_all();
+    st->cv_ring.notify_all();
+    st->cv_hint.notify_all();
+    if (st->issuer.joinable()) {
+        st->issuer.join();
+    }
+    for (auto & t : st->workers) {
+        t.join();
+    }
+    if (st->hinter.joinable()) {
+        st->hinter.join();
+    }
+    for (size_t i = 0; i < st->buf.size(); ++i) {
+        if (st->dma_done[i] != nullptr && st->ops.event_free) {
+            st->ops.event_free(st->ops.ctx, st->dma_done[i]);
+        }
+        if (st->buf[i] != nullptr && st->ops.host_free) {
+            st->ops.host_free(st->ops.ctx, st->buf[i]);
+        }
+    }
+    delete st;
+}
+
+uint64_t ggml_stager_submit(ggml_stager_t st, void * dst, const void * src, size_t n, void * wait_event, void * done_event) {
+    uint64_t ticket;
+    {
+        std::lock_guard<std::mutex> lk(st->mu);
+        req r;
+        r.ticket  = st->next_ticket++;
+        r.dst     = dst;
+        r.src     = (const uint8_t *) src;
+        r.n       = n;
+        r.wait_ev = wait_event;
+        r.done_ev = done_event;
+        r.j0      = st->total_chunks;
+        r.nchunks = (int64_t) ((n + st->params.chunk_bytes - 1) / st->params.chunk_bytes);
+        st->total_chunks += r.nchunks;
+        st->stats.requests++;
+        st->stats.chunks += (uint64_t) r.nchunks;
+        st->stats.bytes  += n;
+        ticket = r.ticket;
+        st->reqs.push_back(r);
+    }
+    st->cv_work.notify_all();
+    st->cv_fill.notify_all();
+    return ticket;
+}
+
+bool ggml_stager_enqueued(ggml_stager_t st, uint64_t ticket) {
+    std::lock_guard<std::mutex> lk(st->mu);
+    return st->enqueued >= ticket;
+}
+
+void ggml_stager_wait_enqueued(ggml_stager_t st, uint64_t ticket) {
+    std::unique_lock<std::mutex> lk(st->mu);
+    if (st->enqueued >= ticket) {
+        return;
+    }
+    const auto t0 = clk::now();
+    st->cv_done.wait(lk, [&] { return st->enqueued >= ticket; });
+    st->stats.caller_wait_us += us_since(t0);
+}
+
+void ggml_stager_drain(ggml_stager_t st) {
+    uint64_t last;
+    {
+        std::lock_guard<std::mutex> lk(st->mu);
+        last = st->next_ticket - 1;
+    }
+    if (last > 0) {
+        ggml_stager_wait_enqueued(st, last);
+    }
+    if (st->ops.sync) {
+        st->ops.sync(st->ops.ctx);
+    }
+}
+
+void ggml_stager_will_need(ggml_stager_t st, const void * src, size_t n) {
+    if (st == nullptr || !st->params.will_need || src == nullptr || n == 0) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(st->mu);
+        st->hints.emplace_back(src, n);
+        st->stats.hint_calls++;
+        st->stats.hint_bytes += n;
+    }
+    st->cv_hint.notify_all();
+}
+
+void ggml_stager_get_stats(ggml_stager_t st, struct ggml_stager_stats * out) {
+    if (st == nullptr || out == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lk(st->mu);
+    *out = st->stats;
+    out->worker_copy_us = st->s_worker_copy_us.load();
+    out->worker_ring_us = st->s_worker_ring_us.load();
+}
+
+const struct ggml_stager_params * ggml_stager_get_params(ggml_stager_t st) {
+    return st ? &st->params : nullptr;
+}
+
+bool ggml_stager_ring_pinned(ggml_stager_t st) {
+    return st != nullptr && st->pinned;
+}
