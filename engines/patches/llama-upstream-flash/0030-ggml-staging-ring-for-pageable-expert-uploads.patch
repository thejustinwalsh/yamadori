diff --git a/ggml/include/ggml-stager.h b/ggml/include/ggml-stager.h
new file mode 100644
index 000000000..6c3b18626
--- /dev/null
+++ b/ggml/include/ggml-stager.h
@@ -0,0 +1,124 @@
+#pragma once
+
+// 0030: a staging ring for host-to-device copies of PAGEABLE memory (LLAMA_STAGER=1).
+//
+// cudaMemcpyAsync from pageable host memory (an mmapped model file) is not asynchronous: the driver copies it through
+// its own small pinned buffer and the calling host thread is blocked for the whole copy. A thread that has to keep
+// launching kernels, or that has other copies to queue, loses that time (docs/FLASH-NEXT.md 12.5/13: the layer-major
+// prefill's "overlapped" upload of the next layer's experts ran with and without it at the same speed, 433-443 against
+// 433-439 tok/s, n=3).
+//
+// This is the stager of Niko1221/Strata (src/prefill/prefill.cpp @ d551edf :122-239 `struct Stager`, MIT, notice in
+// engines/patches/llama-upstream-flash/LICENSE.strata): a ring of pinned buffers, a few worker threads that memcpy the
+// pageable source into the ring ahead of need (a ring buffer is reused only once the DMA that read it has landed, an
+// event recorded by the issuing side), and one issuer that queues the DMA from the ring on the device's copy stream.
+// Differences from Strata's: the unit is a chunk of a tensor (chunk_bytes), not one expert blob, so a 256 MiB expert
+// tensor streams through a 16 x 16 MiB ring; the issuer is a thread of its own (Strata issues from the launching thread
+// and waits for the memcpy there), so the thread that launches compute never blocks on a copy; a request names the event
+// to record when its last chunk has been queued and an optional event the copy stream waits for first (the last reader
+// of the destination).
+//
+// What a caller must know: a request is DONE (its event recorded) only when ggml_stager_wait_enqueued() returns; an event
+// the compute stream waits on before that has not been recorded yet and the wait would be a no-op.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+    typedef struct ggml_stager * ggml_stager_t;
+
+    // What the stager asks of the device. ggml_stager_new_backend() fills it from a ggml backend; the tests supply a
+    // fake one whose copies land when it says so. Every hook is called from the stager's own threads (bind_thread first).
+    struct ggml_stager_ops {
+        void * ctx;
+
+        // called once on each thread the stager starts (a CUDA backend makes its device current)
+        void   (*bind_thread)(void * ctx);
+
+        // a host buffer the DMA reads; *pinned says whether the device can DMA from it directly (else it is ordinary memory
+        // and the copy is synchronous: correct, not overlapped)
+        void * (*host_alloc)(void * ctx, size_t size, bool * pinned);
+        void   (*host_free)(void * ctx, void * ptr);
+
+        // queue dst[off, off + n) <- src on the stager's stream. `dst` is whatever the caller passed to submit
+        void   (*copy_async)(void * ctx, void * dst, size_t off, const void * src, size_t n);
+
+        // events (may be NULL when the device has none: then the copies are synchronous and there is nothing to wait for)
+        void * (*event_new)(void * ctx);
+        void   (*event_free)(void * ctx, void * ev);
+        void   (*event_record)(void * ctx, void * ev);  // on the stager's stream
+        void   (*stream_wait)(void * ctx, void * ev);   // the stager's stream waits for what `ev` last recorded
+        void   (*event_sync)(void * ctx, void * ev);    // the host waits for what `ev` last recorded
+        void   (*sync)(void * ctx);                     // the host waits for the stager's stream
+    };
+
+    struct ggml_stager_params {
+        int    n_workers;            // memcpy threads (>= 1)
+        size_t chunk_bytes;          // one ring buffer
+        int    n_chunks;             // ring buffers (>= 2)
+        bool   will_need;            // ggml_stager_will_need() does something (else a no-op)
+        bool   unsafe_skip_dma_wait; // TESTS ONLY: a worker reuses a ring buffer without waiting for the DMA that read it
+    };
+
+    struct ggml_stager_stats {
+        uint64_t requests;
+        uint64_t chunks;
+        uint64_t bytes;
+        uint64_t worker_copy_us;     // time the workers spent in memcpy (summed over workers)
+        uint64_t worker_ring_us;     // time the workers waited for a ring buffer to be free again
+        uint64_t issuer_fill_us;     // time the issuer waited for a chunk's memcpy
+        uint64_t caller_wait_us;     // time callers spent in ggml_stager_wait_enqueued()
+        uint64_t hint_calls;
+        uint64_t hint_bytes;
+        uint64_t hint_us;            // time the hint thread spent in the OS call
+    };
+
+    GGML_API struct ggml_stager_params ggml_stager_params_default(void);
+
+    // reads LLAMA_STAGER_THREADS, LLAMA_STAGER_CHUNK_MIB, LLAMA_STAGER_RING and LLAMA_STAGER_WILLNEED over the defaults;
+    // *enabled is LLAMA_STAGER (unset or 0: false). Nothing is created here.
+    GGML_API struct ggml_stager_params ggml_stager_params_from_env(bool * enabled);
+
+    GGML_API ggml_stager_t ggml_stager_new(const struct ggml_stager_ops * ops, const struct ggml_stager_params * params);
+
+    // the stager over a ggml backend (its own stream: pass a backend instance made for it). The ring is the device's host
+    // buffer type (pinned) when it has one.
+    GGML_API ggml_stager_t ggml_stager_new_backend(ggml_backend_t backend, ggml_backend_dev_t dev, const struct ggml_stager_params * params);
+
+    // waits for every submitted request to be queued and landed, then stops the threads
+    GGML_API void ggml_stager_free(ggml_stager_t st);
+
+    // Queue the copy of src[0, n) into dst[0, n). If `wait_event` is not NULL the stager's stream waits for what it has
+    // recorded before the first chunk; `done_event` (not NULL) is recorded on the stager's stream after the last. Returns a
+    // ticket (> 0). The source must stay readable until the request has landed (the model file mapping does).
+    GGML_API uint64_t ggml_stager_submit(ggml_stager_t st, void * dst, const void * src, size_t n, void * wait_event, void * done_event);
+
+    // every chunk of the ticket's request, and every request before it, has been queued and its done event recorded
+    GGML_API bool ggml_stager_enqueued(ggml_stager_t st, uint64_t ticket);
+    GGML_API void ggml_stager_wait_enqueued(ggml_stager_t st, uint64_t ticket);
+
+    // everything submitted so far has been queued and has landed
+    GGML_API void ggml_stager_drain(ggml_stager_t st);
+
+    // Ask the operating system to read src[0, n) into memory now (PrefetchVirtualMemory, else madvise WILLNEED): for the
+    // layer after the one being streamed, so the first read of a cold mapping is not a page fault per page. Returns at
+    // once; the OS call runs on a thread of the stager's. A no-op unless params.will_need.
+    GGML_API void ggml_stager_will_need(ggml_stager_t st, const void * src, size_t n);
+
+    // the OS call itself, synchronously (what the hint thread runs; the tests call it)
+    GGML_API void ggml_stager_will_need_now(const void * src, size_t n);
+
+    GGML_API void ggml_stager_get_stats(ggml_stager_t st, struct ggml_stager_stats * stats);
+    GGML_API const struct ggml_stager_params * ggml_stager_get_params(ggml_stager_t st);
+    GGML_API bool ggml_stager_ring_pinned(ggml_stager_t st);
+
+#ifdef __cplusplus
+}
+#endif
