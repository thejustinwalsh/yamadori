diff --git a/tests/test-stager.cpp b/tests/test-stager.cpp
new file mode 100644
index 000000000..cc18f0872
--- /dev/null
+++ b/tests/test-stager.cpp
@@ -0,0 +1,611 @@
+// 0030: the staging ring (ggml/include/ggml-stager.h) against a fake device whose copies land when IT says so.
+//
+//   test-stager                          CPU only: random requests through the ring with a slow, jittery fake DMA engine
+//   test-stager --device CUDA0           also the real backend: a pageable source through the pinned ring to the card, read
+//                                        back and compared (needs a GPU; not run in the offline gate)
+//   test-stager --trials N --seed S
+//
+// What is checked, after every request, with the destination poisoned before the copy and guard bytes on both sides:
+//   - every byte of the destination equals the source, and the guards are untouched (a chunk landed in the wrong place,
+//     twice, or not at all fails it);
+//   - a ring buffer is never overwritten while the DMA that reads it is still to land: the fake engine reads the buffer
+//     when the copy LANDS (after a random delay), and poisons it right after, so a worker that reuses it too early either
+//     corrupts the destination or is read back as poison;
+//   - ggml_stager_wait_enqueued(t) returns only once the request's done event has been recorded, and the done event
+//     completes only after its last byte landed (the consumer's reading rule);
+//   - a request that names a wait event lands nothing until the event completes (the last reader of the slot);
+//   - ggml_stager_free() with requests still in flight drains them;
+//   - the CONTROLS: the same test with the DMA-completion wait left out of the workers (params.unsafe_skip_dma_wait) must
+//     be caught, and a consumer that reads the destination without waiting for the done event must read poison.
+// The default hooks (ggml_stager_new_backend) are exercised on the CPU backend, which has no events and copies
+// synchronously.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-stager.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+static int g_checks = 0;
+static int g_failed = 0;
+
+#define CHECK(cond, ...)                                                                                              \
+    do {                                                                                                              \
+        ++g_checks;                                                                                                   \
+        if (!(cond)) {                                                                                                \
+            ++g_failed;                                                                                               \
+            if (g_failed <= 40) {                                                                                     \
+                fprintf(stderr, "FAIL %s:%d: %s -- ", __FILE__, __LINE__, #cond);                                     \
+                fprintf(stderr, __VA_ARGS__);                                                                         \
+                fprintf(stderr, "\n");                                                                                \
+            }                                                                                                         \
+        }                                                                                                             \
+    } while (0)
+
+using clk = std::chrono::steady_clock;
+
+static void spin_us(int us) {
+    if (us <= 0) {
+        return;
+    }
+    const auto t = clk::now() + std::chrono::microseconds(us);
+    while (clk::now() < t) {
+        std::this_thread::yield();
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the fake device: one in-order stream (a thread), events, a destination region
+
+struct fake_event {
+    std::mutex              mu;
+    std::condition_variable cv;
+    int64_t                 recorded  = 0;   // records queued
+    int64_t                 completed = 0;   // records the stream has reached
+};
+
+struct fake_dst {
+    std::vector<uint8_t> mem;        // guard + body + guard
+    size_t               guard = 64;
+    size_t               n     = 0;
+    std::atomic<bool>    reader_active{false};   // a "kernel" is reading it: nothing may land
+    std::atomic<int64_t> landed{0};
+    uint8_t *            body() { return mem.data() + guard; }
+};
+
+struct fake_engine {
+    enum kind_t { COPY, RECORD, WAIT };
+    struct op {
+        kind_t      kind;
+        fake_dst *  dst;
+        size_t      off, n;
+        uint8_t *   src;
+        fake_event *ev;
+        int64_t     target;
+    };
+
+    std::mutex              mu;
+    std::condition_variable cv;
+    std::deque<op>          q;
+    bool                    stop = false;
+    std::thread             th;
+    std::atomic<int>        max_delay_us{0};
+    std::atomic<int>        violations{0};      // landed into a region a reader was using
+    std::atomic<int64_t>    in_flight{0};
+    std::mt19937            rng{1};
+    bool                    poison_after_copy = true;
+    std::vector<std::pair<void *, size_t>> allocs;
+    std::mutex              amu;
+
+    fake_engine() { th = std::thread([this] { run(); }); }
+    ~fake_engine() {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            stop = true;
+        }
+        cv.notify_all();
+        th.join();
+        for (auto & a : allocs) {
+            free(a.first);
+        }
+    }
+
+    void push(const op & o) {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            q.push_back(o);
+            in_flight++;
+        }
+        cv.notify_all();
+    }
+
+    void run() {
+        for (;;) {
+            op o;
+            {
+                std::unique_lock<std::mutex> lk(mu);
+                cv.wait(lk, [&] { return stop || !q.empty(); });
+                if (q.empty()) {
+                    return;
+                }
+                o = q.front();
+                q.pop_front();
+            }
+            if (o.kind == COPY) {
+                spin_us(max_delay_us.load() > 0 ? (int) (rng() % (uint32_t) (max_delay_us.load() + 1)) : 0);
+                if (o.dst->reader_active.load()) {
+                    violations++;
+                }
+                // the DMA reads the host buffer NOW; if the stager gave it to a worker too early this is not the chunk's data
+                memcpy(o.dst->body() + o.off, o.src, o.n);
+                o.dst->landed += (int64_t) o.n;
+                if (poison_after_copy) {
+                    memset(o.src, 0xFF, o.n);   // the ring buffer is nobody's until the stager fills it again
+                }
+            } else if (o.kind == RECORD) {
+                std::lock_guard<std::mutex> lk(o.ev->mu);
+                o.ev->completed++;
+                o.ev->cv.notify_all();
+            } else {
+                std::unique_lock<std::mutex> lk(o.ev->mu);
+                o.ev->cv.wait(lk, [&] { return o.ev->completed >= o.target; });
+            }
+            in_flight--;
+        }
+    }
+};
+
+static void f_bind(void *) {}
+
+static void * f_host_alloc(void * c, size_t size, bool * pinned) {
+    auto * e = (fake_engine *) c;
+    *pinned = true;
+    void * p = malloc(size);
+    memset(p, 0xFF, size);
+    std::lock_guard<std::mutex> lk(e->amu);
+    e->allocs.emplace_back(p, size);
+    return p;
+}
+
+static void f_host_free(void * c, void * ptr) {
+    auto * e = (fake_engine *) c;
+    std::lock_guard<std::mutex> lk(e->amu);
+    for (size_t i = 0; i < e->allocs.size(); ++i) {
+        if (e->allocs[i].first == ptr) {
+            free(ptr);
+            e->allocs.erase(e->allocs.begin() + (long) i);
+            return;
+        }
+    }
+}
+
+static void f_copy(void * c, void * dst, size_t off, const void * src, size_t n) {
+    auto * e = (fake_engine *) c;
+    fake_engine::op o = {};
+    o.kind = fake_engine::COPY;
+    o.dst  = (fake_dst *) dst;
+    o.off  = off;
+    o.n    = n;
+    o.src  = (uint8_t *) src;
+    e->push(o);
+}
+
+static void * f_event_new(void *) { return new fake_event(); }
+static void   f_event_free(void *, void * ev) { delete (fake_event *) ev; }
+
+static void f_event_record(void * c, void * ev) {
+    auto * e = (fake_engine *) c;
+    auto * x = (fake_event *) ev;
+    {
+        std::lock_guard<std::mutex> lk(x->mu);
+        x->recorded++;
+    }
+    fake_engine::op o = {};
+    o.kind = fake_engine::RECORD;
+    o.ev   = x;
+    e->push(o);
+}
+
+static void f_stream_wait(void * c, void * ev) {
+    auto * e = (fake_engine *) c;
+    auto * x = (fake_event *) ev;
+    fake_engine::op o = {};
+    o.kind = fake_engine::WAIT;
+    o.ev   = x;
+    {
+        std::lock_guard<std::mutex> lk(x->mu);
+        o.target = x->recorded;
+    }
+    e->push(o);
+}
+
+static void f_event_sync(void *, void * ev) {
+    auto * x = (fake_event *) ev;
+    std::unique_lock<std::mutex> lk(x->mu);
+    const int64_t t = x->recorded;
+    x->cv.wait(lk, [&] { return x->completed >= t; });
+}
+
+static void f_sync(void * c) {
+    auto * e = (fake_engine *) c;
+    while (e->in_flight.load() != 0) {
+        std::this_thread::yield();
+    }
+}
+
+static ggml_stager_ops fake_ops(fake_engine * e) {
+    ggml_stager_ops o = {};
+    o.ctx          = e;
+    o.bind_thread  = f_bind;
+    o.host_alloc   = f_host_alloc;
+    o.host_free    = f_host_free;
+    o.copy_async   = f_copy;
+    o.event_new    = f_event_new;
+    o.event_free   = f_event_free;
+    o.event_record = f_event_record;
+    o.stream_wait  = f_stream_wait;
+    o.event_sync   = f_event_sync;
+    o.sync         = f_sync;
+    return o;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+static std::unique_ptr<fake_dst> make_dst(size_t n) {
+    auto d = std::make_unique<fake_dst>();
+    d->n = n;
+    d->mem.assign(n + 2 * d->guard, 0xA5);   // the guards and the body start poisoned
+    return d;
+}
+
+static bool guards_ok(fake_dst & d) {
+    for (size_t i = 0; i < d.guard; ++i) {
+        if (d.mem[i] != 0xA5 || d.mem[d.guard + d.n + i] != 0xA5) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static std::vector<uint8_t> random_bytes(std::mt19937 & r, size_t n) {
+    std::vector<uint8_t> v(n);
+    for (size_t i = 0; i < n; ++i) {
+        v[i] = (uint8_t) r();
+    }
+    return v;
+}
+
+struct trial_cfg {
+    int    workers;
+    size_t chunk;
+    int    ring;
+    int    delay_us;
+    int    n_req;
+    bool   unsafe = false;
+};
+
+// returns the number of requests whose destination was wrong
+static int run_trial(std::mt19937 & r, const trial_cfg & cfg, bool control) {
+    fake_engine eng;
+    eng.max_delay_us = cfg.delay_us;
+    eng.rng.seed((uint32_t) r());
+    ggml_stager_ops ops = fake_ops(&eng);
+    ggml_stager_params p = ggml_stager_params_default();
+    p.n_workers = cfg.workers;
+    p.chunk_bytes = cfg.chunk;
+    p.n_chunks = cfg.ring;
+    p.will_need = true;
+    p.unsafe_skip_dma_wait = cfg.unsafe;
+    ggml_stager_t st = ggml_stager_new(&ops, &p);
+    CHECK(st != nullptr, "ggml_stager_new");
+    if (st == nullptr) {
+        return 0;
+    }
+
+    struct item {
+        std::unique_ptr<fake_dst>    dst;
+        std::vector<uint8_t>         src;
+        std::unique_ptr<fake_event>  done;
+        std::unique_ptr<fake_event>  wait;
+        uint64_t                     ticket = 0;
+    };
+    std::vector<item> items((size_t) cfg.n_req);
+    int bad = 0;
+
+    for (int k = 0; k < cfg.n_req; ++k) {
+        item & it = items[(size_t) k];
+        const size_t pick = r() % 8;
+        size_t n;
+        switch (pick) {
+            case 0:  n = 0; break;
+            case 1:  n = cfg.chunk - 1; break;
+            case 2:  n = cfg.chunk; break;
+            case 3:  n = cfg.chunk + 1; break;
+            case 4:  n = 2 * cfg.chunk; break;
+            default: n = 1 + r() % (size_t) (cfg.chunk * 5 + 17); break;
+        }
+        if (control) {
+            n = cfg.chunk * (4 + r() % 4);
+        }
+        it.src  = random_bytes(r, n);
+        it.dst  = make_dst(n);
+        it.done.reset(new fake_event());
+        // a source that does not start on a chunk boundary or a page: the model's tensors do not
+        const bool use_wait = !control && (r() % 4 == 0);
+        if (use_wait) {
+            it.wait.reset(new fake_event());
+            it.wait->recorded = 1;     // the last reader's `free` event: recorded, not yet complete
+            it.dst->reader_active = true;
+        }
+        it.ticket = ggml_stager_submit(st, it.dst.get(), it.src.data(), n, it.wait.get(), it.done.get());
+        CHECK(it.ticket > 0, "ticket");
+
+        if (use_wait) {
+            // nothing may land while the reader runs; then it finishes and the copy may go
+            spin_us(300);
+            CHECK(it.dst->landed.load() == 0, "request %d landed %lld bytes before the slot's last reader finished", k, (long long) it.dst->landed.load());
+            it.dst->reader_active = false;
+            {
+                std::lock_guard<std::mutex> lk(it.wait->mu);
+                it.wait->completed = 1;
+                it.wait->cv.notify_all();
+            }
+        }
+
+        // sometimes consume at once, sometimes let several requests pile up
+        if (r() % 3 == 0 || k + 1 == cfg.n_req) {
+            for (int q = 0; q <= k; ++q) {
+                item & jt = items[(size_t) q];
+                if (jt.ticket == 0) {
+                    continue;
+                }
+                ggml_stager_wait_enqueued(st, jt.ticket);
+                CHECK(ggml_stager_enqueued(st, jt.ticket), "enqueued after the wait");
+                {
+                    std::lock_guard<std::mutex> lk(jt.done->mu);
+                    CHECK(jt.done->recorded == 1, "request %d: wait_enqueued returned with the done event recorded %lld times", q, (long long) jt.done->recorded);
+                }
+                if (control) {
+                    // the consumer that does not wait for the done event reads whatever has landed so far
+                    // (nothing to assert here: the unsafe-ring control below does the checking)
+                }
+                f_event_sync(nullptr, jt.done.get());
+                const bool equal = jt.src.empty() || memcmp(jt.dst->body(), jt.src.data(), jt.src.size()) == 0;
+                CHECK(jt.dst->landed.load() == (int64_t) jt.src.size(), "request %d landed %lld of %zu bytes", q, (long long) jt.dst->landed.load(), jt.src.size());
+                if (!control) {
+                    CHECK(equal, "request %d (%zu bytes, chunk %zu, ring %d, %d workers): the destination differs from the source", q, jt.src.size(), cfg.chunk, cfg.ring, cfg.workers);
+                    CHECK(guards_ok(*jt.dst), "request %d: a guard byte was written", q);
+                }
+                bad += equal && guards_ok(*jt.dst) ? 0 : 1;
+                jt.ticket = 0;
+            }
+        }
+    }
+
+    if (!control) {
+        CHECK(eng.violations.load() == 0, "%d copies landed into a region a reader was using", eng.violations.load());
+    }
+    ggml_stager_stats s = {};
+    ggml_stager_get_stats(st, &s);
+    uint64_t total = 0;
+    for (auto & it : items) {
+        total += it.src.size();
+    }
+    if (!control) {
+        CHECK(s.bytes == total, "stats: %llu bytes submitted, expected %llu", (unsigned long long) s.bytes, (unsigned long long) total);
+        CHECK(s.requests == (uint64_t) cfg.n_req, "stats: %llu requests", (unsigned long long) s.requests);
+    }
+    ggml_stager_free(st);
+    return bad;
+}
+
+// requests still queued when the stager is freed are drained, not dropped
+static void test_free_drains(std::mt19937 & r) {
+    fake_engine eng;
+    eng.max_delay_us = 150;
+    ggml_stager_ops ops = fake_ops(&eng);
+    ggml_stager_params p = ggml_stager_params_default();
+    p.n_workers = 3;
+    p.chunk_bytes = 4096;
+    p.n_chunks = 4;
+    ggml_stager_t st = ggml_stager_new(&ops, &p);
+    std::vector<std::unique_ptr<fake_dst>> dsts;
+    std::vector<std::vector<uint8_t>> srcs;
+    std::vector<std::unique_ptr<fake_event>> evs;
+    for (int k = 0; k < 6; ++k) {
+        srcs.push_back(random_bytes(r, 4096 * 5 + 11));
+        dsts.push_back(make_dst(srcs.back().size()));
+        evs.emplace_back(new fake_event());
+        ggml_stager_submit(st, dsts.back().get(), srcs.back().data(), srcs.back().size(), nullptr, evs.back().get());
+    }
+    ggml_stager_free(st);   // no wait before this
+    for (int k = 0; k < 6; ++k) {
+        CHECK(memcmp(dsts[(size_t) k]->body(), srcs[(size_t) k].data(), srcs[(size_t) k].size()) == 0, "request %d not drained by free", k);
+    }
+}
+
+// a consumer that reads the destination before the done event completes reads poison: the check the real consumer
+// (a kernel launched after `stream wait on done`) must never fail, and proof that the poison is visible if it did
+static void test_early_read_sees_poison(std::mt19937 & r) {
+    fake_engine eng;
+    eng.max_delay_us = 2000;   // a slow link
+    ggml_stager_ops ops = fake_ops(&eng);
+    ggml_stager_params p = ggml_stager_params_default();
+    p.n_workers = 2;
+    p.chunk_bytes = 4096;
+    p.n_chunks = 4;
+    ggml_stager_t st = ggml_stager_new(&ops, &p);
+    auto src = random_bytes(r, 4096 * 8);
+    auto dst = make_dst(src.size());
+    fake_event done;
+    const uint64_t t = ggml_stager_submit(st, dst.get(), src.data(), src.size(), nullptr, &done);
+    ggml_stager_wait_enqueued(st, t);
+    // queued, not landed: with a 2 ms-a-chunk link the first read sees poison
+    const bool early_poison = memcmp(dst->body(), src.data(), src.size()) != 0;
+    CHECK(early_poison, "the control did not see an unfinished copy: the fake link is not slow enough to prove anything");
+    f_event_sync(nullptr, &done);
+    CHECK(memcmp(dst->body(), src.data(), src.size()) == 0, "after the done event the bytes are there");
+    ggml_stager_free(st);
+}
+
+// the default hooks over the CPU backend: no events, synchronous copies, an ordinary-memory ring
+static void test_cpu_backend(std::mt19937 & r) {
+    ggml_backend_t cpu = ggml_backend_cpu_init();
+    ggml_backend_dev_t dev = ggml_backend_get_device(cpu);
+    ggml_stager_params p = ggml_stager_params_default();
+    p.n_workers = 3;
+    p.chunk_bytes = 4096;
+    p.n_chunks = 5;
+    ggml_stager_t st = ggml_stager_new_backend(cpu, dev, &p);
+    CHECK(st != nullptr, "ggml_stager_new_backend on the CPU backend");
+    if (st == nullptr) {
+        ggml_backend_free(cpu);
+        return;
+    }
+    CHECK(!ggml_stager_ring_pinned(st), "a CPU ring is not pinned");
+    ggml_init_params ip = { 4 * ggml_tensor_overhead() + 1024, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    const size_t n = 4096 * 7 + 123;
+    ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, (int64_t) n);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, cpu);
+    ggml_backend_buffer_clear(buf, 0xA5);
+    auto src = random_bytes(r, n);
+    const uint64_t k = ggml_stager_submit(st, t, src.data(), n, nullptr, nullptr);
+    ggml_stager_wait_enqueued(st, k);
+    ggml_stager_drain(st);
+    std::vector<uint8_t> back(n);
+    ggml_backend_tensor_get(t, back.data(), 0, n);
+    CHECK(back == src, "CPU backend: the tensor differs from the source");
+    ggml_stager_will_need(st, src.data(), src.size());   // must not crash on ordinary memory
+    ggml_stager_will_need_now(src.data(), src.size());
+    ggml_stager_will_need_now(nullptr, 10);
+    ggml_stager_free(st);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    ggml_backend_free(cpu);
+}
+
+// the real backend: a pageable source (ordinary malloc, odd offset) through the pinned ring to the card
+static void test_device(const std::string & name, std::mt19937 & r) {
+    ggml_backend_dev_t dev = ggml_backend_dev_by_name(name.c_str());
+    if (dev == nullptr) {
+        fprintf(stderr, "no device %s\n", name.c_str());
+        g_failed++;
+        return;
+    }
+    ggml_backend_t be = ggml_backend_dev_init(dev, nullptr);
+    ggml_backend_t be2 = ggml_backend_dev_init(dev, nullptr);   // the stager's own instance (its own stream)
+    ggml_stager_params p = ggml_stager_params_default();
+    ggml_stager_t st = ggml_stager_new_backend(be2, dev, &p);
+    CHECK(st != nullptr, "ggml_stager_new_backend on %s", name.c_str());
+    if (st == nullptr) {
+        return;
+    }
+    printf("device %s: ring %d x %zu MiB, %s, %d threads\n", name.c_str(), ggml_stager_get_params(st)->n_chunks,
+           ggml_stager_get_params(st)->chunk_bytes >> 20, ggml_stager_ring_pinned(st) ? "pinned" : "NOT pinned",
+           ggml_stager_get_params(st)->n_workers);
+    CHECK(ggml_stager_ring_pinned(st), "the device's host buffer type should give a pinned ring");
+    const size_t n = (size_t) 300 << 20;
+    ggml_init_params ip = { 4 * ggml_tensor_overhead() + 1024, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, (int64_t) n);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, be);
+    CHECK(buf != nullptr, "device buffer");
+    ggml_backend_buffer_clear(buf, 0xA5);
+    ggml_backend_synchronize(be);
+    std::vector<uint8_t> big = random_bytes(r, n + 4099);
+    const uint8_t * src = big.data() + 4099;   // not page aligned
+    ggml_backend_event_t done = ggml_backend_event_new(dev);
+    const auto t0 = clk::now();
+    const uint64_t k = ggml_stager_submit(st, t, src, n, nullptr, done);
+    ggml_stager_wait_enqueued(st, k);
+    ggml_backend_event_wait(be, done);   // the consumer's stream
+    ggml_backend_synchronize(be);
+    const double ms = std::chrono::duration<double, std::milli>(clk::now() - t0).count();
+    std::vector<uint8_t> back(n);
+    ggml_backend_tensor_get(t, back.data(), 0, n);
+    CHECK(memcmp(back.data(), src, n) == 0, "%s: the tensor differs from the source", name.c_str());
+    printf("device %s: %.0f MiB staged in %.1f ms = %.2f GB/s (n=1: a smoke check, not the probe)\n", name.c_str(), n / 1048576.0, ms, n / 1e6 / ms);
+    ggml_stager_stats s = {};
+    ggml_stager_get_stats(st, &s);
+    printf("device %s: memcpy %.1f ms (summed), workers waited for the ring %.1f ms, issuer waited for a chunk %.1f ms\n", name.c_str(),
+           s.worker_copy_us / 1000.0, s.worker_ring_us / 1000.0, s.issuer_fill_us / 1000.0);
+    ggml_stager_free(st);
+    ggml_backend_event_free(done);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    ggml_backend_free(be2);
+    ggml_backend_free(be);
+}
+
+int main(int argc, char ** argv) {
+    int trials = 200;
+    uint32_t seed = 20261006;
+    std::string device;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        if (a == "--trials" && i + 1 < argc) { trials = atoi(argv[++i]); }
+        else if (a == "--seed" && i + 1 < argc) { seed = (uint32_t) strtoul(argv[++i], nullptr, 10); }
+        else if (a == "--device" && i + 1 < argc) { device = argv[++i]; }
+        else if (a == "--quick") { trials = 40; }
+        else { fprintf(stderr, "unknown argument %s\n", a.c_str()); return 2; }
+    }
+    std::mt19937 r(seed);
+
+    // 1. random requests, workers 1-4, chunks 4-64 KiB (including one that is not a power of two), rings 2-9, a fake DMA
+    //    engine that lands each chunk after 0-300 us
+    int total_bad = 0;
+    for (int t = 0; t < trials; ++t) {
+        static const size_t chunks[] = { 4096, 8192, 12288, 16384, 65536 };
+        trial_cfg c;
+        c.workers  = 1 + (int) (r() % 4);
+        c.chunk    = chunks[r() % 5];
+        c.ring     = 2 + (int) (r() % 8);
+        c.delay_us = (int) (r() % 4) * 100;
+        c.n_req    = 1 + (int) (r() % 12);
+        total_bad += run_trial(r, c, false);
+    }
+    printf("1. random requests: %d trials, %d wrong destinations\n", trials, total_bad);
+
+    // 2. the control: no wait for the DMA that reads a ring buffer. It must be caught.
+    int caught = 0, ctrl_trials = std::max(20, trials / 4);
+    for (int t = 0; t < ctrl_trials; ++t) {
+        trial_cfg c;
+        c.workers  = 4;
+        c.chunk    = 4096;
+        c.ring     = 2;
+        c.delay_us = 400;
+        c.n_req    = 3;
+        c.unsafe   = true;
+        caught += run_trial(r, c, true) > 0 ? 1 : 0;
+    }
+    printf("2. control (workers do not wait for the DMA): caught in %d of %d trials\n", caught, ctrl_trials);
+    CHECK(caught >= ctrl_trials * 9 / 10, "the control must be caught in nearly every trial (%d of %d)", caught, ctrl_trials);
+
+    test_free_drains(r);
+    printf("3. free() drains what is queued\n");
+    test_early_read_sees_poison(r);
+    printf("4. a read before the done event sees poison; after it, the data\n");
+    test_cpu_backend(r);
+    printf("5. the default hooks over the CPU backend (no events, synchronous copies)\n");
+    if (!device.empty()) {
+        test_device(device, r);
+    }
+
+    printf("%d checks, %d failed\n", g_checks, g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
