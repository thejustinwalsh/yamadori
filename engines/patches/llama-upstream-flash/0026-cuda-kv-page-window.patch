--- /dev/null
+++ b/ggml/src/ggml-cuda/kv-window.cu
@@ -0,0 +1,720 @@
+// The K/V page window (patch 0026). See kv-window.cuh for what it is.
+//
+// Ported from Strata: Niko1221/Strata, src/kernels/cuda/kv_stream.cu and include/strata/kernels/kv_stream.hpp, read
+// at d551edf ("docs: troubleshooting row for the IQ3_XXS long-prompt stop (fixed in 0.1.15)").
+//
+//   Copyright (c) 2026 Niko1221 and the Strata contributors
+//
+//   Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated
+//   documentation files (the "Software"), to deal in the Software without restriction, including without
+//   limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the
+//   Software, and to permit persons to whom the Software is furnished to do so, subject to the following
+//   conditions:
+//
+//   The above copyright notice and this permission notice shall be included in all copies or substantial portions
+//   of the Software.
+//
+//   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED
+//   TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+//   THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF
+//   CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+//   DEALINGS IN THE SOFTWARE.
+//
+// Taken from Strata, per function below: the residency map (page_table block -> slot or -1, slot_block, slot_stamp,
+// slot_ref, ctl, miss_block, miss_slot: KvStreamMap, kv_stream.hpp:49), block_scan (kv_stream.cu:58), the resolve
+// kernel (:82: hits take this call's epoch and their CLOCK reference bit, a missing block is claimed once -1 -> -2,
+// one victim slot per miss by a CLOCK sweep that never takes a slot this call uses), the copy kernel (:161), the
+// reset kernel (:173) and the 4-cell page. Ours: what Strata did not need because it owns its K/V layout and its
+// writers -- here the cache is llama.cpp's, written by ggml ops and by host copies, so a write drops the pages it
+// touches (kvw_invalidate_rows_kernel, on_node, flush_buffer) instead of writing through; the pool holds the cache's
+// own quantized rows (q8_0 / q4_0) and the reader (fattn-common.cuh) converts from it, so a hit is bit-identical to a
+// read of the host row; the lists come from the sparse flash attention's index lists; and the cases Strata rules
+// out by a legal n_slots (a call that names more pages than the pool holds, fewer than 1,024 slots) are handled.
+
+#include "kv-window.cuh"
+
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+
+void ggml_cuda_kv_window_on_init_tensor(ggml_backend_buffer_t, const ggml_tensor *, int, bool) {}
+void ggml_cuda_kv_window_on_free_buffer(ggml_backend_buffer_t) {}
+void ggml_cuda_kv_window_flush_buffer(ggml_backend_buffer_t) {}
+void ggml_cuda_kv_window_on_node(ggml_backend_cuda_context &, const ggml_tensor *) {}
+void ggml_cuda_kv_window_tick() {}
+ggml_cuda_kv_window_view ggml_cuda_kv_window_prepare(
+        ggml_backend_cuda_context &, const ggml_tensor *, const int32_t *, const int32_t *, int64_t, int64_t, cudaStream_t) {
+    return {};
+}
+void ggml_cuda_kv_window_configure(int64_t, int64_t) {}
+void ggml_cuda_kv_window_set_use(int) {}
+void ggml_cuda_kv_window_set_debug(int, int) {}
+int  ggml_cuda_kv_window_query(const ggml_tensor *, int64_t *, int32_t *, int32_t *) { return 0; }
+int  ggml_cuda_kv_window_test_fill(const ggml_tensor *, int64_t, const void *, int64_t) { return 0; }
+
+#else
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr int RT       = 1024;  // the resolve block (Strata kv_stream.cu:23)
+constexpr int CTL_INTS = 16;    // ctl: [0] epoch [1] hand [2] misses placed by the last call [3] overflow (sticky);
+                                // u64 at [4] pages copied, [6] lookups, [8] calls (Strata kv_stream.hpp:61)
+
+// The window's size. LLAMA_KV_PAGE_WINDOW=<cells per K or V tensor>; Strata's own numbers: it keeps N cells of each
+// QSA layer in VRAM with N = max(--kv-resident, 20480) (src/core/layer.cpp:508 `max(g_kv_resident,
+// qsa_kv_resident_min())`, :522 `qsa_kv_resident_min() { return 20480; }`, the floor: n_slots must hold the
+// distinct pages of one call, n_q x (cap / page_size + 2)) and its setup script passes 32768 (setup.py:1022).
+// LLAMA_KV_PAGE_WINDOW=1 means that 32768. LLAMA_KV_PAGE_WINDOW_FLOOR (tests only) replaces the 20480 floor.
+constexpr int64_t STRATA_FLOOR_CELLS   = 20480;
+constexpr int64_t STRATA_DEFAULT_CELLS = 32768;
+
+struct kvw_config {
+    int64_t cells         = 0;                  // 0: no windows
+    int64_t floor_cells   = STRATA_FLOOR_CELLS;
+    bool    poison        = false;              // tests: a pool starts as NaN scales, so a read before a copy is NaN
+    bool    no_invalidate = false;              // tests: writers do not drop pages (a mutation: the tests must fail)
+    bool    stats         = false;              // log the hit rate when a buffer is freed
+};
+
+std::mutex  g_cfg_mu;
+std::atomic<bool> g_no_invalidate{false};   // mirrors kvw_config::no_invalidate, read on every writer node
+kvw_config  g_cfg;
+bool        g_cfg_init = false;
+
+kvw_config cfg_get() {
+    std::lock_guard<std::mutex> lock(g_cfg_mu);
+    if (!g_cfg_init) {
+        g_cfg_init = true;
+        if (const char * e = getenv("LLAMA_KV_PAGE_WINDOW")) {
+            const long long v = atoll(e);
+            g_cfg.cells = v <= 0 ? 0 : v == 1 ? STRATA_DEFAULT_CELLS : v;
+        }
+        if (const char * e = getenv("LLAMA_KV_PAGE_WINDOW_FLOOR")) {
+            const long long v = atoll(e);
+            if (v >= GGML_CUDA_KV_PAGE_CELLS) {
+                g_cfg.floor_cells = v;
+            }
+        }
+        const char * e;
+        g_cfg.poison        = (e = getenv("GGML_CUDA_KV_PAGE_POISON"))        && e[0] == '1';
+        g_cfg.no_invalidate = (e = getenv("GGML_CUDA_KV_PAGE_NO_INVALIDATE")) && e[0] == '1';
+        g_cfg.stats         = (e = getenv("GGML_CUDA_KV_PAGE_STATS"))         && e[0] == '1';
+        g_no_invalidate.store(g_cfg.no_invalidate);
+    }
+    return g_cfg;
+}
+
+std::atomic<bool> g_use{true};         // reads on / off (tests toggle it between a windowed and a plain run)
+std::atomic<int>  g_n_windows{0};
+
+// the residency map: all device memory at fixed addresses (graphs bake them in), Strata's KvStreamMap
+struct kvw_dev {
+    int32_t * page_table;  // (n_blocks,) block -> slot, or -1 (-2 only inside a resolve: claimed)
+    int32_t * slot_block;  // (n_slots,)  slot -> block, or -1
+    int32_t * slot_stamp;  // (n_slots,)  the resolve epoch that last used the slot
+    int32_t * slot_ref;    // (n_slots,)  clock reference bit
+    int32_t * ctl;
+    int32_t * miss_block;  // (n_slots,)
+    int32_t * miss_slot;   // (n_slots,)
+    int64_t   n_blocks;
+    int64_t   n_slots;
+};
+
+struct kvw {
+    int                   device = 0;
+    ggml_backend_buffer_t buffer = nullptr;
+    const void *          key    = nullptr;   // the cache tensor's data pointer
+    std::string           name;
+    ggml_type             type   = GGML_TYPE_F16;
+    int64_t               row_bytes  = 0;     // one cell, all heads: the cache tensor's nb[1]
+    int64_t               n_cells    = 0;
+    int64_t               n_blocks   = 0;
+    int64_t               n_slots    = 0;
+    int64_t               page_bytes = 0;     // GGML_CUDA_KV_PAGE_CELLS rows
+    char *                arrays = nullptr;
+    kvw_dev               dev    = {};
+    char *                pool   = nullptr;   // n_slots pages; allocated by the first call that can use it
+    bool                  pool_failed = false;
+};
+
+std::mutex                                      g_mu;
+std::map<std::pair<int, const void *>, std::unique_ptr<kvw>> g_windows;
+
+kvw * find_window(int device, const void * key) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    auto it = g_windows.find({device, key});
+    return it == g_windows.end() ? nullptr : it->second.get();
+}
+
+// the window of a cache tensor, whatever its device (tests)
+kvw * find_window_of(const ggml_tensor * root) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    for (auto & kv : g_windows) {
+        if (kv.second->key == root->data && kv.second->buffer == root->buffer) {
+            return kv.second.get();
+        }
+    }
+    return nullptr;
+}
+
+// Block-wide exclusive prefix sum of one int per thread (RT threads); `total` is the sum over the block.
+// Strata kv_stream.cu:58, unchanged.
+__device__ int kvw_block_scan(int v, int * warp_sums, int & total) {
+    const int lane = threadIdx.x & 31, w = threadIdx.x >> 5;
+    int x = v;
+    for (int o = 1; o < 32; o <<= 1) {
+        const int y = __shfl_up_sync(0xffffffffu, x, o);
+        if (lane >= o) x += y;
+    }
+    if (lane == 31) warp_sums[w] = x;
+    __syncthreads();
+    if (w == 0) {
+        int t = warp_sums[lane];
+        for (int o = 1; o < 32; o <<= 1) {
+            const int y = __shfl_up_sync(0xffffffffu, t, o);
+            if (lane >= o) t += y;
+        }
+        warp_sums[lane] = t;
+    }
+    __syncthreads();
+    total = warp_sums[31];
+    const int excl = x - v + (w > 0 ? warp_sums[w - 1] : 0);
+    __syncthreads();
+    return excl;
+}
+
+// One page named by this call (Strata kv_stream.cu:98-104): a resident one takes this call's epoch and its clock
+// reference bit; a missing one is claimed exactly once (-1 -> -2) into the miss list.
+__device__ __forceinline__ void kvw_touch(const kvw_dev & m, const int b, const int epoch, const int n, int * s_nmiss) {
+    const int sl = m.page_table[b];
+    if (sl >= 0) {
+        m.slot_stamp[sl] = epoch;
+        m.slot_ref[sl]   = 1;
+    } else if (sl == -1 && atomicCAS(&m.page_table[b], -1, -2) == -1) {
+        const int k = atomicAdd(s_nmiss, 1);
+        if (k < n) {
+            m.miss_block[k] = b;
+        } else {
+            m.page_table[b] = -1;   // more pages than slots: not resident, read from the host
+        }
+    }
+}
+
+// Make every page the lists name resident. Strata kv_stream.cu:82 resolve_kernel, one block of RT threads:
+//   1. hits take this call's epoch and their clock reference bit; a missing page is claimed once (-1 -> -2) into a
+//      miss list;
+//   2. one victim slot per miss by a CLOCK sweep (second chance) that never takes a slot this call uses;
+//   3. the page table is re-pointed (old block -> -1, new block -> slot).
+// Differences from Strata's: the ids are the sparse attention's index lists (counts[l] valid entries, ascending) and
+// page 0 is always looked up (the sparse kernels' padded slots gather row 0); a call that names more pages than the
+// window holds does not write past the miss arrays: the pages that do not fit are left at -1, and the reader
+// (fattn-common.cuh) reads them from the host; and a window of fewer than RT slots works (Strata's sweep gives two
+// threads the same slot there; its n_slots is never below 5,120): only min(n, RT) threads take part in a sweep.
+__global__ void __launch_bounds__(RT) kvw_resolve_kernel(
+        kvw_dev m, const int32_t * __restrict__ ids, const int32_t * __restrict__ counts, int n_lists, int n_kv_max) {
+    __shared__ int s_nmiss, s_lookups, s_cut;
+    __shared__ int warp_sums[32];
+    const int epoch = (int) ((uint32_t) m.ctl[0] + 1u);
+    const int n     = (int) m.n_slots;
+    if (threadIdx.x == 0) { s_nmiss = 0; s_lookups = 0; }
+    __syncthreads();
+    // 1. hits take this epoch and their reference bit; a missing block is claimed exactly once (-1 -> -2)
+    int lookups = 0;
+    if (threadIdx.x == 0) {
+        kvw_touch(m, 0, epoch, n, &s_nmiss);
+        ++lookups;
+    }
+    for (int l = 0; l < n_lists; ++l) {
+        const int width = counts[l];
+        const int32_t * qi = ids + (long long) l * n_kv_max;
+        for (int i = threadIdx.x; i < width; i += RT) {
+            const int cell = qi[i];
+            if (cell < 0) continue;
+            const int b = cell >> GGML_CUDA_KV_PAGE_SHIFT;
+            if (i > 0 && (qi[i - 1] >> GGML_CUDA_KV_PAGE_SHIFT) == b) continue;   // ids are ascending: one lookup per block
+            kvw_touch(m, b, epoch, n, &s_nmiss);
+            ++lookups;
+        }
+    }
+    atomicAdd(&s_lookups, lookups);
+    __syncthreads();
+    // 2. one victim per miss: a clock sweep from the hand. A slot this call uses (stamp == epoch) is never taken;
+    //    a referenced one loses its bit as the hand passes it and is taken on the next pass.
+    const int total_miss = s_nmiss;
+    const int need       = total_miss < n ? total_miss : n;
+    const int span       = n < RT ? n : RT;
+    int hand = m.ctl[1], got = 0;
+    for (int scanned = 0; got < need && scanned < 3 * n; scanned += span) {
+        const bool act  = (int) threadIdx.x < span;
+        const int  j    = act ? (int) (((long long) hand + threadIdx.x) % n) : 0;
+        const bool mine = act && m.slot_stamp[j] == epoch;
+        const bool cand = act && !mine && (m.slot_block[j] < 0 || m.slot_ref[j] == 0);
+        int total = 0;
+        const int rank = kvw_block_scan(cand ? 1 : 0, warp_sums, total);
+        const int want = need - got;
+        if (threadIdx.x == 0) s_cut = span;
+        __syncthreads();
+        if (cand && rank == want - 1) s_cut = threadIdx.x + 1;   // the hand stops just past the last slot taken
+        __syncthreads();
+        const int cut = s_cut;
+        if (cand && rank < want) {
+            m.miss_slot[got + rank] = j;
+            m.slot_stamp[j] = epoch;   // taken: a sweep that wraps around must not take it twice
+        } else if (act && (int) threadIdx.x < cut && !mine) {
+            m.slot_ref[j] = 0;
+        }
+        got += total < want ? total : want;
+        hand = (int) (((long long) hand + cut) % n);
+        __syncthreads();
+    }
+    // 3. re-point the table; the copy kernel fills the slots
+    const int placed = got < need ? got : need;
+    for (int k = threadIdx.x; k < need; k += RT) {
+        const int b = m.miss_block[k];
+        if (k >= placed) { m.page_table[b] = -1; continue; }   // no victim: read from the host
+        const int sl  = m.miss_slot[k];
+        const int old = m.slot_block[sl];
+        if (old >= 0) m.page_table[old] = -1;
+        m.slot_block[sl] = b;
+        m.slot_stamp[sl] = epoch;
+        m.slot_ref[sl]   = 1;
+        m.page_table[b]  = sl;
+    }
+    if (threadIdx.x == 0) {
+        m.ctl[0] = epoch;
+        m.ctl[1] = hand;
+        m.ctl[2] = placed;
+        if (placed < total_miss) m.ctl[3] = 1;
+        unsigned long long * c = reinterpret_cast<unsigned long long *>(m.ctl + 4);
+        c[0] += (unsigned long long) placed;
+        c[1] += (unsigned long long) s_lookups;
+        c[2] += 1ull;
+    }
+}
+
+// One block per missed page (grid-stride): copy it from the host copy into its slot, 16 B per thread.
+// Strata kv_stream.cu:161 copy_kernel; one run per page (the cache's rows of a page are contiguous).
+__global__ void kvw_copy_kernel(kvw_dev m, const char * __restrict__ host, char * __restrict__ pool, int page_bytes) {
+    const int need = m.ctl[2];
+    for (int k = blockIdx.x; k < need; k += gridDim.x) {
+        const long long b = m.miss_block[k], sl = m.miss_slot[k];
+        const uint4 * src = reinterpret_cast<const uint4 *>(host + b * page_bytes);
+        uint4 *       dst = reinterpret_cast<uint4 *>(pool + sl * page_bytes);
+        for (int i = threadIdx.x; i < page_bytes / 16; i += blockDim.x) dst[i] = src[i];
+    }
+}
+
+// Every page evicted: page table all -1, slots free. Strata kv_stream.cu:173 reset_kernel; the counters ctl[4..]
+// are kept (they are what the hit rate is read from), the epoch and the clock hand restart.
+__global__ void kvw_reset_kernel(kvw_dev m) {
+    const long long i0 = (long long) blockIdx.x * blockDim.x + threadIdx.x, st = (long long) gridDim.x * blockDim.x;
+    for (long long i = i0; i < m.n_blocks; i += st) m.page_table[i] = -1;
+    for (long long i = i0; i < m.n_slots; i += st) {
+        m.slot_block[i] = -1;
+        m.slot_stamp[i] = -1;
+        m.slot_ref[i]   = 0;
+    }
+    if (i0 < 3) m.ctl[i0] = 0;   // epoch, hand, placed (ctl[3] is the sticky overflow flag)
+}
+
+// A write to rows of the cache: the pages those rows are in no longer match the host copy -- drop them. (Strata
+// writes through to the slot; its writers are its own kernels. Here the writers are ggml ops and host copies, so a
+// page that was written is simply evicted and re-copied by the next resolve that names it.)
+template <typename idx_t>
+__global__ void kvw_invalidate_rows_kernel(kvw_dev m, const idx_t * __restrict__ rows, int n_rows, long long n_cells) {
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n_rows; i += gridDim.x * blockDim.x) {
+        const long long r = (long long) rows[i];
+        if (r < 0 || r >= n_cells) continue;
+        const int b  = (int) (r >> GGML_CUDA_KV_PAGE_SHIFT);
+        const int sl = m.page_table[b];
+        if (sl >= 0) {
+            m.page_table[b]  = -1;
+            m.slot_block[sl] = -1;
+            m.slot_ref[sl]   = 0;
+        }
+    }
+}
+
+size_t align16(size_t n) { return (n + 15) & ~(size_t) 15; }
+
+void reset_window(const kvw & w, cudaStream_t stream) {
+    kvw_reset_kernel<<<128, 256, 0, stream>>>(w.dev);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------------------------------------------
+// configuration (tests)
+
+void ggml_cuda_kv_window_configure(int64_t cells, int64_t floor_cells) {
+    (void) cfg_get();
+    std::lock_guard<std::mutex> lock(g_cfg_mu);
+    g_cfg.cells = cells < 0 ? 0 : cells;
+    if (floor_cells >= GGML_CUDA_KV_PAGE_CELLS) {
+        g_cfg.floor_cells = floor_cells;
+    }
+}
+
+void ggml_cuda_kv_window_set_use(int use) {
+    g_use.store(use != 0);
+}
+
+void ggml_cuda_kv_window_set_debug(int poison, int no_invalidate) {
+    (void) cfg_get();
+    std::lock_guard<std::mutex> lock(g_cfg_mu);
+    g_cfg.poison        = poison != 0;
+    g_cfg.no_invalidate = no_invalidate != 0;
+    g_no_invalidate.store(g_cfg.no_invalidate);
+}
+
+// out[0] n_blocks, [1] n_slots, [2] page_bytes, [3] pool bytes (0: not allocated), [4] pages resident, [5] pages
+// copied, [6] lookups, [7] calls, [8] overflow seen, [9] epoch. page_table (n_blocks) and slot_block (n_slots) are
+// copied out if not null. Returns 0 when the tensor has no window.
+int ggml_cuda_kv_window_query(const ggml_tensor * root, int64_t * out, int32_t * page_table, int32_t * slot_block) {
+    if (!root || !root->buffer) {
+        return 0;
+    }
+    kvw * w = find_window_of(root);
+    if (!w) {
+        return 0;
+    }
+    ggml_cuda_set_device(w->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    std::vector<int32_t> pt(w->n_blocks), sb(w->n_slots);
+    int32_t ctl[CTL_INTS] = {};
+    CUDA_CHECK(cudaMemcpy(pt.data(), w->dev.page_table, pt.size()*sizeof(int32_t), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(sb.data(), w->dev.slot_block, sb.size()*sizeof(int32_t), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(ctl, w->dev.ctl, sizeof(ctl), cudaMemcpyDeviceToHost));
+    int64_t resident = 0;
+    for (int32_t s : pt) {
+        resident += s >= 0;
+    }
+    const unsigned long long * u = reinterpret_cast<const unsigned long long *>(ctl + 4);
+    out[0] = w->n_blocks;
+    out[1] = w->n_slots;
+    out[2] = w->page_bytes;
+    out[3] = w->pool ? w->n_slots * w->page_bytes : 0;
+    out[4] = resident;
+    out[5] = (int64_t) u[0];
+    out[6] = (int64_t) u[1];
+    out[7] = (int64_t) u[2];
+    out[8] = ctl[3];
+    out[9] = ctl[0];
+    if (page_table) std::copy(pt.begin(), pt.end(), page_table);
+    if (slot_block) std::copy(sb.begin(), sb.end(), slot_block);
+    return 1;
+}
+
+int ggml_cuda_kv_window_test_fill(const ggml_tensor * root, int64_t byte_off, const void * data, int64_t bytes) {
+    kvw * w = root && root->buffer ? find_window_of(root) : nullptr;
+    if (!w) {
+        return 0;
+    }
+    ggml_cuda_set_device(w->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    if (data) {
+        CUDA_CHECK(cudaMemcpyAsync((char *) root->data + byte_off, data, bytes, cudaMemcpyHostToDevice, cudaStreamPerThread));
+    } else {
+        CUDA_CHECK(cudaMemsetAsync((char *) root->data + byte_off, 0xFF, bytes, cudaStreamPerThread));
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    return 1;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// the buffer's side
+
+void ggml_cuda_kv_window_on_init_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * t, int device, bool host_mapped) {
+    const kvw_config cfg = cfg_get();
+    if (cfg.cells <= 0 || !host_mapped || t->view_src != nullptr) {
+        return;
+    }
+    // the llama.cpp K/V cache layout: [n_embd_gqa, kv_size, 1] (one stream), quantized, one cell = one row
+    const int64_t bs = ggml_blck_size(t->type);
+    if ((t->type != GGML_TYPE_Q8_0 && t->type != GGML_TYPE_Q4_0) || t->ne[0] % bs != 0 || t->ne[2] != 1 || t->ne[3] != 1 ||
+            t->ne[1] % GGML_CUDA_KV_PAGE_CELLS != 0 || t->nb[1] != ggml_row_size(t->type, t->ne[0]) ||
+            t->nb[2] != t->nb[1]*t->ne[1]) {
+        return;
+    }
+    const int64_t row_bytes  = t->nb[1];
+    const int64_t page_bytes = row_bytes * GGML_CUDA_KV_PAGE_CELLS;
+    if (page_bytes % 16 != 0 || (uintptr_t) t->data % 16 != 0 || page_bytes > INT32_MAX) {
+        return;
+    }
+    auto w = std::make_unique<kvw>();
+    w->device     = device;
+    w->buffer     = buffer;
+    w->key        = t->data;
+    w->name       = t->name;
+    w->type       = t->type;
+    w->row_bytes  = row_bytes;
+    w->n_cells    = t->ne[1];
+    w->n_blocks   = w->n_cells / GGML_CUDA_KV_PAGE_CELLS;
+    w->page_bytes = page_bytes;
+    // the window: max(N, the floor) cells, rounded up to whole pages, never more than the cache holds
+    const int64_t cells = std::max(cfg.cells, cfg.floor_cells);
+    w->n_slots = std::min<int64_t>((cells + GGML_CUDA_KV_PAGE_CELLS - 1) / GGML_CUDA_KV_PAGE_CELLS, w->n_blocks);
+
+    const size_t n_blocks = (size_t) w->n_blocks, n_slots = (size_t) w->n_slots;
+    const size_t off_pt = 0;
+    const size_t off_sb = off_pt + align16(n_blocks*4);
+    const size_t off_st = off_sb + align16(n_slots*4);
+    const size_t off_sr = off_st + align16(n_slots*4);
+    const size_t off_mb = off_sr + align16(n_slots*4);
+    const size_t off_ms = off_mb + align16(n_slots*4);
+    const size_t off_ct = off_ms + align16(n_slots*4);
+    const size_t total  = off_ct + CTL_INTS*4;
+
+    ggml_cuda_set_device(device);
+    void * p = nullptr;
+    if (cudaMalloc(&p, total) != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_WARN("%s: no memory for the K/V page window map of %s (%zu bytes); no window for it\n", __func__, t->name, total);
+        return;
+    }
+    w->arrays = (char *) p;
+    w->dev.page_table = (int32_t *) (w->arrays + off_pt);
+    w->dev.slot_block = (int32_t *) (w->arrays + off_sb);
+    w->dev.slot_stamp = (int32_t *) (w->arrays + off_st);
+    w->dev.slot_ref   = (int32_t *) (w->arrays + off_sr);
+    w->dev.miss_block = (int32_t *) (w->arrays + off_mb);
+    w->dev.miss_slot  = (int32_t *) (w->arrays + off_ms);
+    w->dev.ctl        = (int32_t *) (w->arrays + off_ct);
+    w->dev.n_blocks   = w->n_blocks;
+    w->dev.n_slots    = w->n_slots;
+    CUDA_CHECK(cudaMemsetAsync(w->arrays, 0, total, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    reset_window(*w, cudaStreamPerThread);
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+
+    std::lock_guard<std::mutex> lock(g_mu);
+    const auto key = std::make_pair(device, (const void *) t->data);
+    g_windows[key] = std::move(w);
+    g_n_windows.fetch_add(1);
+}
+
+void ggml_cuda_kv_window_on_free_buffer(ggml_backend_buffer_t buffer) {
+    if (g_n_windows.load() == 0) {
+        return;
+    }
+    std::vector<std::unique_ptr<kvw>> dead;
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        for (auto it = g_windows.begin(); it != g_windows.end();) {
+            if (it->second->buffer == buffer) {
+                dead.push_back(std::move(it->second));
+                it = g_windows.erase(it);
+                g_n_windows.fetch_sub(1);
+            } else {
+                ++it;
+            }
+        }
+    }
+    if (dead.empty()) {
+        return;
+    }
+    const kvw_config cfg = cfg_get();
+    unsigned long long copied = 0, lookups = 0, calls = 0;
+    size_t pool_bytes = 0;
+    bool overflow = false;
+    for (auto & w : dead) {
+        ggml_cuda_set_device(w->device);
+        CUDA_CHECK(cudaDeviceSynchronize());
+        if (cfg.stats) {
+            int32_t ctl[CTL_INTS] = {};
+            CUDA_CHECK(cudaMemcpy(ctl, w->dev.ctl, sizeof(ctl), cudaMemcpyDeviceToHost));
+            const unsigned long long * u = reinterpret_cast<const unsigned long long *>(ctl + 4);
+            copied += u[0]; lookups += u[1]; calls += u[2];
+            overflow = overflow || ctl[3] != 0;
+        }
+        if (w->pool) {
+            pool_bytes += (size_t) w->n_slots * w->page_bytes;
+            CUDA_CHECK(cudaFree(w->pool));
+        }
+        CUDA_CHECK(cudaFree(w->arrays));
+    }
+    if (cfg.stats) {
+        GGML_LOG_INFO("kv page window: %zu tensors, %llu resolves, %llu page lookups, %llu pages copied (hit rate %.1f%%), "
+                      "overflow %s, pool %.1f MiB\n", dead.size(), calls, lookups, copied,
+                      lookups ? 100.0 * (double) (lookups - std::min(lookups, copied)) / (double) lookups : 0.0,
+                      overflow ? "yes" : "no", pool_bytes / 1024.0 / 1024.0);
+    }
+}
+
+void ggml_cuda_kv_window_tick() {
+    static std::atomic<uint64_t> n{0};
+    static unsigned long long last_lookups = 0, last_copied = 0, last_calls = 0;
+    if (g_n_windows.load(std::memory_order_relaxed) == 0 || !cfg_get().stats || n.fetch_add(1) % 1024 != 1023) {
+        return;
+    }
+    unsigned long long lookups = 0, copied = 0, calls = 0;
+    int n_win = 0;
+    bool overflow = false;
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        for (auto & kv : g_windows) {
+            const kvw & w = *kv.second;
+            int32_t ctl[CTL_INTS] = {};
+            ggml_cuda_set_device(w.device);
+            CUDA_CHECK(cudaMemcpyAsync(ctl, w.dev.ctl, sizeof(ctl), cudaMemcpyDeviceToHost, cudaStreamPerThread));
+            CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+            const unsigned long long * u = reinterpret_cast<const unsigned long long *>(ctl + 4);
+            copied += u[0]; lookups += u[1]; calls += u[2];
+            overflow = overflow || ctl[3] != 0;
+            n_win += w.pool != nullptr;
+        }
+    }
+    const unsigned long long dl = lookups - last_lookups, dc = copied - last_copied, dn = calls - last_calls;
+    last_lookups = lookups; last_copied = copied; last_calls = calls;
+    if (dn > 0) {
+        GGML_LOG_INFO("kv page window: %d windows in use, last %llu resolves: %llu page lookups, %llu copied over PCIe "
+                      "(hit rate %.1f%%)%s\n", n_win, dn, dl, dc, dl ? 100.0 * (double) (dl - std::min(dl, dc)) / (double) dl : 0.0,
+                      overflow ? ", a call has overflowed the window" : "");
+    }
+}
+
+void ggml_cuda_kv_window_flush_buffer(ggml_backend_buffer_t buffer) {
+    if (g_n_windows.load() == 0) {
+        return;
+    }
+    std::vector<kvw *> ws;
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        for (auto & kv : g_windows) {
+            if (kv.second->buffer == buffer) {
+                ws.push_back(kv.second.get());
+            }
+        }
+    }
+    for (kvw * w : ws) {
+        ggml_cuda_set_device(w->device);
+        reset_window(*w, cudaStreamPerThread);
+    }
+    if (!ws.empty()) {
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    }
+}
+
+void ggml_cuda_kv_window_on_node(ggml_backend_cuda_context & ctx, const ggml_tensor * node) {
+    if (g_n_windows.load(std::memory_order_relaxed) == 0 || node->view_src == nullptr) {
+        return;
+    }
+    switch (node->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_VIEW:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return;
+        default:
+            break;
+    }
+    const ggml_tensor * root = node->view_src;
+    kvw * w = find_window(ctx.device, root->data);
+    if (!w || w->buffer != root->buffer) {
+        return;
+    }
+    if (g_no_invalidate.load(std::memory_order_relaxed)) {
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    if (node->op == GGML_OP_SET_ROWS) {
+        // the rows it names; the cache tensor's row is a cell (llama_kv_cache::cpy_k / cpy_v, one stream)
+        const ggml_tensor * rows = node->src[1];
+        if (rows && (rows->type == GGML_TYPE_I64 || rows->type == GGML_TYPE_I32) && rows->ne[1] == 1 && rows->ne[2] == 1 &&
+                rows->ne[3] == 1 && rows->nb[0] == ggml_type_size(rows->type) && node->ne[1] == w->n_cells &&
+                node->nb[1] == w->row_bytes && node->ne[2] == 1 && node->ne[3] == 1) {
+            const int n_rows = (int) rows->ne[0];
+            const int blocks = std::max(1, std::min((n_rows + 255) / 256, 64));
+            if (rows->type == GGML_TYPE_I64) {
+                kvw_invalidate_rows_kernel<int64_t><<<blocks, 256, 0, stream>>>(w->dev, (const int64_t *) rows->data, n_rows, w->n_cells);
+            } else {
+                kvw_invalidate_rows_kernel<int32_t><<<blocks, 256, 0, stream>>>(w->dev, (const int32_t *) rows->data, n_rows, w->n_cells);
+            }
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
+    }
+    // any other op that writes into the cache (a K shift, a copy): every page goes
+    reset_window(*w, stream);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// the flash attention's side
+
+ggml_cuda_kv_window_view ggml_cuda_kv_window_prepare(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * K, const int32_t * idx, const int32_t * counts,
+        int64_t n_lists, int64_t n_kv_max, cudaStream_t stream) {
+    ggml_cuda_kv_window_view out;
+    if (g_n_windows.load(std::memory_order_relaxed) == 0 || !g_use.load(std::memory_order_relaxed)) {
+        return out;
+    }
+    const ggml_tensor * root = K->view_src ? K->view_src : K;
+    kvw * w = find_window(ctx.device, root->data);
+    if (!w || w->buffer != root->buffer) {
+        return out;
+    }
+    // K must be the cache tensor's own cells at its own stride: cell c, head h at data + c*nb[1] + h*nb[2], the heads
+    // inside the cell's row, one stream, no offset into the cache
+    if (K->type != w->type || K->data != root->data || K->ne[3] != 1 || K->nb[1] != w->row_bytes || K->ne[1] > w->n_cells ||
+            (K->ne[2] - 1)*(int64_t) K->nb[2] + (int64_t) ggml_row_size(K->type, K->ne[0]) > w->row_bytes) {
+        return out;
+    }
+    // the lists name at most n_lists x (n_kv_max / page + 2) pages if their cells are whole blocks (Strata's bound,
+    // kv_stream.hpp "n_q x (cap / page_size + 2)"), plus page 0; a window that cannot hold that is not used
+    if (n_lists * ((n_kv_max >> GGML_CUDA_KV_PAGE_SHIFT) + 2) + 1 > w->n_slots) {
+        return out;
+    }
+    if (!w->pool) {
+        if (w->pool_failed) {
+            return out;
+        }
+        // allocated outside of a graph capture only (the first calls of a graph run eagerly, ggml-cuda.cu)
+        cudaStreamCaptureStatus capturing = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(stream, &capturing));
+        if (capturing != cudaStreamCaptureStatusNone) {
+            return out;
+        }
+        ggml_cuda_set_device(w->device);
+        void * p = nullptr;
+        const size_t bytes = (size_t) w->n_slots * (size_t) w->page_bytes;
+        if (cudaMalloc(&p, bytes) != cudaSuccess) {
+            (void) cudaGetLastError();
+            w->pool_failed = true;
+            GGML_LOG_WARN("%s: no memory for the K/V page window pool of %s (%.1f MiB); no window for it\n", __func__,
+                          w->name.c_str(), bytes / 1024.0 / 1024.0);
+            return out;
+        }
+        w->pool = (char *) p;
+        if (cfg_get().poison) {
+            // 0xFF: the scale of a q8_0 / q4_0 block is a half NaN, so a read of a slot nothing copied into is NaN
+            CUDA_CHECK(cudaMemsetAsync(w->pool, 0xFF, bytes, stream));
+        }
+        GGML_LOG_INFO("kv page window: %s: %lld slots of %lld cells (%.1f MiB of VRAM), the cache holds %lld cells\n",
+                      w->name.c_str(), (long long) w->n_slots, (long long) GGML_CUDA_KV_PAGE_CELLS, bytes / 1024.0 / 1024.0,
+                      (long long) w->n_cells);
+    }
+
+    kvw_resolve_kernel<<<1, RT, 0, stream>>>(w->dev, idx, counts, (int) n_lists, (int) n_kv_max);
+    CUDA_CHECK(cudaGetLastError());
+    // 96 x 128: Strata's launch (kv_stream.cu:214); most calls miss a handful of pages, a cold one the whole selection
+    kvw_copy_kernel<<<96, 128, 0, stream>>>(w->dev, (const char *) root->data, w->pool, (int) w->page_bytes);
+    CUDA_CHECK(cudaGetLastError());
+
+    out.page_table = w->dev.page_table;
+    out.pool       = w->pool;
+    return out;
+}
+
+#endif // !HIP && !MUSA
diff --git a/ggml/src/ggml-cuda/kv-window.cuh b/ggml/src/ggml-cuda/kv-window.cuh
new file mode 100644
index 00000000..76aa2be7
--- /dev/null
+++ b/ggml/src/ggml-cuda/kv-window.cuh
@@ -0,0 +1,71 @@
+#pragma once
+
+// The K/V page window (patch 0026): a persistent, VRAM-resident cache of recently used pages of an attention K/V
+// cache that lives in pinned host memory (LLAMA_KV_HOST_MAPPED, patch 0012). The sparse (QSA) flash attention reads
+// ~2,051 selected cells per query per layer (0014); with the cache host-mapped each of them crossed PCIe on every
+// step. A window keeps the pages the previous steps selected in VRAM, so a selected cell that is in the window is
+// read from VRAM and only the pages that are missing cross PCIe.
+//
+// Ported from Strata (Niko1221/Strata, MIT; LICENSE.strata beside the patch): src/kernels/cuda/kv_stream.cu and
+// include/strata/kernels/kv_stream.hpp, read at d551edf (resolve_kernel :82, copy_kernel :161, reset_kernel :173,
+// kv_stream_resolve :204, KvStreamMap hpp :49). See kv-window.cu for what was taken and what is ours.
+
+#include "common.cuh"
+
+// one page = 4 cells (Strata include/strata/kernels/qsa.hpp:115 `s.page_size = 4`: one indexer block)
+#define GGML_CUDA_KV_PAGE_SHIFT 2
+#define GGML_CUDA_KV_PAGE_CELLS (1 << GGML_CUDA_KV_PAGE_SHIFT)
+
+// what a reader needs: block -> slot (or -1), and the pool the slots index (a slot is GGML_CUDA_KV_PAGE_CELLS rows
+// of the cache's own row stride, in the cache's own quantized format). Both null: no window, read the host rows.
+struct ggml_cuda_kv_window_view {
+    const int32_t * page_table = nullptr;
+    const char    * pool       = nullptr;
+};
+
+// ---- ggml-cuda.cu hooks (all no-ops while no window exists, i.e. while LLAMA_KV_PAGE_WINDOW is unset) ----
+
+// a tensor was allocated in `buffer` (host-mapped or not): create its window if it is a K/V cache tensor
+void ggml_cuda_kv_window_on_init_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor, int device, bool host_mapped);
+// the buffer is being freed: free its windows (logs their hit rate with GGML_CUDA_KV_PAGE_STATS=1)
+void ggml_cuda_kv_window_on_free_buffer(ggml_backend_buffer_t buffer);
+// bytes of the buffer were written from the host (set / memset / clear / copy into it): every page of its windows is
+// dropped. Same discipline as the write itself: the caller has synchronised with the compute streams.
+void ggml_cuda_kv_window_flush_buffer(ggml_backend_buffer_t buffer);
+// a graph node is about to run: a node that writes into a windowed cache tensor (SET_ROWS: the rows it names; any
+// other op whose result is a view of the cache: the whole window) invalidates the pages it touches. Capturable.
+void ggml_cuda_kv_window_on_node(ggml_backend_cuda_context & ctx, const ggml_tensor * node);
+
+// once per graph compute: with GGML_CUDA_KV_PAGE_STATS=1, every 1,024th call logs the windows' hit rate since the last
+// line (INFO), read without stalling the compute streams
+void ggml_cuda_kv_window_tick();
+
+// ---- the flash attention's side ----
+
+// Make every page that the lists name resident in the window of K (a view of a windowed cache tensor) and return
+// its page table and pool; both null when the tensor has no window or the call cannot use it (geometry, a call that
+// names more pages than the window holds, a pool that cannot be allocated while a graph is being captured).
+//   idx    int32 [n_lists][n_kv_max]  the cells of each list, ascending (flash_attn_mask_to_sparse_indices)
+//   counts int32 [n_lists]            how many entries of each list are valid
+// Always reads cell 0's page as well: the sparse kernels' padded slots gather row 0.
+ggml_cuda_kv_window_view ggml_cuda_kv_window_prepare(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * K, const int32_t * idx, const int32_t * counts,
+        int64_t n_lists, int64_t n_kv_max, cudaStream_t stream);
+
+// ---- configuration and inspection (tests; the registry proc addresses ggml_backend_cuda_kv_page_window_*) ----
+
+// cells: the window per K or V tensor (as LLAMA_KV_PAGE_WINDOW; it applies to tensors allocated after the call),
+// floor_cells: the least window (the env default is Strata's 20,480). Not for production: set the environment.
+void ggml_cuda_kv_window_configure(int64_t cells, int64_t floor_cells);
+// reads on / off: a plain run and a windowed run over the same tensors
+void ggml_cuda_kv_window_set_use(int use);
+// tests: poison the pool (NaN scales) and / or stop writers dropping pages (a mutation the tests must catch)
+void ggml_cuda_kv_window_set_debug(int poison, int no_invalidate);
+// out[0] n_blocks, [1] n_slots, [2] page_bytes, [3] pool bytes (0: not yet allocated), [4] pages resident, [5] pages
+// copied, [6] lookups, [7] resolves, [8] overflow seen, [9] epoch; page_table (n_blocks) and slot_block (n_slots)
+// copied out when not null. Returns 0 when the tensor has no window.
+int ggml_cuda_kv_window_query(const ggml_tensor * root, int64_t * out, int32_t * page_table, int32_t * slot_block);
+// tests: write `bytes` bytes of the windowed cache tensor `root` at byte_off straight into its (host) memory --
+// `data`, or 0xFF when null -- WITHOUT telling the window (the hooks of set / memset are bypassed). Poisons the host
+// copy of pages that are resident, to show a hit never reads it. Returns 0 when the tensor has no window.
+int ggml_cuda_kv_window_test_fill(const ggml_tensor * root, int64_t byte_off, const void * data, int64_t bytes);
