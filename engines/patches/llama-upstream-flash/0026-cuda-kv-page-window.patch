diff --git a/tests/test-kv-page-window-model.cpp b/tests/test-kv-page-window-model.cpp
new file mode 100644
index 00000000..fa00c547
--- /dev/null
+++ b/tests/test-kv-page-window-model.cpp
@@ -0,0 +1,298 @@
+// CPU-only model of the K/V page window's resolve kernel (patch 0026; ggml/src/ggml-cuda/kv-window.cu,
+// kvw_resolve_kernel, ported from Strata src/kernels/cuda/kv_stream.cu @ d551edf resolve_kernel).
+//
+// The kernel is one block of 1,024 threads whose phases are separated by __syncthreads(). This runs the same
+// phases with the 1,024 threads emulated one after another between the barriers (the kernel's cross-thread
+// accesses between two barriers are atomics, or each thread's own slot), line for line the kernel's logic, and
+// fuzzes it: random index lists, windows from 3 slots to 5,000 (the kernel's own sweep is changed for fewer than
+// 1,024 slots: only min(n, 1,024) threads sweep), a call after a call, writes that drop pages in between. After
+// every call it checks what the window promises:
+//   - the page table and the slots are a bijection; no more pages resident than slots;
+//   - every page the call named is resident afterwards, or the call overflowed (more distinct pages than slots)
+//     and the pages left out read -1 (the reader then reads the host copy);
+//   - a page the call hit keeps its slot (a slot this call uses is never taken);
+//   - the number of pages placed is min(misses, slots not used by the call);
+//   - the copy list names exactly the pages that were placed.
+// It cannot show the kernel is right (it is a transcription), only that the algorithm is.
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace {
+
+constexpr int RT = 1024;
+constexpr int SHIFT = 2;
+
+struct map_t {
+    std::vector<int32_t> page_table, slot_block, slot_stamp, slot_ref, miss_block, miss_slot;
+    int32_t epoch = 0, hand = 0, placed = 0, overflow = 0;
+    int64_t n_blocks = 0, n_slots = 0;
+    void reset(int64_t nb, int64_t ns) {
+        n_blocks = nb; n_slots = ns;
+        page_table.assign(nb, -1); slot_block.assign(ns, -1); slot_stamp.assign(ns, -1); slot_ref.assign(ns, 0);
+        miss_block.assign(ns, 0); miss_slot.assign(ns, 0);
+        epoch = 0; hand = 0; placed = 0; overflow = 0;
+    }
+};
+
+struct call_result {
+    int total_miss = 0;
+    int placed = 0;
+};
+
+void touch(map_t & m, int b, int epoch, int n, int & s_nmiss) {
+    const int sl = m.page_table[b];
+    if (sl >= 0) {
+        m.slot_stamp[sl] = epoch;
+        m.slot_ref[sl]   = 1;
+    } else if (sl == -1) {   // atomicCAS(-1 -> -2) succeeds for the first thread only
+        m.page_table[b] = -2;
+        const int k = s_nmiss++;
+        if (k < n) {
+            m.miss_block[k] = b;
+        } else {
+            m.page_table[b] = -1;
+        }
+    }
+}
+
+// kvw_resolve_kernel, phase by phase
+call_result resolve(map_t & m, const std::vector<std::vector<int32_t>> & lists) {
+    int s_nmiss = 0;
+    const int epoch = (int) ((uint32_t) m.epoch + 1u);
+    const int n = (int) m.n_slots;
+    // phase 1
+    for (int tid = 0; tid < RT; ++tid) {
+        if (tid == 0) {
+            touch(m, 0, epoch, n, s_nmiss);
+        }
+        for (const auto & qi : lists) {
+            const int width = (int) qi.size();
+            for (int i = tid; i < width; i += RT) {
+                const int cell = qi[i];
+                if (cell < 0) continue;
+                const int b = cell >> SHIFT;
+                if (i > 0 && (qi[i - 1] >> SHIFT) == b) continue;
+                touch(m, b, epoch, n, s_nmiss);
+            }
+        }
+    }
+    // phase 2: the clock sweep
+    const int total_miss = s_nmiss;
+    const int need = total_miss < n ? total_miss : n;
+    const int span = n < RT ? n : RT;
+    int hand = m.hand, got = 0;
+    for (int scanned = 0; got < need && scanned < 3 * n; scanned += span) {
+        std::vector<char> act(RT), mine(RT), cand(RT);
+        std::vector<int> j(RT, 0);
+        for (int tid = 0; tid < RT; ++tid) {
+            act[tid]  = tid < span;
+            j[tid]    = act[tid] ? (int) (((long long) hand + tid) % n) : 0;
+            mine[tid] = act[tid] && m.slot_stamp[j[tid]] == epoch;
+            cand[tid] = act[tid] && !mine[tid] && (m.slot_block[j[tid]] < 0 || m.slot_ref[j[tid]] == 0);
+        }
+        // block_scan: exclusive prefix sum of cand
+        std::vector<int> rank(RT);
+        int total = 0;
+        for (int tid = 0; tid < RT; ++tid) {
+            rank[tid] = total;
+            total += cand[tid] ? 1 : 0;
+        }
+        const int want = need - got;
+        int s_cut = span;
+        for (int tid = 0; tid < RT; ++tid) {
+            if (cand[tid] && rank[tid] == want - 1) s_cut = tid + 1;
+        }
+        const int cut = s_cut;
+        for (int tid = 0; tid < RT; ++tid) {
+            if (cand[tid] && rank[tid] < want) {
+                m.miss_slot[got + rank[tid]] = j[tid];
+                m.slot_stamp[j[tid]] = epoch;
+            } else if (act[tid] && tid < cut && !mine[tid]) {
+                m.slot_ref[j[tid]] = 0;
+            }
+        }
+        got += total < want ? total : want;
+        hand = (int) (((long long) hand + cut) % n);
+    }
+    // phase 3
+    const int placed = got < need ? got : need;
+    for (int k = 0; k < need; ++k) {
+        const int b = m.miss_block[k];
+        if (k >= placed) { m.page_table[b] = -1; continue; }
+        const int sl  = m.miss_slot[k];
+        const int old = m.slot_block[sl];
+        if (old >= 0) m.page_table[old] = -1;
+        m.slot_block[sl] = b;
+        m.slot_stamp[sl] = epoch;
+        m.slot_ref[sl]   = 1;
+        m.page_table[b]  = sl;
+    }
+    m.epoch = epoch;
+    m.hand = hand;
+    m.placed = placed;
+    if (placed < total_miss) m.overflow = 1;
+    return { total_miss, placed };
+}
+
+// kvw_invalidate_rows_kernel
+void invalidate(map_t & m, const std::vector<int64_t> & rows) {
+    for (int64_t r : rows) {
+        if (r < 0 || r >= m.n_blocks * 4) continue;
+        const int b = (int) (r >> SHIFT);
+        const int sl = m.page_table[b];
+        if (sl >= 0) { m.page_table[b] = -1; m.slot_block[sl] = -1; m.slot_ref[sl] = 0; }
+    }
+}
+
+int g_fail = 0, g_calls = 0, g_overflows = 0, g_evictions = 0;
+
+#define EXPECT(cond, ...) do { if (!(cond)) { ++g_fail; printf("FAIL %s:%d: %s -- ", __FILE__, __LINE__, #cond); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+void check_map(const map_t & m, const char * ctx) {
+    int64_t resident = 0;
+    for (int64_t b = 0; b < m.n_blocks; ++b) {
+        const int s = m.page_table[b];
+        EXPECT(s != -2, "%s: block %lld left claimed", ctx, (long long) b);
+        if (s >= 0) {
+            EXPECT(s < m.n_slots && m.slot_block[s] == b, "%s: table %lld -> %d, slot says %d", ctx, (long long) b, s, s < m.n_slots ? m.slot_block[s] : -9);
+            ++resident;
+        }
+    }
+    int64_t held = 0;
+    for (int64_t s = 0; s < m.n_slots; ++s) {
+        const int b = m.slot_block[s];
+        if (b >= 0) {
+            EXPECT(b < m.n_blocks && m.page_table[b] == s, "%s: slot %lld holds %d, table says %d", ctx, (long long) s, b, m.page_table[b]);
+            ++held;
+        }
+    }
+    EXPECT(resident == held && resident <= m.n_slots, "%s: resident %lld held %lld slots %lld", ctx, (long long) resident, (long long) held, (long long) m.n_slots);
+}
+
+void fuzz(uint32_t seed, int n_calls) {
+    std::mt19937 gen(seed);
+    const int64_t n_blocks = 200 + gen() % 9000;
+    const int64_t n_slots = std::min<int64_t>(n_blocks, 3 + (gen() % 3 == 0 ? gen() % 40 : gen() % 5000));
+    map_t m;
+    m.reset(n_blocks, n_slots);
+    std::vector<std::vector<int32_t>> prev;
+    for (int call = 0; call < n_calls; ++call) {
+        ++g_calls;
+        // 1-4 lists, each of whole blocks (and now and then scattered cells), ascending
+        const int n_lists = 1 + gen() % 4;
+        std::vector<std::vector<int32_t>> lists;
+        for (int l = 0; l < n_lists; ++l) {
+            std::set<int32_t> cells;
+            const int n_blocks_sel = 1 + gen() % std::min<int64_t>(n_blocks, 600);
+            const bool scattered = gen() % 6 == 0;
+            // drift from the previous call's list
+            if (!prev.empty() && gen() % 3 != 0) {
+                for (int32_t c : prev[l % prev.size()]) {
+                    if (gen() % 100 < 85) cells.insert(c);
+                }
+            }
+            for (int i = 0; i < n_blocks_sel; ++i) {
+                const int32_t b = gen() % n_blocks;
+                if (scattered) {
+                    cells.insert(b*4 + gen() % 4);
+                } else {
+                    for (int c = 0; c < 4; ++c) cells.insert(b*4 + c);
+                }
+            }
+            lists.emplace_back(cells.begin(), cells.end());
+        }
+        // writes since the last call
+        if (gen() % 3 == 0) {
+            std::vector<int64_t> rows;
+            for (int i = 0, n = 1 + gen() % 8; i < n; ++i) rows.push_back((int64_t) (gen() % (n_blocks*4)));
+            invalidate(m, rows);
+            for (int64_t r : rows) {
+                EXPECT(m.page_table[r >> SHIFT] == -1, "invalidate left row %lld resident", (long long) r);
+            }
+            check_map(m, "after invalidate");
+        }
+        std::set<int32_t> named = { 0 };
+        for (const auto & l : lists) for (int32_t c : l) named.insert(c >> SHIFT);
+        std::map<int32_t, int32_t> hit_slot;
+        for (int32_t b : named) if (m.page_table[b] >= 0) hit_slot[b] = m.page_table[b];
+        const int64_t free_for_call = n_slots - (int64_t) hit_slot.size();
+        const call_result r = resolve(m, lists);
+        check_map(m, "after resolve");
+        const int64_t misses = (int64_t) named.size() - (int64_t) hit_slot.size();
+        // more misses than slots: pages left out are un-claimed and may be claimed again, so the count only bounds
+        EXPECT(r.total_miss >= std::min<int64_t>(misses, n_slots) && (misses > n_slots || r.total_miss == misses),
+               "total_miss %d, distinct misses %lld, slots %lld", r.total_miss, (long long) misses, (long long) n_slots);
+        EXPECT(r.placed == std::min<int64_t>(r.total_miss, std::min<int64_t>(n_slots, free_for_call)),
+               "placed %d, misses %d, slots %lld, free for the call %lld (n_slots %lld)", r.placed, r.total_miss,
+               (long long) n_slots, (long long) free_for_call, (long long) n_slots);
+        for (const auto & kv : hit_slot) {
+            EXPECT(m.page_table[kv.first] == kv.second, "hit page %d moved from slot %d to %d", kv.first, kv.second, m.page_table[kv.first]);
+        }
+        int resident_named = 0;
+        for (int32_t b : named) resident_named += m.page_table[b] >= 0;
+        if ((int64_t) named.size() <= n_slots) {
+            EXPECT(resident_named == (int) named.size(), "%d of %zu named pages resident (slots %lld)", resident_named, named.size(), (long long) n_slots);
+        } else {
+            ++g_overflows;
+            EXPECT(m.overflow == 1, "a call naming more pages than slots did not flag overflow");
+            EXPECT(resident_named == n_slots, "overflow: %d named pages resident of %lld slots", resident_named, (long long) n_slots);
+        }
+        // the copy list is exactly the pages placed
+        std::set<int32_t> copied;
+        for (int k = 0; k < r.placed; ++k) {
+            const int b = m.miss_block[k], s = m.miss_slot[k];
+            EXPECT(m.page_table[b] == s, "copy[%d]: page %d slot %d, table says %d", k, b, s, m.page_table[b]);
+            EXPECT(copied.insert(b).second, "page %d copied twice", b);
+        }
+        for (int32_t b : named) {
+            if (!hit_slot.count(b) && m.page_table[b] >= 0) {
+                EXPECT(copied.count(b), "page %d became resident without a copy", b);
+            }
+        }
+        g_evictions += r.placed;
+        prev = lists;
+    }
+}
+
+} // namespace
+
+int main() {
+    for (uint32_t seed = 1; seed <= 300; ++seed) {
+        fuzz(seed, 40);
+    }
+    // the shipped geometry: 8,192-page cache, 2,112-page window, decode steps of ~515 pages, verify windows of 4 lists
+    {
+        std::mt19937 gen(7);
+        map_t m;
+        m.reset(8192, 2112);
+        std::set<int32_t> cur;
+        while (cur.size() < 512) cur.insert(gen() % 8191);
+        for (int t = 0; t < 200; ++t) {
+            std::vector<std::vector<int32_t>> lists;
+            for (int l = 0; l < (t % 7 == 6 ? 4 : 1); ++l) {
+                std::set<int32_t> nxt;
+                for (int32_t b : cur) if (gen() % 100 < 90) nxt.insert(b);
+                while (nxt.size() < 512) nxt.insert(gen() % 8191);
+                cur = nxt;
+                std::vector<int32_t> cells;
+                for (int32_t b : cur) for (int c = 0; c < 4; ++c) cells.push_back(b*4 + c);
+                lists.push_back(cells);
+            }
+            const call_result r = resolve(m, lists);
+            check_map(m, "shipped geometry");
+            EXPECT(m.overflow == 0, "overflow at step %d", t);
+            (void) r;
+        }
+    }
+    printf("%d calls, %d overflowing, %d pages placed, %d failed\n", g_calls, g_overflows, g_evictions, g_fail);
+    printf(g_fail == 0 ? "all passed\n" : "FAIL\n");
+    return g_fail == 0 ? 0 : 1;
+}
diff --git a/tests/test-kv-page-window.cpp b/tests/test-kv-page-window.cpp
new file mode 100644
index 00000000..44e60dce
--- /dev/null
+++ b/tests/test-kv-page-window.cpp
@@ -0,0 +1,651 @@
+// Tests for the K/V page window (patch 0026; ggml/src/ggml-cuda/kv-window.cu).
+//
+// The window is a cache: with it on, the sparse flash attention must return exactly what it returns with it off.
+// Everything here runs on one CUDA device, on a K/V cache in host-mapped memory laid out as llama.cpp lays it out
+// (llama_kv_cache: [n_embd_gqa, kv_size, 1] per layer, K and V, written by ggml_set_rows, read through a permuted
+// view), at Flash-Next's attention shape (head 256, 2 KV heads, 24 query heads, top-k 2,048 + a 3-cell tail).
+//
+//   a. no window configured: no window exists, the attention is the 0014 path
+//   b. window on vs off, bit for bit, for q8_0 and q4_0, over steps that miss (cold), hit (the same selection),
+//      evict (a window smaller than the cache, drifting selections), and verify windows of 4 queries
+//   c. poison: the host copy of every resident page is overwritten with NaN scales and the same selection must
+//      still give the same output (a hit is read from VRAM); a write into a resident page must show in the next
+//      step (a stale page is never read) -- and with the writers' invalidation switched off (the mutation) that
+//      same check must FAIL, which proves it can; a host write through the buffer drops every page
+//   d. the window never exceeds its configured size: pool bytes, pages resident, the page table and the slots stay
+//      consistent after every step; a window too small for a call is declined and the call is still exact
+//
+// Run it on one device only (CUDA_VISIBLE_DEVICES): bench/a4000_dev.py. Exit code 0 = every check passed.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <numeric>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace {
+
+constexpr int     HD       = 256;     // head size
+constexpr int     N_KV_H   = 2;       // KV heads
+constexpr int     N_HEAD   = 24;      // query heads (gqa 12)
+constexpr int     N_EMBD   = HD*N_KV_H;
+constexpr int     KV       = 32768;   // cells (the sparse kernels' thresholds: 1 query past 4,096, 4 past 16,384)
+constexpr int     BLOCKS   = KV/4;
+constexpr int     TOP_BLOCKS = 512;   // indexer_top_k 2048 / 4
+constexpr int     TAIL     = 3;       // + the incomplete tail: 2,051 cells a query
+constexpr int     N_KV_MAX = TOP_BLOCKS*4 + TAIL;
+
+int g_checks = 0;
+int g_failed = 0;
+
+void check(bool ok, const char * what, const std::string & detail = "") {
+    ++g_checks;
+    if (!ok) {
+        ++g_failed;
+    }
+    printf("  [%s] %s%s%s\n", ok ? " ok " : "FAIL", what, detail.empty() ? "" : " -- ", detail.c_str());
+    fflush(stdout);
+}
+
+struct window_api {
+    void (*configure)(int64_t, int64_t)                                           = nullptr;
+    void (*set_use)(int)                                                          = nullptr;
+    void (*set_debug)(int, int)                                                   = nullptr;
+    int  (*query)(const ggml_tensor *, int64_t *, int32_t *, int32_t *)           = nullptr;
+    int  (*fill)(const ggml_tensor *, int64_t, const void *, int64_t)             = nullptr;
+    ggml_backend_buffer_type_t (*mapped)(ggml_backend_dev_t)                      = nullptr;
+};
+
+struct window_info {
+    bool    has = false;
+    int64_t n_blocks = 0, n_slots = 0, page_bytes = 0, pool_bytes = 0, resident = 0, copied = 0, lookups = 0, resolves = 0,
+            overflow = 0, epoch = 0;
+    std::vector<int32_t> page_table, slot_block;
+};
+
+window_info query(const window_api & api, const ggml_tensor * t) {
+    window_info w;
+    int64_t out[16] = {};
+    // two calls: the sizes first, then the tables
+    if (!api.query(t, out, nullptr, nullptr)) {
+        return w;
+    }
+    w.has = true;
+    w.n_blocks = out[0]; w.n_slots = out[1]; w.page_bytes = out[2]; w.pool_bytes = out[3]; w.resident = out[4];
+    w.copied = out[5]; w.lookups = out[6]; w.resolves = out[7]; w.overflow = out[8]; w.epoch = out[9];
+    w.page_table.resize(w.n_blocks);
+    w.slot_block.resize(w.n_slots);
+    api.query(t, out, w.page_table.data(), w.slot_block.data());
+    return w;
+}
+
+// the residency map must be a bijection between resident blocks and the slots that hold them
+bool consistent(const window_info & w, int64_t window_cells_limit, std::string & why) {
+    int64_t resident = 0;
+    for (int64_t b = 0; b < w.n_blocks; ++b) {
+        const int32_t s = w.page_table[b];
+        if (s == -1) {
+            continue;
+        }
+        if (s < 0 || s >= w.n_slots) {
+            why = "page_table[" + std::to_string(b) + "] = " + std::to_string(s) + " is not a slot";
+            return false;
+        }
+        if (w.slot_block[s] != b) {
+            why = "slot " + std::to_string(s) + " holds " + std::to_string(w.slot_block[s]) + ", the table says " + std::to_string(b);
+            return false;
+        }
+        ++resident;
+    }
+    int64_t held = 0;
+    for (int64_t s = 0; s < w.n_slots; ++s) {
+        const int32_t b = w.slot_block[s];
+        if (b < 0) {
+            continue;
+        }
+        if (b >= w.n_blocks || w.page_table[b] != s) {
+            why = "slot " + std::to_string(s) + " says block " + std::to_string(b) + " but the table disagrees";
+            return false;
+        }
+        ++held;
+    }
+    if (resident != held || resident != w.resident) {
+        why = "resident " + std::to_string(resident) + " held " + std::to_string(held) + " reported " + std::to_string(w.resident);
+        return false;
+    }
+    if (resident > w.n_slots || w.n_slots * 4 > window_cells_limit + 3) {
+        why = "resident " + std::to_string(resident) + " of " + std::to_string(w.n_slots) + " slots; limit " + std::to_string(window_cells_limit) + " cells";
+        return false;
+    }
+    if (w.pool_bytes != 0 && w.pool_bytes != w.n_slots*w.page_bytes) {
+        why = "pool bytes " + std::to_string(w.pool_bytes) + " != slots x page";
+        return false;
+    }
+    return true;
+}
+
+// one selection per query: TOP_BLOCKS whole blocks and TAIL cells of one more block, ascending
+using selection = std::vector<int32_t>;
+
+selection make_selection(std::mt19937 & gen, const std::vector<int32_t> & blocks_in, int tail_block) {
+    selection s;
+    std::vector<int32_t> blocks = blocks_in;
+    std::sort(blocks.begin(), blocks.end());
+    for (int32_t b : blocks) {
+        for (int c = 0; c < 4; ++c) {
+            s.push_back(b*4 + c);
+        }
+    }
+    for (int c = 0; c < TAIL; ++c) {
+        s.push_back(tail_block*4 + c);
+    }
+    std::sort(s.begin(), s.end());
+    (void) gen;
+    return s;
+}
+
+std::vector<int32_t> random_blocks(std::mt19937 & gen, int n, const std::set<int32_t> & avoid = {}) {
+    std::set<int32_t> out;
+    std::uniform_int_distribution<int32_t> d(0, BLOCKS - 2);
+    while ((int) out.size() < n) {
+        const int32_t b = d(gen);
+        if (!avoid.count(b)) {
+            out.insert(b);
+        }
+    }
+    return std::vector<int32_t>(out.begin(), out.end());
+}
+
+// keep `keep` of the blocks, replace the rest
+std::vector<int32_t> drift(std::mt19937 & gen, const std::vector<int32_t> & prev, double keep) {
+    std::vector<int32_t> p = prev;
+    std::shuffle(p.begin(), p.end(), gen);
+    const int n_keep = (int) std::lround(keep*p.size());
+    std::set<int32_t> kept(p.begin(), p.begin() + n_keep);
+    std::set<int32_t> all = kept;
+    std::uniform_int_distribution<int32_t> d(0, BLOCKS - 2);
+    while ((int) all.size() < TOP_BLOCKS) {
+        all.insert(d(gen));
+    }
+    return std::vector<int32_t>(all.begin(), all.end());
+}
+
+struct fixture {
+    ggml_backend_dev_t dev = nullptr;
+    ggml_backend_t     backend = nullptr;
+    window_api         api;
+    ggml_type          type = GGML_TYPE_Q8_0;
+
+    ggml_context *        cache_ctx = nullptr;
+    ggml_backend_buffer_t cache_buf = nullptr;
+    ggml_tensor *         K = nullptr;
+    ggml_tensor *         V = nullptr;
+    std::vector<uint8_t>  mirror_K, mirror_V;   // the host's view of the cache bytes (refreshed from the device)
+    ggml_gallocr_t        galloc = nullptr;
+
+    int64_t row_bytes() const { return (int64_t) ggml_row_size(type, N_EMBD); }
+
+    bool setup(ggml_type t, int64_t window_cells, int64_t floor_cells, bool poison) {
+        type = t;
+        api.configure(window_cells, floor_cells);
+        api.set_debug(poison ? 1 : 0, 0);
+        api.set_use(1);
+        ggml_init_params ip = { ggml_tensor_overhead()*8 + 1024, nullptr, true };
+        cache_ctx = ggml_init(ip);
+        K = ggml_new_tensor_3d(cache_ctx, type, N_EMBD, KV, 1);
+        V = ggml_new_tensor_3d(cache_ctx, type, N_EMBD, KV, 1);
+        ggml_set_name(K, "cache_k_l0");
+        ggml_set_name(V, "cache_v_l0");
+        cache_buf = ggml_backend_alloc_ctx_tensors_from_buft(cache_ctx, api.mapped(dev));
+        if (!cache_buf) {
+            return false;
+        }
+        galloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+        mirror_K.resize(ggml_nbytes(K));
+        mirror_V.resize(ggml_nbytes(V));
+        return true;
+    }
+
+    void teardown() {
+        if (galloc) ggml_gallocr_free(galloc);
+        if (cache_buf) ggml_backend_buffer_free(cache_buf);
+        if (cache_ctx) ggml_free(cache_ctx);
+        galloc = nullptr; cache_buf = nullptr; cache_ctx = nullptr;
+    }
+
+    // random quantized cells, through the buffer (a host write: it drops every page)
+    void fill_random(uint32_t seed) {
+        std::mt19937 gen(seed);
+        std::normal_distribution<float> d(0.0f, 1.0f);
+        std::vector<float> f((size_t) KV*N_EMBD);
+        for (ggml_tensor * t : { K, V }) {
+            for (auto & x : f) {
+                x = d(gen);
+            }
+            // cells differ in scale, so a wrong page is not hidden by similar values
+            for (int c = 0; c < KV; ++c) {
+                const float s = 0.25f + (float) ((c*7919u + seed) % 64u)/16.0f;
+                for (int j = 0; j < N_EMBD; ++j) {
+                    f[(size_t) c*N_EMBD + j] *= s;
+                }
+            }
+            std::vector<uint8_t> q(ggml_nbytes(t));
+            ggml_quantize_chunk(type, f.data(), q.data(), 0, KV, N_EMBD, nullptr);
+            ggml_backend_tensor_set(t, q.data(), 0, q.size());
+        }
+        refresh_mirrors();
+    }
+
+    void refresh_mirrors() {
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(K, mirror_K.data(), 0, mirror_K.size());
+        ggml_backend_tensor_get(V, mirror_V.data(), 0, mirror_V.size());
+    }
+
+    // ggml_set_rows into K and V, as llama_kv_cache::cpy_k / cpy_v do (one stream: the tensor itself)
+    void write_cells(const std::vector<int64_t> & cells, uint32_t seed) {
+        ggml_init_params ip = { ggml_tensor_overhead()*16 + ggml_graph_overhead() + 4096, nullptr, true };
+        ggml_context * ctx = ggml_init(ip);
+        const int n = (int) cells.size();
+        ggml_tensor * kcur = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, N_EMBD, n);
+        ggml_tensor * vcur = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, N_EMBD, n);
+        ggml_tensor * idx  = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, n);
+        ggml_tensor * wk = ggml_set_rows(ctx, K, kcur, idx);
+        ggml_tensor * wv = ggml_set_rows(ctx, V, vcur, idx);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, wk);
+        ggml_build_forward_expand(gf, wv);
+        ggml_gallocr_alloc_graph(galloc, gf);
+        std::mt19937 gen(seed);
+        std::normal_distribution<float> d(0.0f, 3.0f);
+        std::vector<float> fk((size_t) n*N_EMBD), fv((size_t) n*N_EMBD);
+        for (auto & x : fk) x = d(gen);
+        for (auto & x : fv) x = d(gen);
+        ggml_backend_tensor_set(kcur, fk.data(), 0, fk.size()*sizeof(float));
+        ggml_backend_tensor_set(vcur, fv.data(), 0, fv.size()*sizeof(float));
+        ggml_backend_tensor_set(idx, cells.data(), 0, cells.size()*sizeof(int64_t));
+        ggml_backend_graph_compute(backend, gf);
+        ggml_backend_synchronize(backend);
+        ggml_free(ctx);
+        refresh_mirrors();
+    }
+
+    // one decode (nq = 1) or verify (nq = 4) attention over the cache, for the selections given; the output as floats
+    std::vector<float> attend(const std::vector<float> & q_data, const std::vector<selection> & sel) {
+        const int nq = (int) sel.size();
+        ggml_init_params ip = { ggml_tensor_overhead()*16 + ggml_graph_overhead() + 4096, nullptr, true };
+        ggml_context * ctx = ggml_init(ip);
+
+        ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, HD, nq, N_HEAD, 1);
+        const int64_t rb = (int64_t) ggml_row_size(type, N_EMBD);
+        // llama_kv_cache::get_k: [head, kv head, cell, stream] over the cache tensor, then permuted by build_attn_mha
+        ggml_tensor * kv4 = ggml_view_4d(ctx, K, HD, N_KV_H, KV, 1, ggml_row_size(type, HD), (size_t) rb, (size_t) rb*KV, 0);
+        ggml_tensor * vv4 = ggml_view_4d(ctx, V, HD, N_KV_H, KV, 1, ggml_row_size(type, HD), (size_t) rb, (size_t) rb*KV, 0);
+        ggml_tensor * k = ggml_permute(ctx, kv4, 0, 2, 1, 3);
+        ggml_tensor * v = ggml_permute(ctx, vv4, 0, 2, 1, 3);
+        ggml_tensor * m = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, KV, nq, 1, 1);
+        ggml_tensor * out = ggml_flash_attn_ext(ctx, q, k, v, m, 1.0f/sqrtf((float) HD), 0.0f, 0.0f);
+        ggml_flash_attn_ext_set_n_kv_max(out, N_KV_MAX);
+        ggml_prec_set_acc(out, GGML_PREC_F32);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, out);
+        ggml_gallocr_alloc_graph(galloc, gf);
+
+        ggml_backend_tensor_set(q, q_data.data(), 0, q_data.size()*sizeof(float));
+        std::vector<float> mf((size_t) KV*nq, -INFINITY);
+        for (int i = 0; i < nq; ++i) {
+            for (int32_t c : sel[i]) {
+                mf[(size_t) i*KV + c] = 0.0f;
+            }
+        }
+        std::vector<ggml_fp16_t> mh(mf.size());
+        ggml_fp32_to_fp16_row(mf.data(), mh.data(), mh.size());
+        ggml_backend_tensor_set(m, mh.data(), 0, mh.size()*sizeof(ggml_fp16_t));
+
+        ggml_backend_graph_compute(backend, gf);
+        ggml_backend_synchronize(backend);
+        std::vector<float> res((size_t) ggml_nelements(out));
+        ggml_backend_tensor_get(out, res.data(), 0, res.size()*sizeof(float));
+        ggml_free(ctx);
+        return res;
+    }
+
+    std::vector<float> random_q(int nq, uint32_t seed) const {
+        std::mt19937 gen(seed);
+        std::normal_distribution<float> d(0.0f, 1.0f);
+        std::vector<float> q((size_t) HD*nq*N_HEAD);
+        for (auto & x : q) x = d(gen);
+        return q;
+    }
+
+    // the plain run: the window off, the same tensors
+    std::vector<float> attend_plain(const std::vector<float> & q, const std::vector<selection> & sel) {
+        api.set_use(0);
+        auto r = attend(q, sel);
+        api.set_use(1);
+        return r;
+    }
+
+    // overwrite (or poison, with data == nullptr) the host copy of whole pages, behind the window's back
+    void host_pages(const std::vector<int32_t> & blocks, bool poison) {
+        const int64_t pb = row_bytes()*4;
+        for (int32_t b : blocks) {
+            api.fill(K, b*pb, poison ? nullptr : mirror_K.data() + b*pb, pb);
+            api.fill(V, b*pb, poison ? nullptr : mirror_V.data() + b*pb, pb);
+        }
+    }
+};
+
+std::vector<int32_t> pages_of(const std::vector<selection> & sel) {
+    std::set<int32_t> p;
+    for (const auto & s : sel) {
+        for (int32_t c : s) {
+            p.insert(c/4);
+        }
+    }
+    p.insert(0);
+    return std::vector<int32_t>(p.begin(), p.end());
+}
+
+bool nan_free(const std::vector<float> & v) {
+    for (float x : v) {
+        if (!std::isfinite(x)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+double max_abs_diff(const std::vector<float> & a, const std::vector<float> & b) {
+    double m = 0.0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        const double d = std::fabs((double) a[i] - (double) b[i]);
+        if (!(d <= m)) {   // NaN counts
+            m = std::isnan(d) ? INFINITY : d;
+        }
+    }
+    return m;
+}
+
+bool bitwise(const std::vector<float> & a, const std::vector<float> & b) {
+    return a.size() == b.size() && memcmp(a.data(), b.data(), a.size()*sizeof(float)) == 0;
+}
+
+// the whole scenario for one cache type
+void scenario(ggml_backend_dev_t dev, ggml_backend_t backend, const window_api & api, ggml_type type) {
+    const char * tn = ggml_type_name(type);
+    printf("\n== %s ==\n", tn);
+
+    // ---- the large window: holds the 4-query verify window's pages; the cache holds 8,192 pages, the window 2,112
+    const int64_t WINDOW_CELLS = 2112*4;
+    fixture fx;
+    fx.dev = dev; fx.backend = backend; fx.api = api;
+    if (!fx.setup(type, WINDOW_CELLS, WINDOW_CELLS, /*poison*/ true)) {
+        check(false, "the cache allocates in host-mapped memory");
+        return;
+    }
+    fx.fill_random(1234);
+    std::string why;
+    window_info w0 = query(api, fx.K);
+    check(w0.has && query(api, fx.V).has, "K and V each have a window (created when the cache was allocated)");
+    check(w0.has && w0.n_slots == 2112 && w0.pool_bytes == 0, "the window is 2,112 pages and its pool is not allocated until used",
+          "slots " + std::to_string(w0.n_slots) + " pool " + std::to_string(w0.pool_bytes));
+
+    std::mt19937 gen(99);
+    const std::vector<float> q1 = fx.random_q(1, 7);
+
+    // ---- b: cold, then hot; the plain run twice first (is the kernel deterministic?)
+    std::vector<int32_t> blocks0 = random_blocks(gen, TOP_BLOCKS);
+    std::vector<selection> s0 = { make_selection(gen, blocks0, 7000) };
+    auto ref_a = fx.attend_plain(q1, s0);
+    auto ref_b = fx.attend_plain(q1, s0);
+    const bool deterministic = bitwise(ref_a, ref_b);
+    check(nan_free(ref_a), "the plain sparse attention output is finite");
+    printf("      (the plain run %s)\n", deterministic ? "is bit-reproducible" : "is NOT bit-reproducible: the window must match within the plain run's own noise");
+    const double noise = max_abs_diff(ref_a, ref_b);
+    auto same = [&](const std::vector<float> & ref, const std::vector<float> & got, double * diff) {
+        *diff = max_abs_diff(ref, got);
+        return nan_free(got) && (deterministic ? bitwise(ref, got) : *diff <= noise);
+    };
+    double diff = 0;
+
+    auto cold = fx.attend(q1, s0);
+    window_info w1 = query(api, fx.K);
+    check(w1.resolves >= 1, "the sparse path took the window (K resolved)", "resolves " + std::to_string(w1.resolves));
+    check(same(ref_a, cold, &diff), (std::string(tn) + ": a cold step (every page missing) equals the plain run").c_str(), "max |diff| " + std::to_string(diff));
+    check(w1.pool_bytes == w1.n_slots*w1.page_bytes && w1.resident == (int64_t) pages_of(s0).size(),
+          "the pool is allocated and exactly the selected pages (+ page 0) are resident",
+          "resident " + std::to_string(w1.resident) + " pages " + std::to_string(pages_of(s0).size()));
+    check(consistent(w1, WINDOW_CELLS, why), "the residency map is consistent after a cold step", why);
+
+    const int64_t copied_before = w1.copied;
+    auto hot = fx.attend(q1, s0);
+    window_info w2 = query(api, fx.K);
+    check(same(ref_a, hot, &diff), "a hot step (the same selection: every page a hit) equals the plain run", "max |diff| " + std::to_string(diff));
+    check(w2.copied == copied_before, "a hot step copies no page over PCIe", "copied " + std::to_string(w2.copied - copied_before));
+
+    // ---- c1: the host copy of the resident pages is poisoned; a hit must not read it
+    fx.host_pages(pages_of(s0), /*poison*/ true);
+    auto poisoned = fx.attend(q1, s0);
+    check(same(ref_a, poisoned, &diff), "with the host copy of every resident page poisoned, a hot step still equals the plain run",
+          "max |diff| " + std::to_string(diff));
+    auto plain_poisoned = fx.attend_plain(q1, s0);
+    check(!nan_free(plain_poisoned), "(the poison is real: the plain run over the poisoned host pages is not finite)");
+    fx.host_pages(pages_of(s0), /*poison*/ false);   // restored behind the window's back
+    check(bitwise(fx.attend_plain(q1, s0), ref_a) || !deterministic, "the host copy is restored");
+
+    // ---- c2: a write into resident pages shows in the next step
+    {
+        std::vector<int64_t> cells;
+        for (int i = 0; i < 6; ++i) {
+            cells.push_back(s0[0][i*300] );                     // cells inside resident pages
+        }
+        cells.push_back(7000*4 + 1);                            // a cell of the tail block (7000)
+        fx.write_cells(cells, 55);
+        auto ref_w = fx.attend_plain(q1, s0);
+        check(max_abs_diff(ref_a, ref_w) > 0.0, "(the write changes the attention output: the check can tell)");
+        auto win_w = fx.attend(q1, s0);
+        check(same(ref_w, win_w, &diff), "a write into resident pages: the next windowed step equals the plain run (no stale page)",
+              "max |diff| " + std::to_string(diff));
+        window_info w3 = query(api, fx.K);
+        check(consistent(w3, WINDOW_CELLS, why), "the residency map is consistent after the write", why);
+        ref_a = ref_w;
+    }
+
+    // ---- c2 mutation: writers stop dropping pages; the same check must now FAIL
+    {
+        api.set_debug(1, /*no_invalidate*/ 1);
+        std::vector<int64_t> cells = { (int64_t) s0[0][100], (int64_t) s0[0][900], (int64_t) s0[0][1500], 7000*4 + 2 };
+        fx.write_cells(cells, 77);
+        auto ref_w = fx.attend_plain(q1, s0);
+        auto win_w = fx.attend(q1, s0);
+        check(max_abs_diff(ref_w, win_w) > 0.0,
+              "MUTATION (writers do not invalidate): the windowed step no longer equals the plain run -- the stale-page check can fail",
+              "max |diff| " + std::to_string(max_abs_diff(ref_w, win_w)));
+        api.set_debug(1, 0);
+        // a host write through the buffer drops every page, stale ones included
+        fx.refresh_mirrors();
+        ggml_backend_tensor_set(fx.K, fx.mirror_K.data(), 0, fx.mirror_K.size());
+        ggml_backend_tensor_set(fx.V, fx.mirror_V.data(), 0, fx.mirror_V.size());
+        window_info wf = query(api, fx.K);
+        check(wf.resident == 0, "a host write through the buffer (set_tensor) drops every page", "resident " + std::to_string(wf.resident));
+        auto win_ok = fx.attend(q1, s0);
+        check(same(ref_w, win_ok, &diff), "after the flush the windowed step equals the plain run again", "max |diff| " + std::to_string(diff));
+        ref_a = ref_w;
+    }
+
+    // ---- b: 4-query verify windows (one list per query, or one list for the group)
+    {
+        std::vector<int32_t> b = random_blocks(gen, TOP_BLOCKS);
+        std::vector<selection> sel;
+        for (int i = 0; i < 4; ++i) {
+            b = drift(gen, b, 0.9);
+            sel.push_back(make_selection(gen, b, 7100 + i));
+        }
+        const std::vector<float> q4 = fx.random_q(4, 11);
+        auto ref4 = fx.attend_plain(q4, sel);
+        const int64_t r_before = query(api, fx.K).resolves;
+        auto win4 = fx.attend(q4, sel);
+        const window_info w4 = query(api, fx.K);
+        check(same(ref4, win4, &diff), "a 4-query verify window equals the plain run", "max |diff| " + std::to_string(diff));
+        check(w4.resolves > r_before, "(the verify window took the window too)", "resolves " + std::to_string(w4.resolves));
+        check(consistent(w4, WINDOW_CELLS, why), "the residency map is consistent after the verify window", why);
+    }
+
+    fx.teardown();
+
+    // ---- b/d: a window smaller than the cache, drifting selections: misses and evictions every step
+    {
+        const int64_t SMALL = 640*4;   // 640 pages; a decode step names ~515
+        fixture sm;
+        sm.dev = dev; sm.backend = backend; sm.api = api;
+        if (!sm.setup(type, SMALL, SMALL, true)) {
+            check(false, "the small cache allocates");
+            return;
+        }
+        sm.fill_random(4321);
+        std::vector<int32_t> b = random_blocks(gen, TOP_BLOCKS);
+        int64_t evicted_total = 0;
+        bool all_equal = true, all_consistent = true, all_resident = true;
+        double worst = 0;
+        std::string first_why;
+        const int steps = 40;
+        for (int t = 0; t < steps; ++t) {
+            b = drift(gen, b, t % 5 == 4 ? 0.0 : 0.85);   // every fifth step is a jump to new pages
+            std::vector<selection> sel = { make_selection(gen, b, 7200 + t % 50) };
+            const std::vector<float> q = sm.random_q(1, 100 + t);
+            auto ref = sm.attend_plain(q, sel);
+            const window_info before = query(api, sm.K);
+            auto win = sm.attend(q, sel);
+            const window_info after = query(api, sm.K);
+            double d = 0;
+            const bool eq = nan_free(win) && (bitwise(ref, win) || (!deterministic && (d = max_abs_diff(ref, win)) <= noise));
+            if (!eq) {
+                d = max_abs_diff(ref, win);
+                worst = std::max(worst, d);
+            }
+            all_equal = all_equal && eq;
+            std::string w2;
+            if (!consistent(after, SMALL, w2)) {
+                all_consistent = false;
+                if (first_why.empty()) first_why = "step " + std::to_string(t) + ": " + w2;
+            }
+            // every page the step named is resident afterwards (the call fits, so nothing overflows)
+            for (int32_t p : pages_of(sel)) {
+                if (after.page_table[p] < 0) {
+                    all_resident = false;
+                }
+            }
+            if (before.has) {
+                evicted_total += std::max<int64_t>(0, (after.copied - before.copied) - (after.n_slots - before.resident));
+            }
+        }
+        const window_info wl = query(api, sm.K);
+        check(all_equal, (std::string(tn) + ": 40 steps of drifting selections through a window of 640 pages (misses, hits, evictions) all equal the plain run").c_str(),
+              "worst |diff| " + std::to_string(worst));
+        check(all_consistent, "the residency map stays consistent and within the window after every step", first_why);
+        check(all_resident, "every page a step names is resident after it (no overflow)");
+        check(wl.copied > wl.n_slots, "pages were evicted and re-copied (copied more pages than the window holds)",
+              "copied " + std::to_string(wl.copied) + " slots " + std::to_string(wl.n_slots));
+        check(wl.overflow == 0, "no call overflowed the window");
+        check(wl.pool_bytes == 640*sm.row_bytes()*4, "d: the pool is exactly the configured window",
+              "pool bytes " + std::to_string(wl.pool_bytes) + " window " + std::to_string(640*sm.row_bytes()*4));
+        (void) evicted_total;
+        sm.teardown();
+    }
+
+    // ---- d: a window too small for one call is declined, and the call is still exact
+    {
+        const int64_t TINY = 256*4;
+        fixture tn_fx;
+        tn_fx.dev = dev; tn_fx.backend = backend; tn_fx.api = api;
+        if (!tn_fx.setup(type, TINY, TINY, true)) {
+            check(false, "the tiny cache allocates");
+            return;
+        }
+        tn_fx.fill_random(555);
+        std::vector<selection> sel = { make_selection(gen, random_blocks(gen, TOP_BLOCKS), 7300) };
+        const std::vector<float> q = tn_fx.random_q(1, 3);
+        auto ref = tn_fx.attend_plain(q, sel);
+        auto got = tn_fx.attend(q, sel);
+        const window_info wt = query(api, tn_fx.K);
+        check(wt.has && wt.resolves == 0 && wt.pool_bytes == 0, "d: a window smaller than one call needs (256 pages for ~515) is declined: nothing resolved, no pool allocated",
+              "resolves " + std::to_string(wt.resolves) + " pool " + std::to_string(wt.pool_bytes));
+        double d2 = 0;
+        check(nan_free(got) && (bitwise(ref, got) || (!deterministic && (d2 = max_abs_diff(ref, got)) <= noise)), "and the call equals the plain run");
+        tn_fx.teardown();
+    }
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    (void) argc; (void) argv;
+    // CUDA graphs would replay a capture of the plain run for the windowed one (same shapes, same addresses)
+    // GGML_CUDA_DISABLE_GRAPHS and the sparse-conversion poison are read once, at first use: set them before any CUDA work
+#ifdef _WIN32
+    _putenv_s("GGML_CUDA_DISABLE_GRAPHS", "1");
+    _putenv_s("GGML_CUDA_FA_SPARSE_ROWS_POISON", "1");
+#else
+    setenv("GGML_CUDA_DISABLE_GRAPHS", "1", 1);
+    setenv("GGML_CUDA_FA_SPARSE_ROWS_POISON", "1", 1);
+#endif
+    ggml_backend_load_all();
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (!dev) {
+        printf("no GPU device\n");
+        return 2;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    window_api api;
+    api.configure = (void (*)(int64_t, int64_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_page_window_configure");
+    api.set_use   = (void (*)(int)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_page_window_set_use");
+    api.set_debug = (void (*)(int, int)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_page_window_set_debug");
+    api.query     = (int (*)(const ggml_tensor *, int64_t *, int32_t *, int32_t *)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_page_window_query");
+    api.fill      = (int (*)(const ggml_tensor *, int64_t, const void *, int64_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_page_window_test_fill");
+    api.mapped    = (ggml_backend_buffer_type_t (*)(ggml_backend_dev_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_host_mapped_buffer_type");
+    if (!api.configure || !api.set_use || !api.set_debug || !api.query || !api.fill || !api.mapped) {
+        printf("the CUDA backend has no K/V page window (patch 0026) or no host-mapped buffer type (0012)\n");
+        return 2;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    printf("device: %s\n", ggml_backend_dev_description(dev));
+
+    // ---- a: no window configured
+    {
+        printf("\n== no window configured ==\n");
+        fixture fx;
+        fx.dev = dev; fx.backend = backend; fx.api = api;
+        if (fx.setup(GGML_TYPE_Q8_0, 0, 20480, false)) {
+            fx.fill_random(5);
+            std::mt19937 gen(5);
+            std::vector<selection> sel = { make_selection(gen, random_blocks(gen, TOP_BLOCKS), 7000) };
+            const std::vector<float> q = fx.random_q(1, 1);
+            auto plain = fx.attend_plain(q, sel);
+            auto with_switch_on = fx.attend(q, sel);
+            check(!query(api, fx.K).has && !query(api, fx.V).has, "a: LLAMA_KV_PAGE_WINDOW unset: the cache tensors have no window");
+            check(nan_free(plain) && bitwise(plain, with_switch_on), "a: the sparse attention is the same run (the 0014 path)");
+            fx.teardown();
+        } else {
+            check(false, "the cache allocates");
+        }
+    }
+
+    scenario(dev, backend, api, GGML_TYPE_Q8_0);
+    scenario(dev, backend, api, GGML_TYPE_Q4_0);
+
+    ggml_backend_free(backend);
+    printf("\n%d checks, %d failed\n", g_checks, g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
