diff --git a/src/llama-moecache-refill.cpp b/src/llama-moecache-refill.cpp
new file mode 100644
index 000000000..8aaa9a452
--- /dev/null
+++ b/src/llama-moecache-refill.cpp
@@ -0,0 +1,105 @@
+#include "llama-moecache-refill.h"
+
+#include <algorithm>
+
+namespace moe_refill {
+
+event_query_fn event_query_of(ggml_backend_dev_t dev) {
+    if (!dev) {
+        return nullptr;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    return reg ? (event_query_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_event_query") : nullptr;
+}
+
+backend_engine::backend_engine(ggml_backend_dev_t dev, size_t max_batches) {
+    query = event_query_of(dev);
+    if (!dev || !query) {
+        return;
+    }
+    backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) {
+        return;
+    }
+    for (size_t i = 0; i < max_batches; ++i) {
+        ggml_backend_event_t ev = ggml_backend_event_new(dev);
+        if (!ev) {
+            break;
+        }
+        events.push_back(ev);
+        free_events.push_back(i);
+    }
+}
+
+backend_engine::~backend_engine() {
+    if (backend) {
+        ggml_backend_synchronize(backend);
+    }
+    for (ggml_backend_event_t ev : events) {
+        ggml_backend_event_free(ev);
+    }
+    if (backend) {
+        ggml_backend_free(backend);
+    }
+}
+
+void backend_engine::copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) {
+    ggml_backend_tensor_set_async(backend, dst, src, dst_offset, size);
+    enqueued = true;
+}
+
+int64_t backend_engine::submit() {
+    if (!enqueued) {
+        return 0;
+    }
+    enqueued = false;
+    if (free_events.empty()) {
+        // the caller checks can_submit() first; if it did not, wait for the oldest batch rather than lose one
+        wait(outstanding.front().ticket);
+    }
+    const size_t ev = free_events.back();
+    free_events.pop_back();
+    ggml_backend_event_record(events[ev], backend);
+    slot s;
+    s.ticket = next_ticket++;
+    s.event  = ev;
+    outstanding.push_back(s);
+    return s.ticket;
+}
+
+bool backend_engine::done(int64_t ticket) {
+    if (ticket <= completed_through) {
+        return true;
+    }
+    for (const slot & s : outstanding) {
+        if (s.ticket != ticket) {
+            continue;
+        }
+        if (!query(events[s.event])) {
+            return false;
+        }
+        // one stream: everything submitted before this batch has landed too, and their events are free again
+        completed_through = std::max(completed_through, ticket);
+        while (!outstanding.empty() && outstanding.front().ticket <= completed_through) {
+            free_events.push_back(outstanding.front().event);
+            outstanding.pop_front();
+        }
+        return true;
+    }
+    return true;   // already reaped
+}
+
+void backend_engine::wait(int64_t ticket) {
+    if (ticket <= completed_through) {
+        return;
+    }
+    for (const slot & s : outstanding) {
+        if (s.ticket == ticket) {
+            ggml_backend_event_synchronize(events[s.event]);
+            break;
+        }
+    }
+    done(ticket);
+}
+
+} // namespace moe_refill
diff --git a/src/llama-moecache-refill.h b/src/llama-moecache-refill.h
new file mode 100644
index 000000000..65114331d
--- /dev/null
+++ b/src/llama-moecache-refill.h
@@ -0,0 +1,232 @@
+#pragma once
+
+// Yamadori 0025: queued refills for the MoE expert cache (llama-moecache.h). The cache's refills (the adaptive tier's
+// swaps and the LRU's inserts) are copies of whole experts from the pinned host weights into device slots. Here they
+// are enqueued on a second CUDA stream, and a slot's table entry is published only after the event that follows its copy
+// has completed -- a refill never blocks the decode, and a slot is never read before its data is there.
+//
+// Ported from Strata (github.com/Niko1221/Strata). Copyright (c) 2026 Niko1221 and the Strata contributors; MIT
+// License (the full notice: engines/patches/llama-upstream-flash/LICENSE.strata; the file is in Strata at c0107c3, the
+// code below was read at d551edf):
+//  - src/program/generate.cpp @ d551edf :3302-3370 (`adapt` / `apply_pending`): a swap marks its victim uncached FIRST
+//    (the CPU computes it meanwhile), copies the newcomer on the adapt stream, and publishes the new residency only
+//    once the copy's event has completed;
+//  - src/core/expert_cache.cpp @ d551edf :268 and :285 (`fill_slot_queued`, `sync_queued`): the copies are queued, the
+//    caller synchronises on them once.
+// NOT ported: Strata's issuer thread and its pageable-blob stager (src/prefill/prefill.cpp @ d551edf :122-239,
+// :945-1003). Those hide the cost of copying UNPINNED blobs; the experts here are pinned (0005), so cudaMemcpyAsync
+// returns at once and there is nothing for a thread to hide. With pageable experts the queued path is not used.
+//
+// What the cache did before (0003/0004): a worker thread copied each slice with ggml_backend_tensor_set (a copy and a
+// stream synchronise per matrix) and the decode thread wrote the table entries one at a time, each a synchronous
+// device copy (up to 2 x 96 of them per adaptive step). The copies were already off the decode thread; the table writes
+// were not. Here the copies need no thread, and the table of a layer is written once per step, whole.
+//
+// Off unless LLAMA_MOE_CACHE_QUEUED_REFILL=1. LLAMA_MOE_REFILL_POISON=1 (tests only, either path) fills a slot with
+// 0xFF bytes (NaN in every float and quantized scale) before its copy is enqueued, so a read of a slot that was
+// published too early shows up as NaN in the output.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace moe_refill {
+
+struct job {
+    size_t  layer  = 0;
+    int32_t expert = -1;
+    int32_t slot   = -1;
+};
+
+// ---- the copy engine ----------------------------------------------------------------------------------------------
+
+// Enqueues copies, closes them into numbered batches, and says without blocking whether a batch has landed.
+struct engine {
+    virtual ~engine() = default;
+    // dst[dst_offset, dst_offset + size) <- src; may return before the data lands
+    virtual void copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) = 0;
+    // closes the copies enqueued since the last submit into a batch; its ticket (> 0), or 0 when nothing was enqueued
+    virtual int64_t submit() = 0;
+    // has every copy of the batch landed (never blocks)
+    virtual bool done(int64_t ticket) = 0;
+    // blocks until the batch has landed
+    virtual void wait(int64_t ticket) = 0;
+    // can another batch be submitted now
+    virtual bool can_submit() const = 0;
+};
+
+// The device's non-blocking event query, or null: ggml has none in its public API, so a backend offers it through its
+// registry's get_proc_address as "ggml_backend_event_query" (ggml-cuda does, 0025), true when the event has completed.
+typedef bool (*event_query_fn)(ggml_backend_event_t);
+event_query_fn event_query_of(ggml_backend_dev_t dev);
+
+// A second backend instance on the device (its own CUDA stream) and a pool of events. Needs a device whose events can
+// be queried without blocking (event_query_of); ok() says so.
+class backend_engine : public engine {
+public:
+    explicit backend_engine(ggml_backend_dev_t dev, size_t max_batches = 32);
+    ~backend_engine() override;
+    bool ok() const { return backend != nullptr && !events.empty(); }
+
+    void    copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) override;
+    int64_t submit() override;
+    bool    done(int64_t ticket) override;
+    void    wait(int64_t ticket) override;
+    bool    can_submit() const override { return !free_events.empty(); }
+
+    ggml_backend_t backend = nullptr;   // owned
+    event_query_fn query = nullptr;
+
+private:
+    struct slot { int64_t ticket = 0; size_t event = 0; };
+    std::vector<ggml_backend_event_t> events;
+    std::vector<size_t>               free_events;
+    std::deque<slot>                  outstanding;   // submitted batches not yet seen complete, oldest first
+    bool                              enqueued = false;
+    int64_t                           next_ticket = 1;
+    int64_t                           completed_through = 0;   // every ticket <= this has landed (one stream: in order)
+};
+
+// ---- the queue ----------------------------------------------------------------------------------------------------
+
+class queue {
+public:
+    explicit queue(engine * eng) : eng(eng) {}
+
+    bool can_push() const { return eng->can_submit(); }
+
+    // Enqueues every job's copies (copy_job does the engine calls) as one batch. The jobs are returned by poll() once the
+    // batch has landed, and not before. `step` is a caller's counter, for the latency statistics.
+    void push(const std::vector<job> & jobs, const std::function<void(const job &, engine &)> & copy_job, uint64_t step) {
+        if (jobs.empty()) {
+            return;
+        }
+        for (const job & j : jobs) {
+            copy_job(j, *eng);
+        }
+        batch b;
+        b.ticket = eng->submit();
+        b.jobs   = jobs;
+        b.step   = step;
+        n_jobs_in_flight += jobs.size();
+        n_batches++;
+        n_jobs_total += jobs.size();
+        inflight.push_back(std::move(b));
+    }
+
+    // The jobs of every batch that has landed, oldest first. Never blocks; a batch that has not landed stays.
+    std::vector<job> poll(uint64_t step) {
+        std::vector<job> out;
+        while (!inflight.empty()) {
+            batch & b = inflight.front();
+            if (b.ticket != 0 && !eng->done(b.ticket)) {
+                break;
+            }
+            out.insert(out.end(), b.jobs.begin(), b.jobs.end());
+            n_jobs_in_flight -= b.jobs.size();
+            lat_sum += step - b.step;
+            lat_max = std::max<uint64_t>(lat_max, step - b.step);
+            lat_n++;
+            inflight.pop_front();
+        }
+        return out;
+    }
+
+    // Blocks until everything has landed (tests, shutdown).
+    std::vector<job> drain(uint64_t step) {
+        for (batch & b : inflight) {
+            if (b.ticket != 0) {
+                eng->wait(b.ticket);
+            }
+        }
+        return poll(step);
+    }
+
+    // is this expert already being copied (a batch not yet published has it): a second copy of it must not be started
+    bool contains(size_t layer, int32_t expert) const {
+        for (const batch & b : inflight) {
+            for (const job & j : b.jobs) {
+                if (j.layer == layer && j.expert == expert) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    size_t jobs_in_flight() const { return n_jobs_in_flight; }
+    size_t batches_in_flight() const { return inflight.size(); }
+
+    // statistics
+    uint64_t n_batches = 0, n_jobs_total = 0;
+    uint64_t lat_sum = 0, lat_max = 0, lat_n = 0;   // steps from push to poll
+
+private:
+    struct batch { int64_t ticket = 0; std::vector<job> jobs; uint64_t step = 0; };
+    engine *           eng;
+    std::deque<batch>  inflight;
+    size_t             n_jobs_in_flight = 0;
+};
+
+// ---- what the cache does with a layer (templates: llama-moecache.cpp's layer_state and the test's have the same names)
+
+// A layer's bookkeeping, by member name:
+//   .pub.{up_src, gate_src, down_src, up_c, gate_c, down_c, dev_table, host_table, n_slots}
+//   .expert_slot (expert -> slot or -1), .table_dirty (bool)
+
+// the copies of one refill: the three matrices of an expert into a slot
+template <class L>
+void enqueue_job(const L & ls, const job & j, engine & eng, bool poison) {
+    const struct { ggml_tensor * dst; const ggml_tensor * src; } m[3] = {
+        { ls.pub.up_c,   ls.pub.up_src   },
+        { ls.pub.gate_c, ls.pub.gate_src },
+        { ls.pub.down_c, ls.pub.down_src },
+    };
+    for (const auto & p : m) {
+        const size_t sz = p.src->nb[2];
+        if ((size_t) j.slot * p.dst->nb[2] + sz > ggml_nbytes(p.dst) || (size_t) j.expert * sz + sz > ggml_nbytes(p.src)) {
+            fprintf(stderr, "moe-cache: bad refill %s <- %s expert=%d slot=%d sz=%zu\n", p.dst->name, p.src->name, j.expert, j.slot, sz);
+            continue;
+        }
+        if (poison) {
+            ggml_backend_tensor_memset(p.dst, 0xFF, (size_t) j.slot * p.dst->nb[2], sz);
+        }
+        eng.copy(p.dst, (const char *) p.src->data + (size_t) j.expert * sz, (size_t) j.slot * p.dst->nb[2], sz);
+    }
+}
+
+// the copy has landed: the expert is resident in the slot (the host mirror; the tables follow at the next flush)
+template <class L>
+void publish(L & ls, const job & j, uint64_t clock_value) {
+    ls.slot_expert[j.slot]    = j.expert;
+    ls.expert_slot[j.expert]  = j.slot;
+    ls.slot_last_use[j.slot]  = clock_value;
+    ls.slot_in_flight[j.slot] = false;
+    ls.table_dirty = true;
+}
+
+// the layer's tables from its host mirror, both written once, whole: expert -> slot, or n_slots (the dummy) when uncached.
+// The device table is read by the next graph's get_rows, the host table by the CPU mul_mat_id (to skip cached experts).
+template <class L>
+bool flush_tables(L & ls) {
+    if (!ls.table_dirty) {
+        return false;
+    }
+    std::vector<int32_t> table(ls.expert_slot.size());
+    for (size_t e = 0; e < table.size(); ++e) {
+        table[e] = ls.expert_slot[e] >= 0 ? ls.expert_slot[e] : ls.pub.n_slots;
+    }
+    ggml_backend_tensor_set(ls.pub.dev_table,  table.data(), 0, table.size() * sizeof(int32_t));
+    ggml_backend_tensor_set(ls.pub.host_table, table.data(), 0, table.size() * sizeof(int32_t));
+    ls.table_dirty = false;
+    return true;
+}
+
+} // namespace moe_refill
diff --git a/src/llama-moecache.cpp b/src/llama-moecache.cpp
index 79518d9e5..738922679 100644
--- a/src/llama-moecache.cpp
