diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 53dc92b1f..cf0345726 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5862,6 +5862,23 @@ static void ggml_backend_cuda_device_event_synchronize(ggml_backend_dev_t dev, g
     CUDA_CHECK(cudaEventSynchronize((cudaEvent_t)event->context));
 }
 
+// Yamadori 0025: has the event completed? cudaEventQuery never blocks; cudaErrorNotReady is the answer "not yet", not a
+// failure, and is cleared so that it is not reported as the error of whatever CUDA call comes next. Offered through the
+// registry's get_proc_address ("ggml_backend_event_query"), as ggml's other optional backend features are, so that no
+// public ggml header changes.
+static bool ggml_backend_cuda_event_query(ggml_backend_event_t event) {
+    const cudaError_t err = cudaEventQuery((cudaEvent_t)event->context);
+    if (err == cudaSuccess) {
+        return true;
+    }
+    if (err == cudaErrorNotReady) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    CUDA_CHECK(err);
+    return true;
+}
+
 static const ggml_backend_device_i ggml_backend_cuda_device_interface = {
     /* .get_name                = */ ggml_backend_cuda_device_get_name,
     /* .get_description         = */ ggml_backend_cuda_device_get_description,
@@ -6002,6 +6019,9 @@ static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, con
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_cuda_get_features;
     }
+    if (strcmp(name, "ggml_backend_event_query") == 0) {
+        return (void *)ggml_backend_cuda_event_query;   // Yamadori 0025
+    }
     return nullptr;
 }
 
