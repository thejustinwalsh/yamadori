+        h.bufs.push_back(hb);
+        h.bufs.push_back(db);
+        ggml_backend_buffer_clear(db, 0);
+        int m = 0;
+        for (ggml_tensor * t : { L.pub.up_src, L.pub.gate_src, L.pub.down_src }) {
+            std::vector<uint8_t> bytes(ggml_nbytes(t));
+            for (int32_t e = 0; e < h.n_expert; ++e) {
+                for (size_t i = 0; i < h.expert_bytes; ++i) {
+                    bytes[(size_t) e * h.expert_bytes + i] = pattern(l, m, e, i);
+                }
+            }
+            ggml_backend_tensor_set(t, bytes.data(), 0, bytes.size());
+            ++m;
+        }
+        L.slot_expert.assign((size_t) h.n_slots, -1);
+        L.expert_slot.assign((size_t) h.n_expert, -1);
+        L.slot_last_use.assign((size_t) h.n_slots, 0);
+        L.slot_in_flight.assign((size_t) h.n_slots, false);
+        L.table_dirty = true;
+        moe_refill::flush_tables(L);   // everything uncached: the dummy slot
+    }
+}
+
+// the invariant: every expert the device table points at is in its slot, complete
+static void check(harness & h, const char * when, bool report = true) {
+    for (int l = 0; l < h.n_layers; ++l) {
+        tlayer & L = h.layers[(size_t) l];
+        std::vector<int32_t> dev((size_t) h.n_expert), host((size_t) h.n_expert);
+        ggml_backend_tensor_get(L.pub.dev_table,  dev.data(),  0, dev.size() * sizeof(int32_t));
+        ggml_backend_tensor_get(L.pub.host_table, host.data(), 0, host.size() * sizeof(int32_t));
+        for (int32_t e = 0; e < h.n_expert; ++e) {
+            if (dev[(size_t) e] != host[(size_t) e]) {
+                if (report) CHECK(false, "%s: layer %d expert %d: the device table says %d, the host table %d", when, l, e, dev[(size_t) e], host[(size_t) e]);
+                else ++n_failed;
+                return;
+            }
+            const int32_t s = dev[(size_t) e];
+            if (s == h.n_slots) {
+                continue;
+            }
+            const std::pair<ggml_tensor *, int> ms[3] = { { L.pub.up_c, 0 }, { L.pub.gate_c, 1 }, { L.pub.down_c, 2 } };
+            for (const auto & p : ms) {
+                std::vector<uint8_t> got(h.expert_bytes);
+                ggml_backend_tensor_get(p.first, got.data(), (size_t) s * h.expert_bytes, h.expert_bytes);
+                for (size_t i = 0; i < h.expert_bytes; ++i) {
+                    if (got[i] != pattern(l, p.second, e, i)) {
+                        if (report) {
+                            CHECK(false, "%s: layer %d expert %d is published in slot %d but its matrix %d byte %zu is 0x%02X, not 0x%02X",
+                                  when, l, e, s, p.second, i, got[i], pattern(l, p.second, e, i));
+                        } else {
+                            ++n_failed;
+                        }
+                        return;
+                    }
+                }
+            }
+            if (L.slot_expert[(size_t) s] != e || L.slot_in_flight[(size_t) s]) {
+                if (report) CHECK(false, "%s: layer %d expert %d is published in slot %d but the mirror says expert %d, in flight %d",
+                                  when, l, e, s, L.slot_expert[(size_t) s], (int) L.slot_in_flight[(size_t) s]);
+                else ++n_failed;
+                return;
+            }
+        }
+    }
+    ++n_checks;
+}
+
+// one step of the cache's queued path, with random swaps in place of the policy
+struct driver {
+    harness & h;
+    moe_refill::queue q;
+    std::mt19937 & rng;
+    uint64_t step = 0;
+    size_t in_flight = 0;
+    bool eager = false;      // the negative control: publish at push time
+    bool poison = true;
+    uint64_t polls_not_ready = 0, published = 0, pushed = 0;
+
+    driver(harness & h, moe_refill::engine * e, std::mt19937 & r) : h(h), q(e), rng(r) {}
+
+    void publish_landed() {
+        for (const auto & j : q.poll(step)) {
+            moe_refill::publish(h.layers[j.layer], j, ++h.clock);
+            ++published;
+            if (in_flight > 0) in_flight--;
+        }
+        for (auto & L : h.layers) {
+            moe_refill::flush_tables(L);
+        }
+    }
+
+    void swaps(int n) {
+        std::vector<moe_refill::job> jobs;
+        for (int k = 0; k < n; ++k) {
+            const size_t li = rng() % h.layers.size();
+            tlayer & L = h.layers[li];
+            // a victim slot that is not in flight; the expert it holds (if any) is evicted now
+            std::vector<int32_t> free_slots;
+            for (int32_t s = 0; s < h.n_slots; ++s) {
+                if (!L.slot_in_flight[(size_t) s]) {
+                    free_slots.push_back(s);
+                }
+            }
+            if (free_slots.empty()) {
+                continue;
+            }
+            const int32_t slot = free_slots[rng() % free_slots.size()];
+            // a newcomer that is neither resident nor in flight
+            int32_t e = -1;
+            for (int tries = 0; tries < 20 && e < 0; ++tries) {
+                const int32_t c = (int32_t) (rng() % (uint64_t) h.n_expert);
+                bool busy = L.expert_slot[(size_t) c] >= 0;
+                for (const auto & j : jobs) {
+                    busy = busy || (j.layer == li && j.expert == c);
+                }
+                for (int32_t s = 0; s < h.n_slots; ++s) {
+                    busy = busy || (L.slot_in_flight[(size_t) s] && L.slot_expert[(size_t) s] == c);
+                }
+                if (!busy) {
+                    e = c;
+                }
+            }
+            if (e < 0) {
+                continue;
+            }
+            const int32_t victim = L.slot_expert[(size_t) slot];
+            if (victim >= 0) {
+                L.expert_slot[(size_t) victim] = -1;
+                L.slot_expert[(size_t) slot] = -1;
+            }
+            L.table_dirty = true;
+            L.slot_in_flight[(size_t) slot] = true;
+            jobs.push_back({ li, e, slot });
+            ++in_flight;
+        }
+        // commit: the tables first (no graph can see an evicted slot), then the copies
+        for (auto & L : h.layers) {
+            moe_refill::flush_tables(L);
+        }
+        pushed += jobs.size();
+        std::vector<moe_refill::job> published_now = jobs;
+        q.push(jobs, [&](const moe_refill::job & j, moe_refill::engine & en) {
+            moe_refill::enqueue_job(h.layers[j.layer], j, en, poison);
+        }, step);
+        if (eager) {
+            // the broken harness: believe the copy has landed
+            for (const auto & j : published_now) {
+                moe_refill::publish(h.layers[j.layer], j, ++h.clock);
+            }
+            for (auto & L : h.layers) {
+                moe_refill::flush_tables(L);
+            }
+        }
+    }
+};
+
+static void run_fake(std::mt19937 & rng, int steps, size_t expert_bytes) {
+    harness h;
+    h.expert_bytes = expert_bytes;
+    build(h, nullptr);
+    fake_engine eng;
+    driver d(h, &eng, rng);
+    uint64_t not_ready = 0;
+    for (int s = 0; s < steps; ++s) {
+        d.step = (uint64_t) s + 1;
+        // the steps that find a batch not yet landed are the point
+        if (d.q.batches_in_flight() > 0) {
+            ++not_ready;
+        }
+        d.publish_landed();
+        check(h, "after publish");
+        if (d.q.can_push()) {
+            d.swaps(1 + (int) (rng() % 6));
+        }
+        check(h, "after push (copies still in flight)");
+        // the copies land late, in order, a few steps behind
+        const uint32_t r = (uint32_t) (rng() % 10);
+        if (r < 5) {
+            eng.land_oldest();
+        } else if (r == 5) {
+            eng.land_all();
+        }
+    }
+    // everything lands and is published
+    eng.land_all();
+    d.step = (uint64_t) steps + 1;
+    d.publish_landed();
+    check(h, "after the last publish");
+    CHECK(d.q.jobs_in_flight() == 0, "jobs left in flight: %zu", d.q.jobs_in_flight());
+    CHECK(d.in_flight == 0, "the cache's in-flight count is %zu", d.in_flight);
+    CHECK(d.published == d.pushed, "published %" PRIu64 " of %" PRIu64 " pushed", d.published, d.pushed);
+    CHECK(not_ready > (uint64_t) steps / 4, "only %" PRIu64 " of %d steps found a batch still in flight: the test did not exercise the wait", not_ready, steps);
+    printf("fake engine: %d steps, %" PRIu64 " refills, %" PRIu64 " steps with a batch still in flight; steps to land avg %.2f max %" PRIu64 "\n",
+           steps, d.pushed, not_ready, d.q.lat_n ? (double) d.q.lat_sum / (double) d.q.lat_n : 0.0, d.q.lat_max);
+
+    // every resident expert is where the table says (the final state is also complete)
+    for (int l = 0; l < h.n_layers; ++l) {
+        for (int32_t e = 0; e < h.n_expert; ++e) {
+            const int32_t s = h.layers[(size_t) l].expert_slot[(size_t) e];
+            if (s >= 0) {
+                CHECK(h.layers[(size_t) l].slot_expert[(size_t) s] == e, "mirror");
+            }
+        }
+    }
+}
+
+// the harness that publishes at push time must be caught
+static void run_negative(std::mt19937 & rng, size_t expert_bytes) {
+    harness h;
+    h.expert_bytes = expert_bytes;
+    build(h, nullptr);
+    fake_engine eng;
+    driver d(h, &eng, rng);
+    d.eager = true;
+    int caught = 0;
+    const int before_failed = n_failed, before_checks = n_checks;
+    for (int s = 0; s < 40; ++s) {
+        d.step = (uint64_t) s + 1;
+        d.publish_landed();
+        d.swaps(3);
+        const int f0 = n_failed;
+        check(h, "negative control", false);   // counts a failure instead of reporting it
+        if (n_failed > f0) {
+            ++caught;
+            n_failed = f0;                      // the failure is the expected result
+        }
+        eng.land_oldest();
+    }
+    n_failed = before_failed;
+    n_checks = before_checks;
+    CHECK(caught > 0, "a harness that publishes before the copy has landed was never caught");
+    printf("negative control (publish at push time): caught in %d of 40 steps\n", caught);
+}
+
+// ---- the real engine --------------------------------------------------------------------------------------------------
+
+static void run_device(std::mt19937 & rng, int steps, size_t expert_bytes, const char * device) {
+    harness h;
+    h.expert_bytes = expert_bytes;
+    build(h, device);
+    ggml_backend_dev_t dev = ggml_backend_dev_by_name(device);
+    moe_refill::event_query_fn query = moe_refill::event_query_of(dev);
+    CHECK(query, "the device has no non-blocking event query");
+    if (!query) {
+        return;
+    }
+    slow_engine eng(dev, h.dev_buft);
+    CHECK(eng.ok(), "the engine is not usable on %s", device);
+    if (!eng.ok()) {
+        return;
+    }
+    driver d(h, &eng, rng);
+    uint64_t not_ready = 0;
+    for (int s = 0; s < steps; ++s) {
+        d.step = (uint64_t) s + 1;
+        const size_t before = d.q.batches_in_flight();
+        d.publish_landed();
+        if (before > 0 && d.q.batches_in_flight() > 0) {
+            ++not_ready;   // a poll found a batch that had not landed, and did not wait for it
+        }
+        check(h, "after publish");
+        if (d.q.can_push()) {
+            d.swaps(1 + (int) (rng() % 6));
+        }
+        check(h, "after push (copies still in flight)");
+    }
+    // drain: wait for everything, then publish
+    d.step = (uint64_t) steps + 1;
+    for (const auto & j : d.q.drain(d.step)) {
+        moe_refill::publish(h.layers[j.layer], j, ++h.clock);
+        ++d.published;
+        if (d.in_flight > 0) d.in_flight--;
+    }
+    for (auto & L : h.layers) {
+        moe_refill::flush_tables(L);
+    }
+    check(h, "after the drain");
+    CHECK(d.published == d.pushed, "published %" PRIu64 " of %" PRIu64 " pushed", d.published, d.pushed);
+    CHECK(not_ready > 0, "no poll ever found a batch still in flight: the engine was not slow enough to test the non-blocking path");
+    printf("%s: %d steps, %" PRIu64 " refills, %" PRIu64 " polls found a batch not landed yet; steps to land avg %.2f max %" PRIu64 "\n",
+           device, steps, d.pushed, not_ready, d.q.lat_n ? (double) d.q.lat_sum / (double) d.q.lat_n : 0.0, d.q.lat_max);
+
+    // the event query itself: not yet for an event behind 512 MiB of copies, done after it has completed
+    {
+        ggml_backend_event_t ev = ggml_backend_event_new(dev);
+        for (int i = 0; i < 8; ++i) {
+            ggml_backend_tensor_set_async(eng.backend, eng.d, eng.h->data, 0, slow_engine::kBytes);
+        }
+        ggml_backend_event_record(ev, eng.backend);
+        const bool early = query(ev);
+        ggml_backend_event_synchronize(ev);
+        const bool late = query(ev);
+        CHECK(!early, "an event behind 512 MiB of copies already reported complete");
+        CHECK(late, "a completed event reported not complete");
+        ggml_backend_event_free(ev);
+    }
+}
+
+// the queue alone, in order, with a fake that completes out of order
+static void test_queue_order() {
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    CHECK(cpu, "cpu");
+    fake_engine eng;
+    moe_refill::queue q(&eng);
+    // no copies enqueued -> ticket 0 -> lands at once (a batch of nothing is not a batch: push ignores it)
+    q.push({}, [](const moe_refill::job &, moe_refill::engine &) {}, 1);
+    CHECK(q.batches_in_flight() == 0, "an empty push made a batch");
+    ggml_init_params ip = { ggml_tensor_overhead() * 4, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, 64);
+    ggml_backend_buffer_t b = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_cpu_buffer_type());
+    uint8_t src[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
+    for (int i = 0; i < 3; ++i) {
+        q.push({ { 0, i, i } }, [&](const moe_refill::job & j, moe_refill::engine & e) { e.copy(t, src, (size_t) j.slot * 8, 8); }, (uint64_t) i + 1);
+    }
+    CHECK(q.batches_in_flight() == 3 && q.jobs_in_flight() == 3, "three batches in flight");
+    CHECK(q.contains(0, 1) && q.contains(0, 2) && !q.contains(0, 9) && !q.contains(1, 1), "contains: an expert whose copy is queued");
+    CHECK(q.poll(4).empty(), "poll returned a job whose batch has not landed");
+    eng.batches[1].landed = true;                 // the middle one lands first
+    CHECK(q.poll(4).empty(), "poll skipped over the oldest unlanded batch (the publication order would change)");
+    eng.land_oldest();                            // the oldest
+    const auto got = q.poll(5);
+    CHECK(got.size() == 2 && got[0].expert == 0 && got[1].expert == 1, "poll: the landed prefix, oldest first (%zu)", got.size());
+    CHECK(!q.contains(0, 0) && !q.contains(0, 1) && q.contains(0, 2), "contains: a published expert is no longer in flight");
+    CHECK(q.batches_in_flight() == 1, "one batch left");
+    eng.land_all();
+    CHECK(q.poll(6).size() == 1, "the last one");
+    ggml_backend_buffer_free(b);
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    // Never wake a GPU by accident (see test-moe-pcie-split.cpp): without --device every CUDA device is hidden
+    bool has_device = false;
+    for (int i = 1; i < argc; ++i) {
+        has_device |= !strcmp(argv[i], "--device");
+    }
+    if (!has_device) {
+#ifdef _WIN32
+        _putenv("CUDA_VISIBLE_DEVICES=-1");
+#else
+        setenv("CUDA_VISIBLE_DEVICES", "-1", 1);
+#endif
+    } else if (!getenv("CUDA_VISIBLE_DEVICES")) {
+        fprintf(stderr, "--device needs CUDA_VISIBLE_DEVICES set to the one GPU to use\n");
+        return 2;
+    }
+    ggml_backend_load_all();
+
+    int steps = 400;
+    uint32_t seed = 20261002;
+    size_t expert_bytes = 4096;
+    const char * device = nullptr;
+    for (int i = 1; i < argc; ++i) {
+        if (!strcmp(argv[i], "--steps") && i + 1 < argc) { steps = atoi(argv[++i]); }
+        else if (!strcmp(argv[i], "--seed") && i + 1 < argc) { seed = (uint32_t) atoll(argv[++i]); }
+        else if (!strcmp(argv[i], "--expert-bytes") && i + 1 < argc) { expert_bytes = (size_t) atoll(argv[++i]); }
+        else if (!strcmp(argv[i], "--device") && i + 1 < argc) { device = argv[++i]; }
+    }
+    std::mt19937 rng(seed);
+
+    test_queue_order();
+    run_fake(rng, steps, expert_bytes);
+    run_negative(rng, expert_bytes);
+    if (device) {
+        run_device(rng, std::min(steps, 200), expert_bytes, device);
+    } else {
+        // the CPU device has no event query: ggml says so, and the cache then keeps its upload thread
+        ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        CHECK(cpu && !moe_refill::event_query_of(cpu), "the CPU device claims a non-blocking event query");
+    }
+
+    printf("%d checks, %d failed\n", n_checks, n_failed);
+    return n_failed ? 1 : 0;
+}
