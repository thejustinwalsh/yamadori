+// Yamadori 0025: queued refills for the MoE expert cache (src/llama-moecache-refill.h): the cache's refills are enqueued on a
+// second stream and a slot's table entry is published only after the event after its copy has completed.
+//
+// The harness below drives the same functions llama_moe_cache_step() calls -- moe_refill::queue::push / poll,
+// enqueue_job (which poisons the destination slot with 0xFF first), publish, flush_tables -- over a layer bookkeeping
+// with the same member names as the cache's layer_state, with random swaps. The invariant, checked after every
+// operation: every expert the device table points at sits in a slot that holds exactly that expert's bytes (all three
+// matrices), i.e. no slot is ever read before its copy has landed. A slot that was published early holds the poison.
+//
+//   - fake engine (no GPU): the copies land only when the test lands them, at random, so batches complete late and out of
+//     step with the pushes; the check must hold throughout, and a harness that publishes at push time (the negative
+//     control) must be CAUGHT;
+//   - --device NAME (a GPU; the caller restricts CUDA_VISIBLE_DEVICES to the one card): the real engine -- a second
+//     backend instance and events queried without blocking -- with eight 64 MiB copies queued ahead of every batch so that
+//     it completes late; the same invariant, plus: polls that find a batch not yet landed must happen, and ggml's
+//     event query must say "not yet" for an event that has not completed and "done" after it has.
+//
+//   test-moe-refill [--steps N] [--seed S] [--expert-bytes B] [--device NAME]
+
+#include "../src/llama-moecache-refill.h"
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static int n_failed = 0;
+static int n_checks = 0;
+
+#define CHECK(cond, ...)                                      \
+    do {                                                      \
+        ++n_checks;                                           \
+        if (!(cond)) {                                        \
+            ++n_failed;                                       \
+            printf("FAIL %s:%d: %s -- ", __FILE__, __LINE__, #cond); \
+            printf(__VA_ARGS__);                              \
+            printf("\n");                                     \
+        }                                                     \
+    } while (0)
+
+// ---- a fake engine: copies land when the test says so -------------------------------------------------------------
+
+struct fake_engine : moe_refill::engine {
+    struct rec { ggml_tensor * dst; const void * src; size_t off, size; };
+    struct bat { int64_t ticket; std::vector<rec> copies; bool landed = false; };
+    std::vector<rec> open;
+    std::vector<bat> batches;
+    int64_t next = 1;
+    size_t  max_unlanded = 5;
+
+    void copy(ggml_tensor * dst, const void * src, size_t off, size_t size) override { open.push_back({ dst, src, off, size }); }
+    int64_t submit() override {
+        if (open.empty()) {
+            return 0;
+        }
+        batches.push_back({ next++, open, false });
+        open.clear();
+        return batches.back().ticket;
+    }
+    bool done(int64_t t) override {
+        for (const bat & b : batches) {
+            if (b.ticket == t) {
+                return b.landed;
+            }
+        }
+        return true;
+    }
+    void wait(int64_t t) override {
+        for (bat & b : batches) {
+            if (b.ticket <= t) {
+                land(b);
+            }
+        }
+    }
+    bool can_submit() const override {
+        size_t n = 0;
+        for (const bat & b : batches) {
+            n += b.landed ? 0 : 1;
+        }
+        return n < max_unlanded;
+    }
+    void land(bat & b) {
+        if (b.landed) {
+            return;
+        }
+        for (const rec & r : b.copies) {
+            ggml_backend_tensor_set(r.dst, r.src, r.off, r.size);
+        }
+        b.landed = true;
+    }
+    void land_oldest() {
+        for (bat & b : batches) {
+            if (!b.landed) {
+                land(b);
+                return;
+            }
+        }
+    }
+    void land_all() {
+        for (bat & b : batches) {
+            land(b);
+        }
+    }
+};
+
+// ---- the real engine, made slow ------------------------------------------------------------------------------------
+
+struct slow_engine : moe_refill::backend_engine {
+    ggml_context * hctx = nullptr, * dctx = nullptr;
+    ggml_backend_buffer_t hb = nullptr, db = nullptr;
+    ggml_tensor * h = nullptr, * d = nullptr;
+    bool slowed = false;
+    static constexpr size_t kBytes = 64ull << 20;
+
+    slow_engine(ggml_backend_dev_t dev, ggml_backend_buffer_type_t dev_buft) : moe_refill::backend_engine(dev) {
+        ggml_init_params ip = { ggml_tensor_overhead() * 4, nullptr, true };
+        hctx = ggml_init(ip);
+        dctx = ggml_init(ip);
+        h = ggml_new_tensor_1d(hctx, GGML_TYPE_I8, (int64_t) kBytes);
+        d = ggml_new_tensor_1d(dctx, GGML_TYPE_I8, (int64_t) kBytes);
+        ggml_backend_buffer_type_t hbt = ggml_backend_dev_host_buffer_type(dev);
+        hb = ggml_backend_alloc_ctx_tensors_from_buft(hctx, hbt ? hbt : ggml_backend_cpu_buffer_type());
+        db = ggml_backend_alloc_ctx_tensors_from_buft(dctx, dev_buft);
+        if (hb) {
+            memset(h->data, 0, kBytes);
+        }
+    }
+    ~slow_engine() override {
+        if (backend) {
+            ggml_backend_synchronize(backend);
+        }
+        if (db) ggml_backend_buffer_free(db);
+        if (hb) ggml_backend_buffer_free(hb);
+        ggml_free(dctx);
+        ggml_free(hctx);
+    }
+    void copy(ggml_tensor * dst, const void * src, size_t off, size_t size) override {
+        if (!slowed && hb && db) {
+            slowed = true;
+            for (int i = 0; i < 8; ++i) {
+                ggml_backend_tensor_set_async(backend, d, h->data, 0, kBytes);   // ~40 ms of PCIe ahead of the real copies
+            }
+        }
+        moe_refill::backend_engine::copy(dst, src, off, size);
+    }
+    int64_t submit() override {
+        slowed = false;
+        return moe_refill::backend_engine::submit();
+    }
+};
+
+// ---- the layer bookkeeping, with the cache's member names -----------------------------------------------------------
+
+struct pub_t {
+    ggml_tensor * up_src = nullptr, * gate_src = nullptr, * down_src = nullptr;
+    ggml_tensor * up_c = nullptr, * gate_c = nullptr, * down_c = nullptr;
+    ggml_tensor * dev_table = nullptr, * host_table = nullptr;
+    int32_t n_slots = 0;
+};
+
+struct tlayer {
+    pub_t pub;
+    std::vector<int32_t>  slot_expert, expert_slot;
+    std::vector<uint64_t> slot_last_use;
+    std::vector<bool>     slot_in_flight;
+    bool table_dirty = false;
+};
+
+struct harness {
+    int64_t n_expert = 48;
+    int32_t n_slots = 10;
+    size_t  expert_bytes = 4096;
+    int     n_layers = 3;
+
+    ggml_backend_t cpu = nullptr;
+    ggml_backend_dev_t dev = nullptr;
+    ggml_backend_buffer_type_t host_buft = nullptr, dev_buft = nullptr;
+    std::vector<ggml_context *> ctxs;
+    std::vector<ggml_backend_buffer_t> bufs;
+    std::vector<tlayer> layers;
+    uint64_t clock = 0;
+};
+
+static uint8_t pattern(int layer, int matrix, int32_t expert, size_t i) {
+    return (uint8_t) ((layer * 131 + matrix * 71 + expert * 37 + (int) i * 11 + 5) & 0x7F);   // 0x00-0x7F: never the poison 0xFF
+}
+
+static ggml_tensor * mk3(harness & h, ggml_context * ctx, int64_t n) {
+    return ggml_new_tensor_3d(ctx, GGML_TYPE_I8, (int64_t) h.expert_bytes, 1, n);
