@@ -3,6 +3,7 @@
 #include "llama-impl.h"
 #include "llama-model.h"
 #include "llama-moecache-pcie.h"
+#include "llama-moecache-refill.h"
 
 #include "ggml.h"
 #include "ggml-backend.h"
@@ -34,6 +35,8 @@ struct layer_state {
 
     std::vector<bool>     slot_in_flight; // slot has an upload pending
 
+    bool                  table_dirty = false; // 0025: the tables are rewritten whole, once per step, when this is set
+
     std::vector<float>    usage;          // 0004 (Strata's adaptive tier): decayed routed count per expert
 
     uint64_t n_hit  = 0;
@@ -75,6 +78,13 @@ struct moe_cache {
     std::map<int, moe_pcie::layer *>              pcie_by_il;
     int32_t pcie_num = 0;
 
+    // 0025: queued refills (llama-moecache-refill.h): no worker thread, the copies on a second stream, the tables published
+    // when the event after a batch of copies has completed
+    bool queued = false;
+    bool poison = false;   // LLAMA_MOE_REFILL_POISON: a slot is filled with 0xFF before its refill (tests only)
+    std::unique_ptr<moe_refill::backend_engine> refill_engine;
+    std::unique_ptr<moe_refill::queue>          refill;
+
     // async upload worker: slices are copied to the device off the decode
     // thread; the new table mapping is only published at a later step() once
     // the upload has completed, so a running graph never reads a torn slot
@@ -148,6 +158,8 @@ void moe_obs_cb(const char * name, const struct ggml_tensor * ids, void * ud) {
     }
 }
 
+bool g_refill_poison = false;   // 0025: LLAMA_MOE_REFILL_POISON, read once at init
+
