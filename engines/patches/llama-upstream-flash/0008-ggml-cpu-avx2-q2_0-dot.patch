From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Justin Walsh <contact.me@thejustinwalsh.com>
Date: Tue, 29 Sep 2026 12:07:52 -0400
Subject: [PATCH 8/9] ggml-cpu: AVX2 dot product for Q2_0 x Q8_0

x86 had only the scalar generic ggml_vec_dot_q2_0_q8_0 (arch-fallback.h
mapped it for the whole x86 block). Every GSQ-RCO Qwen3.8-Flash-Next file
keeps its routed down projections in Q2_0 (all three expert matrices in the
Q2_0 file), so with experts in RAM the scalar dot was two thirds of the CPU
time of a decode step.

Per 32-value half: the 8 code bytes are unpacked to 32 unsigned codes in
value order (shift-and-mask per 2-bit lane, then byte/word interleaves), and
sum((c - 1) * q) = maddubs(c, q) - maddubs(1, q), summed to int32 lanes (no
int16 saturation: |c*q| <= 762, |q| <= 254 per pair), scaled by d_x * d_y
and accumulated in fp32. Without AVX2 the generic dot runs as before.

Measured on an i7-13700K (AVX2), Flash-Next's down shape ([640, 2560] x 512
experts, 10 routed, one token, 16 threads, weights from DRAM): 0.575 ->
0.118 ms per layer; the whole CPU half of a MoE layer 0.87 -> 0.48 ms
(dev-flash/tools/moe_cpu_bench.cpp, median of 300). Output against the
scalar dot: relative L2 1.1e-7 (1 and 4 tokens), the float summation order.
---
 ggml/src/ggml-cpu/arch-fallback.h   |  3 +-
 ggml/src/ggml-cpu/arch/x86/quants.c | 53 +++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cpu/arch-fallback.h b/ggml/src/ggml-cpu/arch-fallback.h
index 4dbd1982ba03729ffc304876e668da9427acbca2..034ef8d92e1c96d173188d38f5e3c1b6ef2431ca 100644
--- a/ggml/src/ggml-cpu/arch-fallback.h
+++ b/ggml/src/ggml-cpu/arch-fallback.h
@@ -86,8 +86,7 @@
 #define ggml_gemm_mxfp4_8x8_q8_0_generic ggml_gemm_mxfp4_8x8_q8_0
 #define ggml_gemm_q2_K_8x8_q8_K_generic ggml_gemm_q2_K_8x8_q8_K
 #elif defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
-// quants.c
-#define ggml_vec_dot_q2_0_q8_0_generic ggml_vec_dot_q2_0_q8_0
+// quants.c: ggml_vec_dot_q2_0_q8_0 is implemented for x86 (AVX2; the generic otherwise)
 // repack.cpp
 #define ggml_quantize_mat_q8_0_4x4_generic ggml_quantize_mat_q8_0_4x4
 #define ggml_quantize_mat_q8_K_4x4_generic ggml_quantize_mat_q8_K_4x4
diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index ea54cfe44ce403fe06c8b4aa10b5a882779e7e71..a47328aba82e713de620152cc7f09b5617d86473 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -698,6 +698,59 @@ void ggml_vec_dot_q1_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const voi
 #endif
 }
 
+// Q2_0: 64-value blocks (fp16 d, 16 bytes of 2-bit codes; value j is bits 2*(j%4) of byte j/4, and code c
+// means c - 1) against Q8_0 (two 32-value blocks per Q2_0 block). x86 had only the scalar generic dot.
+#if defined(__AVX2__)
+// the 8 code bytes of one 32-value half -> 32 unsigned codes 0..3 in value order
+static inline __m256i ggml_q2_0_codes32(const uint8_t * GGML_RESTRICT p) {
+    const __m128i m3 = _mm_set1_epi8(3);
+    const __m128i v  = _mm_loadl_epi64((const __m128i *) p);
+    const __m128i r0 = _mm_and_si128(v, m3);                     // values 4k+0
+    const __m128i r1 = _mm_and_si128(_mm_srli_epi16(v, 2), m3);  // values 4k+1
+    const __m128i r2 = _mm_and_si128(_mm_srli_epi16(v, 4), m3);  // values 4k+2
+    const __m128i r3 = _mm_and_si128(_mm_srli_epi16(v, 6), m3);  // values 4k+3
+    const __m128i e  = _mm_unpacklo_epi8(r0, r1);                // (4k, 4k+1) pairs, k = 0..7
+    const __m128i o  = _mm_unpacklo_epi8(r2, r3);                // (4k+2, 4k+3) pairs
+    return MM256_SET_M128I(_mm_unpackhi_epi16(e, o), _mm_unpacklo_epi16(e, o));
+}
+
+// sum((c - 1) * q) for 32 codes against 32 int8, as 8 int32 lanes: the codes stay unsigned for maddubs and
+// the -1 is a second maddubs against ones (|c*q| <= 762 and |q| <= 254 per int16 pair: no saturation)
+static inline __m256i ggml_q2_0_dot32(const __m256i c, const __m256i q) {
+    const __m256i d16 = _mm256_sub_epi16(_mm256_maddubs_epi16(c, q), _mm256_maddubs_epi16(_mm256_set1_epi8(1), q));
+    return _mm256_madd_epi16(d16, _mm256_set1_epi16(1));
+}
+#endif
+
+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+#if defined(__AVX2__)
+    const int nb = n / QK2_0;
+
+    assert(n % QK2_0 == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_0 * GGML_RESTRICT x = vx;
+    const block_q8_0 * GGML_RESTRICT y = vy;
+
+    __m256 acc = _mm256_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        for (int h = 0; h < 2; ++h) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[2*i + h];
+            const __m256i p = ggml_q2_0_dot32(ggml_q2_0_codes32(x[i].qs + 8*h), _mm256_loadu_si256((const __m256i *) yb->qs));
+            acc = _mm256_fmadd_ps(_mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(yb->d)), _mm256_cvtepi32_ps(p), acc);
+        }
+    }
+    *s = hsum_float_8(acc);
+#else
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
 void ggml_vec_dot_q4_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     const int qk = QK8_0;
     const int nb = n / qk;
