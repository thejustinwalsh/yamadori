From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Justin Walsh <contact.me@thejustinwalsh.com>
Date: Wed, 30 Sep 2026 18:37:29 -0400
Subject: [PATCH] qwen4exp: QSA selects its budget as whole blocks
 (LLAMA_QSA_BLOCK_TOPK=1)

The indexer scores one mean-pooled key per block of r cells. To pick the
cells a query attends to, qwen4exp expanded every block score to every cell
(get_rows over n_kv), added the attention mask over n_kv, and took the top
indexer_top_k + r - 1 cells over n_kv -- per QSA layer, per token, all
n_kv-sized. With LLAMA_QSA_BLOCK_TOPK=1 the budget is taken as whole blocks:
the top indexer_top_k / r blocks by block score (the per-block bias already
forces the token's own block in; blocks wholly in the token's future, and
the spare block of unpooled cells, now get a large finite negative bias so
they cannot take a place), their r cells each through blk_cells, plus each
token's visible unpooled cells (its incomplete tail) as a second list the
attention unmasks too (llama_memory_hybrid_idx fills it, padded with a cell
the token cannot see). No n_kv-sized op is left in the selection; cell_blk
is not built.

This is the reference's shape (top-k blocks plus the tail, which is what
"indexer_top_k + compress_ratio - 1" names); the cell path differs from it
where it filled its width with up to r - 1 cells of one more block. =2 takes
one block more (a superset of the cell path's cells). Off by default.

On Flash-Next (IQ2_XS, the A4000, llama-perplexity, 4 chunks of 4,096,
q8_0 K/V), against the cell path: mode 1 KLD 0.0089 (same top 97.1%), mode 2
0.0088 (97.2%); mode 1 against mode 2 -- one block apart -- 0.0090 (96.8%);
the cell path against itself 0.000000. Any change to the selected set moves
this model by ~0.009, the size of llama-perplexity's own batch-8-vs-16
yardstick (0.011).
---
 src/llama-memory-hybrid-idx.cpp | 84 +++++++++++++++++++++++++++++----
 src/llama-memory-hybrid-idx.h   | 12 ++++-
 src/models/models.h             |  6 ++-
 src/models/qwen4exp.cpp         | 76 ++++++++++++++++++++++++-----
 4 files changed, 153 insertions(+), 25 deletions(-)

diff --git a/src/llama-memory-hybrid-idx.cpp b/src/llama-memory-hybrid-idx.cpp
index 3972ce9c..338cc415 100644
--- a/src/llama-memory-hybrid-idx.cpp
+++ b/src/llama-memory-hybrid-idx.cpp
@@ -277,14 +277,17 @@ void llama_memory_hybrid_idx::set_input_qsa(
         ggml_tensor * bias,
         const llama_ubatch * ubatch,
         uint32_t ratio,
-        bool blk_bias) const {
+        bool blk_bias,
+        ggml_tensor * tail_cells,
+        int64_t n_kv_arg) const {
     GGML_ASSERT(ratio > 0);
     GGML_ASSERT(get_mem_idx() != nullptr);
 
-    GGML_ASSERT(ggml_backend_buffer_is_host(cell_blk->buffer));
+    GGML_ASSERT(cell_blk == nullptr || ggml_backend_buffer_is_host(cell_blk->buffer));
+    GGML_ASSERT(cell_blk != nullptr || (tail_cells != nullptr && n_kv_arg > 0));
 
-    const int64_t n_kv     = cell_blk->ne[0];
-    const int64_t n_ns     = cell_blk->ne[1];        // streams in this ubatch
+    const int64_t n_kv     = cell_blk ? cell_blk->ne[0] : n_kv_arg;
+    const int64_t n_ns     = blk_cells->ne[1];       // streams in this ubatch
     const int64_t n_blocks = blk_pos->ne[0]/(4*n_ns);
     const int64_t n_tokens = ubatch->n_tokens;
     const int64_t r        = ratio;
@@ -292,7 +295,12 @@ void llama_memory_hybrid_idx::set_input_qsa(
     GGML_ASSERT(n_tokens % n_ns == 0);
     const int64_t n_tps = n_tokens/n_ns;             // tokens per stream
 
-    int32_t * dst_cell_blk  = (int32_t *) cell_blk->data;
+    int32_t * dst_cell_blk  = cell_blk ? (int32_t *) cell_blk->data : nullptr;
+    // M2b: the block top-k mode (tail_cells given)
+    const bool    blk_topk  = tail_cells != nullptr;
+    const int64_t n_tail    = blk_topk ? tail_cells->ne[0] : 0;
+    int32_t *     dst_tail  = blk_topk ? (int32_t *) tail_cells->data : nullptr;
+    GGML_ASSERT(!blk_topk || blk_bias);
     int32_t * dst_blk_cells = (int32_t *) blk_cells->data;
     int32_t * dst_blk_pos   = (int32_t *) blk_pos->data;
     float   * dst_bias      = (float   *) bias->data;
@@ -326,7 +334,7 @@ void llama_memory_hybrid_idx::set_input_qsa(
         const llama_seq_id seq_of_stream = ubatch->seq_id[s*n_tps][0];
         const auto & cells = get_mem_idx()->get_cells(seq_of_stream);
 
-        int32_t * cur_cell_blk  = dst_cell_blk  + s*n_kv;
+        int32_t * cur_cell_blk  = dst_cell_blk ? dst_cell_blk + s*n_kv : nullptr;
         int32_t * cur_blk_cells = dst_blk_cells + s*(r*n_blocks);
 
         std::fill(cur_blk_cells, cur_blk_cells + r*n_blocks, 0);
@@ -508,7 +516,28 @@ void llama_memory_hybrid_idx::set_input_qsa(
                 cur_blk_cells[blk_of[j]*r + (idx%r)] = (int32_t) j;
             }
 
-            cur_cell_blk[j] = blk_of[j] < 0 ? dead_bid : blk_of[j];
+            if (cur_cell_blk) {
+                cur_cell_blk[j] = blk_of[j] < 0 ? dead_bid : blk_of[j];
+            }
+        }
+
+        // M2b: the cells no full block covers (the incomplete tail, and any hole), newest first, and one cell the
+        // tokens of this stream cannot see (an empty cell) to pad each token's tail list with
+        std::vector<std::pair<int64_t, int32_t>> unpooled;
+        int32_t pad_cell = -1;
+        if (blk_topk) {
+            for (int64_t j = 0; j < n_kv; ++j) {
+                if (cells.is_empty(j)) {
+                    if (pad_cell < 0) {
+                        pad_cell = (int32_t) j;
+                    }
+                    continue;
+                }
+                if (blk_of[j] < 0) {
+                    unpooled.emplace_back(ranked ? rank[j] : cells.pos_get(j), (int32_t) j);
+                }
+            }
+            std::sort(unpooled.begin(), unpooled.end(), [](const auto & a, const auto & b) { return a.first > b.first; });
         }
 
         for (int64_t ii = 0; ii < n_tps; ++ii) {
@@ -554,6 +583,13 @@ void llama_memory_hybrid_idx::set_input_qsa(
                         continue;
                     }
 
+                    // M2b: the block top-k sees no per-cell mask, so a block wholly in this token's future must not
+                    // take a place in its budget (finite, as below)
+                    if (blk_topk && bid_idx[b] > q) {
+                        cur_blk_bias[b] = -1e30f;
+                        continue;
+                    }
+
                     // finite, so it can never meet a -inf and produce a nan
                     cur_blk_bias[b] = bid_idx[b] >= tail_start ? 1e9f : 0.0f;
                 }
@@ -562,7 +598,33 @@ void llama_memory_hybrid_idx::set_input_qsa(
                 // it gets the tail value. it must stay finite: a sequence with fewer than
                 // `ratio` cells owns no full block, and a row of -inf only gives a nan.
                 if (have_dead) {
-                    cur_blk_bias[dead_bid] = 1e9f;
+                    // M2b: the tail cells are listed on their own, so the spare block competes for nothing
+                    cur_blk_bias[dead_bid] = blk_topk ? -1e30f : 1e9f;
+                }
+
+                if (blk_topk) {
+                    // this token's unpooled cells it can see (sequence and position), newest first; then the pad
+                    // cell (an empty cell, masked for every token), else the newest listed cell again, else its own
+                    int32_t * cur_tail = dst_tail + i*n_tail;
+                    int64_t   n_fill   = 0;
+                    for (const auto & u : unpooled) {
+                        if (n_fill == n_tail) {
+                            break;
+                        }
+                        if (u.first <= q && cells.seq_has((uint32_t) u.second, seq_id)) {
+                            cur_tail[n_fill++] = u.second;
+                        }
+                    }
+                    int32_t pad = pad_cell >= 0 ? pad_cell : (n_fill > 0 ? cur_tail[0] : -1);
+                    for (int64_t j = 0; j < n_kv && pad < 0; ++j) {
+                        if (!cells.is_empty(j) && cells.seq_has((uint32_t) j, seq_id) &&
+                                (ranked ? rank[j] : cells.pos_get(j)) == q) {
+                            pad = (int32_t) j;
+                        }
+                    }
+                    for (int64_t t = n_fill; t < n_tail; ++t) {
+                        cur_tail[t] = pad < 0 ? 0 : pad;
+                    }
                 }
 
                 continue;
@@ -676,8 +738,10 @@ void llama_memory_hybrid_idx_context::set_input_qsa(
         ggml_tensor * bias,
         const llama_ubatch * ubatch,
         uint32_t ratio,
-        bool blk_bias) const {
+        bool blk_bias,
+        ggml_tensor * tail_cells,
+        int64_t n_kv_arg) const {
     GGML_ASSERT(mem != nullptr);
 
-    mem->set_input_qsa(cell_blk, blk_cells, blk_pos, bias, ubatch, ratio, blk_bias);
+    mem->set_input_qsa(cell_blk, blk_cells, blk_pos, bias, ubatch, ratio, blk_bias, tail_cells, n_kv_arg);
 }
diff --git a/src/llama-memory-hybrid-idx.h b/src/llama-memory-hybrid-idx.h
index 705189e7..8dc908c0 100644
--- a/src/llama-memory-hybrid-idx.h
+++ b/src/llama-memory-hybrid-idx.h
@@ -83,9 +83,13 @@ public:
     //   bias      F32 [n_kv, n_tokens/ns, ns] -inf where invisible, large where always visible
     // blk_bias asks for the bias per block instead: [n_blocks, n_tokens/ns, ns]
     // the caller then adds the attention mask, the only part of the bias that varies within a block
+    // tail_cells (M2b, block top-k; nullptr: the cell path): I32 [T, n_tokens/ns, ns], per token the cells no full
+    // block covers that it may see (its incomplete tail), newest first, padded with a cell it cannot see. In that
+    // mode cell_blk may be nullptr (n_kv then comes from n_kv_arg) and a block the token cannot see at all (wholly
+    // in its future, or the spare block of unpooled cells) gets a large finite negative bias instead of 0 / 1e9
     void set_input_qsa(ggml_tensor * cell_blk, ggml_tensor * blk_cells, ggml_tensor * blk_pos,
                        ggml_tensor * bias, const llama_ubatch * ubatch, uint32_t ratio,
-                       bool blk_bias) const;
+                       bool blk_bias, ggml_tensor * tail_cells = nullptr, int64_t n_kv_arg = -1) const;
 
 private:
     // forget seq_id (all of it if seq_id < 0) in every cache at once, so a failed restore cannot leave the caches out of step
@@ -141,9 +145,13 @@ public:
     // streams in the current slot info, the `ns` of get_k/get_v; 1 if unified
     uint32_t get_n_stream() const;
 
+    // tail_cells (M2b, block top-k; nullptr: the cell path): I32 [T, n_tokens/ns, ns], per token the cells no full
+    // block covers that it may see (its incomplete tail), newest first, padded with a cell it cannot see. In that
+    // mode cell_blk may be nullptr (n_kv then comes from n_kv_arg) and a block the token cannot see at all (wholly
+    // in its future, or the spare block of unpooled cells) gets a large finite negative bias instead of 0 / 1e9
     void set_input_qsa(ggml_tensor * cell_blk, ggml_tensor * blk_cells, ggml_tensor * blk_pos,
                        ggml_tensor * bias, const llama_ubatch * ubatch, uint32_t ratio,
-                       bool blk_bias) const;
+                       bool blk_bias, ggml_tensor * tail_cells = nullptr, int64_t n_kv_arg = -1) const;
 
 private:
     const llama_memory_hybrid_idx * mem = nullptr;
diff --git a/src/models/models.h b/src/models/models.h
index 10e4dde0..674afebc 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -2426,7 +2426,8 @@ struct llama_model_qwen4exp : public llama_model_base {
                     ggml_tensor * v_cur,
                     ggml_tensor * top_k,
                           float   kq_scale,
-                            int   il);
+                            int   il,
+                    ggml_tensor * tail = nullptr);
 
         // the QSA cache layout inputs do not depend on the layer, only on its compress ratio,
         // so the layers sharing a ratio share one input set
@@ -2439,7 +2440,8 @@ struct llama_model_qwen4exp : public llama_model_base {
                     ggml_tensor * inp_pos,
                     ggml_tensor * kq_mask,
                             int * sections,
-                            int   il);
+                            int   il,
+                  ggml_tensor ** tail = nullptr);
 
         ggml_tensor * build_layer_attn_linear(
              llm_graph_input_rs * inp,
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index a501450c..35356363 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -738,7 +738,8 @@ public:
 
     void set_input(const llama_ubatch * ubatch) override {
         mctx->get_idx()->set_input_k_idxs(k_idxs, ubatch);
-        mctx->set_input_qsa(cell_blk, blk_cells, blk_pos, bias, ubatch, ratio, blk_bias);
+        mctx->set_input_qsa(cell_blk, blk_cells, blk_pos, bias, ubatch, ratio, blk_bias, tail_cells,
+                            mctx->get_idx()->get_n_kv());
     }
 
     bool can_reuse(const llm_graph_params & params) override {
@@ -758,8 +759,16 @@ public:
         res &= params.ubatch.n_tokens % n_stream == 0;
 
         res &= k_idxs->ne[0]    == params.ubatch.n_tokens;
-        res &= cell_blk->ne[0]  == n_kv;
-        res &= cell_blk->ne[1]  == n_stream;
+        res &= (cell_blk == nullptr) == (tail_cells != nullptr);
+        if (cell_blk) {
+            res &= cell_blk->ne[0] == n_kv;
+            res &= cell_blk->ne[1] == n_stream;
+        }
+        if (tail_cells) {
+            res &= tail_cells->ne[1] == params.ubatch.n_tokens/n_stream;
+            res &= tail_cells->ne[2] == n_stream;
+        }
+        res &= blk_cells->ne[1] == n_stream;
         res &= blk_cells->ne[0] == (int64_t) ratio*n_blocks;
         res &= blk_pos->ne[0]   == 4*n_blocks*n_stream;
         res &= bias->ne[0]      == (blk_bias ? n_blocks : n_kv);
@@ -774,6 +783,8 @@ public:
     ggml_tensor * blk_cells = nullptr;   // I32 [ratio*n_blocks, n_stream]
     ggml_tensor * blk_pos   = nullptr;   // I32 [4*n_blocks*n_stream]
     ggml_tensor * bias      = nullptr;   // F32 [n_blocks or n_kv, n_tokens/n_stream, n_stream]
+    // M2b (block top-k): each token's visible unpooled cells, padded; cell_blk is then not built
+    ggml_tensor * tail_cells = nullptr;  // I32 [2*ratio, n_tokens/n_stream, n_stream]
 
     const llama_memory_hybrid_idx_context * mctx;
     const uint32_t ratio;
@@ -788,7 +799,8 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         ggml_tensor *                           inp_pos,
         ggml_tensor *                           kq_mask,
         int *                                   sections,
-        int                                     il) {
+        int                                     il,
+        ggml_tensor **                          tail_out) {
     const llama_kv_cache_context * mctx_idx = mctx_hyb->get_idx();
 
     const int64_t idx_dim  = hparams.indexer_head_size;
@@ -813,6 +825,16 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         kq_mask->ne[0] == n_kv && kq_mask->ne[1] == n_tps && kq_mask->ne[3] == n_stream &&
         cparams.causal_attn && !hparams.use_alibi;
 
+    // M2b, LLAMA_QSA_BLOCK_TOPK=1: select the budget as whole BLOCKS (top_k/r of them by block score) plus each
+    // token's incomplete tail, instead of expanding every block score to its cells and taking the top cells -- the
+    // expansion, its mask add and the top-k were n_kv-sized per QSA layer per token. Differs from the cell path only
+    // where that path filled its width (top_k + r - 1) with part of one more block when the tail was short.
+    // =2: one block more than the budget, so the selection holds every cell the cell path would have picked (that
+    // path fills its width with up to r - 1 cells of the next block)
+    static const int blk_topk_env = [] { const char * e = getenv("LLAMA_QSA_BLOCK_TOPK"); return e ? atoi(e) : 0; }();
+    const bool blk_topk = blk_topk_env > 0 && blk_bias && tail_out != nullptr &&
+        hparams.indexer_top_k % r == 0 && (int64_t) hparams.indexer_top_k < n_kv;
+
     // nothing above depends on the layer, so the layers sharing a ratio share one input set
     llm_graph_input_qsa * inp = nullptr;
 
@@ -823,12 +845,16 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         auto qsa = std::make_unique<llm_graph_input_qsa>(mctx_hyb, (uint32_t) r, blk_bias);
 
         qsa->k_idxs    = mctx_idx->build_input_k_idxs(ctx0, ubatch);
-        qsa->cell_blk  = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, n_kv, n_stream);
+        qsa->cell_blk  = blk_topk ? nullptr : ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, n_kv, n_stream);
         qsa->blk_cells = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, r*n_blocks, n_stream);
         qsa->blk_pos   = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, 4*n_blocks*n_stream);
         qsa->bias      = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, blk_bias ? n_blocks : n_kv, n_tps, n_stream);
-
-        ggml_set_input(qsa->cell_blk);
+        if (blk_topk) {
+            qsa->tail_cells = ggml_new_tensor_3d(ctx0, GGML_TYPE_I32, 2*r, n_tps, n_stream);
+            ggml_set_input(qsa->tail_cells);
+        } else {
+            ggml_set_input(qsa->cell_blk);
+        }
         ggml_set_input(qsa->blk_cells);
         ggml_set_input(qsa->blk_pos);
         ggml_set_input(qsa->bias);
@@ -907,6 +933,20 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
         score = ggml_add(ctx0, score, inp->bias);
     }
 
+    if (blk_topk) {
+        // the budget in whole blocks, by block score (bias: the token's own block forced in, blocks it cannot see
+        // pushed out), their r cells each; the tail cells come as their own list (the input)
+        const int64_t kb = std::min<int64_t>(n_blocks, (int64_t) hparams.indexer_top_k / r + (blk_topk_env == 2 ? 1 : 0));
+        ggml_tensor * blk_top = ggml_cont(ctx0, ggml_top_k(ctx0, score, kb));             // I32 [kb, n_tps, n_stream]
+        blk_top = ggml_reshape_2d(ctx0, blk_top, kb*n_tps, n_stream);
+        ggml_tensor * cells_of = ggml_reshape_3d(ctx0, inp->blk_cells, r, n_blocks, n_stream);
+        ggml_tensor * top_k = ggml_get_rows(ctx0, cells_of, blk_top);                      // I32 [r, kb*n_tps, n_stream]
+        top_k = ggml_reshape_4d(ctx0, ggml_cont(ctx0, top_k), r*kb, n_tps, 1, n_stream);
+        cb(top_k, "indexer_top_k", il);
+        *tail_out = ggml_reshape_4d(ctx0, inp->tail_cells, 2*r, n_tps, 1, n_stream);
+        return top_k;
+    }
+
     // every token of a block gets the block score; the budget is whole blocks, so top-k cuts on a block boundary
     ggml_tensor * expanded = ggml_get_rows(ctx0,
             ggml_cont(ctx0, ggml_permute(ctx0, score, 1, 0, 2, 3)), inp->cell_blk);
@@ -942,7 +982,8 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
         ggml_tensor *             v_cur,
         ggml_tensor *             top_k,
         float                     kq_scale,
-        int                       il) {
+        int                       il,
+        ggml_tensor *             tail) {
     // rotate q/k/v before they reach a quantized cache, as the dense path does. the indexer
     // has already scored with its own query in build_qsa_top_k, so top_k is unaffected.
     if (inp->self_k_rot) {
@@ -993,6 +1034,18 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
     // ggml_set_rows([1, n_kv, n_batch, n_stream], [1, n_top_k, n_batch, n_stream], [n_top_k, n_batch, n_stream, 1])
     ggml_tensor * kq_mask_top_k = ggml_set_rows(ctx0, kq_mask_all, zeros, top_k_3d);
 
+    // M2b: the tail list, unmasked the same way (its padding is a cell the token cannot see, so the attention mask
+    // added below keeps it out)
+    int64_t n_kv_max = top_k->ne[0];
+    if (tail) {
+        ggml_tensor * tail_3d = ggml_view_4d(ctx0, tail, tail->ne[0], tail->ne[1], tail->ne[3], 1, tail->nb[1], tail->nb[2],
+                tail->ne[3]*tail->nb[3], 0);
+        ggml_tensor * zeros_t = ggml_fill(ctx0, ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, 1, tail_3d->ne[0], tail_3d->ne[1],
+                tail_3d->ne[2]), 0.0f);
+        kq_mask_top_k = ggml_set_rows(ctx0, kq_mask_top_k, zeros_t, tail_3d);
+        n_kv_max += tail->ne[0];
+    }
+
     // reshape to restore the original shape of KQ mask:
     // [1, n_kv, n_batch, n_stream] -> [n_kv, n_batch, 1, n_stream]
     kq_mask_top_k = ggml_view_4d(ctx0, kq_mask_top_k, kq_mask_top_k->ne[1], kq_mask_top_k->ne[2], 1, kq_mask_top_k->ne[3], kq_mask_top_k->nb[2], kq_mask_top_k->nb[3], kq_mask_top_k->nb[3], 0);
@@ -1004,7 +1057,7 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
     ggml_tensor * k = mctx_cur->get_k(ctx0, il);
     ggml_tensor * v = mctx_cur->get_v(ctx0, il);
 
-    ggml_tensor * cur = build_attn_mha(q, k, v, nullptr, kq_mask_top_k, nullptr, nullptr, top_k->ne[0], kq_scale, il);
+    ggml_tensor * cur = build_attn_mha(q, k, v, nullptr, kq_mask_top_k, nullptr, nullptr, n_kv_max, kq_scale, il);
     cb(cur, "kqv_out", il);
 
     // the rotation is its own inverse, so undo it on the value side of the output
@@ -1028,7 +1081,8 @@ ggml_tensor * llama_model_qwen4exp::graph::build_layer_attn(
     // indexer reads the same block input as q/k/v; no cache or no ratio means dense
     const bool qsa = mctx_hyb->get_idx() != nullptr && hparams.dsv4_compress_ratios[il] > 0;
 
-    ggml_tensor * top_k = qsa ? build_qsa_top_k(mctx_hyb, cur, inp_pos, inp->get_kq_mask(), sections, il) : nullptr;
+    ggml_tensor * qsa_tail = nullptr;
