diff --git a/src/llama-moecache-pcie.cpp b/src/llama-moecache-pcie.cpp
new file mode 100644
index 000000000..dc2c231c0
--- /dev/null
+++ b/src/llama-moecache-pcie.cpp
@@ -0,0 +1,297 @@
+#include "llama-moecache-pcie.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+
+namespace moe_pcie {
+
+// ---- the share ----------------------------------------------------------------------------------------------------
+
+int32_t num_of_frac(double frac) {
+    // Strata generate.cpp @ d551edf :2397 (and :3565-3567): pcie_num = (int) (pcie_frac * 256.0 + 0.5), clamped 0..256
+    const int n = (int) (frac * 256.0 + 0.5);
+    return std::max(0, std::min(256, n));
+}
+
+double frac_of_bandwidth(double gbps, double base) {
+    // Strata generate.cpp @ d9ab843 :1723-1730: "from 20 GB/s up (x16 PCIe 4/5) the measured default stays";
+    // below ~4 GB/s a missed expert takes longer to cross than the CPU takes to compute it, so none go over the link
+    return gbps >= 20.0 ? base : gbps < 4.0 ? 0.0 : std::min(base, std::max(0.05, base * (gbps / 26.0)));
+}
+
+bool parse_frac(const char * value, double & frac, bool & automatic) {
+    frac = 0.0;
+    automatic = false;
+    if (!value) {
+        return false;
+    }
+    while (*value == ' ' || *value == '\t') {
+        ++value;
+    }
+    if (!*value || !strcmp(value, "0") || !strcmp(value, "off") || !strcmp(value, "OFF") || !strcmp(value, "no")) {
+        return false;
+    }
+    if (!strcmp(value, "auto")) {
+        automatic = true;
+        return true;
+    }
+    char * end = nullptr;
+    const double v = strtod(value, &end);
+    if (end == value || *end != '\0' || !(v > 0.0) || v > 1.0) {
+        return false;
+    }
+    frac = v;
+    return true;
+}
+
+double probe_h2d_gbps(ggml_backend_t backend, ggml_backend_buffer_type_t dev_buft) {
+    // Strata generate.cpp @ d9ab843 :950 (probe_pcie_h2d_gbps): a warm-up copy, then timed copies from pinned host memory.
+    // Strata times four 256 MiB copies between two CUDA events; ggml has no event timing, so this is wall time around
+    // a stream synchronise, over eight 64 MiB copies (less device memory at the moment the cache is being sized).
+    constexpr size_t   kBytes = 64ull << 20;
+    constexpr int      kIters = 8;
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_buffer_type_t host_buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+    if (!host_buft || !dev_buft) {
+        return -1.0;
+    }
+    ggml_init_params ip = { /*.mem_size =*/ ggml_tensor_overhead() * 4, /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+    // one context per buffer, so each tensor is in the buffer type it was meant for
+    ggml_context * ch = ggml_init(ip);
+    ggml_context * cd = ggml_init(ip);
+    if (!ch || !cd) {
+        if (ch) ggml_free(ch);
+        if (cd) ggml_free(cd);
+        return -1.0;
+    }
+    ggml_tensor * h = ggml_new_tensor_1d(ch, GGML_TYPE_I8, (int64_t) kBytes);
+    ggml_tensor * d = ggml_new_tensor_1d(cd, GGML_TYPE_I8, (int64_t) kBytes);
+    ggml_backend_buffer_t hb = ggml_backend_alloc_ctx_tensors_from_buft(ch, host_buft);
+    ggml_backend_buffer_t db = ggml_backend_alloc_ctx_tensors_from_buft(cd, dev_buft);
+    double gbps = -1.0;
+    if (hb && db) {
+        memset(h->data, 0, kBytes);                                  // fault the pages in before timing
+        ggml_backend_tensor_set_async(backend, d, h->data, 0, kBytes);   // warm-up: context up, copy engine primed
+        ggml_backend_synchronize(backend);
+        const auto t0 = std::chrono::steady_clock::now();
+        for (int i = 0; i < kIters; ++i) {
+            ggml_backend_tensor_set_async(backend, d, h->data, 0, kBytes);
+        }
+        ggml_backend_synchronize(backend);
+        const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        if (s > 1e-5) {
+            gbps = ((double) kIters * (double) kBytes / s) / 1e9;
+        }
+    }
+    ggml_backend_buffer_free(db);
+    ggml_backend_buffer_free(hb);
+    ggml_free(cd);
+    ggml_free(ch);
+    return gbps;
+}
+
+// ---- the partition ------------------------------------------------------------------------------------------------
+
+void partition_step(const int32_t * ids, int64_t n_used, int64_t n_tokens, size_t nb0, size_t nb1,
+                    const int32_t * table, int64_t n_expert, int32_t dummy,
+                    int32_t pcie_num, int32_t pool_slots,
+                    int32_t * cpu_tbl, int32_t * pool_ids, partition & out) {
+    // Strata expert_source.cpp @ d551edf :309-392 (expert_pool_dispatch_multi): "Distinct experts in routing order;
+    // resident ones and the last pcie_num/256 of the missed ones go to the GPU." Position i = t * n_used + j, as there.
+    const int64_t n = n_used * n_tokens;
+    out.n_missed = 0;
+    out.share.clear();
+
+    thread_local std::vector<int32_t> distinct;
+    thread_local std::vector<int32_t> slot_of;
+    distinct.clear();
+    slot_of.assign((size_t) n_expert, -1);
+    // the experts seen so far: slot_of doubles as the "seen" mark (-2 = seen, not shared)
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t j = 0; j < n_used; ++j) {
+            const int32_t e = *(const int32_t *) ((const char *) ids + t * nb1 + j * nb0);
+            if (e < 0 || e >= n_expert || slot_of[(size_t) e] != -1) {
+                continue;
+            }
+            slot_of[(size_t) e] = -2;
+            distinct.push_back(e);
+            if (table[e] == dummy) {
+                out.n_missed++;
+            }
+        }
+    }
+
+    for (int64_t e = 0; e < n_expert; ++e) {
+        cpu_tbl[e] = table[e];
+    }
+
+    // m = (nmiss * pcie_num) >> 8, as Strata (expert_source.cpp :1666 at d9ab843), and no more than the pool holds
+    int32_t m = (int32_t) (((int64_t) out.n_missed * (int64_t) pcie_num) >> 8);
+    m = std::min(m, pool_slots);
+    int32_t miss_rank = 0;
+    for (const int32_t e : distinct) {
+        if (table[e] != dummy) {
+            continue;
+        }
+        if (miss_rank >= out.n_missed - m) {   // the last m missed ones, in routing order (:1683)
+            const int32_t slot = (int32_t) out.share.size();
+            out.share.emplace_back(e, slot);
+            slot_of[(size_t) e] = slot;
+            cpu_tbl[e] = dummy + 1;          // the CPU nodes skip it
+        }
+        ++miss_rank;
+    }
+
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t j = 0; j < n_used; ++j) {
+            const int32_t e = *(const int32_t *) ((const char *) ids + t * nb1 + j * nb0);
+            const int32_t s = (e >= 0 && e < n_expert) ? slot_of[(size_t) e] : -1;
+            pool_ids[t * n_used + j] = s >= 0 ? s : pool_slots;
+        }
+    }
+    (void) n;
+}
+
+// ---- the copy engine ----------------------------------------------------------------------------------------------
+
+backend_copier::backend_copier(ggml_backend_dev_t dev) {
+    backend = ggml_backend_dev_init(dev, nullptr);
+    event   = ggml_backend_event_new(dev);
+}
+
+backend_copier::~backend_copier() {
+    if (event) {
+        ggml_backend_event_free(event);
+    }
+    if (backend) {
+        ggml_backend_free(backend);
+    }
+}
+
+void backend_copier::copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) {
+    ggml_backend_tensor_set_async(backend, dst, src, dst_offset, size);
+    enqueued = true;
+}
+
+bool backend_copier::mark() {
+    if (!enqueued) {
+        return false;
+    }
+    enqueued = false;
+    if (event) {
+        ggml_backend_event_record(event, backend);
+    }
+    pending = true;
+    return true;
+}
+
+void backend_copier::wait() {
+    if (!pending) {
+        return;
+    }
+    if (event) {
+        ggml_backend_event_synchronize(event);
+    } else {
+        ggml_backend_synchronize(backend);
+    }
+    pending = false;
+}
+
+// ---- the graph ----------------------------------------------------------------------------------------------------
+
+namespace {
+
+// The plan node: runs on the CPU backend (its table input is a host tensor), once per layer and step, in the thread
+// that executes the graph. Writes cpu_tbl and the pool's slot ids, then enqueues the share's copies.
+void plan_op(ggml_tensor * dst, int ith, int nth, void * ud) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    layer & L = *(layer *) ud;
+    const ggml_tensor * ids   = dst->src[0];
+    const ggml_tensor * table = dst->src[1];
+    const int64_t n_used   = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    const int64_t n_expert = ggml_nelements(table);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && table->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_nelements(dst) == n_expert + n_used * n_tokens);
+
+    int32_t * out = (int32_t *) dst->data;
+    thread_local partition part;
+    partition_step((const int32_t *) ids->data, n_used, n_tokens, ids->nb[0], ids->nb[1],
+                   (const int32_t *) table->data, n_expert, L.dummy, L.pcie_num, L.shared->n_slots,
+                   out, out + n_expert, part);
+
+    pool & P = *L.shared;
+    for (const auto & es : part.share) {
+        const int64_t e = es.first;
+        const size_t  s = (size_t) es.second;
+        P.engine->copy(P.up,   (const char *) L.up_src->data   + (size_t) e * L.up_src->nb[2],   s * P.up->nb[2],   L.up_src->nb[2]);
+        P.engine->copy(P.gate, (const char *) L.gate_src->data + (size_t) e * L.gate_src->nb[2], s * P.gate->nb[2], L.gate_src->nb[2]);
+        P.engine->copy(P.down, (const char *) L.down_src->data + (size_t) e * L.down_src->nb[2], s * P.down->nb[2], L.down_src->nb[2]);
+    }
+    L.pending = P.engine->mark();
+
+    L.n_plans.fetch_add(1, std::memory_order_relaxed);
+    L.n_missed.fetch_add((uint64_t) part.n_missed, std::memory_order_relaxed);
+    L.n_share.fetch_add((uint64_t) part.share.size(), std::memory_order_relaxed);
+}
+
+// The wait node: after the CPU chain, before the GPU chain. Blocks (in this thread, the CPU's) until the stream the
+// copies were enqueued on has passed their event, then hands the slot ids on; the GPU chain reads them, so it cannot
+// be launched before the copies have landed.
+void wait_op(ggml_tensor * dst, int ith, int nth, void * ud) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    layer & L = *(layer *) ud;
+    if (L.pending) {
+        L.shared->engine->wait();
+        L.pending = false;
+    }
+    const ggml_tensor * src = dst->src[0];
+    GGML_ASSERT(ggml_nbytes(src) == ggml_nbytes(dst));
+    memcpy(dst->data, src->data, ggml_nbytes(dst));
+}
+
+} // namespace
+
+plan_nodes build_plan(ggml_context * ctx, layer & L, ggml_tensor * ids, ggml_tensor * host_table) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && host_table->type == GGML_TYPE_I32);
+    const int64_t n_used   = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    const int64_t n_expert = ggml_nelements(host_table);
+
+    ggml_tensor * args[2] = { ids, host_table };
+    plan_nodes p;
+    p.plan = ggml_custom_4d(ctx, GGML_TYPE_I32, n_expert + n_used * n_tokens, 1, 1, 1, args, 2, plan_op, 1, &L);
+    p.cpu_tbl  = ggml_view_1d(ctx, p.plan, n_expert, 0);
+    p.ids_tail = ggml_view_1d(ctx, p.plan, n_used * n_tokens, (size_t) n_expert * sizeof(int32_t));
+    return p;
+}
+
+ggml_tensor * build_wait(ggml_context * ctx, layer & L, const plan_nodes & p, ggml_tensor * cpu_result,
+                         ggml_tensor * host_table, int64_t n_used, int64_t n_tokens) {
+    ggml_tensor * args[3] = { p.ids_tail, cpu_result, host_table };
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, n_used, n_tokens, 1, 1, args, 3, wait_op, 1, &L);
+}
+
+ggml_tensor * build_chain(ggml_context * ctx, layer & L, ggml_tensor * x, ggml_tensor * slot_ids,
+                          const std::function<ggml_tensor *(ggml_tensor *, ggml_tensor *)> & act,
+                          const std::function<void(ggml_tensor *, const char *)> & name) {
+    pool & P = *L.shared;
+    ggml_tensor * up_g   = ggml_mul_mat_id(ctx, P.up,   x, slot_ids);
+    ggml_tensor * gate_g = ggml_mul_mat_id(ctx, P.gate, x, slot_ids);
+    name(up_g,   "up");
+    name(gate_g, "gate");
+    ggml_tensor * act_g  = act(gate_g, up_g);
+    ggml_tensor * down_g = ggml_mul_mat_id(ctx, P.down, act_g, slot_ids);
+    name(down_g, "down");
+    return down_g;
+}
+
+} // namespace moe_pcie
diff --git a/src/llama-moecache-pcie.h b/src/llama-moecache-pcie.h
new file mode 100644
index 000000000..8ceb69e9d
--- /dev/null
+++ b/src/llama-moecache-pcie.h
@@ -0,0 +1,167 @@
+#pragma once
+
+// Yamadori 0024: `pcie_frac` for the MoE expert cache (llama-moecache.h) -- a share of one step's MISSED experts is
+// computed on the GPU, their weights read over PCIe, while the CPU computes the rest.
+//
+// Ported from Strata (github.com/Niko1221/Strata). Copyright (c) 2026 Niko1221 and the Strata contributors; MIT
+// License (the full notice: engines/patches/llama-upstream-flash/LICENSE.strata; the file is in Strata at c0107c3,
+// and the code below was read at d551edf and d9ab843, both named where it is used):
+//  - the split rule and the plan: src/core/expert_source.cpp @ d551edf :282-392 (`expert_pool_dispatch_multi`;
+//    at d9ab843 the same rule at :1666 and :1683): the distinct experts of a layer in routing order, the resident ones
+//    stay with the GPU cache, and of the MISSED ones the last m = (n_missed * pcie_num) >> 8 go to the GPU through the
+//    PCIe path; pcie_num = int(frac * 256 + 0.5). Duplicates of an expert (several tokens) go with it.
+//  - the share's source: src/program/generate.cpp @ d9ab843 :950 (`probe_pcie_h2d_gbps`: copies from pinned host
+//    memory between two events, after a warm-up) and :1715-1735 (the rule: from 20 GB/s up the base share stays,
+//    below 4 GB/s none, else min(base, max(0.05, base * gbps / 26))). Strata's base (0.55) and its 26 GB/s
+//    reference are THEIR measurements on THEIR CPU kernels; here the base is LLAMA_MOE_PCIE_BASE, and the probe is
+//    a starting point for a sweep of explicit shares, not a result for this CPU.
+//
+// What differs from Strata, and why (docs/FLASH-NEXT.md section 10.2):
+//  - Strata's plan is published to doorbell flags the GPU polls and its copy kernel reads the pinned arena through a
+//    device alias. Here the plan is one graph node (a custom op on the CPU backend) that writes the tables the other
+//    nodes read and enqueues the copies on a second CUDA stream; a second node waits for the copies' event. No new
+//    kernel: the GPU computes the share with the same mul_mat_id the cache chain uses, over a small POOL of slots
+//    that the plan fills each step (one pool shared by all layers of the same expert shape; the layers run one after
+//    another, and the CPU split's input copy has synchronised the compute stream before a plan runs, so a pool slot
+//    is never overwritten while a previous layer's chain still reads it).
+//  - a pool slot holds a whole expert (up, gate, down), the zero slot is the last one, exactly as the cache's.
+//
+// Off unless LLAMA_MOE_PCIE_FRAC is set (a number in (0, 1], or "auto" for the probe rule). With it off nothing in this
+// file runs and the graph is the one 0003/0004/0007/0013 build.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace moe_pcie {
+
+// ---- the share ----------------------------------------------------------------------------------------------------
+
+// Strata's numerator out of 256: int(frac * 256 + 0.5), clamped to 0..256
+int32_t num_of_frac(double frac);
+
+// Strata's probe rule (generate.cpp @ d9ab843 :1715-1735): the share from the measured host->device GB/s
+double frac_of_bandwidth(double gbps, double base);
+
+// LLAMA_MOE_PCIE_FRAC: unset, "", "0", "off" -> off (returns false); "auto" -> automatic = true; a number -> frac
+bool parse_frac(const char * value, double & frac, bool & automatic);
+
+// host->device bandwidth over `backend`'s stream, in GB/s, from the device's pinned host buffer into `dev_buft`
+// (Strata's probe, with ggml's copies; < 0 when it cannot run)
+double probe_h2d_gbps(ggml_backend_t backend, ggml_backend_buffer_type_t dev_buft);
+
+// ---- the partition (pure) -----------------------------------------------------------------------------------------
+
+struct partition {
+    int32_t n_missed = 0;                          // distinct missed experts of this layer and step
+    std::vector<std::pair<int32_t, int32_t>> share; // (expert, pool slot) for the experts the GPU pool computes
+};
+
+// One layer of one step. ids is [n_used, n_tokens] (byte strides nb0, nb1), table maps expert -> cache slot or
+// `dummy` when uncached. Writes cpu_tbl [n_expert]: the table the CPU mul_mat_id nodes skip by (a value != dummy is
+// skipped), i.e. table, with the pool's experts marked dummy + 1; and pool_ids [n_used * n_tokens]: the pool slot of
+// every position whose expert the pool computes, else pool_slots (the pool's zero slot).
+void partition_step(const int32_t * ids, int64_t n_used, int64_t n_tokens, size_t nb0, size_t nb1,
+                    const int32_t * table, int64_t n_expert, int32_t dummy,
+                    int32_t pcie_num, int32_t pool_slots,
+                    int32_t * cpu_tbl, int32_t * pool_ids, partition & out);
+
+// ---- the copy engine ----------------------------------------------------------------------------------------------
+
+// Enqueues copies into a device tensor and says when they have landed. The real one is a second backend instance on
+// the device (its own CUDA stream) and an event; the tests' is a fake whose copies land only when wait() is called.
+struct copier {
+    virtual ~copier() = default;
+    // dst[dst_offset, dst_offset + size) <- src; may return before the data lands
+    virtual void copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) = 0;
+    // a completion point after every copy enqueued so far; true when something is outstanding
+    virtual bool mark() = 0;
+    // blocks until the last mark()'s point has completed
+    virtual void wait() = 0;
+};
+
+struct backend_copier : copier {
+    ggml_backend_t       backend = nullptr;   // owned: a second instance on the same device
+    ggml_backend_event_t event   = nullptr;   // NULL where the device has none (copies are then synchronous)
+    bool                 pending = false;
+    bool                 enqueued = false;
+
+    explicit backend_copier(ggml_backend_dev_t dev);
+    ~backend_copier() override;
+    void copy(ggml_tensor * dst, const void * src, size_t dst_offset, size_t size) override;
+    bool mark() override;
+    void wait() override;
+};
+
+// ---- the pool and the per-layer state -----------------------------------------------------------------------------
+
+struct pool {
+    // [ne0, ne1, n_slots + 1], the last slot all zeros; the data lives in `buf`
+    ggml_tensor * up   = nullptr;
+    ggml_tensor * gate = nullptr;
+    ggml_tensor * down = nullptr;
+    int32_t       n_slots = 0;
+    ggml_context *        ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    std::unique_ptr<copier> engine;
+
+    pool() = default;
+    pool(const pool &) = delete;
+    pool & operator=(const pool &) = delete;
+    ~pool() {
+        engine.reset();                      // the stream first: nothing may still write into the buffer
+        if (buf) {
+            ggml_backend_buffer_free(buf);
+        }
+        if (ctx) {
+            ggml_free(ctx);
+        }
+    }
+};
+
+struct layer {
+    pool *               shared = nullptr;
+    const ggml_tensor *  up_src   = nullptr;   // the host experts, the authority
+    const ggml_tensor *  gate_src = nullptr;
+    const ggml_tensor *  down_src = nullptr;
+    int32_t              dummy    = 0;         // the cache's "uncached" table value (its slot count)
+    int32_t              pcie_num = 0;
+    bool                 pending  = false;     // copies enqueued by the last plan and not yet waited for
+
+    // counters, read by the cache's hit-rate line
+    std::atomic<uint64_t> n_plans{0};
+    std::atomic<uint64_t> n_missed{0};
+    std::atomic<uint64_t> n_share{0};
+};
+
+// ---- the graph ----------------------------------------------------------------------------------------------------
+
+struct plan_nodes {
+    ggml_tensor * plan    = nullptr;   // I32 [n_expert + n_used * n_tokens]: cpu_tbl, then the pool's slot ids
+    ggml_tensor * cpu_tbl = nullptr;   // view: the CPU mul_mat_id nodes' src[3] (op_params[0] stays the dummy)
+    ggml_tensor * ids_tail = nullptr;  // view: the pool's slot ids, valid once the copies have landed
+};
+
+// The plan node, to be built before the CPU mul_mat_id nodes. ids: the routing [n_used, n_tokens] I32 (the tensor the
+// CPU nodes read); host_table: the cache's host table (its data is read on the CPU).
+plan_nodes build_plan(ggml_context * ctx, layer & L, ggml_tensor * ids, ggml_tensor * host_table);
+
+// The wait node: blocks until the plan's copies have landed, ordered after `cpu_result` (the CPU chain's output),
+// and returns the pool's slot ids [n_used, n_tokens] I32 for the GPU chain. host_table pins it to the CPU backend.
+ggml_tensor * build_wait(ggml_context * ctx, layer & L, const plan_nodes & p, ggml_tensor * cpu_result,
+                         ggml_tensor * host_table, int64_t n_used, int64_t n_tokens);
+
+// The GPU chain over the pool: up and gate mul_mat_id, `act(gate, up)`, then down. x: [n_embd, 1, n_tokens].
+// name(tensor, "up" | "gate" | "down") lets the caller label the nodes.
+ggml_tensor * build_chain(ggml_context * ctx, layer & L, ggml_tensor * x, ggml_tensor * slot_ids,
+                          const std::function<ggml_tensor *(ggml_tensor * gate, ggml_tensor * up)> & act,
+                          const std::function<void(ggml_tensor *, const char *)> & name);
+
+} // namespace moe_pcie
