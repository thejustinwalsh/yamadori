+// ---- the graph -----------------------------------------------------------------------------------------------------
+
+// the copies land only when wait() runs; wait() can be told to drop them (the negative control)
+struct fake_copier : moe_pcie::copier {
+    struct job { ggml_tensor * dst; const void * src; size_t off, size; };
+    std::vector<job> queued;
+    bool drop_wait = false;
+    bool landed_early = false;
+    int  n_waits = 0;
+
+    void copy(ggml_tensor * dst, const void * src, size_t off, size_t size) override {
+        queued.push_back({ dst, src, off, size });
+    }
+    bool mark() override { return !queued.empty(); }
+    void wait() override {
+        ++n_waits;
+        if (drop_wait) {
+            queued.clear();
+            return;
+        }
+        for (const job & j : queued) {
+            // the slot must still be poison here: a copy that landed before the wait would have overwritten it
+            const uint8_t * p = (const uint8_t *) j.dst->data + j.off;
+            if (p[0] != 0xFF || p[j.size - 1] != 0xFF) {
+                landed_early = true;
+            }
+            ggml_backend_tensor_set(j.dst, j.src, j.off, j.size);
+        }
+        queued.clear();
+    }
+};
+
+// On a device: the real copy engine (a second backend instance and an event), able to drop its wait and to HOLD its copies
+// (never enqueue them) -- the negative control: a graph that does not wait for the copies, whose copies have not landed,
+// reads the poisoned slots. The control cannot be made by queueing a backlog on the stream ahead of the real copies: on
+// this card (WDDM) the compute stream's own work waited for it too (a step took ~0.9 s behind 600 x 256 MiB of
+// device-to-device copies on the second stream, whatever the kind of copy), so nothing would have raced.
+struct delayed_copier : moe_pcie::backend_copier {
+    bool delay = false;        // hold the copies
+    bool drop_wait = false;
+
+    delayed_copier(ggml_backend_dev_t dev, ggml_backend_buffer_type_t) : moe_pcie::backend_copier(dev) {}
+    void copy(ggml_tensor * dst, const void * src, size_t off, size_t size) override {
+        if (delay) {
+            return;
+        }
+        moe_pcie::backend_copier::copy(dst, src, off, size);
+    }
+    void wait() override {
+        if (drop_wait) {
+            pending = false;
+            return;
+        }
+        moe_pcie::backend_copier::wait();
+    }
+};
