+static void test_share_rule() {
+    // Strata's rule (generate.cpp @ d9ab843 :1723-1730)
+    CHECK(moe_pcie::num_of_frac(0.0) == 0, "0");
+    CHECK(moe_pcie::num_of_frac(1.0) == 256, "1");
+    CHECK(moe_pcie::num_of_frac(2.0) == 256, "clamped");
+    CHECK(moe_pcie::num_of_frac(0.29) == 74, "0.29 -> 74/256 got %d", moe_pcie::num_of_frac(0.29));
+    CHECK(moe_pcie::num_of_frac(0.55) == 141, "0.55 -> 141/256 got %d", moe_pcie::num_of_frac(0.55));
+    CHECK(moe_pcie::frac_of_bandwidth(26.0, 0.55) == 0.55, "x16: the base");
+    CHECK(moe_pcie::frac_of_bandwidth(20.0, 0.55) == 0.55, "20 GB/s: the base");
+    CHECK(moe_pcie::frac_of_bandwidth(3.9, 0.55) == 0.0, "an x1 link: none");
+    CHECK(std::fabs(moe_pcie::frac_of_bandwidth(14.1, 0.55) - 0.55 * 14.1 / 26.0) < 1e-12, "14.1 GB/s");
+    CHECK(moe_pcie::frac_of_bandwidth(4.0, 0.30) == 0.05, "the floor 0.05 (4 GB/s, base 0.3: 0.3 * 4/26 = 0.046)");
+    CHECK(std::fabs(moe_pcie::frac_of_bandwidth(4.0, 0.55) - 0.55 * 4.0 / 26.0) < 1e-12, "4 GB/s, base 0.55");
+
+    double f = -1;
+    bool a = true;
+    CHECK(!moe_pcie::parse_frac(nullptr, f, a) && f == 0 && !a, "unset is off");
+    CHECK(!moe_pcie::parse_frac("", f, a), "empty is off");
+    CHECK(!moe_pcie::parse_frac("0", f, a), "0 is off");
+    CHECK(!moe_pcie::parse_frac("off", f, a), "off is off");
+    CHECK(!moe_pcie::parse_frac("abc", f, a), "garbage is off");
+    CHECK(!moe_pcie::parse_frac("1.5", f, a), "above 1 is off");
+    CHECK(!moe_pcie::parse_frac("-0.2", f, a), "negative is off");
+    CHECK(moe_pcie::parse_frac("auto", f, a) && a, "auto");
+    CHECK(moe_pcie::parse_frac("0.3", f, a) && !a && f == 0.3, "0.3");
+    CHECK(moe_pcie::parse_frac("1", f, a) && f == 1.0, "1");
+}
