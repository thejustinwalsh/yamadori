+static bool make_world(world & w, std::mt19937 & rng, const char * device) {
+    w.cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    CHECK(w.cpu, "no CPU backend");
+    if (device) {
+        w.dev_h = ggml_backend_dev_by_name(device);
+        if (!w.dev_h) {
+            printf("device %s not found\n", device);
+            return false;
+        }
+        w.dev = ggml_backend_dev_init(w.dev_h, nullptr);
+        w.dev_buft  = ggml_backend_dev_buffer_type(w.dev_h);
+        w.host_buft = ggml_backend_dev_host_buffer_type(w.dev_h);
+        if (!w.host_buft) {
+            w.host_buft = ggml_backend_cpu_buffer_type();
+        }
+    } else {
+        w.dev_buft = w.host_buft = ggml_backend_cpu_buffer_type();
+    }
+
+    // host weights: the model's expert shapes
+    ggml_init_params ip = { ggml_tensor_overhead() * 64, nullptr, true };
+    ggml_context * hctx = ggml_init(ip);
+    w.wctx = hctx;
+    w.W_up   = ggml_new_tensor_3d(hctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, w.n_expert);
+    w.W_gate = ggml_new_tensor_3d(hctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, w.n_expert);
+    w.W_down = ggml_new_tensor_3d(hctx, GGML_TYPE_Q2_0,  w.n_ff, w.n_embd, w.n_expert);
+    ggml_set_name(w.W_up, "ffn_up_exps"); ggml_set_name(w.W_gate, "ffn_gate_exps"); ggml_set_name(w.W_down, "ffn_down_exps");
+    w.cs.slots  = w.cache_slots;
+    w.big.slots = w.cache_slots + w.pool_slots;
+    w.cs.host_table  = ggml_new_tensor_2d(hctx, GGML_TYPE_I32, 1, w.n_expert);
+    w.big.host_table = ggml_new_tensor_2d(hctx, GGML_TYPE_I32, 1, w.n_expert);
+    ggml_backend_buffer_t hb = ggml_backend_alloc_ctx_tensors_from_buft(hctx, w.host_buft);
+    CHECK(hb, "host buffer");
+    w.bufs.push_back(hb);
+    ggml_backend_buffer_set_usage(hb, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    quantize_into(w.W_up,   rng, 0, w.n_expert);
+    quantize_into(w.W_gate, rng, 0, w.n_expert);
+    quantize_into(w.W_down, rng, 0, w.n_expert);
+
+    // the device side: the cache, its table, the pool
+    ggml_context * dctx = ggml_init(ip);
+    for (world::cache_set * c : { &w.cs, &w.big }) {
+        c->up   = ggml_new_tensor_3d(dctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, c->slots + 1);
+        c->gate = ggml_new_tensor_3d(dctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, c->slots + 1);
+        c->down = ggml_new_tensor_3d(dctx, GGML_TYPE_Q2_0,  w.n_ff, w.n_embd, c->slots + 1);
+        c->dev_table = ggml_new_tensor_2d(dctx, GGML_TYPE_I32, 1, w.n_expert);
+    }
+    ggml_backend_buffer_t db = ggml_backend_alloc_ctx_tensors_from_buft(dctx, w.dev_buft);
+    CHECK(db, "device buffer");
+    w.bufs.push_back(db);
+    ggml_backend_buffer_clear(db, 0);
+
+    ggml_context * pctx = ggml_init(ip);
+    w.pool.ctx  = pctx;
+    w.pool.n_slots = w.pool_slots;
+    w.pool.up   = ggml_new_tensor_3d(pctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, w.pool_slots + 1);
+    w.pool.gate = ggml_new_tensor_3d(pctx, GGML_TYPE_IQ2_S, w.n_embd, w.n_ff, w.pool_slots + 1);
+    w.pool.down = ggml_new_tensor_3d(pctx, GGML_TYPE_Q2_0,  w.n_ff, w.n_embd, w.pool_slots + 1);
+    w.pool.buf  = ggml_backend_alloc_ctx_tensors_from_buft(pctx, w.dev_buft);
+    CHECK(w.pool.buf, "pool buffer");
+    if (w.dev) {
+        w.pool.engine = std::make_unique<delayed_copier>(w.dev_h, w.dev_buft);
+    } else {
+        w.pool.engine = std::make_unique<fake_copier>();
+    }
+    // keep the second context for freeing: the pool owns pctx; dctx is leaked on purpose (the process is short)
+    (void) dctx;
+    return true;
+}
+
+// poison every pool slot but the zero slot
+static void poison_pool(world & w) {
+    for (ggml_tensor * t : { w.pool.up, w.pool.gate, w.pool.down }) {
+        std::vector<uint8_t> ff((size_t) w.pool_slots * t->nb[2], 0xFF);
+        ggml_backend_tensor_set(t, ff.data(), 0, ff.size());
+        std::vector<uint8_t> zero(t->nb[2], 0);
+        ggml_backend_tensor_set(t, zero.data(), (size_t) w.pool_slots * t->nb[2], zero.size());
+    }
+}
+
+// a cache: `resident` experts in slots 0.., the rest uncached (the dummy slot = c.slots)
+static void fill_cache(world & w, world::cache_set & c, const std::vector<int32_t> & resident) {
+    c.table.assign((size_t) w.n_expert, c.slots);
+    for (ggml_tensor * t : { c.up, c.gate, c.down }) {
+        std::vector<uint8_t> z((size_t) (c.slots + 1) * t->nb[2], 0);
+        ggml_backend_tensor_set(t, z.data(), 0, z.size());
+    }
+    std::vector<uint8_t> buf;
+    for (size_t sl = 0; sl < resident.size(); ++sl) {
+        const int32_t e = resident[sl];
+        c.table[(size_t) e] = (int32_t) sl;
+        const std::pair<ggml_tensor *, ggml_tensor *> pairs[3] = { { w.W_up, c.up }, { w.W_gate, c.gate }, { w.W_down, c.down } };
+        for (const auto & pr : pairs) {
+            buf.resize(pr.first->nb[2]);
+            ggml_backend_tensor_get(pr.first, buf.data(), (size_t) e * pr.first->nb[2], pr.first->nb[2]);
+            ggml_backend_tensor_set(pr.second, buf.data(), sl * pr.second->nb[2], pr.second->nb[2]);
+        }
+    }
+    ggml_backend_tensor_set(c.host_table, c.table.data(), 0, c.table.size() * sizeof(int32_t));
+    ggml_backend_tensor_set(c.dev_table,  c.table.data(), 0, c.table.size() * sizeof(int32_t));
+}
+
+static int g_pcie_num = 0;   // the share (out of 256) the next step runs with
+
+enum class mode { reference, cache_only, pcie, enlarged };
+
+struct step_result {
+    std::vector<float> out;      // [n_embd, n_used, n_tokens]
+    bool ok = false;
+};
+
+// One layer, one step. `ids` is n_used x n_tokens, optionally read through a strided view.
+static step_result run_step(world & w, ggml_backend_sched_t sched, mode m, const std::vector<int32_t> & ids,
+                            int64_t n_tokens, bool strided, std::mt19937 & rng, ggml_backend_t anchor = nullptr) {
+    const int64_t n_used = w.n_used;
+    ggml_init_params ip = { ggml_tensor_overhead() * 512 + ggml_graph_overhead_custom(2048, false) + (1u << 20), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, 2048, false);
+
+    ggml_tensor * x_in = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, w.n_embd, 1, n_tokens);
+    ggml_set_name(x_in, "x"); ggml_set_input(x_in);
+    ggml_tensor * x = x_in;
+    const int64_t pad = strided ? 3 : 0;
+    ggml_tensor * ids_full = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used + pad, n_tokens);
+    ggml_set_name(ids_full, "ids"); ggml_set_input(ids_full);
+    // In the engine the hidden state and the router's ids are produced on the GPU, and that is what pulls the cache chain
+    // and the pool chain onto it: nodes whose weights are in a plain device buffer are placed by their neighbours. A
+    // graph whose only inputs are graph inputs (which the scheduler puts on the CPU) runs entirely on the CPU, with the
+    // device tensors copied to it at the start of each split -- the pool before its copies have landed. So with a device
+    // the inputs go through a GPU node first, as the router's top-k does (the ids as a view, strided, like the top-k's).
+    std::vector<ggml_tensor *> gpu_nodes;
+    ggml_tensor * ids_src = ids_full;
+    if (anchor) {
+        x = ggml_scale(ctx, x_in, 1.0f);
+        ids_src = ggml_cont(ctx, ids_full);
+        gpu_nodes = { x, ids_src };
+    }
+    ggml_tensor * sel = (strided || anchor) ? ggml_view_2d(ctx, ids_src, n_used, n_tokens, ids_src->nb[1], 0) : ids_src;
+
+    ggml_tensor * res = nullptr;
+    moe_pcie::layer L;
+    if (m == mode::reference) {
+        ggml_tensor * up   = ggml_mul_mat_id(ctx, w.W_up,   x, sel);
+        ggml_tensor * gate = ggml_mul_mat_id(ctx, w.W_gate, x, sel);
+        ggml_tensor * act  = ggml_swiglu_split(ctx, gate, up);
+        res = ggml_mul_mat_id(ctx, w.W_down, act, sel);
+    } else {
+        // `enlarged`: the cache chain over a cache that also holds the pool's experts -- the same kernels on the same rows
+        // as the split, in one chain, so the split must equal it exactly
+        const world::cache_set & c = (m == mode::enlarged) ? w.big : w.cs;
+        L.shared = &w.pool; L.up_src = w.W_up; L.gate_src = w.W_gate; L.down_src = w.W_down;
+        L.dummy = c.slots;
+        L.pcie_num = g_pcie_num;
+
+        moe_pcie::plan_nodes mp;
+        ggml_tensor * skip = c.host_table;
+        if (m == mode::pcie) {
+            mp = moe_pcie::build_plan(ctx, L, sel, c.host_table);
+            skip = mp.cpu_tbl;
+        }
+        // the cache's slot lookup, as llama-graph.cpp: the ids as one flat row
+        ggml_tensor * mc_ids = ggml_is_contiguous(sel) ? sel : ggml_cont(ctx, sel);
+        mc_ids = ggml_reshape_1d(ctx, mc_ids, n_used * n_tokens);
+        ggml_tensor * mc_slot_ids = ggml_get_rows(ctx, c.dev_table, mc_ids);
+        mc_slot_ids = ggml_reshape_2d(ctx, mc_slot_ids, n_used, n_tokens);
+
+        ggml_tensor * up   = ggml_mul_mat_id(ctx, w.W_up,   x, sel);
+        up->src[3] = skip; up->op_params[0] = c.slots;
+        ggml_tensor * gate = ggml_mul_mat_id(ctx, w.W_gate, x, sel);
+        gate->src[3] = skip; gate->op_params[0] = c.slots;
+        ggml_tensor * act  = ggml_swiglu_split(ctx, gate, up);
+        ggml_tensor * experts = ggml_mul_mat_id(ctx, w.W_down, act, sel);
+        experts->src[3] = skip; experts->op_params[0] = c.slots;
+
+        ggml_tensor * pcie_ids = nullptr;
+        if (m == mode::pcie) {
+            ggml_build_forward_expand(gf, experts);
+            pcie_ids = moe_pcie::build_wait(ctx, L, mp, experts, c.host_table, n_used, n_tokens);
+            ggml_build_forward_expand(gf, pcie_ids);
+        }
+        auto act_fn = [&](ggml_tensor * g, ggml_tensor * u) { return ggml_swiglu_split(ctx, g, u); };
+
+        ggml_tensor * up_g   = ggml_mul_mat_id(ctx, c.up,   x, mc_slot_ids);
+        ggml_tensor * gate_g = ggml_mul_mat_id(ctx, c.gate, x, mc_slot_ids);
+        ggml_tensor * act_g  = act_fn(gate_g, up_g);
+        ggml_tensor * down_g = ggml_mul_mat_id(ctx, c.down, act_g, mc_slot_ids);
+        experts = ggml_add(ctx, experts, down_g);
+        if (pcie_ids) {
+            ggml_tensor * pd = moe_pcie::build_chain(ctx, L, x, pcie_ids, act_fn, [](ggml_tensor *, const char *) {});
+            experts = ggml_add(ctx, experts, pd);
+        }
+        res = experts;
+    }
+    if (anchor) {
+        // and the next layer's GPU work consumes the MoE output, which is what pulls the chains' last nodes (the add) back
+        res = ggml_scale(ctx, res, 1.0f);
+        gpu_nodes.push_back(res);
+    }
+    ggml_set_output(res);
+    ggml_build_forward_expand(gf, res);
+
+    step_result r;
+    ggml_backend_sched_reset(sched);
+    for (ggml_tensor * t : gpu_nodes) {
+        ggml_backend_sched_set_tensor_backend(sched, t, anchor);
+    }
+    if (!ggml_backend_sched_alloc_graph(sched, gf)) {
+        printf("graph allocation failed\n");
+        ggml_free(ctx);
+        return r;
+    }
+    std::vector<float> xv((size_t) (w.n_embd * n_tokens));
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    for (float & v : xv) {
+        v = nd(rng);
+    }
+    ggml_backend_tensor_set(x_in, xv.data(), 0, xv.size() * sizeof(float));
+    std::vector<int32_t> padded((size_t) ((n_used + pad) * n_tokens), -1);
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t j = 0; j < n_used; ++j) {
+            padded[(size_t) (t * (n_used + pad) + j)] = ids[(size_t) (t * n_used + j)];
+        }
+    }
+    ggml_backend_tensor_set(ids_full, padded.data(), 0, padded.size() * sizeof(int32_t));
+    const ggml_status st = ggml_backend_sched_graph_compute(sched, gf);
+    r.ok = st == GGML_STATUS_SUCCESS;
+    if (r.ok) {
+        r.out.resize((size_t) ggml_nelements(res));
+        ggml_backend_tensor_get(res, r.out.data(), 0, ggml_nbytes(res));
+    }
+    ggml_free(ctx);
+    return r;
+}
+
+static ggml_backend_sched_t make_sched(world & w) {
+    std::vector<ggml_backend_t> bs;
+    std::vector<ggml_backend_buffer_type_t> bt;
+    if (w.dev) {
+        bs.push_back(w.dev);
+        bt.push_back(w.dev_buft);
+    }
+    bs.push_back(w.cpu);
+    bt.push_back(ggml_backend_get_default_buffer_type(w.cpu));
+    return ggml_backend_sched_new(bs.data(), bt.data(), (int) bs.size(), 2048, false, false);
+}
+
+static void compare(const char * what, const step_result & a, const step_result & b, double rel_tol, double * worst) {
+    CHECK(a.ok && b.ok, "%s: a graph failed", what);
+    if (!a.ok || !b.ok) {
+        return;
+    }
+    double max_ref = 0, max_diff = 0;
+    bool nan = false;
+    for (size_t i = 0; i < a.out.size(); ++i) {
+        if (!std::isfinite(a.out[i]) || !std::isfinite(b.out[i])) {
+            nan = true;
+        }
+        max_ref  = std::max(max_ref, (double) std::fabs(a.out[i]));
+        max_diff = std::max(max_diff, (double) std::fabs(a.out[i] - b.out[i]));
+    }
+    *worst = std::max(*worst, max_ref > 0 ? max_diff / max_ref : max_diff);
+    CHECK(!nan, "%s: a non-finite value (a poisoned slot was read?)", what);
+    CHECK(max_ref > 0 && max_diff <= rel_tol * max_ref, "%s: max |diff| %.3g vs max |ref| %.3g", what, max_diff, max_ref);
+}
+
+static void test_graph(std::mt19937 & rng, const char * device, int64_t n_expert, int trials) {
+    world w;
+    w.n_expert = n_expert;
+    w.cache_slots = (int32_t) std::min<int64_t>(24, n_expert / 2);
+    w.pool_slots = 24;
+    printf("building the weights (%" PRId64 " experts, iq2_s 2560x640 gate/up, q2_0 640x2560 down) ...\n", n_expert);
+    if (!make_world(w, rng, device)) {
+        return;
+    }
+    ggml_backend_sched_t sched = make_sched(w);
+    fake_copier * fake = dynamic_cast<fake_copier *>(w.pool.engine.get());
+    delayed_copier * dcop = dynamic_cast<delayed_copier *>(w.pool.engine.get());
+    auto set_drop = [&](bool drop) {
+        if (fake) { fake->drop_wait = drop; }
+        if (dcop) { dcop->drop_wait = drop; dcop->delay = drop; }
+    };
+
+    // the device arm compares a CPU reference with a graph whose cached and pooled rows run on the GPU's kernels (MMVQ over
+    // q8_1 activations), so they differ by quantisation noise; the exact comparison is against the enlarged cache
+    const double tol_ref = device ? 2e-2 : 1e-5;
+    double worst_off = 0, worst_on = 0, worst_exact = 0;
+    int shared_total = 0, steps_with_share = 0, dropped_detected = 0, dropped_runs = 0;
+    for (int trial = 0; trial < trials; ++trial) {
+        const int64_t n_tokens = 1 + (int64_t) (rng() % 7);
+        const bool strided = (rng() % 2) == 1;
+
+        // residency: k random experts in slots 0..k-1
+        std::vector<int32_t> all((size_t) n_expert);
+        for (int32_t e = 0; e < (int32_t) n_expert; ++e) {
+            all[(size_t) e] = e;
+        }
+        std::shuffle(all.begin(), all.end(), rng);
+        const int k = (int) (rng() % (uint64_t) (w.cache_slots + 1));
+        std::vector<int32_t> resident(all.begin(), all.begin() + k);
+        fill_cache(w, w.cs, resident);
+
+        // routing: top-10 per token from a small popular set half the time, so tokens share experts
+        std::vector<int32_t> ids;
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            std::vector<int32_t> row;
+            while ((int64_t) row.size() < w.n_used) {
+                const int32_t e = (rng() % 2) ? all[(size_t) (rng() % 16)] : (int32_t) (rng() % (uint64_t) n_expert);
+                if (std::find(row.begin(), row.end(), e) == row.end()) {
+                    row.push_back(e);
+                }
+            }
+            ids.insert(ids.end(), row.begin(), row.end());
+        }
+        // the share: Strata's 0.29 and 0.55, the extremes, and none
+        static const int nums[] = { 74, 141, 256, 8, 0 };
+        g_pcie_num = nums[trial % 5];
+
+        // what the pool takes this step (the same arithmetic as the op), and the enlarged cache that holds it
+        moe_pcie::partition part;
+        {
+            std::vector<int32_t> cpu_tbl((size_t) n_expert), pool_ids(ids.size());
+            moe_pcie::partition_step(ids.data(), w.n_used, n_tokens, sizeof(int32_t), (size_t) w.n_used * sizeof(int32_t),
+                    w.cs.table.data(), n_expert, w.cache_slots, g_pcie_num, w.pool_slots, cpu_tbl.data(), pool_ids.data(), part);
+            shared_total += (int) part.share.size();
+            steps_with_share += part.share.empty() ? 0 : 1;
+        }
+        std::vector<int32_t> resident_big = resident;
+        for (const auto & es : part.share) {
+            resident_big.push_back(es.first);
+        }
+        fill_cache(w, w.big, resident_big);
+
+        // the unsplit reference, on the CPU alone with the full weights
+        std::mt19937 rng_x(1234 + trial);
+        std::vector<ggml_backend_t> cpu_only = { w.cpu };
+        std::vector<ggml_backend_buffer_type_t> cpu_buft = { ggml_backend_get_default_buffer_type(w.cpu) };
+        ggml_backend_sched_t ref_sched = ggml_backend_sched_new(cpu_only.data(), cpu_buft.data(), 1, 2048, false, false);
+        step_result ref = run_step(w, ref_sched, mode::reference, ids, n_tokens, strided, rng_x);
+        ggml_backend_sched_free(ref_sched);
+
+        // (a) the engine's graph without pcie_frac
+        std::mt19937 rng_x2(1234 + trial);
+        step_result off = run_step(w, sched, mode::cache_only, ids, n_tokens, strided, rng_x2, w.dev);
+        compare("cache only vs unsplit", ref, off, tol_ref, &worst_off);
+
+        // (b)+(c) with the pool: poisoned first, copies landing only at the wait
+        poison_pool(w);
+        set_drop(false);
+        if (fake) {
+            fake->landed_early = false;
+        }
+        std::mt19937 rng_x3(1234 + trial);
+        step_result on = run_step(w, sched, mode::pcie, ids, n_tokens, strided, rng_x3, w.dev);
+        compare("pcie split vs unsplit", ref, on, tol_ref, &worst_on);
+        std::mt19937 rng_x5(1234 + trial);
+        step_result exact = run_step(w, sched, mode::enlarged, ids, n_tokens, strided, rng_x5, w.dev);
+        compare("pcie split vs the enlarged cache (same kernels, same rows)", exact, on, 1e-6, &worst_exact);
+        if (fake) {
+            CHECK(!fake->landed_early, "a copy landed before the wait node ran (trial %d)", trial);
+            CHECK(fake->queued.empty(), "copies left queued (trial %d)", trial);
+        }
+
+        {
+            // the negative control: drop the wait -- when the pool took anything, the result must NOT match
+            if ((fake || dcop) && !part.share.empty()) {
+                poison_pool(w);
+                set_drop(true);
+                std::mt19937 rng_x4(1234 + trial);
+                step_result bad = run_step(w, sched, mode::pcie, ids, n_tokens, strided, rng_x4, w.dev);
+                set_drop(false);
+                if (dcop) {
+                    ggml_backend_synchronize(dcop->backend);
+                }
+                ++dropped_runs;
+                bool differs = !bad.ok;
+                if (bad.ok) {
+                    for (size_t i = 0; i < bad.out.size() && !differs; ++i) {
+                        if (!std::isfinite(bad.out[i]) || std::fabs(bad.out[i] - exact.out[i]) > 1e-3 * std::fabs(exact.out[i]) + 1e-6) {
+                            differs = true;
+                        }
+                    }
+                }
+                dropped_detected += differs ? 1 : 0;
+            }
+        }
+    }
+    printf("graph: %d trials, worst rel diff against the CPU reference: cache only %.3g, with pool %.3g; against the enlarged cache %.3g; "
+           "the pool took %d experts over %d steps\n", trials, worst_off, worst_on, worst_exact, shared_total, steps_with_share);
+    CHECK(steps_with_share > 0, "no step used the pool: the test did not exercise the split");
+    if (fake || dcop) {
+        CHECK(dropped_runs > 0 && dropped_detected == dropped_runs, "the dropped-wait control was detected in %d of %d runs", dropped_detected, dropped_runs);
+    }
+    ggml_backend_sched_free(sched);
+}
+
+int main(int argc, char ** argv) {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    // Never wake a GPU by accident: the CUDA backend initialises every device it can see the first time ggml's backend
+    // registry is touched. Without --device the test hides them all; with --device the caller must have restricted
+    // CUDA_VISIBLE_DEVICES to the one card it means (bench/a4000_dev.py does for the A4000).
+    bool has_device = false;
+    for (int i = 1; i < argc; ++i) {
+        has_device |= !strcmp(argv[i], "--device");
+    }
+    if (!has_device) {
+#ifdef _WIN32
+        _putenv("CUDA_VISIBLE_DEVICES=-1");
+#else
+        setenv("CUDA_VISIBLE_DEVICES", "-1", 1);
+#endif
+    } else if (!getenv("CUDA_VISIBLE_DEVICES")) {
+        fprintf(stderr, "--device needs CUDA_VISIBLE_DEVICES set to the one GPU to use\n");
+        return 2;
+    }
+    ggml_backend_load_all();
+    int trials = 60;
+    int64_t n_expert = 64;
+    const char * device = nullptr;
+    uint32_t seed = 20261002;
+    bool quick = false;
+    for (int i = 1; i < argc; ++i) {
+        if (!strcmp(argv[i], "--quick")) { quick = true; }
+        else if (!strcmp(argv[i], "--n-expert") && i + 1 < argc) { n_expert = atoll(argv[++i]); }
+        else if (!strcmp(argv[i], "--device") && i + 1 < argc) { device = argv[++i]; }
+        else if (!strcmp(argv[i], "--trials") && i + 1 < argc) { trials = atoi(argv[++i]); }
+        else if (!strcmp(argv[i], "--seed") && i + 1 < argc) { seed = (uint32_t) atoll(argv[++i]); }
+    }
+    if (quick) {
+        trials = std::min(trials, 10);
+        n_expert = std::min<int64_t>(n_expert, 32);
+    }
+    std::mt19937 rng(seed);
+
+    test_share_rule();
+    test_partition(rng, quick ? 500 : 5000);
+    test_graph(rng, device, n_expert, trials);
+
+    printf("%d checks, %d failed\n", n_checks, n_failed);
+    return n_failed ? 1 : 0;
+}
