+struct world {
+    int64_t n_embd = 2560, n_ff = 640, n_expert = 64, n_used = 10;
+    int32_t cache_slots = 24;
+    int32_t pool_slots  = 24;
+
+    ggml_backend_t cpu = nullptr;
+    ggml_backend_t dev = nullptr;                      // null: everything on the CPU
+    ggml_backend_dev_t dev_h = nullptr;
+    ggml_backend_buffer_type_t host_buft = nullptr, dev_buft = nullptr;
+
+    ggml_context * wctx = nullptr;                     // weights, cache, pool, tables
+    std::vector<ggml_backend_buffer_t> bufs;
+    ggml_tensor *W_up, *W_gate, *W_down;
+    struct cache_set {                                 // a device cache [.., slots + 1] (the last slot zero) and its tables
+        ggml_tensor * up = nullptr, * gate = nullptr, * down = nullptr;
+        ggml_tensor * host_table = nullptr, * dev_table = nullptr;   // I32 [1, n_expert]
+        int32_t slots = 0;
+        std::vector<int32_t> table;                    // expert -> slot or `slots`
+    };
+    cache_set cs;                                      // the engine's cache
+    cache_set big;                                     // a cache that holds the cache's experts AND the pool's: the exact reference
+    moe_pcie::pool pool;
+};
+
+static void quantize_into(ggml_tensor * t, std::mt19937 & rng, int64_t first, int64_t count) {
+    // experts [first, first+count) of t [ne0, ne1, n_expert], from random normal floats
+    const int64_t cols = t->ne[0], rows = t->ne[1];
+    std::vector<float> f((size_t) (rows * cols));
+    std::vector<uint8_t> q(ggml_row_size(t->type, cols) * (size_t) rows);
+    std::vector<float> im;
+    if (ggml_quantize_requires_imatrix(t->type)) {
+        im.assign((size_t) (rows * cols), 1.0f);
+    }
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    for (int64_t e = first; e < first + count; ++e) {
+        for (float & v : f) {
+            v = nd(rng);
+        }
+        ggml_quantize_chunk(t->type, f.data(), q.data(), 0, rows, cols, im.empty() ? nullptr : im.data());
+        ggml_backend_tensor_set(t, q.data(), (size_t) e * t->nb[2], q.size());
+    }
+}
