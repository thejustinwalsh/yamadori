+// brute force: what partition_step must give
+static void test_partition(std::mt19937 & rng, int trials) {
+    for (int trial = 0; trial < trials; ++trial) {
+        const int64_t n_expert = 8 + (int64_t) (rng() % 505);
+        const int64_t n_used   = 1 + (int64_t) (rng() % 10);
+        const int64_t n_tokens = 1 + (int64_t) (rng() % 7);
+        const int32_t slots    = 1 + (int32_t) (rng() % 40);      // the cache's slots (the dummy)
+        const int32_t pool     = 1 + (int32_t) (rng() % 24);
+        const int32_t num      = (int32_t) (rng() % 257);
+
+        std::vector<int32_t> table((size_t) n_expert, slots);
+        const int n_res = (int) (rng() % (slots + 1));
+        for (int i = 0; i < n_res; ++i) {
+            table[rng() % (uint64_t) n_expert] = i;             // may collide; any non-dummy value is "resident"
+        }
+        // routing with duplicates across tokens: draw from a small popular set half the time
+        std::vector<int32_t> ids((size_t) (n_used * n_tokens));
+        const size_t stride = (size_t) n_used + (rng() % 3);      // a strided view: nb1 > n_used * 4 sometimes
+        std::vector<int32_t> padded(stride * (size_t) n_tokens, -7);
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            std::vector<int32_t> row;
+            while ((int64_t) row.size() < n_used) {
+                const int32_t e = (rng() % 2) ? (int32_t) (rng() % std::min<int64_t>(n_expert, 14)) : (int32_t) (rng() % (uint64_t) n_expert);
+                if (std::find(row.begin(), row.end(), e) == row.end()) {
+                    row.push_back(e);
+                }
+                if ((int64_t) row.size() < n_used && n_expert <= n_used) {
+                    break;
+                }
+            }
+            for (int64_t j = 0; j < n_used; ++j) {
+                const int32_t e = j < (int64_t) row.size() ? row[(size_t) j] : (int32_t) (rng() % (uint64_t) n_expert);
+                padded[(size_t) t * stride + (size_t) j] = e;
+                ids[(size_t) (t * n_used + j)] = e;
+            }
+        }
+
+        std::vector<int32_t> cpu_tbl((size_t) n_expert), pool_ids((size_t) (n_used * n_tokens));
+        moe_pcie::partition part;
+        moe_pcie::partition_step(padded.data(), n_used, n_tokens, sizeof(int32_t), stride * sizeof(int32_t),
+                table.data(), n_expert, slots, num, pool, cpu_tbl.data(), pool_ids.data(), part);
+
+        // brute force
+        std::vector<int32_t> distinct;
+        for (int32_t e : ids) {
+            if (std::find(distinct.begin(), distinct.end(), e) == distinct.end()) {
+                distinct.push_back(e);
+            }
+        }
+        std::vector<int32_t> missed;
+        for (int32_t e : distinct) {
+            if (table[(size_t) e] == slots) {
+                missed.push_back(e);
+            }
+        }
+        int32_t m = (int32_t) (((int64_t) missed.size() * num) >> 8);
+        m = std::min(m, pool);
+        CHECK(part.n_missed == (int32_t) missed.size(), "n_missed %d vs %zu", part.n_missed, missed.size());
+        CHECK((int32_t) part.share.size() == m, "share %zu vs %d", part.share.size(), m);
+        // the LAST m missed ones in routing order, slots 0.. in that order
+        bool order_ok = true;
+        for (int32_t i = 0; i < m; ++i) {
+            const int32_t e = missed[missed.size() - (size_t) m + (size_t) i];
+            if (part.share[(size_t) i].first != e || part.share[(size_t) i].second != i) {
+                order_ok = false;
+            }
+        }
+        CHECK(order_ok, "the share is not the last m missed experts in routing order");
+
+        // every position is served by exactly one of: the cache (resident), the pool, the CPU
+        bool serve_ok = true, tbl_ok = true;
+        for (int64_t i = 0; i < n_used * n_tokens; ++i) {
+            const int32_t e = ids[(size_t) i];
+            const bool resident = table[(size_t) e] != slots;
+            const bool pooled   = pool_ids[(size_t) i] != pool;
+            const bool cpu      = cpu_tbl[(size_t) e] == slots;     // not skipped by the CPU nodes
+            if ((int) resident + (int) pooled + (int) cpu != 1) {
+                serve_ok = false;
+            }
+            if (pooled) {
+                bool found = false;
+                for (const auto & es : part.share) {
+                    if (es.first == e && es.second == pool_ids[(size_t) i]) {
+                        found = true;
+                    }
+                }
+                if (!found) {
+                    serve_ok = false;
+                }
+            }
+        }
+        for (int64_t e = 0; e < n_expert; ++e) {
+            const bool shared = std::find_if(part.share.begin(), part.share.end(), [&](const auto & es) { return es.first == e; }) != part.share.end();
+            const int32_t want = shared ? slots + 1 : table[(size_t) e];
+            if (cpu_tbl[(size_t) e] != want) {
+                tbl_ok = false;
+            }
+        }
+        CHECK(serve_ok, "an entry is served by none or by several of cache/pool/CPU (trial %d)", trial);
+        CHECK(tbl_ok, "cpu_tbl differs from the cache table + the share (trial %d)", trial);
+    }
+}
