From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Justin Walsh <contact.me@thejustinwalsh.com>
Date: Thu, 1 Oct 2026 09:04:26 -0400
Subject: [PATCH] cuda: mul_mat_id's MMQ pads src1 for the tile width it picks

ggml_cuda_mul_mat_q's mul_mat_id path packs src1 into ne12*n_expert_used
compact rows (one per token slot, sorted by expert) and pads the buffer by
ggml_cuda_mmq_get_J_max(type, fallback, cc, ne11) columns. But the tile
width J is picked by mul_mat_q_switch_J against ncols_opt -- ne12, the
tokens -- up to 128 columns, and the last expert's last tile reads up to
J-1 columns past the compact rows. ne11 is 1 for broadcast activations (the
gate/up experts, quantized once per token and scattered) and n_expert_used
otherwise, so the padding was 0 or 8 columns. On a fresh process the
over-read ran off the end of the CUDA VMM pool's mapped range: "an illegal
memory access" in MUL_MAT_ID (the driver logs Xid 13, MMU NACK). A warm
process has mapped past it and read stale bytes into masked columns.

Found on Qwen3.8-Flash-Next (iq2_s routed experts, 2560 -> 640, 512
experts, top-10) under llama-server with op offload: a fresh server's first
prompt of 1,024 tokens is processed as 512 + 508 + 4 tokens, and the
508-token ubatch faulted in blk.0's ffn_moe_gate on an RTX 5060 Ti, every
time (5 of 5 fresh servers); 1,025 tokens, a warm server, or
--no-op-offload did not. test-backend-ops reproduces it with that shape at
n=508 (and only there in n=440..600 before the fix, below).

The padding now covers the widest tile the switch can pick (MMQ_J_MAX,
128, which the switch loop now names): 18 KiB per call at most. The
regular (non-id) path is unchanged: there J is picked against ne11 itself.

Tests: test-backend-ops MUL_MAT_ID gains the Flash-Next shape at
n=507/508/509; DIAG_QWEN4EXP=a-b sweeps n over a range.
---
 ggml/src/ggml-cuda/mmq.cu  |  7 ++++++-
 ggml/src/ggml-cuda/mmq.cuh |  3 ++-
 tests/test-backend-ops.cpp | 17 +++++++++++++++++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 3e1721bbe686407c1e12b79f5ef9ba6db840fc49..17bf3864d0ee2cafe516da6ae1c6ea32a729454c 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -254,8 +254,13 @@ void ggml_cuda_mul_mat_q(
         CUDA_CHECK(cudaGetLastError());
     }
 
+    // The tile width J is picked by mul_mat_q_switch_J against ncols_opt (ne12, the tokens), not ne11, and the last
+    // expert's last tile reads up to J-1 compact columns past the ne12*n_expert_used rows of src1_q8_1, so the
+    // padding covers the widest tile the switch can pick. Sized by ne11 -- 1 for broadcast activations, n_expert_used
+    // otherwise -- it covered 0 or 8 columns, and the over-read ran off the pool's mapped end on a fresh process:
+    // "an illegal memory access" (iq2_s, 512 experts, top-10, a 508-token ubatch).
     const size_t nbytes_src1_q8_1 = ne12*n_expert_used*ne10_padded * y_block_size/y_values_per_block +
-        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, ne11) * sizeof(block_q8_1_mmq);
+        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, MMQ_J_MAX) * sizeof(block_q8_1_mmq);
     ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), nbytes_src1_q8_1);
     ggml_cuda_pool_alloc<float> src1_scale(ctx.pool());
     if (src0->type == GGML_TYPE_NVFP4 && use_native_fp4) {
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 4b50d1dc333bb3e0293e55e2e3ec07bd20ab2fe3..ac885c487588ee00ad7e7935797c505a06d132e3 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -9,6 +9,7 @@
 #define MMQ_ITER_K             256
 #define MMQ_ITER_K_FP4         512
 #define MMQ_NWARPS               8
+#define MMQ_J_MAX              128 // the widest tile mul_mat_q_switch_J picks (src1 columns per tile)
 
 typedef void (*ggml_cuda_mmq_load_tiles_t)(const char * __restrict__ x, int * x_tile, const int kbx0, const int i_max, const int stride);
 typedef void (*ggml_cuda_mmq_vec_dot_t)(const int * __restrict__ x, const int * __restrict__ y, float * __restrict__ sum, const int k00);
@@ -1491,7 +1492,7 @@ void mul_mat_q_switch_J(ggml_backend_cuda_context & ctx, const mmq_args & args,
     int J_best        = 0;
     int ntiles_J_best = INT_MAX;
 
-    for (int J = 8; J <= 128 && ntiles_J_best > 1; J += 8) {
+    for (int J = 8; J <= MMQ_J_MAX && ntiles_J_best > 1; J += 8) {
         const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc, prec_src1);
         if (config.type == GGML_TYPE_COUNT) {
             continue;
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index e10a153a4087059c70c632b5a07979790d5452c3..4fd2348d4a91386aadcca75c44bb026f7df94caf 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10217,6 +10217,23 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         test_cases.emplace_back(new test_mul_mat_id(type_a, GGML_TYPE_F32, 8, 1, false, 512, 1, 256));
     }
 
+    // mul_mat_id's src1 padding: MMQ picks its tile width against the tokens (ne12), and the last expert's last tile
+    // reads up to J-1 columns past the compact rows. The padding was sized by ne11 (1 for broadcast activations), so the
+    // over-read could run off the pool's mapped end. Qwen3.8-Flash-Next's routed experts (iq2_s, 2560 -> 640, 512
+    // experts, top-10, broadcast): n=508 faulted on a fresh RTX 5060 Ti (a 1,024-token prompt's second ubatch).
+    for (int n : {507, 508, 509}) {
+        test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_IQ2_S, GGML_TYPE_F32, 512, 10, true, 640, n, 2560));
+    }
+    // DIAG_QWEN4EXP=a-b: the same shape over a range of token counts (a sweep, not run by default)
+    if (const char * v = getenv("DIAG_QWEN4EXP")) {
+        int n0 = 0, n1 = -1;
+        if (sscanf(v, "%d-%d", &n0, &n1) == 2) {
+            for (int n = n0; n <= n1; n++) {
+                test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_IQ2_S, GGML_TYPE_F32, 512, 10, true, 640, n, 2560));
+            }
+        }
+    }
+
     for (ggml_type type_a : other_types) {
         for (ggml_type type_b : {GGML_TYPE_F32}) {
             if (ggml_blck_size(type_a) != 256) {
-- 
