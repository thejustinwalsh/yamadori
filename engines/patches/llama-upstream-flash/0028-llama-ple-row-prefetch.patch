diff --git a/src/llama-ple-prefetch.cpp b/src/llama-ple-prefetch.cpp
new file mode 100644
index 000000000..fdd709ba2
--- /dev/null
+++ b/src/llama-ple-prefetch.cpp
@@ -0,0 +1,205 @@
+#include "llama-ple-prefetch.h"
+
+#include "llama-hparams.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+struct llama_ple_prefetch::impl {
+    const llama_model & model;
+    const uint8_t * base      = nullptr;   // the table's mapped data
+    size_t          row_bytes = 0;         // nb[1]: one row (90 bytes for 160 IQ4_NL values)
+    int64_t         n_rows    = 0;
+    int             n_threads = 8;
+    bool            verbose   = false;
+
+    struct job {
+        std::vector<llama_token> toks;     // the predecessors of the first ubatch's end, then the tokens past it
+        uint32_t n_lead   = 0;             // how many of toks are predecessors only
+        uint32_t n_ubatch = 0;
+    };
+
+    std::mutex              m;
+    std::condition_variable cv;
+    bool                    stop    = false;
+    bool                    has_job = false;
+    job                     pending;
+    std::atomic<uint64_t>   gen{0};        // bumped by every submit: a running job stops when it is no longer current
+    std::thread             worker;
+
+    explicit impl(const llama_model & model) : model(model) {}
+
+    void run(const job & j, const uint64_t my_gen) {
+        const auto & hp = model.hparams;
+        const int64_t n_heads = hp.ple_n_heads;
+        const int64_t n_prev  = hp.ple_ngram_size - 1;
+        const size_t  n_tok   = j.toks.size();
+
+        const auto t0 = std::chrono::steady_clock::now();
+        size_t n_read = 0, n_groups = 0;
+
+        // ubatch by ubatch, in the order the decode reaches them; within one, the rows in file order
+        for (size_t g0 = j.n_lead; g0 < n_tok && gen.load() == my_gen; g0 += j.n_ubatch) {
+            const size_t g1 = std::min(n_tok, g0 + j.n_ubatch);
+
+            std::vector<int32_t> rows;
+            rows.reserve((g1 - g0)*n_heads);
+            std::vector<int32_t> out(n_heads);
+            for (size_t i = g0; i < g1; ++i) {
+                llama_token back[LLAMA_MAX_PLE_NGRAM];
+                for (int64_t s = 1; s <= n_prev; ++s) {
+                    back[s - 1] = i >= (size_t) s ? j.toks[i - s] : LLAMA_TOKEN_NULL;
+                }
+                llama_ple_rows(hp, j.toks[i], back, out.data());
+                rows.insert(rows.end(), out.begin(), out.end());
+            }
+            std::sort(rows.begin(), rows.end());
+            rows.erase(std::unique(rows.begin(), rows.end()), rows.end());
+
+            // read the first and the last byte of each row (a row may straddle two pages); the sum is kept so the
+            // reads are not removed
+            std::atomic<size_t> next{0};
+            std::atomic<unsigned> sink{0};
+            auto reader = [&]() {
+                unsigned s = 0;
+                constexpr size_t CHUNK = 64;
+                size_t k;
+                while ((k = next.fetch_add(CHUNK)) < rows.size()) {
+                    if (gen.load(std::memory_order_relaxed) != my_gen) {
+                        break;
+                    }
+                    const size_t k1 = std::min(rows.size(), k + CHUNK);
+                    for (size_t r = k; r < k1; ++r) {
+                        if (rows[r] < 0 || rows[r] >= n_rows) {
+                            continue;
+                        }
+                        const volatile uint8_t * p = base + (size_t) rows[r]*row_bytes;
+                        s += p[0] + p[row_bytes - 1];
+                    }
+                }
+                sink += s;
+            };
+            std::vector<std::thread> th;
+            for (int t = 1; t < n_threads; ++t) {
+                th.emplace_back(reader);
+            }
+            reader();
+            for (auto & t : th) {
+                t.join();
+            }
+            n_read += rows.size();
+            ++n_groups;
+        }
+
+        if (verbose) {
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            LLAMA_LOG_INFO("ple prefetch: %zu ubatches, %zu distinct rows, %.1f ms on %d threads%s\n", n_groups, n_read, ms,
+                           n_threads, gen.load() == my_gen ? "" : " (superseded)");
+        }
+    }
+
+    void loop() {
+        std::unique_lock<std::mutex> lk(m);
+        while (true) {
+            cv.wait(lk, [&] { return stop || has_job; });
+            if (stop) {
+                return;
+            }
+            job j = std::move(pending);
+            has_job = false;
+            const uint64_t my_gen = gen.load();
+            lk.unlock();
+            run(j, my_gen);
+            lk.lock();
+        }
+    }
+};
+
+llama_ple_prefetch::llama_ple_prefetch(std::unique_ptr<impl> p) : pimpl(std::move(p)) {}
+
+std::unique_ptr<llama_ple_prefetch> llama_ple_prefetch::create(const llama_model & model) {
+    const char * e = getenv("LLAMA_PLE_PREFETCH");
+    if (!e || e[0] == '\0' || e[0] == '0') {
+        return nullptr;
+    }
+
+    const ggml_tensor * t = model.per_layer_tok_embd;
+    const auto & hp = model.hparams;
+    if (t == nullptr || t->data == nullptr || t->buffer == nullptr || !ggml_backend_buffer_is_host(t->buffer) ||
+            hp.ple_n_heads == 0) {
+        return nullptr;
+    }
+
+    auto p = std::make_unique<impl>(model);
+    p->base      = (const uint8_t *) t->data;
+    p->row_bytes = t->nb[1];
+    p->n_rows    = t->ne[1];
+    // 8 readers: the measured cold rate of 8,192 random rows of this table is the same at 8 and 16 threads (the
+    // device's, ~35,000 rows/s: ple_bench, n=1 each), so more threads read no faster
+    p->n_threads = 8;
+    if (const char * te = getenv("LLAMA_PLE_PREFETCH_THREADS")) {
+        p->n_threads = std::max(1, atoi(te));
+    } else if (atoi(e) > 1) {
+        p->n_threads = atoi(e);
+    }
+    const char * ve = getenv("LLAMA_PLE_PREFETCH_LOG");
+    p->verbose = ve && ve[0] == '1';
+
+    impl * raw = p.get();
+    raw->worker = std::thread([raw] { raw->loop(); });
+    LLAMA_LOG_INFO("ple prefetch: enabled, %d reader threads, %zu byte rows\n", p->n_threads, p->row_bytes);
+    return std::unique_ptr<llama_ple_prefetch>(new llama_ple_prefetch(std::move(p)));
+}
+
+llama_ple_prefetch::~llama_ple_prefetch() {
+    if (!pimpl) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(pimpl->m);
+        pimpl->stop = true;
+        pimpl->gen++;
+    }
+    pimpl->cv.notify_all();
+    if (pimpl->worker.joinable()) {
+        pimpl->worker.join();
+    }
+}
+
+void llama_ple_prefetch::submit(const llama_batch & batch, uint32_t n_ubatch) {
+    const auto & hp = pimpl->model.hparams;
+    if (batch.token == nullptr || n_ubatch == 0 || batch.n_tokens <= (int32_t) n_ubatch) {
+        return;   // nothing past the first ubatch, or embeddings
+    }
+    // one sequence: the rows of a token depend on the tokens before it in that sequence
+    for (int32_t i = 0; i < batch.n_tokens; ++i) {
+        if (batch.n_seq_id[i] != 1 || batch.seq_id[i][0] != batch.seq_id[0][0]) {
+            return;
+        }
+    }
+
+    impl::job j;
+    const uint32_t n_prev = hp.ple_ngram_size - 1;
+    const uint32_t from   = n_ubatch > n_prev ? n_ubatch - n_prev : 0;
+    j.n_lead   = n_ubatch - from;
+    j.n_ubatch = n_ubatch;
+    j.toks.assign(batch.token + from, batch.token + batch.n_tokens);
+
+    {
+        std::lock_guard<std::mutex> lk(pimpl->m);
+        pimpl->gen++;           // a job still running stops at its next chunk
+        pimpl->pending = std::move(j);
+        pimpl->has_job = true;
+    }
+    pimpl->cv.notify_one();
+}
diff --git a/src/llama-ple-prefetch.h b/src/llama-ple-prefetch.h
new file mode 100644
index 000000000..4e3818e86
--- /dev/null
+++ b/src/llama-ple-prefetch.h
@@ -0,0 +1,35 @@
+#pragma once
+
+// PLE row prefetch (0028): Qwen3.8-Flash-Next reads its per-layer n-gram embeddings (qwen4exp PLE) from a 28.8 GB
+// IQ4_NL table (320M rows of 90 bytes) that is lazily mapped (--lazy-mode): the rows a ubatch hashes to are random
+// pages of the file, cold for any text the stack has not seen, and the CPU gather for a ubatch runs before its graph
+// does, with the GPU idle. This reads the rows of the LATER ubatches of a batch in the background while the earlier
+// ones compute. Off unless LLAMA_PLE_PREFETCH=1 (or N: N reader threads). A hint only: it reads and discards.
+
+#include "llama.h"
+
+#include <cstdint>
+#include <memory>
+
+struct llama_hparams;
+struct llama_model;
+
+// the PLE table rows of one token (one per head); see qwen4exp.cpp
+void llama_ple_rows(const llama_hparams & hp, llama_token tok, const llama_token * back, int32_t * out);
+
+class llama_ple_prefetch {
+public:
+    // nullptr unless the switch is on and the model has a host-mapped PLE table
+    static std::unique_ptr<llama_ple_prefetch> create(const llama_model & model);
+
+    ~llama_ple_prefetch();
+
+    // a decode call's batch: reads the rows of the tokens past the first n_ubatch (one sequence, tokens only);
+    // replaces any earlier job still running
+    void submit(const llama_batch & batch, uint32_t n_ubatch);
+
+private:
+    struct impl;
+    explicit llama_ple_prefetch(std::unique_ptr<impl> p);
+    std::unique_ptr<impl> pimpl;
+};
