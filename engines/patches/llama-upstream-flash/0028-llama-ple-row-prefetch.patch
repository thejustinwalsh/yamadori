@@ -2,6 +2,7 @@
 #include "llama-impl.h"
 #include "llama-memory-hybrid-idx.h"
 #include "llama-memory-recurrent.h"
+#include "llama-ple-prefetch.h"
 
 #include <algorithm>
 #include <cinttypes>
@@ -1359,6 +1360,39 @@ public:
     std::vector<llama_token> prev;
 };
 
+// the PLE table rows of one token (one per head): the n-gram hash of the token and its predecessors, newest first
+// (back[s - 1] is the token s positions back, LLAMA_TOKEN_NULL where there is none). Shared by set_input() and the
+// row prefetch (llama-ple-prefetch.cpp), so both read the same rows.
+void llama_ple_rows(const llama_hparams & hp, llama_token tok, const llama_token * back, int32_t * out) {
+    const int64_t n_gram   = hp.ple_ngram_size;
+    const int64_t per_gram = hp.ple_heads_per_ngram;
+    const int64_t eos      = hp.ple_eos_token_id;
+
+    // an EOS in the window resets everything at or before it
+    // a missing predecessor (before the sequence start, or no cached cell) reads as EOS
+    // the EOS of the token itself does not cut its own context, as in the reference
+    int64_t ctx[LLAMA_MAX_PLE_NGRAM];
+    ctx[0] = tok;
+    bool cut = false;
+    for (int64_t s = 1; s < n_gram; ++s) {
+        const llama_token t = cut ? LLAMA_TOKEN_NULL : back[s - 1];
+        cut = cut || t < 0 || t == eos;
+        ctx[s] = cut ? eos : t;
+    }
+
+    for (int64_t n = 2; n <= n_gram; ++n) {
+        uint64_t mixed = (uint64_t) ctx[0] * hp.ple_layer_multipliers[0];
+        for (int64_t j = 1; j < n; ++j) {
+            mixed ^= (uint64_t) ctx[j] * hp.ple_layer_multipliers[j];
+        }
+        const int64_t base = (n - 2) * per_gram;
+        for (int64_t g = 0; g < per_gram; ++g) {
+            const int64_t h_i = base + g;
+            out[h_i] = (int32_t) (mixed % hp.ple_head_vocab_sizes[h_i] + hp.ple_head_offsets[h_i]);
+        }
+    }
+}
