+// ---------------------------------------------------------------------------
+// Early nudge tests
+//
+// simulate() drives the sampler like a generation loop: at each step it calls
+// apply(); when exactly one logit survives, that forced token is emitted,
+// otherwise the "model" emits its next token. Forced steps do not consume a
+// model token. Tokens: 100 = <think>, 101 = </think>, 102 = budget message,
+// 10 = a newline piece (the boundary), 200..202 = the nudge, 50..54 = filler.
+// ---------------------------------------------------------------------------
+
+static const llama_token NUDGE_MAX_TOKEN = 300;
+
+static std::vector<llama_token> simulate(struct llama_sampler * sampler, const std::vector<llama_token> & model, size_t n_steps) {
+    std::vector<llama_token_data> cur;
+    for (llama_token i = 0; i <= NUDGE_MAX_TOKEN; i++) {
+        cur.emplace_back(llama_token_data{i, 0.0f, 0.0f});
+    }
+
+    std::vector<llama_token> emitted;
+    size_t next_model = 0;
+    for (size_t step = 0; step < n_steps; step++) {
+        for (auto & td : cur) {
+            td.logit = 1.0f;
+        }
+        llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+        llama_sampler_apply(sampler, &cur_p);
+
+        size_t      finite_count = 0;
+        llama_token finite_token = LLAMA_TOKEN_NULL;
+        for (const auto & td : cur) {
+            if (std::isfinite(td.logit)) {
+                finite_count++;
+                finite_token = td.id;
+            }
+        }
+
+        llama_token token;
+        if (finite_count == 1) {
+            token = finite_token;
+        } else {
+            GGML_ASSERT(finite_count == cur.size() && "sampler must either force one token or pass through");
+            if (next_model >= model.size()) {
+                break;
+            }
+            token = model[next_model++];
+        }
+
+        llama_sampler_accept(sampler, token);
+        emitted.push_back(token);
+    }
+    return emitted;
+}
+
+// <think>, then n_think tokens of filler with a newline at every `newline_every`-th
+// thinking token (1-based: tokens 7, 14, ... for 7), then more filler forever.
+static std::vector<llama_token> model_stream(size_t n_think, size_t newline_every, size_t last_newline = SIZE_MAX) {
+    std::vector<llama_token> out = {100};
+    for (size_t n = 1; n <= n_think; n++) {
+        const bool newline = newline_every > 0 && n % newline_every == 0 && n <= last_newline;
+        out.push_back(newline ? 10 : (llama_token) (50 + n % 5));
+    }
+    return out;
+}
+
+static size_t count_subsequence(const std::vector<llama_token> & hay, const std::vector<llama_token> & needle, size_t * first = nullptr) {
+    size_t count = 0;
+    for (size_t i = 0; i + needle.size() <= hay.size(); i++) {
+        if (std::equal(needle.begin(), needle.end(), hay.begin() + i)) {
+            if (count == 0 && first) {
+                *first = i;
+            }
+            count++;
+        }
+    }
+    return count;
+}
+
+static void test_reasoning_budget_nudge() {
+    const std::vector<llama_tokens> start  = {{100}};
+    const std::vector<llama_tokens> end    = {{101}};
+    const llama_tokens              forced = {102, 101};
+    const llama_tokens              nudge_tokens = {200, 201, 202};
+    const int32_t                   budget = 100;
+
+    common_reasoning_budget_nudge nudge;
+    nudge.tokens          = nudge_tokens;
+    nudge.at              = 0.8f;
+    nudge.min_room        = 8;
+    nudge.boundary_tokens = {10};
+
+    const auto model = model_stream(400, 7);
+
+    // baseline: no nudge argument at all (the pre-nudge call)
+    std::vector<llama_token> baseline;
+    {
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE);
+        baseline = simulate(s, model, 150);
+        llama_sampler_free(s);
+
+        // the hard stop: exactly `budget` thinking tokens, then message + end tag
+        GGML_ASSERT(baseline[0] == 100);
+        GGML_ASSERT(baseline[1 + budget] == 102 && baseline[2 + budget] == 101);
+        GGML_ASSERT(count_subsequence(baseline, nudge_tokens) == 0);
+    }
+
+    // 1. off by default: an empty nudge (other fields set) gives the identical sequence
+    {
+        common_reasoning_budget_nudge off = nudge;
+        off.tokens.clear();
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, off);
+        GGML_ASSERT(simulate(s, model, 150) == baseline && "an empty nudge must not change the sequence");
+        llama_sampler_free(s);
+
+        auto * s2 = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, common_reasoning_budget_nudge{});
+        GGML_ASSERT(simulate(s2, model, 150) == baseline && "a default nudge must not change the sequence");
+        llama_sampler_free(s2);
+
+        // an unlimited budget (INT_MAX, as sampling.cpp passes it) never nudges
+        auto * s3 = common_reasoning_budget_init(nullptr, start, end, forced, INT_MAX, REASONING_BUDGET_IDLE, nudge);
+        const auto out3 = simulate(s3, model, 150);
+        GGML_ASSERT(count_subsequence(out3, nudge_tokens) == 0 && "an unlimited budget must not nudge");
+        llama_sampler_free(s3);
+    }
+
+    // 2. fires once, at the first boundary at or after 80% of the budget; returns
+    //    to COUNTING; the hard stop still fires after, with the nudge counted
+    {
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+
+        std::vector<llama_token> out;
+        bool saw_nudging = false;
+        bool saw_counting_after = false;
+        {
+            // step manually so the states can be observed
+            std::vector<llama_token_data> cur;
+            for (llama_token i = 0; i <= NUDGE_MAX_TOKEN; i++) {
+                cur.emplace_back(llama_token_data{i, 0.0f, 0.0f});
+            }
+            size_t next_model = 0;
+            for (size_t step = 0; step < 150; step++) {
+                for (auto & td : cur) { td.logit = 1.0f; }
+                llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+                llama_sampler_apply(s, &cur_p);
+                size_t finite_count = 0;
+                llama_token finite_token = LLAMA_TOKEN_NULL;
+                for (const auto & td : cur) {
+                    if (std::isfinite(td.logit)) { finite_count++; finite_token = td.id; }
+                }
+                const llama_token token = finite_count == 1 ? finite_token : model[next_model++];
+                llama_sampler_accept(s, token);
+                out.push_back(token);
+
+                const auto state = common_reasoning_budget_get_state(s);
+                if (state == REASONING_BUDGET_NUDGING) {
+                    saw_nudging = true;
+                } else if (saw_nudging && state == REASONING_BUDGET_COUNTING) {
+                    saw_counting_after = true;
+                }
+            }
+        }
+        llama_sampler_free(s);
+
+        size_t at = SIZE_MAX;
+        GGML_ASSERT(count_subsequence(out, nudge_tokens, &at) == 1 && "the nudge must fire exactly once");
+        // thinking tokens 7, 14, ..., 77, 84 are newlines; 80% of 100 = 80, so the
+        // boundary is thinking token 84 (out[84]) and the nudge starts at out[85]
+        GGML_ASSERT(at == 85);
+        GGML_ASSERT(out[at - 1] == 10 && "the nudge follows a boundary token");
+        for (size_t i = 1; i < at - 1; i++) {
+            GGML_ASSERT(!(out[i] == 10 && i >= 80) && "no earlier boundary at or after 80% was skipped");
+        }
+        GGML_ASSERT(saw_nudging && saw_counting_after && "NUDGING must return to COUNTING");
+        // the model resumes right after the nudge (thinking token 85 of the model stream)
+        GGML_ASSERT(out[at + nudge_tokens.size()] == model[85]);
+        // the nudge counts against the budget: the hard stop still lands after
+        // exactly `budget` thinking tokens (nudge included)
+        GGML_ASSERT(out[1 + budget] == 102 && out[2 + budget] == 101);
+        GGML_ASSERT(count_subsequence(out, forced) == 1);
+    }
+
+    // 3. natural end before 80% = no nudge, no forcing
+    {
+        auto natural = model_stream(50, 7);
+        natural.push_back(101);            // </think> after 50 thinking tokens
+        for (int i = 0; i < 100; i++) {
+            natural.push_back(i % 2 ? 10 : 60); // answer text, with newlines
+        }
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+        const auto out = simulate(s, natural, 200);
+        GGML_ASSERT(out == natural && "a natural end before 80% must leave the sequence untouched");
+        GGML_ASSERT(common_reasoning_budget_get_state(s) == REASONING_BUDGET_DONE);
+        llama_sampler_free(s);
+    }
+
+    // 4. no boundary between 80% and the hard stop: the hard stop wins, no nudge
+    {
+        const auto no_late_newline = model_stream(400, 7, 77);
+        auto * s0 = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE);
+        const auto expected = simulate(s0, no_late_newline, 150);
+        llama_sampler_free(s0);
+
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+        const auto out = simulate(s, no_late_newline, 150);
+        llama_sampler_free(s);
+        GGML_ASSERT(out == expected && "without a boundary the nudge must not fire");
+        GGML_ASSERT(out[1 + budget] == 102);
+    }
+
+    // 5. a boundary too close to the hard stop (fewer than nudge + min_room left): abandoned
+    {
+        // newlines only at thinking token 95 (5 tokens remain < 3 + 8)
+        auto late = model_stream(400, 0);
+        late[95] = 10;
+        auto * s0 = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE);
+        const auto expected = simulate(s0, late, 150);
+        llama_sampler_free(s0);
+
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+        const auto out = simulate(s, late, 150);
+        llama_sampler_free(s);
+        GGML_ASSERT(out == expected && "a nudge with no room left must be abandoned");
+    }
+
+    // 6. init guard: budget - at x budget < nudge + min_room (default 64) disables it
+    {
+        common_reasoning_budget_nudge tight = nudge;
+        tight.min_room = 64; // 100 - 80 = 20 < 3 + 64
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, tight);
+        GGML_ASSERT(simulate(s, model, 150) == baseline && "the init guard must disable a nudge with no room");
+        llama_sampler_free(s);
+
+        // with room (budget 1000: 200 left >= 3 + 64) it fires, once
+        auto * s2 = common_reasoning_budget_init(nullptr, start, end, forced, 1000, REASONING_BUDGET_IDLE, tight);
+        const auto out2 = simulate(s2, model_stream(1200, 7), 1100);
+        llama_sampler_free(s2);
+        size_t at2 = SIZE_MAX;
+        GGML_ASSERT(count_subsequence(out2, nudge_tokens, &at2) == 1);
+        GGML_ASSERT(at2 == 806); // the first newline at or after 800 is thinking token 805 (7 x 115), so the nudge starts at out[806]
+    }
+
+    // 7. at most once per generation: a second reasoning block does not nudge
+    //    again; reset() re-arms it
+    {
+        std::vector<llama_token> two_blocks = model_stream(90, 7); // nudge fires after token 84
+        two_blocks.push_back(101);                                 // natural end
+        for (size_t n = 1; n <= 150; n++) {
+            two_blocks.push_back(n == 1 ? 100 : (n % 7 == 0 ? 10 : 55)); // second <think> block
+        }
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+        const auto out = simulate(s, two_blocks, 300);
+        GGML_ASSERT(count_subsequence(out, nudge_tokens) == 1 && "the nudge fires at most once per generation");
+        GGML_ASSERT(count_subsequence(out, forced) == 1 && "the second block still gets its hard stop");
+
+        llama_sampler_reset(s);
+        const auto out_again = simulate(s, model, 150);
+        GGML_ASSERT(count_subsequence(out_again, nudge_tokens) == 1 && "reset() re-arms the nudge");
+        llama_sampler_free(s);
+    }
+
+    // 8. clone mid-nudge keeps the nudge position; force() from NUDGING goes to FORCING
+    {
+        auto * s = common_reasoning_budget_init(nullptr, start, end, forced, budget, REASONING_BUDGET_IDLE, nudge);
+        for (size_t i = 0; i <= 84; i++) {
+            llama_sampler_accept(s, model[i]); // <think> + 84 thinking tokens, the last a boundary
+        }
+        GGML_ASSERT(common_reasoning_budget_get_state(s) == REASONING_BUDGET_NUDGING);
+        GGML_ASSERT(get_forced_token(s, NUDGE_MAX_TOKEN) == 200);
+        llama_sampler_accept(s, 200);
+
+        auto * clone = llama_sampler_clone(s);
+        GGML_ASSERT(get_forced_token(clone, NUDGE_MAX_TOKEN) == 201 && "cloned nudging state lost its position");
+
+        GGML_ASSERT(common_reasoning_budget_force(clone) && "force() should succeed from NUDGING");
+        GGML_ASSERT(common_reasoning_budget_get_state(clone) == REASONING_BUDGET_FORCING);
+        GGML_ASSERT(get_forced_token(clone, NUDGE_MAX_TOKEN) == 102);
+
+        llama_sampler_free(clone);
+        llama_sampler_free(s);
+    }
+
+    fprintf(stderr, "  Test 'early nudge' passed\n");
+}
