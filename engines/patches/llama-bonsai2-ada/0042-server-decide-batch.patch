+    ms.add_kv(LLM_KV_FEED_FORWARD_LENGTH,       n_ff);
+    ms.add_kv(LLM_KV_USE_PARALLEL_RESIDUAL,     false);
+    ms.add_kv(LLM_KV_LOGIT_SCALE,               1.0f);
