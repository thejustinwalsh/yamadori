+    // exchange the full state of cells i and j (either may be empty); the caller exchanges their K/V rows. The
+    // (sequence, position) pairs in the cache do not change, only the cells they live in
+    void swap_cells(uint32_t i, uint32_t j) {
+        assert(i < pos.size() && j < pos.size() && i != j);
+
+        const bool ui = pos[i] != -1;
+        const bool uj = pos[j] != -1;
+
+        if (ui) { seq_blk_upd(i, -1); }
+        if (uj) { seq_blk_upd(j, -1); }
+
+        std::swap(pos  [i], pos  [j]);
+        std::swap(ext  [i], ext  [j]);
+        std::swap(shift[i], shift[j]);
+        std::swap(seq  [i], seq  [j]);
+
+        if (uj) { seq_blk_upd(i, +1); }
+        if (ui) { seq_blk_upd(j, +1); }
+
+        if (ui != uj) {
+            used.erase (ui ? i : j);
+            used.insert(ui ? j : i);
+
+            free_lo = std::min(free_lo, ui ? i : j);
+        }
+    }
