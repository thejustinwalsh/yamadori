+    // cells are counted per sequence in blocks of SPAN_BLK, so the cells a sequence spans are known without a scan
+    static constexpr uint32_t SPAN_BLK = 256;
+
+    // one past the highest cell that holds seq_id, rounded up to a whole block (0 if the sequence holds no cell):
+    // an attention op for this sequence has to span the cells below it, and none above it
+    uint32_t seq_span_p1(llama_seq_id seq_id) const {
+        assert(seq_id >= 0 && seq_id < LLAMA_MAX_SEQ);
+
+        const uint16_t * c = seq_blk.data() + (size_t) seq_id*n_blk;
+        for (uint32_t b = n_blk; b-- > 0;) {
+            if (c[b]) {
+                return std::min<uint32_t>((b + 1)*SPAN_BLK, size());
+            }
+        }
+
+        return 0;
+    }
