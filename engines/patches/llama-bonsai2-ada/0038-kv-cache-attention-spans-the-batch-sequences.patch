+    // no cell below this index is empty (a hint; lowest_free() advances it)
+    mutable uint32_t free_lo = 0;
+
+    // helper functions for updating `seq_pos`, `seq_blk` and `seq_n`, once cell at a time:
+
+    void seq_pos_dec(llama_seq_id s, uint32_t i) {
+        auto it = seq_pos[s].find(pos[i]);
         assert(it != seq_pos[s].end());
 
         if (--it->second == 0) {
             seq_pos[s].erase(it);
         }
+
+        if (!seq_blk.empty()) {
+            seq_blk[(size_t) s*n_blk + i/SPAN_BLK]--;
+        }
+        seq_n[s]--;
