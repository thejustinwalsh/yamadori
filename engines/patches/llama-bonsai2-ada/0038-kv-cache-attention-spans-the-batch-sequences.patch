+    // the lowest empty cell (size() if none); amortized O(1): every cell that becomes empty lowers the hint
+    uint32_t lowest_free() const {
+        while (free_lo < pos.size() && pos[free_lo] != -1) {
+            free_lo++;
+        }
+
+        return free_lo;
