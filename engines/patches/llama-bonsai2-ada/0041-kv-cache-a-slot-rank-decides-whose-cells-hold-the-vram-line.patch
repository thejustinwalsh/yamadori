+void llama_kv_cache::seq_set_rank(llama_seq_id seq_id, int32_t rank, bool active) {
+    if (seq_id < 0 || seq_id >= LLAMA_MAX_SEQ) {
+        return;
+    }
+
+    seq_rank[seq_id] = rank;
+    seq_told.set(seq_id);
+    seq_active.set(seq_id, active);
+}
+
+bool llama_kv_cache::running(llama_seq_id s) const {
+    // told (seq_set_rank): whether it is being decoded. Never told: in one of the last n_seq_max batches (a draft
+    // context decodes each slot on its own, so a sequence absent from this batch may still be running)
+    if (ranked && seq_told.test(s)) {
+        return seq_active.test(s);
+    }
+    return seq_last_batch[s] > 0 && n_batches - seq_last_batch[s] < n_seq_max;
+}
