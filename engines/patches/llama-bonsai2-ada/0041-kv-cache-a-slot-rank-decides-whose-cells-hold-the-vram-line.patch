index 4c36bae1..e8559529 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -822,6 +822,14 @@ extern "C" {
     // exceeds --kv-vram-cells
     LLAMA_API uint32_t llama_memory_seq_span_p1(llama_memory_t mem, llama_seq_id seq_id);
 
+    // A sequence's KV rank for a tiered cache (--kv-vram-cells). Before a batch whose span would pass the VRAM
+    // line, cells move so that the batch's highest-ranked sequences hold the cells below it: a sequence of a
+    // higher rank keeps its cells (running or idle), one of the same rank keeps them while it is active, and a
+    // lower rank moves out first. rank: higher keeps VRAM (default 0). active: the sequence is being decoded
+    // (a server slot with a task). A sequence never told is active while it was in one of the last n_seq_max
+    // batches. No effect on a cache that is not tiered
+    LLAMA_API void llama_memory_seq_set_rank(llama_memory_t mem, llama_seq_id seq_id, int32_t rank, bool active);
+
     // Check if the memory supports shifting
     LLAMA_API bool llama_memory_can_shift(llama_memory_t mem);
 
