+void llama_kv_cache::set_next_batch(const std::vector<llama_seq_id> & seq_ids, uint32_t n_tokens, uint32_t n_ubatch) {
+    next_seq_ids  = seq_ids;
+    next_n_tokens = n_tokens;
+    next_n_ubatch = n_ubatch;
+}
+
+void llama_kv_cache::plan_moves() {
+    pending = {};
+
+    if (next_seq_ids.empty()) {
+        return;
+    }
+
+    const std::vector<llama_seq_id> seq_ids = std::move(next_seq_ids);
+    next_seq_ids.clear();
+
+    n_batches++;
+    for (const llama_seq_id s : seq_ids) {
+        if (s >= 0 && s < LLAMA_MAX_SEQ) {
+            seq_last_batch[s] = n_batches;
+        }
+    }
+
+    if (!promote) {
+        return;
+    }
+
+    const auto & cells = v_cells[0];
+    const uint32_t size = cells.size();
+
+    // S: the batch's sequences. P: sequences that were in one of the last n_seq_max batches but not in this one --
+    // they are running too (a draft context decodes each slot on its own), so their cells stay where they are
+    std::bitset<LLAMA_MAX_SEQ> in_s;
+    std::bitset<LLAMA_MAX_SEQ> in_p;
+
+    uint32_t span0 = 0;
+    uint64_t n_s   = 0;
+    uint64_t n_p   = 0;
+    std::string seqs;
+    for (const llama_seq_id s : seq_ids) {
+        if (s < 0 || s >= LLAMA_MAX_SEQ) {
+            return;
+        }
+        in_s.set(s);
+        span0 = std::max(span0, cells.seq_span_p1(s));
+        n_s  += cells.seq_n_cells(s);
+        seqs += (seqs.empty() ? "" : ",") + std::to_string(s);
+    }
+    for (uint32_t s = 0; s < std::min<uint32_t>(n_seq_max, LLAMA_MAX_SEQ); ++s) {
+        if (!in_s.test(s) && seq_last_batch[s] > 0 && n_batches - seq_last_batch[s] < n_seq_max) {
+            in_p.set(s);
+            n_p += cells.seq_n_cells(s);
+        }
+    }
+
+    // where the batch's span ends without a move: its highest cell, or the new cells placed from the lowest
+    // free cell. The least it could be: every cell of S and P below it, and room for this batch's new cells
+    // (at least a ubatch, so that the moves are made once per ubatch of new cells, not once per token)
+    const uint64_t room  = std::max(next_n_tokens, next_n_ubatch);
+    const uint32_t v0    = std::max<uint32_t>(span0, (uint32_t) std::min<uint64_t>(size, (uint64_t) cells.lowest_free() + next_n_tokens));
+    const uint64_t ideal = std::min<uint64_t>(size, n_s + n_p + room);
+
+    const uint32_t blk = llama_kv_cells::SPAN_BLK;
+    if (GGML_PAD(v0, blk) <= GGML_PAD(ideal, blk)) {
+        return;
+    }
+
+    // the one moment a move pays: the batch's span would reach past the tiered cache's VRAM line, so every step
+    // would stage the cells above it over PCIe. Below the line (and in a cache that is not tiered) the cells stay
+    // where they are: a move there saves only masked VRAM reads, and changes the order the attention op reads
+    // the cells in, and with it the rounding of its sums
+    if (n_line == 0 || v0 <= n_line) {
+        return;
+    }
+
+    // the full plan: one pass over the cells
+    enum { C_E, C_S, C_P, C_X };
+    auto kind = [&](uint32_t i) {
+        if (cells.is_empty(i))       return C_E;
+        if (cells.seq_any(i, in_s))  return C_S;
+        if (cells.seq_any(i, in_p))  return C_P;
+        return C_X;
+    };
+
+    uint64_t n_s_cells = 0;
+    for (uint32_t i = 0; i < size; ++i) {
+        n_s_cells += kind(i) == C_S;
+    }
+
+    // R: the lowest K cells that are not P's; the batch's cells belong there
+    const uint64_t K = std::min<uint64_t>(size, n_s_cells + room);
+    uint32_t r_end = size;
+    {
+        uint64_t cnt = 0;
+        for (uint32_t i = 0; i < size; ++i) {
+            if (kind(i) != C_P && ++cnt == K) {
+                r_end = i + 1;
+                break;
+            }
+        }
+    }
+    if (GGML_PAD(r_end, blk) >= GGML_PAD(v0, blk)) {
+        return;
+    }
+
+    std::vector<uint32_t> s_out; // S cells above R, highest first
+    std::vector<uint32_t> x_in;  // cells of idle sequences inside R, lowest first
+    std::vector<uint32_t> e_in;  // empty cells inside R, lowest first
+    std::vector<uint32_t> e_out; // empty cells above R, lowest first
+    for (uint32_t i = 0; i < size; ++i) {
+        const int c = kind(i);
+        if (i < r_end) {
+            if (c == C_X) { x_in.push_back(i); }
+            if (c == C_E) { e_in.push_back(i); }
+        } else {
+            if (c == C_S) { s_out.push_back(i); }
+            if (c == C_E) { e_out.push_back(i); }
+        }
+    }
+    std::reverse(s_out.begin(), s_out.end());
+
+    move_plan plan;
+    size_t ie = 0;
+    size_t ix = 0;
+    for (const uint32_t s : s_out) {
+        if (ie < e_in.size()) {
+            plan.pairs.emplace_back(s, e_in[ie++]);
+            plan.n_moved++;
+        } else if (ix < x_in.size()) {
+            plan.pairs.emplace_back(s, x_in[ix++]);
+            plan.n_swapped++;
+        } else {
+            break;
+        }
+    }
+    // the rest of R's idle cells make room for the batch's new cells: out to the lowest empty cells above R --
+    // just past the batch's new span, never parked at the top of the pool (where an idle sequence's own span
+    // would reach deep into the host tier when it runs again)
+    for (size_t io = 0; ix < x_in.size() && io < e_out.size(); ) {
+        plan.pairs.emplace_back(x_in[ix++], e_out[io++]);
+        plan.n_evicted++;
+    }
+
+    if (plan.pairs.empty()) {
+        return;
+    }
+
+    plan.n_ubatch    = std::max<uint32_t>(1, next_n_ubatch);
+    plan.n_seq_cells = (uint32_t) n_s_cells;
+    plan.span_before = GGML_PAD(v0, blk);
+    plan.span_after  = GGML_PAD(r_end, blk);
+    plan.seqs        = seqs;
+
+    pending = std::move(plan);
+}
