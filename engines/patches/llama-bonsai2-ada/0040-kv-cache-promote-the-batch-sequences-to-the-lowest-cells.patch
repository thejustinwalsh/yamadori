+// the row indices of one chunk of a move: dst[i] <- src[i], a gather of every src row before any dst row is written
+class llm_graph_input_kv_move : public llm_graph_input_i {
+public:
+    llm_graph_input_kv_move() = default;
+    virtual ~llm_graph_input_kv_move() = default;
+
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_UNUSED(ubatch);
+
+        for (size_t i = 0; i < t_src.size(); ++i) {
+            ggml_backend_tensor_set(t_src[i], v_src[i].data(), 0, v_src[i].size()*sizeof(int32_t));
+            ggml_backend_tensor_set(t_dst[i], v_dst[i].data(), 0, v_dst[i].size()*sizeof(int64_t));
+        }
+    }
+
+    std::vector<ggml_tensor *> t_src; // I32 [n]
+    std::vector<ggml_tensor *> t_dst; // I64 [n]
+
+    std::vector<std::vector<int32_t>> v_src;
+    std::vector<std::vector<int64_t>> v_dst;
+};
+
+bool llama_kv_cache::apply_moves(llama_context * lctx) {
+    move_plan plan = std::move(pending);
+    pending = {};
+
+    auto & cells = v_cells[0];
+
+    llama_synchronize(lctx);
+    const int64_t t_start_us = ggml_time_us();
+
+    // every K and V tensor, gathered and scattered as rows of 32-bit words: the bytes move, never a value
+    std::vector<ggml_tensor *> tensors;
+    for (const auto & layer : layers) {
+        for (ggml_tensor * t : { layer.k, layer.v }) {
+            if (t) {
+                tensors.push_back(t);
+            }
+        }
+    }
+
+    // rows of a pair: its first cell to its second, and the second back when it is in use
+    auto rows_of = [&](const std::pair<uint32_t, uint32_t> & p, std::vector<int32_t> & src, std::vector<int64_t> & dst) {
+        src.push_back((int32_t) p.first);
+        dst.push_back((int64_t) p.second);
+        if (!cells.is_empty(p.second)) {
+            src.push_back((int32_t) p.second);
+            dst.push_back((int64_t) p.first);
+        }
+    };
+
+    // verification: the bytes of a few moved rows of the first tensor, read before and after
+    struct probe { uint32_t from, to; std::vector<uint8_t> bytes; };
+    std::vector<probe> probes;
+    if (promote_verify && !tensors.empty()) {
+        ggml_tensor * t = tensors[0];
+        for (size_t i = 0; i < plan.pairs.size() && probes.size() < 16; i += std::max<size_t>(1, plan.pairs.size()/8)) {
+            const auto & p = plan.pairs[i];
+            probe pr = { p.first, p.second, std::vector<uint8_t>(t->nb[1]) };
+            ggml_backend_tensor_get(t, pr.bytes.data(), (size_t) p.first*t->nb[1], t->nb[1]);
+            probes.push_back(std::move(pr));
+            if (!cells.is_empty(p.second)) {
+                probe pb = { p.second, p.first, std::vector<uint8_t>(t->nb[1]) };
+                ggml_backend_tensor_get(t, pb.bytes.data(), (size_t) p.second*t->nb[1], t->nb[1]);
+                probes.push_back(std::move(pb));
+            }
+        }
+    }
+
+    auto * sched = lctx->get_sched();
+
+    // chunks of at most one ubatch of rows: a chunk's gathered rows are no larger than one F32 activation of
+    // a ubatch's graph, which the reserved compute buffer already holds. A chunk never splits a pair
+    size_t ip = 0;
+    size_t n_rows = 0;
+    int n_graphs = 0;
+    while (ip < plan.pairs.size()) {
+        ggml_backend_sched_reset(sched);
+
+        auto * res = lctx->get_gf_res_reserve();
+        res->reset();
+
+        auto * ctx = res->get_ctx();
+        auto * gf  = res->get_gf();
+
+        std::vector<ggml_tensor *> raws;
+        for (ggml_tensor * t : tensors) {
+            ggml_tensor * r = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, t->nb[1]/4, t->ne[1]);
+            r->data   = t->data;
+            r->buffer = t->buffer;
+            ggml_format_name(r, "kv_move_%s", t->name);
+            raws.push_back(r);
+        }
+
+        auto inp = std::make_unique<llm_graph_input_kv_move>();
+
+        const size_t ip0 = ip;
+        while (ip < plan.pairs.size() &&
+               ggml_graph_n_nodes(gf) + 4*(int) raws.size() + 8 < ggml_graph_size(gf)/2) {
+            std::vector<int32_t> src;
+            std::vector<int64_t> dst;
+            while (ip < plan.pairs.size() && src.size() + 2 <= std::max<uint32_t>(2, plan.n_ubatch)) {
+                rows_of(plan.pairs[ip++], src, dst);
+            }
+
+            ggml_tensor * t_src = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, (int64_t) src.size());
+            ggml_tensor * t_dst = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, (int64_t) dst.size());
+            ggml_set_input(t_src);
+            ggml_set_input(t_dst);
+
+            for (ggml_tensor * r : raws) {
+                ggml_build_forward_expand(gf, ggml_set_rows(ctx, r, ggml_get_rows(ctx, r, t_src), t_dst));
+            }
+
+            n_rows += src.size();
+
+            inp->t_src.push_back(t_src);
+            inp->t_dst.push_back(t_dst);
+            inp->v_src.push_back(std::move(src));
+            inp->v_dst.push_back(std::move(dst));
+        }
+
+        res->add_input(std::move(inp));
+
+        if (!ggml_backend_sched_alloc_graph(sched, gf)) {
+            LLAMA_LOG_ERROR("%s: failed to allocate the graph that moves KV cells; %zu of %zu pairs moved\n",
+                    __func__, ip0, plan.pairs.size());
+            return ip0 > 0;
+        }
+
+        res->set_inputs(nullptr);
+
+        if (lctx->graph_compute(gf, false) != GGML_STATUS_SUCCESS) {
+            GGML_ABORT("%s: failed to compute the graph that moves KV cells", __func__);
+        }
+
+        // the cells' state follows the rows it describes
+        for (size_t i = ip0; i < ip; ++i) {
+            cells.swap_cells(plan.pairs[i].first, plan.pairs[i].second);
+        }
+
+        n_graphs++;
+    }
+
+    llama_synchronize(lctx);
+    const double ms = (ggml_time_us() - t_start_us)/1000.0;
+
+    size_t row_bytes = 0;
+    for (ggml_tensor * t : tensors) {
+        row_bytes += t->nb[1];
+    }
+
+    LLAMA_LOG_INFO("%s: kv promote: seqs %s: %u cells, span %u -> %u%s: %u moved, %u exchanged with idle cells, "
+            "%u idle cells moved out; %zu rows (%.1f MiB) in %d graph(s), %.1f ms\n", __func__,
+            plan.seqs.c_str(), plan.n_seq_cells, plan.span_before, plan.span_after,
+            n_line ? (" (VRAM line " + std::to_string(n_line) + ")").c_str() : "",
+            plan.n_moved, plan.n_swapped, plan.n_evicted, n_rows, n_rows*row_bytes/1048576.0, n_graphs, ms);
+
+    if (!probes.empty()) {
+        ggml_tensor * t = tensors[0];
+        int bad = 0;
+        std::vector<uint8_t> got(t->nb[1]);
+        for (const auto & pr : probes) {
+            ggml_backend_tensor_get(t, got.data(), (size_t) pr.to*t->nb[1], t->nb[1]);
+            bad += memcmp(got.data(), pr.bytes.data(), t->nb[1]) != 0;
+        }
+        if (bad) {
+            LLAMA_LOG_ERROR("%s: kv promote verify: %d of %zu moved rows of %s differ from their source\n", __func__, bad, probes.size(), t->name);
+        } else {
+            LLAMA_LOG_INFO("%s: kv promote verify: %zu moved rows of %s byte-identical to their source\n", __func__, probes.size(), t->name);
+        }
+    }
+
+    return true;
+}
