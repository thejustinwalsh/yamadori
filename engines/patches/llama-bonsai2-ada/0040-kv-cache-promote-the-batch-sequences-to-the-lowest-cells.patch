+    // env: LLAMA_KV_PROMOTE (0 = cells never move). Tiered caches only: before a batch whose span would pass the
+    // VRAM line, the cells of its sequences move to the lowest cells of the pool, and cells of sequences no recent
+    // batch used move out of the way (to the lowest empty cells above them).
+    // LLAMA_KV_PROMOTE_VERIFY=1 reads moved rows back and compares their bytes
+    bool promote        = false;
+    bool promote_verify = false;
+
+    // the sequences of the next batch (set_next_batch), and when each sequence was last in a batch
+    std::vector<llama_seq_id> next_seq_ids;
+    uint32_t next_n_tokens = 0;
+    uint32_t next_n_ubatch = 0;
+    uint64_t n_batches     = 0;
+    std::vector<uint64_t> seq_last_batch;
+
+    struct move_plan {
+        // cells to exchange; the first of each pair is in use, the second is empty or in use
+        std::vector<std::pair<uint32_t, uint32_t>> pairs;
+
+        uint32_t n_ubatch     = 0;
+        uint32_t n_seq_cells  = 0; // cells of the batch's sequences
+        uint32_t span_before  = 0; // the batch's span (with its new cells) without the moves
+        uint32_t span_after   = 0; // ... after them
+        uint32_t n_moved      = 0; // cells of the batch's sequences moved into empty cells
+        uint32_t n_swapped    = 0; // ... exchanged with a cell of an idle sequence
+        uint32_t n_evicted    = 0; // cells of idle sequences moved out of the batch's span into empty cells
+        std::string seqs;
+    };
+
+    move_plan pending;
+
+    // plan the moves for the sequences set by set_next_batch (cheap unless something can be gained)
+    void plan_moves();
+
+    // move the K/V rows of the planned pairs (a gather and a scatter per layer, on the backends that hold them)
+    // and then the cells' state
+    bool apply_moves(llama_context * lctx);
+
     // the tiered-KV line (--kv-vram-cells, cells [0, n_line) in VRAM); 0 when the cache is not tiered
     uint32_t n_line = 0;
 
