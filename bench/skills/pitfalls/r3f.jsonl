// THE r3f PITFALL CASES (react-three-fiber v10 + three.js; bench/skills/pitfall_harness.py, rules bench/skills/pitfall_rules/r3f.py). Operator, 2026-09-30: "Yes to everything pending, queue it up lets go". Each quote is VERBATIM from the pinned docs, pmndrs/react-three-fiber at 27df622f4990778db05fbca0b77ad5a61165169a (the tag v10.0.0-alpha.5, the held @react-three/fiber): docs/advanced/pitfalls.mdx (Performance pitfalls), docs/migration/v10.mdx, docs/webgpu/overview.mdx, saved under pitfalls/sources/react-three-fiber@27df622f4990/ with their sha256 (MANIFEST.json); MIT (the repository's one LICENSE). Prompts never name the good pattern (never_in_prompt); their wording, scene numbers (counts, speeds, colours) and the `examples` are ours, written for this harness -- UNMEASURED.
{"id": "r3f-setstate-in-frame-loop", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `Orbiter({ speed }: { speed: number })`: a small sphere circling the origin. Its angle advances by `speed` radians per second and its position is (cos(angle) * 3, 0, sin(angle) * 3). Also write `App`, which renders two orbiters (speeds 1 and 2.5) in a Canvas with an ambient light.", "never_in_prompt": ["useRef", ".current", "mutate", "mutation"], "pitfall": ["r3f_setstate_in_frame_loop"], "good": ["r3f_mutates_in_frame"], "skills": [{"name": "r3f-useframe-1", "match": ["mutates refs"]}, {"name": "r3f-reconciler-15", "match": ["sanctioned fast path"]}], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "file": "react-three-fiber@27df622f4990/advanced__pitfalls.mdx", "quote": "You might be tempted to setState inside `useFrame` but there is no reason to.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useState } from 'react';\nimport { Canvas, useFrame } from '@react-three/fiber';\nexport function Orbiter({ speed }: { speed: number }) {\n  const [angle, setAngle] = useState(0);\n  useFrame((_, delta) => setAngle((a) => a + speed * delta));\n  return (\n    <mesh position={[Math.cos(angle) * 3, 0, Math.sin(angle) * 3]}>\n      <sphereGeometry args={[0.3, 16, 16]} />\n      <meshStandardMaterial color=\"orange\" />\n    </mesh>\n  );\n}\nexport default function App() {\n  return (\n    <Canvas>\n      <ambientLight />\n      <Orbiter speed={1} />\n      <Orbiter speed={2.5} />\n    </Canvas>\n  );\n}", "good": "import { useRef } from 'react';\nimport * as THREE from 'three';\nimport { Canvas, useFrame } from '@react-three/fiber';\nexport function Orbiter({ speed }: { speed: number }) {\n  const mesh = useRef<THREE.Mesh>(null!);\n  const angle = useRef(0);\n  useFrame((_, delta) => {\n    angle.current += speed * delta;\n    mesh.current.position.set(Math.cos(angle.current) * 3, 0, Math.sin(angle.current) * 3);\n  });\n  return (\n    <mesh ref={mesh}>\n      <sphereGeometry args={[0.3, 16, 16]} />\n      <meshStandardMaterial color=\"orange\" />\n    </mesh>\n  );\n}\nexport default function App() {\n  return (\n    <Canvas>\n      <ambientLight />\n      <Orbiter speed={1} />\n      <Orbiter speed={2.5} />\n    </Canvas>\n  );\n}"}}
{"id": "r3f-alloc-in-frame-loop", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `CameraRig({ target }: { target: [number, number, number] })`, rendered inside the Canvas, that every frame eases the default camera's position 10% of the way toward `target` and keeps the camera looking at the origin. It renders nothing itself.", "never_in_prompt": ["useMemo", "reuse", "re-use", "allocat", "garbage", ".set("], "pitfall": ["r3f_alloc_in_frame"], "good": ["r3f_frame_no_alloc"], "skills": ["r3f-frame-reuse-objects"], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "file": "react-three-fiber@27df622f4990/advanced__pitfalls.mdx", "quote": "Set up re-used objects in global or local space, now the GC will be silent.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import * as THREE from 'three';\nimport { useFrame } from '@react-three/fiber';\nexport function CameraRig({ target }: { target: [number, number, number] }) {\n  useFrame(({ camera }) => {\n    camera.position.lerp(new THREE.Vector3(...target), 0.1);\n    camera.lookAt(0, 0, 0);\n  });\n  return null;\n}", "good": "import * as THREE from 'three';\nimport { useFrame } from '@react-three/fiber';\nconst goal = new THREE.Vector3();\nexport function CameraRig({ target }: { target: [number, number, number] }) {\n  useFrame(({ camera }) => {\n    camera.position.lerp(goal.set(...target), 0.1);\n    camera.lookAt(0, 0, 0);\n  });\n  return null;\n}"}}
{"id": "r3f-many-meshes", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `CubeField({ count = 2000 }: { count?: number })` that scatters `count` identical 0.5-unit cubes at random positions inside a 50-unit box, each with a random rotation, all in the same orange standard material. Positions are generated once. Also write `App` rendering it in a Canvas with an ambient and a directional light.", "never_in_prompt": ["instanc", "Instance", "Merged", "useMemo", "share", "draw call"], "pitfall": ["r3f_mesh_per_item"], "good": ["r3f_instanced_or_shared"], "skills": [{"name": "r3f-resources-16", "match": ["hoist it"]}, "r3f-many-objects-instancing"], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "file": "react-three-fiber@27df622f4990/advanced__pitfalls.mdx", "quote": "as much as you can when you need to display many objects of a similar type!", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useState } from 'react';\nimport { Canvas } from '@react-three/fiber';\ntype V3 = [number, number, number];\nconst rnd = () => (Math.random() - 0.5) * 50;\nfunction Cube({ position, rotation }: { position: V3; rotation: V3 }) {\n  return (\n    <mesh position={position} rotation={rotation}>\n      <boxGeometry args={[0.5, 0.5, 0.5]} />\n      <meshStandardMaterial color=\"orange\" />\n    </mesh>\n  );\n}\nexport function CubeField({ count = 2000 }: { count?: number }) {\n  const [cubes] = useState(() => Array.from({ length: count }, () => ({\n    position: [rnd(), rnd(), rnd()] as V3,\n    rotation: [Math.random() * Math.PI, Math.random() * Math.PI, 0] as V3,\n  })));\n  return <>{cubes.map((c, i) => <Cube key={i} position={c.position} rotation={c.rotation} />)}</>;\n}\nexport default function App() {\n  return (\n    <Canvas>\n      <ambientLight />\n      <directionalLight position={[5, 5, 5]} />\n      <CubeField />\n    </Canvas>\n  );\n}", "good": "import { useLayoutEffect, useRef } from 'react';\nimport * as THREE from 'three';\nimport { Canvas } from '@react-three/fiber';\nconst rnd = () => (Math.random() - 0.5) * 50;\nexport function CubeField({ count = 2000 }: { count?: number }) {\n  const ref = useRef<THREE.InstancedMesh>(null!);\n  useLayoutEffect(() => {\n    const o = new THREE.Object3D();\n    for (let i = 0; i < count; i++) {\n      o.position.set(rnd(), rnd(), rnd());\n      o.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);\n      o.updateMatrix();\n      ref.current.setMatrixAt(i, o.matrix);\n    }\n    ref.current.instanceMatrix.needsUpdate = true;\n  }, [count]);\n  return (\n    <instancedMesh ref={ref} args={[undefined, undefined, count]}>\n      <boxGeometry args={[0.5, 0.5, 0.5]} />\n      <meshStandardMaterial color=\"orange\" />\n    </instancedMesh>\n  );\n}\nexport default function App() {\n  return (\n    <Canvas>\n      <ambientLight />\n      <directionalLight position={[5, 5, 5]} />\n      <CubeField />\n    </Canvas>\n  );\n}"}}
{"id": "r3f-plain-loader", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `Planet({ url, radius, position }: { url: string; radius: number; position: [number, number, number] })` that draws a sphere wrapped in the image at `url`. Then write `SolarSystem`, which renders eight planets that all use '/textures/rock.jpg' at different sizes and positions inside a Canvas.", "never_in_prompt": ["useLoader", "useTexture", "cache", "Suspense"], "pitfall": ["r3f_plain_loader"], "good": ["r3f_uses_loader_hook"], "skills": [{"name": "r3f-useloader", "match": ["useLoader suspends", "Signature is useLoader"]}], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/advanced/pitfalls.mdx", "file": "react-three-fiber@27df622f4990/advanced__pitfalls.mdx", "quote": "Instead use useLoader, which caches assets and makes them available throughout the scene.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nimport * as THREE from 'three';\nexport function Planet({ url, radius, position }: { url: string; radius: number; position: [number, number, number] }) {\n  const [map, setMap] = useState<THREE.Texture | null>(null);\n  useEffect(() => {\n    new THREE.TextureLoader().load(url, setMap);\n  }, [url]);\n  if (!map) return null;\n  return (\n    <mesh position={position}>\n      <sphereGeometry args={[radius, 32, 32]} />\n      <meshStandardMaterial map={map} />\n    </mesh>\n  );\n}", "good": "import { Suspense } from 'react';\nimport { TextureLoader } from 'three';\nimport { Canvas, useLoader } from '@react-three/fiber';\nexport function Planet({ url, radius, position }: { url: string; radius: number; position: [number, number, number] }) {\n  const map = useLoader(TextureLoader, url);\n  return (\n    <mesh position={position}>\n      <sphereGeometry args={[radius, 32, 32]} />\n      <meshStandardMaterial map={map} />\n    </mesh>\n  );\n}\nexport function SolarSystem() {\n  return (\n    <Canvas>\n      <ambientLight />\n      <Suspense fallback={null}>\n        {[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (\n          <Planet key={i} url=\"/textures/rock.jpg\" radius={0.2 * i} position={[i * 3, 0, 0]} />\n        ))}\n      </Suspense>\n    </Canvas>\n  );\n}"}}
{"id": "r3f-v10-frame-clock", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `Bobber` -- a teal box whose y position is sin(t) * 0.5, where t is the number of seconds since the scene started, and which also spins slowly about y. Render it in a Canvas in `App`.", "never_in_prompt": ["elapsed", "FrameState"], "pitfall": ["r3f_v10_frame_clock"], "good": ["r3f_v10_frame_elapsed"], "skills": ["r3f-v10-frame-timing"], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "file": "react-three-fiber@27df622f4990/migration__v10.mdx", "quote": "The `state.clock` (THREE.Clock) has been removed from FrameState. Timing information is now provided directly from the RAF timer, which is more accurate and consistent.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useRef } from 'react';\nimport * as THREE from 'three';\nimport { useFrame } from '@react-three/fiber';\nexport function Bobber() {\n  const ref = useRef<THREE.Mesh>(null!);\n  useFrame((state, delta) => {\n    ref.current.position.y = Math.sin(state.clock.getElapsedTime()) * 0.5;\n    ref.current.rotation.y += delta * 0.3;\n  });\n  return (\n    <mesh ref={ref}>\n      <boxGeometry />\n      <meshStandardMaterial color=\"teal\" />\n    </mesh>\n  );\n}", "good": "import { useRef } from 'react';\nimport * as THREE from 'three';\nimport { useFrame } from '@react-three/fiber';\nexport function Bobber() {\n  const ref = useRef<THREE.Mesh>(null!);\n  useFrame(({ elapsed, delta }) => {\n    ref.current.position.y = Math.sin(elapsed) * 0.5;\n    ref.current.rotation.y += delta * 0.3;\n  });\n  return (\n    <mesh ref={ref}>\n      <boxGeometry />\n      <meshStandardMaterial color=\"teal\" />\n    </mesh>\n  );\n}"}}
{"id": "r3f-v10-state-gl", "area": "r3f", "kind": "pitfall", "prompt": "Write a React Three Fiber v10 TypeScript component `SnapshotOnKey` that you place inside the `<Canvas>`: when the user presses the 'p' key it draws the current frame and downloads it as `frame.png` (via the canvas element's toDataURL). It renders nothing itself and removes its key listener on unmount.", "never_in_prompt": ["renderer", "Renderer"], "pitfall": ["r3f_v10_state_gl"], "good": ["r3f_v10_state_renderer"], "skills": [{"name": "r3f-shader-uniforms-17", "match": ["state.gl to state.renderer"]}], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "file": "react-three-fiber@27df622f4990/migration__v10.mdx", "quote": "The `gl` property in state has been renamed to `renderer` to be renderer-agnostic and match Three.js conventions.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useEffect } from 'react';\nimport { useThree } from '@react-three/fiber';\nexport function SnapshotOnKey() {\n  const { gl, scene, camera } = useThree();\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.key !== 'p') return;\n      gl.render(scene, camera);\n      const a = document.createElement('a');\n      a.href = gl.domElement.toDataURL('image/png');\n      a.download = 'frame.png';\n      a.click();\n    };\n    window.addEventListener('keydown', onKey);\n    return () => window.removeEventListener('keydown', onKey);\n  }, [gl, scene, camera]);\n  return null;\n}", "good": "import { useEffect } from 'react';\nimport { useThree } from '@react-three/fiber';\nexport function SnapshotOnKey() {\n  const { renderer, scene, camera } = useThree();\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.key !== 'p') return;\n      renderer.render(scene, camera);\n      const a = document.createElement('a');\n      a.href = renderer.domElement.toDataURL('image/png');\n      a.download = 'frame.png';\n      a.click();\n    };\n    window.addEventListener('keydown', onKey);\n    return () => window.removeEventListener('keydown', onKey);\n  }, [renderer, scene, camera]);\n  return null;\n}"}}
{"id": "r3f-v10-canvas-background", "area": "r3f", "kind": "pitfall", "prompt": "Write `App.tsx` for a React Three Fiber v10 TypeScript scene: the whole 3D view is filled with the solid colour #1a1a2e behind the objects, and it shows a slowly rotating torus knot lit by an ambient light and a directional light.", "never_in_prompt": ["background"], "pitfall": ["r3f_color_attach_background"], "good": ["r3f_v10_canvas_background"], "skills": [{"name": "r3f-background-6", "match": ["deprecates <color"]}], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/migration/v10.mdx", "file": "react-three-fiber@27df622f4990/migration__v10.mdx", "quote": "The pattern of using `<color attach=\"background\">` to set the scene background is deprecated in favor of the new `background` prop on Canvas.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "import { useRef } from 'react';\nimport * as THREE from 'three';\nimport { Canvas, useFrame } from '@react-three/fiber';\nfunction Knot() {\n  const ref = useRef<THREE.Mesh>(null!);\n  useFrame((_, delta) => { ref.current.rotation.y += delta * 0.4; });\n  return (\n    <mesh ref={ref}>\n      <torusKnotGeometry args={[1, 0.3, 128, 16]} />\n      <meshStandardMaterial color=\"hotpink\" />\n    </mesh>\n  );\n}\nexport default function App() {\n  return (\n    <Canvas>\n      <color attach=\"background\" args={['#1a1a2e']} />\n      <ambientLight intensity={0.4} />\n      <directionalLight position={[3, 3, 3]} />\n      <Knot />\n    </Canvas>\n  );\n}", "good": "import { useRef } from 'react';\nimport * as THREE from 'three';\nimport { Canvas, useFrame } from '@react-three/fiber';\nfunction Knot() {\n  const ref = useRef<THREE.Mesh>(null!);\n  useFrame((_, delta) => { ref.current.rotation.y += delta * 0.4; });\n  return (\n    <mesh ref={ref}>\n      <torusKnotGeometry args={[1, 0.3, 128, 16]} />\n      <meshStandardMaterial color=\"hotpink\" />\n    </mesh>\n  );\n}\nexport default function App() {\n  return (\n    <Canvas background=\"#1a1a2e\">\n      <ambientLight intensity={0.4} />\n      <directionalLight position={[3, 3, 3]} />\n      <Knot />\n    </Canvas>\n  );\n}"}}
{"id": "r3f-v10-webgpu-setup", "area": "r3f", "kind": "setup", "prompt": "Set up a new Vite + React 19 + TypeScript project with React Three Fiber v10 and three.js that draws a sphere on three's WebGPU backend, with a node material whose colour pulses over time, built with TSL (`three/tsl`). Give package.json, vite.config.ts and src/App.tsx.", "never_in_prompt": ["renderer", "Renderer", "@react-three/fiber/webgpu", "0.185"], "pitfall": ["r3f_v9_webgpu_gl_factory", "r3f_v10_deps_too_old"], "good": ["r3f_v10_canvas_renderer", "r3f_v10_webgpu_entry", "r3f_v10_deps"], "skills": ["r3f-v10-webgpu-canvas", {"name": "r3f-peer-deps-13", "match": ["Peer floors differ"]}, {"name": "r3f-drei-pairing-8", "match": ["v10 ships three entries"]}], "packages": ["@react-three/fiber", "three", "react"], "source": {"url": "https://github.com/pmndrs/react-three-fiber/blob/27df622f4990778db05fbca0b77ad5a61165169a/docs/webgpu/overview.mdx", "raw": "https://raw.githubusercontent.com/pmndrs/react-three-fiber/27df622f4990778db05fbca0b77ad5a61165169a/docs/webgpu/overview.mdx", "file": "react-three-fiber@27df622f4990/webgpu__overview.mdx", "quote": "Opt into WebGPU by adding the `renderer` prop to `Canvas`. No manual renderer initialization is required - R3F handles it.", "licence": "MIT (pmndrs/react-three-fiber LICENSE at 27df622 = tag v10.0.0-alpha.5; docs/ carries no separate licence)"}, "examples": {"pitfall": "package.json\n```json\n{\n  \"name\": \"r3f-webgpu\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"dev\": \"vite\", \"build\": \"tsc -b && vite build\" },\n  \"dependencies\": {\n    \"@react-three/fiber\": \"^9.1.0\",\n    \"react\": \"^19.1.0\",\n    \"react-dom\": \"^19.1.0\",\n    \"three\": \"^0.176.0\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^19.1.0\",\n    \"@types/react-dom\": \"^19.1.0\",\n    \"@types/three\": \"^0.176.0\",\n    \"@vitejs/plugin-react\": \"^4.4.1\",\n    \"typescript\": \"~5.8.3\",\n    \"vite\": \"^6.3.5\"\n  }\n}\n```\n\nvite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react()] });\n```\n\nsrc/App.tsx\n```tsx\nimport * as THREE from 'three/webgpu';\nimport { color, sin, time, mix } from 'three/tsl';\nimport { Canvas, extend, type ThreeToJSXElements } from '@react-three/fiber';\n\ndeclare module '@react-three/fiber' {\n  interface ThreeElements extends ThreeToJSXElements<typeof THREE> {}\n}\nextend(THREE as any);\n\nfunction Sphere() {\n  const colorNode = mix(color('#ff4060'), color('#4060ff'), sin(time).mul(0.5).add(0.5));\n  return (\n    <mesh>\n      <sphereGeometry args={[1, 64, 64]} />\n      <meshStandardNodeMaterial colorNode={colorNode} />\n    </mesh>\n  );\n}\n\nexport default function App() {\n  return (\n    <Canvas\n      gl={async (props) => {\n        const renderer = new THREE.WebGPURenderer(props as any);\n        await renderer.init();\n        return renderer;\n      }}\n    >\n      <ambientLight />\n      <directionalLight position={[3, 3, 3]} />\n      <Sphere />\n    </Canvas>\n  );\n}\n```", "good": "package.json\n```json\n{\n  \"name\": \"r3f-webgpu\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"dev\": \"vite\", \"build\": \"tsc -b && vite build\" },\n  \"dependencies\": {\n    \"@react-three/fiber\": \"10.0.0-alpha.5\",\n    \"react\": \"~19.2.0\",\n    \"react-dom\": \"~19.2.0\",\n    \"three\": \"^0.186.0\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^19.2.0\",\n    \"@types/react-dom\": \"^19.2.0\",\n    \"@types/three\": \"^0.186.0\",\n    \"@vitejs/plugin-react\": \"^5.0.0\",\n    \"typescript\": \"~5.9.0\",\n    \"vite\": \"^7.0.0\"\n  }\n}\n```\n\nvite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react()] });\n```\n\nsrc/App.tsx\n```tsx\nimport { color, sin, time, mix } from 'three/tsl';\nimport { Canvas } from '@react-three/fiber/webgpu';\n\nfunction Sphere() {\n  const colorNode = mix(color('#ff4060'), color('#4060ff'), sin(time).mul(0.5).add(0.5));\n  return (\n    <mesh>\n      <sphereGeometry args={[1, 64, 64]} />\n      <meshStandardNodeMaterial colorNode={colorNode} />\n    </mesh>\n  );\n}\n\nexport default function App() {\n  return (\n    <Canvas renderer>\n      <ambientLight />\n      <directionalLight position={[3, 3, 3]} />\n      <Sphere />\n    </Canvas>\n  );\n}\n```"}}
