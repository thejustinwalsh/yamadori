// THE REACT PITFALL CASES (bench/skills/pitfall_harness.py). Operator, 2026-09-29: "the react docs site is the best use of something like this". Each quote is VERBATIM from react.dev (the recipe corpus's `evidence`, bench/recipes/react_dev_*.jsonl, fetched from github.com/reactjs/react.dev main); CC BY 4.0 (react.dev's LICENSE-DOCS.md; the repository carries no separate code licence). Prompts never name the good pattern. `examples` are the rules' own test (--self-test), written for this harness.
{"id": "react-effect-event-latest-callback", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript hook `useChatRoom(roomId: string, onMessage: (text: string) => void)`. It connects with `createConnection(roomId)` (from './chat', returns `{ connect(): void; disconnect(): void; on(event: 'message', cb: (text: string) => void): void }`) when the room changes and disconnects on cleanup. Parents pass a new inline `onMessage` arrow on every render, and the hook must NOT reconnect when only `onMessage` changes, but it must always call the latest `onMessage`.", "pitfall": ["latest_ref_or_suppressed"], "good": ["uses_effect_event"], "skills": ["react-dev-use-effect-event-useeffectevent-1", "react-dev-blog-react-19-2-useeffectevent"], "packages": ["react"], "source": {"url": "https://react.dev/learn/separating-events-from-effects", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/separating-events-from-effects.md", "quote": "Use a special Hook called [`useEffectEvent`](/reference/react/useEffectEvent) to extract this non-reactive logic out of your Effect:", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useRef } from 'react';\nimport { createConnection } from './chat';\nexport function useChatRoom(roomId: string, onMessage: (t: string) => void) {\n  const cb = useRef(onMessage);\n  useEffect(() => { cb.current = onMessage; });\n  useEffect(() => {\n    const c = createConnection(roomId);\n    c.on('message', (t) => cb.current(t));\n    c.connect();\n    return () => c.disconnect();\n  }, [roomId]);\n}", "good": "import { useEffect, useEffectEvent } from 'react';\nimport { createConnection } from './chat';\nexport function useChatRoom(roomId: string, onMessage: (t: string) => void) {\n  const onMsg = useEffectEvent((t: string) => onMessage(t));\n  useEffect(() => {\n    const c = createConnection(roomId);\n    c.on('message', (t) => onMsg(t));\n    c.connect();\n    return () => c.disconnect();\n  }, [roomId]);\n}"}}
{"id": "react-effect-event-analytics", "area": "react", "kind": "pitfall", "prompt": "In a React 19 TypeScript app, write a `Page({ url, cartItemCount }: { url: string; cartItemCount: number })` component that calls `logVisit(url, cartItemCount)` (from './analytics') once each time `url` changes. Changing `cartItemCount` alone must not log a visit, but each logged visit must include the current cart count. Keep the linter's exhaustive-deps rule satisfied.", "pitfall": ["latest_ref_or_suppressed"], "good": ["uses_effect_event"], "skills": ["react-dev-learn-separating-events-from-effects-useeffectevent-1", "react-dev-blog-react-19-2-useeffectevent"], "packages": ["react"], "source": {"url": "https://react.dev/learn/separating-events-from-effects", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/separating-events-from-effects.md", "quote": "The code inside it isn't reactive. This is why you can use `numberOfItems` (or any other reactive value!) without worrying that it will cause the surrounding code to re-execute on changes.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect } from 'react';\nimport { logVisit } from './analytics';\nexport function Page({ url, cartItemCount }: { url: string; cartItemCount: number }) {\n  useEffect(() => {\n    logVisit(url, cartItemCount);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [url]);\n  return null;\n}", "good": "import { useEffect, useEffectEvent } from 'react';\nimport { logVisit } from './analytics';\nexport function Page({ url, cartItemCount }: { url: string; cartItemCount: number }) {\n  const onVisit = useEffectEvent((visited: string) => logVisit(visited, cartItemCount));\n  useEffect(() => { onVisit(url); }, [url]);\n  return null;\n}"}}
{"id": "react-derived-state-effect", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript component `TodoList({ todos, filter }: { todos: Todo[]; filter: 'all' | 'active' | 'done' })` (type Todo = { id: string; text: string; done: boolean }) that renders the todos matching the filter as a list, and shows how many are visible. Keep the visible list in sync whenever `todos` or `filter` change.", "pitfall": ["effect_only_sets_state"], "good": ["no_effect"], "skills": [{"name": "react-dev-learn-you-might-not-need-an-effect-avoid-unnecessary-e", "match": ["Transform all data at the top level", "useMemo instead of useEffect"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/you-might-not-need-an-effect", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/you-might-not-need-an-effect.md", "quote": "To avoid the unnecessary render passes, transform all the data at the top level of your components. That code will automatically re-run whenever your props or state change.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\ntype Todo = { id: string; text: string; done: boolean };\nexport function TodoList({ todos, filter }: { todos: Todo[]; filter: 'all' | 'active' | 'done' }) {\n  const [visible, setVisible] = useState<Todo[]>([]);\n  useEffect(() => {\n    setVisible(todos.filter(t => filter === 'all' || (filter === 'done') === t.done));\n  }, [todos, filter]);\n  return <ul>{visible.map(t => <li key={t.id}>{t.text}</li>)}</ul>;\n}", "good": "type Todo = { id: string; text: string; done: boolean };\nexport function TodoList({ todos, filter }: { todos: Todo[]; filter: 'all' | 'active' | 'done' }) {\n  const visible = todos.filter(t => filter === 'all' || (filter === 'done') === t.done);\n  return <ul>{visible.map(t => <li key={t.id}>{t.text}</li>)}</ul>;\n}"}}
{"id": "react-reset-state-on-prop", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `ProfilePage({ userId }: { userId: string })` that shows a comment textarea (with its own state) for the given user. When `userId` changes to another user, the comment draft must start empty again.", "pitfall": ["effect_only_sets_state"], "good": ["key_reset"], "skills": [{"name": "react-dev-learn-preserving-and-resetting-state-component-definit", "match": ["Use a `key` prop", "explicit identity with the key prop"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/you-might-not-need-an-effect", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/you-might-not-need-an-effect.md", "quote": "To reset the state of an entire component tree, pass a different `key` to it.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nexport function ProfilePage({ userId }: { userId: string }) {\n  const [comment, setComment] = useState('');\n  useEffect(() => { setComment(''); }, [userId]);\n  return <textarea value={comment} onChange={e => setComment(e.target.value)} />;\n}", "good": "import { useState } from 'react';\nexport function ProfilePage({ userId }: { userId: string }) {\n  return <Profile userId={userId} key={userId} />;\n}\nfunction Profile({ userId }: { userId: string }) {\n  const [comment, setComment] = useState('');\n  return <textarea data-user={userId} value={comment} onChange={e => setComment(e.target.value)} />;\n}"}}
{"id": "react-event-logic-in-effect", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `SignupForm` with first and last name inputs. When the user submits, POST `{ firstName, lastName }` as JSON to `/api/register` with fetch and then show 'Registered!'.", "pitfall": ["fetch_in_effect"], "good": ["no_effect"], "skills": [{"name": "react-dev-learn-you-might-not-need-an-effect-effect-vs-event-han", "match": ["Delete the misleading Effect", "Prefer event handlers over effects"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/you-might-not-need-an-effect", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/you-might-not-need-an-effect.md", "quote": "Code that runs because a component was *displayed* should be in Effects, the rest should be in events.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nexport function SignupForm() {\n  const [first, setFirst] = useState('');\n  const [submitted, setSubmitted] = useState(false);\n  useEffect(() => {\n    if (submitted) { fetch('/api/register', { method: 'POST', body: JSON.stringify({ firstName: first }) }); }\n  }, [submitted, first]);\n  return <form onSubmit={e => { e.preventDefault(); setSubmitted(true); }}><input value={first} onChange={e => setFirst(e.target.value)} /></form>;\n}", "good": "import { useState } from 'react';\nexport function SignupForm() {\n  const [first, setFirst] = useState('');\n  const [done, setDone] = useState(false);\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    await fetch('/api/register', { method: 'POST', body: JSON.stringify({ firstName: first }) });\n    setDone(true);\n  }\n  return <form onSubmit={handleSubmit}><input value={first} onChange={e => setFirst(e.target.value)} />{done && 'Registered!'}</form>;\n}"}}
{"id": "react-use-promise-suspense", "area": "react", "kind": "pitfall", "prompt": "In a React 19 TypeScript client app, the parent `PostPage` starts loading comments with `fetchComments(postId)` (from './api', returns `Promise<Comment[]>`, and caches the promise per postId) and renders a `Comments` component that lists them. Write `PostPage({ postId }: { postId: string })` and `Comments`, showing 'Loading comments...' while the comments load.", "pitfall": ["effect_fetch_state"], "good": ["use_with_suspense"], "skills": [{"name": "react-dev-blog-react-19-use-conditional-4", "match": ["promise created in render", "use() may be called conditionally"]}, "react-dev-use-use-hook-refetching-3"], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/use", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/reference/react/use.md", "quote": "You can pass the Promise down as a prop, and unwrap it deeper in the tree. The component that reads the Promise still suspends, but only that part of the tree waits for the data.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nimport { fetchComments } from './api';\nexport function PostPage({ postId }: { postId: string }) {\n  const [comments, setComments] = useState<string[] | null>(null);\n  useEffect(() => { fetchComments(postId).then(setComments); }, [postId]);\n  if (!comments) return <p>Loading comments...</p>;\n  return <ul>{comments.map(c => <li key={c}>{c}</li>)}</ul>;\n}", "good": "import { Suspense, use } from 'react';\nimport { fetchComments } from './api';\nexport function PostPage({ postId }: { postId: string }) {\n  const commentsPromise = fetchComments(postId);\n  return <Suspense fallback={<p>Loading comments...</p>}><Comments commentsPromise={commentsPromise} /></Suspense>;\n}\nfunction Comments({ commentsPromise }: { commentsPromise: Promise<string[]> }) {\n  const comments = use(commentsPromise);\n  return <ul>{comments.map(c => <li key={c}>{c}</li>)}</ul>;\n}"}}
{"id": "react-ref-as-prop", "area": "react", "kind": "pitfall", "prompt": "Write a reusable React 19 TypeScript `TextInput` component (label + input, styled) whose parent can pass a ref that ends up on the underlying `<input>` so the parent can call `.focus()` on it. Show a parent that focuses it on a button click.", "pitfall": ["forward_ref"], "good": ["ref_as_prop"], "skills": ["react-dev-ref-as-prop"], "packages": ["react"], "source": {"url": "https://react.dev/blog/2024/12/05/react-19", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/blog/2024/12/05/react-19.md", "quote": "Starting in React 19, you can now access `ref` as a prop for function components:", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { forwardRef } from 'react';\nexport const TextInput = forwardRef<HTMLInputElement, { label: string }>(function TextInput({ label }, ref) {\n  return <label>{label}<input ref={ref} /></label>;\n});", "good": "import type { Ref } from 'react';\nexport function TextInput({ label, ref }: { label: string; ref?: Ref<HTMLInputElement> }) {\n  return <label>{label}<input ref={ref} /></label>;\n}"}}
{"id": "react-context-as-provider", "area": "react", "kind": "pitfall", "prompt": "In a React 19 TypeScript app, create a `ThemeContext` holding 'light' | 'dark', provide 'dark' around the whole `App`, and write a `Button` that reads the theme to pick its class name.", "pitfall": ["context_provider"], "good": ["context_as_provider"], "skills": ["react-dev-context-as-provider"], "packages": ["react"], "source": {"url": "https://react.dev/blog/2024/12/05/react-19", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/blog/2024/12/05/react-19.md", "quote": "In React 19, you can render `<Context>` as a provider instead of `<Context.Provider>`:", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { createContext, useContext } from 'react';\nexport const ThemeContext = createContext<'light' | 'dark'>('light');\nexport function App() { return <ThemeContext.Provider value='dark'><Button /></ThemeContext.Provider>; }\nfunction Button() { const t = useContext(ThemeContext); return <button className={t} />; }", "good": "import { createContext, use } from 'react';\nexport const ThemeContext = createContext<'light' | 'dark'>('light');\nexport function App() { return <ThemeContext value='dark'><Button /></ThemeContext>; }\nfunction Button() { const t = use(ThemeContext); return <button className={t} />; }"}}
{"id": "react-form-action-state", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `ChangeNameForm` that submits a name to `async function updateName(name: string): Promise<string | null>` (from './api'; it returns an error message or null). While it saves, disable the button and show 'Saving...'; show the returned error if there is one.", "pitfall": ["manual_submit"], "good": ["action_state"], "skills": [{"name": "react-dev-form-component-form-action-prop", "match": ["pass a function to <form action", "Use `useActionState`"]}, {"name": "react-dev-blog-react-19-actions-1", "match": ["useTransition()", "action or formAction prop"]}], "packages": ["react"], "source": {"url": "https://react.dev/blog/2024/12/05/react-19", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/blog/2024/12/05/react-19.md", "quote": "To make the common cases easier for Actions, we've added a new hook called `useActionState`", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useState } from 'react';\nimport { updateName } from './api';\nexport function ChangeNameForm() {\n  const [name, setName] = useState('');\n  const [isPending, setIsPending] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  async function onSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    setIsPending(true);\n    setError(await updateName(name));\n    setIsPending(false);\n  }\n  return <form onSubmit={onSubmit}><input value={name} onChange={e => setName(e.target.value)} /><button disabled={isPending}>Save</button>{error}</form>;\n}", "good": "import { useActionState } from 'react';\nimport { updateName } from './api';\nexport function ChangeNameForm() {\n  const [error, submit, isPending] = useActionState(async (_prev: string | null, fd: FormData) => updateName(String(fd.get('name'))), null);\n  return <form action={submit}><input name='name' /><button disabled={isPending}>{isPending ? 'Saving...' : 'Save'}</button>{error}</form>;\n}"}}
{"id": "react-optimistic-like", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `LikeButton({ postId, likes }: { postId: string; likes: number })` that shows the like count and, on click, calls `async function likePost(postId: string): Promise<number>` (from './api', returns the new server count). The count must go up immediately on click, and fall back to the real value if the request fails.", "pitfall": ["manual_rollback"], "good": ["uses_optimistic"], "skills": ["react-dev-use-optimistic-useoptimistic", {"name": "react-dev-blog-react-19-use-conditional-4", "match": ["useOptimistic(state)"]}], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/useOptimistic", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/reference/react/useOptimistic.md", "quote": "Call `useOptimistic` at the top level of your component to create optimistic state for a value.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useState } from 'react';\nimport { likePost } from './api';\nexport function LikeButton({ postId, likes }: { postId: string; likes: number }) {\n  const [count, setCount] = useState(likes);\n  async function onClick() {\n    setCount(c => c + 1);\n    try { setCount(await likePost(postId)); } catch { setCount(c => c - 1); }\n  }\n  return <button onClick={onClick}>{count}</button>;\n}", "good": "import { useOptimistic, useState, startTransition } from 'react';\nimport { likePost } from './api';\nexport function LikeButton({ postId, likes }: { postId: string; likes: number }) {\n  const [count, setCount] = useState(likes);\n  const [shown, addOptimistic] = useOptimistic(count, (c: number) => c + 1);\n  function onClick() {\n    startTransition(async () => { addOptimistic(null); setCount(await likePost(postId)); });\n  }\n  return <button onClick={onClick}>{shown}</button>;\n}"}}
{"id": "react-transition-slow-tab", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `TabContainer` with three tab buttons: About, Posts and Contact. `Posts` (from './Posts') renders thousands of items and takes a long time to render. Clicking between tabs must keep the UI responsive: a click on another tab while Posts is rendering should switch right away.", "pitfall": ["no_transition"], "good": ["transition"], "skills": ["react-dev-use-transition-starttransition"], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/useTransition", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/reference/react/useTransition.md", "quote": "Call `useTransition` at the top level of your component to mark some state updates as Transitions.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useState } from 'react';\nimport Posts from './Posts';\nexport function TabContainer() {\n  const [tab, setTab] = useState('about');\n  return <div><button onClick={() => setTab('posts')}>Posts</button>{tab === 'posts' && <Posts />}</div>;\n}", "good": "import { useState, useTransition } from 'react';\nimport Posts from './Posts';\nexport function TabContainer() {\n  const [tab, setTab] = useState('about');\n  const [isPending, startTransition] = useTransition();\n  return <div><button onClick={() => startTransition(() => setTab('posts'))}>Posts</button>{isPending ? '...' : null}{tab === 'posts' && <Posts />}</div>;\n}"}}
{"id": "react-fetch-effect-race", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `SearchResults({ query }: { query: string })` that fetches `/api/search?q=<query>` whenever `query` changes and lists the result titles (the response is `{ results: { id: string; title: string }[] }`). The user types quickly, so several requests can be in flight at once.", "pitfall": ["fetch_in_effect_no_cleanup"], "good": ["effect_cleanup_or_use"], "skills": [{"name": "react-dev-learn-synchronizing-with-effects-effect-race-condition", "match": ["declare a local `ignore` flag"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/you-might-not-need-an-effect", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/you-might-not-need-an-effect.md", "quote": "You can fetch data with Effects, but you need to implement cleanup to avoid race conditions.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nexport function SearchResults({ query }: { query: string }) {\n  const [items, setItems] = useState<{ id: string; title: string }[]>([]);\n  useEffect(() => {\n    fetch('/api/search?q=' + query).then(r => r.json()).then(d => setItems(d.results));\n  }, [query]);\n  return <ul>{items.map(i => <li key={i.id}>{i.title}</li>)}</ul>;\n}", "good": "import { useEffect, useState } from 'react';\nexport function SearchResults({ query }: { query: string }) {\n  const [items, setItems] = useState<{ id: string; title: string }[]>([]);\n  useEffect(() => {\n    let ignore = false;\n    fetch('/api/search?q=' + query).then(r => r.json()).then(d => { if (!ignore) setItems(d.results); });\n    return () => { ignore = true; };\n  }, [query]);\n  return <ul>{items.map(i => <li key={i.id}>{i.title}</li>)}</ul>;\n}"}}
{"id": "react-compiler-no-manual-memo", "area": "react", "kind": "pitfall", "prompt": "This React 19 + Vite app has the React Compiler enabled (vite.config.ts passes 'babel-plugin-react-compiler' to @vitejs/plugin-react). Write a TypeScript `ProductList({ products, query, onSelect }: { products: Product[]; query: string; onSelect: (id: string) => void })` (type Product = { id: string; name: string; price: number }) that filters products by query, sorts them by price, and renders a `ProductRow` per product that calls `onSelect` on click. Keep re-renders cheap.", "pitfall": ["manual_memo"], "good": ["no_manual_memo"], "skills": [{"name": "react-dev-compiler-introduction-effect-dependencies", "match": ["For new code, rely on React Compiler", "Profile your code"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/react-compiler/introduction", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/main/src/content/learn/react-compiler/introduction.md", "quote": "For new code, we recommend relying on the compiler for memoization and using `useMemo`/`useCallback` where needed to achieve precise control.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { memo, useMemo, useCallback } from 'react';\ntype Product = { id: string; name: string; price: number };\nexport function ProductList({ products, query, onSelect }: { products: Product[]; query: string; onSelect: (id: string) => void }) {\n  const shown = useMemo(() => products.filter(p => p.name.includes(query)).sort((a, b) => a.price - b.price), [products, query]);\n  const pick = useCallback((id: string) => onSelect(id), [onSelect]);\n  return <ul>{shown.map(p => <ProductRow key={p.id} p={p} onPick={pick} />)}</ul>;\n}\nconst ProductRow = memo(function ProductRow({ p, onPick }: { p: Product; onPick: (id: string) => void }) { return <li onClick={() => onPick(p.id)}>{p.name}</li>; });", "good": "type Product = { id: string; name: string; price: number };\nexport function ProductList({ products, query, onSelect }: { products: Product[]; query: string; onSelect: (id: string) => void }) {\n  const shown = products.filter(p => p.name.includes(query)).sort((a, b) => a.price - b.price);\n  return <ul>{shown.map(p => <ProductRow key={p.id} p={p} onPick={onSelect} />)}</ul>;\n}\nfunction ProductRow({ p, onPick }: { p: Product; onPick: (id: string) => void }) { return <li onClick={() => onPick(p.id)}>{p.name}</li>; }"}}
{"id": "react-setup-new-vite-app", "area": "react", "kind": "setup", "prompt": "Set up a new React 19 + Vite + TypeScript app from scratch: give me package.json and vite.config.ts, plus a minimal src/main.tsx and src/App.tsx with a counter.", "pitfall": ["compiler_missing"], "good": ["compiler_configured"], "skills": [{"name": "react-dev-compiler-introduction-effect-dependencies", "match": ["For new code, rely on React Compiler"]}, "react-dev-compiler-setup-vite"], "packages": ["react"], "source": {"url": "https://react.dev/learn/react-compiler/installation", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/learn/react-compiler/installation.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/learn__react-compiler__installation.md", "quote": "Install React Compiler as a `devDependency`:", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)", "gap": "no library skill carries the installation page's setup; `react-dev-compiler-setup-vite` is to be built from it through the ONE pipeline"}, "examples": {"pitfall": "package.json\n```json\n{\"name\": \"app\", \"dependencies\": {\"react\": \"^19.2.0\", \"react-dom\": \"^19.2.0\"}, \"devDependencies\": {\"vite\": \"^7.0.0\", \"@vitejs/plugin-react\": \"^5.0.0\", \"typescript\": \"^5.9.0\"}}\n```\nvite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react()] });\n```", "good": "package.json\n```json\n{\"name\": \"app\", \"dependencies\": {\"react\": \"^19.2.0\", \"react-dom\": \"^19.2.0\"}, \"devDependencies\": {\"vite\": \"^7.0.0\", \"@vitejs/plugin-react\": \"^5.0.0\", \"babel-plugin-react-compiler\": \"^1.0.0\", \"typescript\": \"^5.9.0\"}}\n```\nvite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react({ babel: { plugins: [['babel-plugin-react-compiler']] } })] });\n```"}}
{"id": "react-setup-add-feature", "area": "react", "kind": "setup", "prompt": "My React 19 + Vite + TypeScript app has this vite.config.ts:\n\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react()] });\n```\n\nand this package.json:\n\n```json\n{\"name\": \"shop\", \"dependencies\": {\"react\": \"^19.2.0\", \"react-dom\": \"^19.2.0\"}, \"devDependencies\": {\"vite\": \"^7.0.0\", \"@vitejs/plugin-react\": \"^5.0.0\", \"typescript\": \"^5.9.0\"}}\n```\n\nAdd a product search page: a `ProductSearch` component with a text box that filters a list of 500 products as the user types, keeping typing smooth. Give me every file you change, in full.", "pitfall": ["compiler_missing"], "good": ["compiler_configured"], "skills": [{"name": "react-dev-compiler-introduction-effect-dependencies", "match": ["For new code, rely on React Compiler"]}, "react-dev-compiler-setup-vite"], "packages": ["react"], "source": {"url": "https://react.dev/learn/react-compiler/installation", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/learn/react-compiler/installation.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/learn__react-compiler__installation.md", "quote": "Install React Compiler as a `devDependency`:", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)", "gap": "no library skill carries the installation page's setup; `react-dev-compiler-setup-vite` is to be built from it through the ONE pipeline"}, "examples": {"pitfall": "ProductSearch.tsx\n```tsx\nimport { useState, useMemo } from 'react';\nexport function ProductSearch({ products }: { products: string[] }) {\n  const [q, setQ] = useState('');\n  const shown = useMemo(() => products.filter(p => p.includes(q)), [products, q]);\n  return <div><input value={q} onChange={e => setQ(e.target.value)} />{shown.join(', ')}</div>;\n}\n```", "good": "package.json\n```json\n{\"name\": \"shop\", \"dependencies\": {\"react\": \"^19.2.0\", \"react-dom\": \"^19.2.0\"}, \"devDependencies\": {\"vite\": \"^7.0.0\", \"@vitejs/plugin-react\": \"^5.0.0\", \"babel-plugin-react-compiler\": \"^1.0.0\", \"typescript\": \"^5.9.0\"}}\n```\nvite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react({ babel: { plugins: [['babel-plugin-react-compiler']] } })] });\n```"}}
{"id": "react-ref-read-in-render", "area": "react", "kind": "pitfall", "prompt": "Write a React 19 TypeScript `DebugPanel({ items }: { items: string[] })` component that lists the items and also shows, for debugging, how many times this component has rendered so far. Keeping the render count must not itself cause extra renders.", "pitfall": ["ref_current_in_render"], "good": ["no_ref_current_in_render"], "skills": [{"name": "react-dev-learn-referencing-values-with-refs-ref-current", "match": ["Don't read or write `ref.current` during rendering", "switch that value to state"]}], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/useRef", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/reference/react/useRef.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/reference__react__useRef.md", "quote": "Reading or writing a ref **during rendering** breaks these expectations.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useRef } from 'react';\nexport function DebugPanel({ items }: { items: string[] }) {\n  const renders = useRef(0);\n  renders.current += 1;\n  return <div><p>renders: {renders.current}</p><ul>{items.map(i => <li key={i}>{i}</li>)}</ul></div>;\n}", "good": "import { useEffect, useRef, useState } from 'react';\nexport function DebugPanel({ items }: { items: string[] }) {\n  const renders = useRef(0);\n  const [shown, setShown] = useState(0);\n  useEffect(() => { renders.current += 1; });\n  return <div><button onClick={() => setShown(renders.current)}>renders: {shown}</button><ul>{items.map(i => <li key={i}>{i}</li>)}</ul></div>;\n}"}}
{"id": "react-ref-guard-effect-once", "area": "react", "kind": "pitfall", "prompt": "In a React 19 TypeScript app with StrictMode on, my `ChatRoom({ roomId }: { roomId: string })` component connects with `const c = createConnection(roomId); c.connect();` (from './chat'; the connection has `connect()` and `disconnect()`) inside a useEffect, and in development I see two connections open. Rewrite ChatRoom so it behaves correctly.", "pitfall": ["ref_guard_in_effect"], "good": ["effect_cleanup_no_guard"], "skills": [{"name": "react-dev-learn-synchronizing-with-effects-async-effect-cleanup", "match": ["Return a cleanup function from your Effect"]}], "packages": ["react"], "source": {"url": "https://react.dev/learn/synchronizing-with-effects", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/learn/synchronizing-with-effects.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/learn__synchronizing-with-effects.md", "quote": "To fix the bug, it is not enough to just make the Effect run once. The effect needs to work after re-mounting, which means the connection needs to be cleaned up like in the solution above.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { useEffect, useRef } from 'react';\nimport { createConnection } from './chat';\nexport function ChatRoom({ roomId }: { roomId: string }) {\n  const started = useRef(false);\n  useEffect(() => {\n    if (started.current) return;\n    started.current = true;\n    const c = createConnection(roomId);\n    c.connect();\n  }, [roomId]);\n  return <h1>{roomId}</h1>;\n}", "good": "import { useEffect } from 'react';\nimport { createConnection } from './chat';\nexport function ChatRoom({ roomId }: { roomId: string }) {\n  useEffect(() => {\n    const c = createConnection(roomId);\n    c.connect();\n    return () => c.disconnect();\n  }, [roomId]);\n  return <h1>{roomId}</h1>;\n}"}}
{"id": "react-use-cached-promise", "area": "react", "kind": "pitfall", "prompt": "In a React 19 TypeScript client app, write an `Albums` component that loads the album list from `/api/albums` (a JSON array of `{ id: string; title: string }`) and lists the titles, reading the data directly during render with React 19's Suspense-based data reading (no useEffect, no loading state variable), plus the parent that shows 'Loading...' while it loads.", "pitfall": ["use_of_render_promise"], "good": ["use_cached_promise"], "skills": [{"name": "react-dev-blog-react-19-use-conditional-4", "match": ["promise created in render"]}], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/use", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/reference/react/use.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/reference__react__use.md", "quote": "Promises created during render are recreated on every render, which causes React to show the Suspense fallback repeatedly and prevents content from appearing.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)"}, "examples": {"pitfall": "import { Suspense, use } from 'react';\nfunction Albums() {\n  const albums: { id: string; title: string }[] = use(fetch('/api/albums').then(r => r.json()));\n  return <ul>{albums.map(a => <li key={a.id}>{a.title}</li>)}</ul>;\n}\nexport function Page() { return <Suspense fallback={<p>Loading...</p>}><Albums /></Suspense>; }", "good": "import { Suspense, use } from 'react';\nconst cache = new Map<string, Promise<{ id: string; title: string }[]>>();\nfunction fetchData(url: string) {\n  if (!cache.has(url)) cache.set(url, fetch(url).then(r => r.json()));\n  return cache.get(url)!;\n}\nfunction Albums({ albumsPromise }: { albumsPromise: Promise<{ id: string; title: string }[]> }) {\n  const albums = use(albumsPromise);\n  return <ul>{albums.map(a => <li key={a.id}>{a.title}</li>)}</ul>;\n}\nexport function Page() { return <Suspense fallback={<p>Loading...</p>}><Albums albumsPromise={fetchData('/api/albums')} /></Suspense>; }"}}
{"id": "react-modal-open-prop", "area": "react", "kind": "pitfall", "prompt": "Write a reusable React 19 TypeScript `Modal` component (a backdrop and a centred panel showing its children) that a parent can open and close, and a parent `SettingsPage` with a 'Settings' button that opens it and a 'Close' button inside the modal that closes it.", "pitfall": ["imperative_handle"], "good": ["open_as_prop"], "skills": ["react-dev-ref-as-prop"], "packages": ["react"], "source": {"url": "https://react.dev/reference/react/forwardRef", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/reference/react/forwardRef.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/reference__react__forwardRef.md", "quote": "**If you can express something as a prop, you should not use a ref.**", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)", "gap": "no library skill carries the forwardRef page's Pitfall (express open/close as a prop, not an imperative handle); `react-dev-ref-as-prop` (bench/skills/react_gap_fill.py) is to be built from this page through the ONE pipeline"}, "examples": {"pitfall": "import { useImperativeHandle, useState, type Ref, type ReactNode } from 'react';\nexport type ModalHandle = { open(): void; close(): void };\nexport function Modal({ ref, children }: { ref?: Ref<ModalHandle>; children: ReactNode }) {\n  const [shown, setShown] = useState(false);\n  useImperativeHandle(ref, () => ({ open: () => setShown(true), close: () => setShown(false) }));\n  return shown ? <div className='backdrop'>{children}</div> : null;\n}", "good": "import { useState, type ReactNode } from 'react';\nexport function Modal({ isOpen, children }: { isOpen: boolean; children: ReactNode }) {\n  return isOpen ? <div className='backdrop'>{children}</div> : null;\n}\nexport function SettingsPage() {\n  const [open, setOpen] = useState(false);\n  return <div><button onClick={() => setOpen(true)}>Settings</button><Modal isOpen={open}><button onClick={() => setOpen(false)}>Close</button></Modal></div>;\n}"}}
{"id": "react-compiler-first-plugin", "area": "react", "kind": "setup", "prompt": "My React 19 + Vite + TypeScript app has this vite.config.ts:\n\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react({ babel: { plugins: ['babel-plugin-react-compiler'] } })] });\n```\n\nand @vitejs/plugin-react ^5.0.0 in package.json. I want to style components with Emotion's `css` prop, which needs `@emotion/babel-plugin`. Give me the updated vite.config.ts in full, and the package.json lines to add.", "pitfall": ["compiler_not_first"], "good": ["compiler_first"], "skills": ["react-dev-compiler-setup-vite"], "packages": ["react"], "source": {"url": "https://react.dev/learn/react-compiler/installation", "raw": "https://raw.githubusercontent.com/reactjs/react.dev/75ef18a9172e4c100b5d5650ae14c395c5c8ef42/src/content/learn/react-compiler/installation.md", "commit": "75ef18a9172e4c100b5d5650ae14c395c5c8ef42", "file": "react.dev@75ef18a9172e/learn__react-compiler__installation.md", "quote": "React Compiler must run **first** in your Babel plugin pipeline.", "licence": "CC-BY-4.0 (react.dev LICENSE-DOCS.md; the repository carries no separate code licence at 75ef18a)", "gap": "no library skill carries the installation page (setup forms, compiler first); `react-dev-compiler-setup-vite` is to be built from this page through the ONE pipeline"}, "examples": {"pitfall": "vite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react({ babel: { plugins: ['@emotion/babel-plugin', 'babel-plugin-react-compiler'] } })] });\n```", "good": "vite.config.ts\n```ts\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nexport default defineConfig({ plugins: [react({ babel: { plugins: ['babel-plugin-react-compiler', '@emotion/babel-plugin'] } })] });\n```"}}
