// THE PMNDRS MATH PITFALL CASES (the npm package `math`, pmndrs/math; bench/skills/pitfall_harness.py; rules bench/skills/pitfall_rules/pmath.py). Operator, 2026-09-30: "Yes to everything pending, queue it up lets go". Each quote is VERBATIM from API.md pinned at the math@0.1.0 release tag (github.com/pmndrs/math@c6713e38dd86, the held math@0.1.0; bench/skills/pitfalls/sources/pmath@c6713e38dd86/MANIFEST.json); MIT (the repository's LICENSE; no separate docs licence). API.md is an API reference: the cases pit the default hand-written or other-library code against the package's own function for the job. No setup case: API.md has no setup section. Prompts never name the good pattern (never_in_prompt). `examples` are the rules' own test (--self-test), written for this harness; the rules' readings are UNMEASURED.
{"id": "pmath-particles-in-place", "area": "pmath", "kind": "pitfall", "prompt": "Using the npm package `math` (pmndrs/math; vectors are plain `[x, y, z]` tuples) in TypeScript, write `step(particles: { position: Vec3; velocity: Vec3 }[], dt: number)` for a particle system of 20,000 particles that runs every frame at 60 fps: add gravity (0, -9.81, 0) times dt to each velocity, then each velocity times dt to its position.", "never_in_prompt": ["scaleAndAdd", "in place", "scratch", "out argument"], "pitfall": ["pmath_allocates_in_loop"], "good": ["pmath_writes_through_out"], "skills": [{"name": "math-data-oriented-functions", "match": ["out argument first", "allocates once"]}, {"name": "math-with-three-js", "match": ["scratch math values"]}], "packages": ["math"], "source": {"url": "https://github.com/pmndrs/math/blob/math@0.1.0/API.md#api-math-vec3", "raw": "https://raw.githubusercontent.com/pmndrs/math/c6713e38dd86de6e3e5bf98b94e22c2a29e4a709/API.md", "file": "pmath@c6713e38dd86/API.md", "quote": "`vec3.scaleAndAdd(out: Vec3, a: Vec3, b: Vec3, scale: number): Vec3` — Adds two vec3's after scaling the second operand by a scalar value", "licence": "MIT (pmndrs/math LICENSE at the math@0.1.0 tag, c6713e3; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { vec3, type Vec3 } from 'math';\n\ntype Particle = { position: Vec3; velocity: Vec3 };\n\nexport function step(particles: Particle[], dt: number) {\n  for (const p of particles) {\n    const g = vec3.scale(vec3.create(), [0, -9.81, 0], dt);\n    p.velocity = vec3.add(vec3.create(), p.velocity, g);\n    p.position = vec3.add(vec3.create(), p.position, vec3.scale(vec3.create(), p.velocity, dt));\n  }\n}", "good": "import { vec3, type Vec3 } from 'math';\n\ntype Particle = { position: Vec3; velocity: Vec3 };\n\nconst GRAVITY: Vec3 = [0, -9.81, 0];\n\nexport function step(particles: Particle[], dt: number) {\n  for (const p of particles) {\n    vec3.scaleAndAdd(p.velocity, p.velocity, GRAVITY, dt);\n    vec3.scaleAndAdd(p.position, p.position, p.velocity, dt);\n  }\n}"}}
{"id": "pmath-orbit-camera", "area": "pmath", "kind": "pitfall", "prompt": "Using the npm package `math` (pmndrs/math; vectors are plain `[x, y, z]` tuples) for the vector math, write `orbitCamera(camera: PerspectiveCamera, target: Vec3, radius: number, azimuth: number, polar: number)` for a three.js scene: it puts the camera at `radius` from `target`, `azimuth` radians around the Y axis and `polar` radians down from the +Y axis, and points it at the target. It is called every frame.", "never_in_prompt": ["spherical", "Spherical", "toVec3"], "pitfall": ["pmath_hand_rolled_or_three_spherical"], "good": ["pmath_spherical_to_vec3"], "skills": [{"name": "math-with-three-js", "match": ["orbits a target"]}, "pmath-spherical-orbit"], "packages": ["math", "three"], "source": {"url": "https://github.com/pmndrs/math/blob/math@0.1.0/API.md#api-math-spherical", "raw": "https://raw.githubusercontent.com/pmndrs/math/c6713e38dd86de6e3e5bf98b94e22c2a29e4a709/API.md", "file": "pmath@c6713e38dd86/API.md", "quote": "`spherical.toVec3(out: Vec3, a: Spherical): Vec3` — Converts spherical coordinates to a Cartesian Vec3 (Three.js / OpenGL convention)", "licence": "MIT (pmndrs/math LICENSE at the math@0.1.0 tag, c6713e3; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import type { PerspectiveCamera } from 'three';\nimport type { Vec3 } from 'math';\n\nexport function orbitCamera(camera: PerspectiveCamera, target: Vec3, radius: number, azimuth: number, polar: number) {\n  const x = target[0] + radius * Math.sin(polar) * Math.sin(azimuth);\n  const y = target[1] + radius * Math.cos(polar);\n  const z = target[2] + radius * Math.sin(polar) * Math.cos(azimuth);\n  camera.position.set(x, y, z);\n  camera.lookAt(target[0], target[1], target[2]);\n}", "good": "import type { PerspectiveCamera } from 'three';\nimport { spherical, vec3, type Vec3 } from 'math';\n\nconst _orbit = spherical.create();\nconst _position = vec3.create();\n\nexport function orbitCamera(camera: PerspectiveCamera, target: Vec3, radius: number, azimuth: number, polar: number) {\n  spherical.set(_orbit, radius, azimuth, polar);\n  spherical.toVec3(_position, _orbit);\n  vec3.add(_position, _position, target);\n  camera.position.fromArray(_position);\n  camera.lookAt(target[0], target[1], target[2]);\n}"}}
{"id": "pmath-seeded-scatter", "area": "pmath", "kind": "pitfall", "prompt": "Using the npm package `math` (pmndrs/math; vectors are plain `[x, y, z]` tuples) in TypeScript, write `scatterTrees(seed: number, count: number): Vec3[]` that places `count` trees at x and z in [-50, 50) on the ground (y = 0). Levels are shared between players as just their seed number, so the same seed must always produce exactly the same trees.", "never_in_prompt": ["mulberry32", "isaac", "math/random"], "pitfall": ["pmath_unseeded_or_hand_rolled_random"], "good": ["pmath_seeded_generator"], "skills": [{"name": "math-noise-and-seeded-random", "match": ["mulberry32", "RandomGenerator"]}], "packages": ["math"], "source": {"url": "https://github.com/pmndrs/math/blob/math@0.1.0/API.md#api-math-random-mulberry32", "raw": "https://raw.githubusercontent.com/pmndrs/math/c6713e38dd86de6e3e5bf98b94e22c2a29e4a709/API.md", "file": "pmath@c6713e38dd86/API.md", "quote": "`mulberry32.create(seed: number): Mulberry32` — Creates Mulberry32 PRNG state seeded with `seed`.", "licence": "MIT (pmndrs/math LICENSE at the math@0.1.0 tag, c6713e3; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import type { Vec3 } from 'math';\n\nfunction seededRandom(seed: number) {\n  let a = seed >>> 0;\n  return () => {\n    a = (a + 0x6d2b79f5) >>> 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nexport function scatterTrees(seed: number, count: number): Vec3[] {\n  const next = seededRandom(seed);\n  const out: Vec3[] = [];\n  for (let i = 0; i < count; i++) out.push([next() * 100 - 50, 0, next() * 100 - 50]);\n  return out;\n}", "good": "import type { Vec3 } from 'math';\nimport { mulberry32, random } from 'math/random';\n\nexport function scatterTrees(seed: number, count: number): Vec3[] {\n  const state = mulberry32.create(seed);\n  const rng = () => mulberry32.sample(state);\n  const out: Vec3[] = [];\n  for (let i = 0; i < count; i++) {\n    out.push([random.float(rng, -50, 50), 0, random.float(rng, -50, 50)]);\n  }\n  return out;\n}"}}
{"id": "pmath-noise-heightmap", "area": "pmath", "kind": "pitfall", "prompt": "Using the npm package `math` (pmndrs/math) in TypeScript, write `heightmap(seed: number, size: number): Float32Array` for a terrain: `size * size` heights from smooth 2D gradient noise with 6 octaves of detail (each octave at twice the frequency and half the amplitude of the one before), scaled to about [-1, 1]. The same seed must always give the same terrain.", "never_in_prompt": ["simplex2d", "perlin2d", "fbm", "math/noise"], "pitfall": ["pmath_hand_rolled_or_foreign_noise"], "good": ["pmath_noise_generator", "pmath_fractal_octaves"], "skills": [{"name": "math-noise-and-seeded-random", "match": ["simplex2d", "fbm"]}], "packages": ["math"], "source": {"url": "https://github.com/pmndrs/math/blob/math@0.1.0/API.md#fbm", "raw": "https://raw.githubusercontent.com/pmndrs/math/c6713e38dd86de6e3e5bf98b94e22c2a29e4a709/API.md", "file": "pmath@c6713e38dd86/API.md", "quote": "`fbm(sample: (frequency: number) => number, octaves: number, lacunarity: number, gain: number): number` — Fractional Brownian motion: sums octaves of a noise source at increasing", "licence": "MIT (pmndrs/math LICENSE at the math@0.1.0 tag, c6713e3; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { createNoise2D } from 'simplex-noise';\nimport alea from 'alea';\n\nexport function heightmap(seed: number, size: number): Float32Array {\n  const noise2D = createNoise2D(alea(seed));\n  const out = new Float32Array(size * size);\n  for (let y = 0; y < size; y++) {\n    for (let x = 0; x < size; x++) {\n      let amp = 1, freq = 1 / 64, sum = 0, norm = 0;\n      for (let o = 0; o < 6; o++) {\n        sum += amp * noise2D(x * freq, y * freq);\n        norm += amp;\n        amp *= 0.5;\n        freq *= 2;\n      }\n      out[y * size + x] = sum / norm;\n    }\n  }\n  return out;\n}", "good": "import { fbm, simplex2d } from 'math/noise';\n\nexport function heightmap(seed: number, size: number): Float32Array {\n  const gen = simplex2d.create(seed);\n  const out = new Float32Array(size * size);\n  for (let y = 0; y < size; y++) {\n    for (let x = 0; x < size; x++) {\n      out[y * size + x] = fbm((f) => simplex2d.sample(gen, (x / 64) * f, (y / 64) * f), 6, 2, 0.5);\n    }\n  }\n  return out;\n}"}}
