// THE KOOTA PITFALL CASES (bench/skills/pitfall_harness.py; rules bench/skills/pitfall_rules/koota.py). Operator, 2026-09-30: "Yes to everything pending, queue it up lets go". Each quote is VERBATIM from koota's README.md or skills/koota/SKILL.md pinned at the v0.6.6 release tag (github.com/pmndrs/koota@7d1329aa82e3, the held koota@0.6.6; bench/skills/pitfalls/sources/koota@7d1329aa82e3/MANIFEST.json); ISC (the repository's LICENSE; no separate docs licence). Prompts never name the good pattern (never_in_prompt). `examples` are the rules' own test (--self-test), written for this harness; the rules' readings of the docs are UNMEASURED.
{"id": "koota-inventory-change-flag", "area": "koota", "kind": "pitfall", "prompt": "In a koota (TypeScript) game the player's inventory is a trait in './traits': `export const Inventory = trait(() => ({ items: [] as Item[] }))`, with `export type Item = { id: string; name: string }`. Write `pickUp(player: Entity, item: Item)`, which the collision system calls when the player touches an item, and an `InventoryBar({ player }: { player: Entity })` React component that lists the item names with `useTrait(player, Inventory)` from 'koota/react'. Busy levels have many pickups a second, so append to the existing array instead of copying it; the bar must show each new item as soon as it is picked up.", "never_in_prompt": ["changed", "entity.set", ".set("], "pitfall": ["koota_mutates_trait_unflagged"], "good": ["koota_change_flagged"], "skills": [{"name": "koota-traits-and-entities", "match": ["entity.changed"]}, {"name": "koota-react-integration", "match": ["does not rerender"]}], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/skills/koota/SKILL.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/skills/koota/SKILL.md", "file": "koota@7d1329aa82e3/skills__koota__SKILL.md", "quote": "For AoS traits where you mutate objects directly, manually signal with `entity.changed(Trait)`.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import type { Entity } from 'koota';\nimport { useTrait } from 'koota/react';\nimport { Inventory, type Item } from './traits';\n\nexport function pickUp(player: Entity, item: Item) {\n  const inventory = player.get(Inventory)!;\n  inventory.items.push(item);\n}\n\nexport function InventoryBar({ player }: { player: Entity }) {\n  const inventory = useTrait(player, Inventory);\n  return <ul>{inventory?.items.map((it) => <li key={it.id}>{it.name}</li>)}</ul>;\n}", "good": "import type { Entity } from 'koota';\nimport { useTrait } from 'koota/react';\nimport { Inventory, type Item } from './traits';\n\nexport function pickUp(player: Entity, item: Item) {\n  const inventory = player.get(Inventory)!;\n  inventory.items.push(item);\n  player.changed(Inventory);\n}\n\nexport function InventoryBar({ player }: { player: Entity }) {\n  const inventory = useTrait(player, Inventory);\n  return <ul>{inventory?.items.map((it) => <li key={it.id}>{it.name}</li>)}</ul>;\n}"}}
{"id": "koota-class-to-traits", "area": "koota", "kind": "pitfall", "prompt": "Our browser game keeps its enemies as instances of this class:\n\n```ts\nexport class Enemy {\n  constructor(public x: number, public y: number, public vx: number, public vy: number, public hp = 3) {}\n  update(dt: number) { this.x += this.vx * dt; this.y += this.vy * dt; }\n  hit(damage: number) { this.hp -= damage; }\n}\n```\n\nMove the enemies into koota (TypeScript): create the world, spawn 20 enemies at random positions and velocities, write the function the game loop calls every frame to move them, and a `damage(enemy: Entity, amount: number)` function that removes an enemy when its hp drops to 0 or below.", "never_in_prompt": ["trait", "updateEach", "createActions"], "pitfall": ["koota_class_holds_state"], "good": ["koota_schema_traits_query_system"], "skills": ["koota-traits-actions-over-classes", {"name": "koota-react-integration", "match": ["instead of classes"]}, {"name": "koota-queries-and-systems", "match": ["updateEach"]}], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/skills/koota/SKILL.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/skills/koota/SKILL.md", "file": "koota@7d1329aa82e3/skills__koota__SKILL.md", "quote": "Prefer not to use classes to encapsulate data and behavior. Use traits for data and actions for behavior.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { createWorld, trait, type Entity } from 'koota';\n\nexport class Enemy {\n  constructor(public x = 0, public y = 0, public vx = 0, public vy = 0, public hp = 3) {}\n  update(dt: number) { this.x += this.vx * dt; this.y += this.vy * dt; }\n  hit(damage: number) { this.hp -= damage; }\n}\n\nexport const EnemyRef = trait(() => new Enemy());\nexport const world = createWorld();\n\nfor (let i = 0; i < 20; i++) {\n  const e = world.spawn(EnemyRef);\n  Object.assign(e.get(EnemyRef)!, { x: Math.random() * 800, y: Math.random() * 600, vx: Math.random() - 0.5, vy: Math.random() - 0.5 });\n}\n\nexport function moveEnemies(dt: number) {\n  for (const e of world.query(EnemyRef)) e.get(EnemyRef)!.update(dt);\n}\n\nexport function damage(enemy: Entity, amount: number) {\n  const en = enemy.get(EnemyRef)!;\n  en.hit(amount);\n  if (en.hp <= 0) enemy.destroy();\n}", "good": "import { createWorld, trait, type Entity, type World } from 'koota';\n\nexport const Position = trait({ x: 0, y: 0 });\nexport const Velocity = trait({ x: 0, y: 0 });\nexport const Health = trait({ hp: 3 });\n\nexport const world = createWorld();\nfor (let i = 0; i < 20; i++) {\n  world.spawn(\n    Position({ x: Math.random() * 800, y: Math.random() * 600 }),\n    Velocity({ x: Math.random() - 0.5, y: Math.random() - 0.5 }),\n    Health,\n  );\n}\n\nexport function moveEnemies(world: World, dt: number) {\n  world.query(Position, Velocity).updateEach(([pos, vel]) => {\n    pos.x += vel.x * dt;\n    pos.y += vel.y * dt;\n  });\n}\n\nexport function damage(enemy: Entity, amount: number) {\n  const hp = enemy.get(Health)!.hp - amount;\n  if (hp <= 0) enemy.destroy();\n  else enemy.set(Health, { hp });\n}"}}
{"id": "koota-system-batch-update", "area": "koota", "kind": "pitfall", "prompt": "Write two koota systems in TypeScript for a 2D platformer. The traits live in './traits': `Position = trait({ x: 0, y: 0 })`, `Velocity = trait({ x: 0, y: 0 })` and the tag `IsGrounded = trait()`. `applyGravity(world: World, delta: number)` adds `GRAVITY * delta` (GRAVITY = 30) to the y velocity of every entity that has Velocity and is not grounded; `applyVelocity(world: World, delta: number)` moves every entity that has Position and Velocity by its velocity times delta. Both run every frame over a few thousand entities.", "never_in_prompt": ["updateEach", "readEach", "useStores"], "pitfall": ["koota_query_loop_get_set"], "good": ["koota_batch_update_each"], "skills": [{"name": "koota-queries-and-systems", "match": ["rather than for...of"]}, {"name": "koota-queries", "match": ["prefer updateEach"]}], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/skills/koota/SKILL.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/skills/koota/SKILL.md", "file": "koota@7d1329aa82e3/skills__koota__SKILL.md", "quote": "Prefer `updateEach`/`readEach` over `for...of` + `entity.get()` for data-bearing queries.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { Not, type World } from 'koota';\nimport { IsGrounded, Position, Velocity } from './traits';\n\nconst GRAVITY = 30;\n\nexport function applyGravity(world: World, delta: number) {\n  for (const e of world.query(Velocity, Not(IsGrounded))) {\n    const v = e.get(Velocity)!;\n    e.set(Velocity, { x: v.x, y: v.y + GRAVITY * delta });\n  }\n}\n\nexport function applyVelocity(world: World, delta: number) {\n  world.query(Position, Velocity).forEach((e) => {\n    const p = e.get(Position)!;\n    const v = e.get(Velocity)!;\n    e.set(Position, { x: p.x + v.x * delta, y: p.y + v.y * delta });\n  });\n}", "good": "import { Not, type World } from 'koota';\nimport { IsGrounded, Position, Velocity } from './traits';\n\nconst GRAVITY = 30;\n\nexport function applyGravity(world: World, delta: number) {\n  world.query(Velocity, Not(IsGrounded)).updateEach(([vel]) => {\n    vel.y += GRAVITY * delta;\n  });\n}\n\nexport function applyVelocity(world: World, delta: number) {\n  world.query(Position, Velocity).updateEach(([pos, vel]) => {\n    pos.x += vel.x * delta;\n    pos.y += vel.y * delta;\n  });\n}"}}
{"id": "koota-render-reactive-reads", "area": "koota", "kind": "pitfall", "prompt": "In a React + TypeScript app whose game state is a koota world (created in './world' as `export const world = createWorld()`; the traits in './traits' are the tag `Enemy` and `Health = trait({ current: 100, max: 100 })`), write an `EnemyList` component that lists every enemy with its current and max health. The list and the numbers must stay current while enemies spawn, take damage and die.", "never_in_prompt": ["useQuery", "useTrait", "koota/react"], "pitfall": ["koota_reads_world_in_render"], "good": ["koota_query_hook", "koota_trait_hook"], "skills": [{"name": "koota-react-integration", "match": ["React hooks"]}, "koota-react-reactive-hooks"], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/README.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/README.md", "file": "koota@7d1329aa82e3/README.md", "quote": "Reactively updates when entities matching the query changes. Returns a `QueryResult`, which is like an array of entities.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { useEffect, useState } from 'react';\nimport { world } from './world';\nimport { Enemy, Health } from './traits';\n\nexport function EnemyList() {\n  const [, setTick] = useState(0);\n  useEffect(() => {\n    const id = setInterval(() => setTick((t) => t + 1), 250);\n    return () => clearInterval(id);\n  }, []);\n  const enemies = world.query(Enemy, Health);\n  return (\n    <ul>\n      {enemies.map((e) => (\n        <li key={e}>{e.get(Health)!.current} / {e.get(Health)!.max}</li>\n      ))}\n    </ul>\n  );\n}", "good": "import type { Entity } from 'koota';\nimport { useQuery, useTrait } from 'koota/react';\nimport { Enemy, Health } from './traits';\n\nfunction EnemyRow({ enemy }: { enemy: Entity }) {\n  const health = useTrait(enemy, Health);\n  if (!health) return null;\n  return <li>{health.current} / {health.max}</li>;\n}\n\nexport function EnemyList() {\n  const enemies = useQuery(Enemy, Health);\n  return <ul>{enemies.map((e) => <EnemyRow key={e} enemy={e} />)}</ul>;\n}"}}
{"id": "koota-view-actions", "area": "koota", "kind": "pitfall", "prompt": "Write a React + TypeScript `ShipControls` component for a koota game: a 'Launch' button spawns a ship (the tag `IsShip`, `Position` at a random x in 0..800 and y 600, `Velocity` { x: 0, y: -5 }) and a 'Scuttle all' button destroys every ship. The traits are exported from './traits' and the app's world is created in './world'.", "never_in_prompt": ["createActions", "useActions"], "pitfall": ["koota_view_mutates_world"], "good": ["koota_uses_actions"], "skills": [{"name": "koota-react-integration", "match": ["through actions"]}, "koota-react-actions"], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/README.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/README.md", "file": "koota@7d1329aa82e3/README.md", "quote": "Use actions to safely modify Koota from inside of React in either effects or events.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "import { world } from './world';\nimport { IsShip, Position, Velocity } from './traits';\n\nexport function ShipControls() {\n  const launch = () =>\n    world.spawn(IsShip, Position({ x: Math.random() * 800, y: 600 }), Velocity({ x: 0, y: -5 }));\n  const scuttle = () => world.query(IsShip).forEach((ship) => ship.destroy());\n  return (\n    <div>\n      <button onClick={launch}>Launch</button>\n      <button onClick={scuttle}>Scuttle all</button>\n    </div>\n  );\n}", "good": "import { createActions } from 'koota';\nimport { useActions } from 'koota/react';\nimport { IsShip, Position, Velocity } from './traits';\n\nexport const shipActions = createActions((world) => ({\n  launchShip: () =>\n    world.spawn(IsShip, Position({ x: Math.random() * 800, y: 600 }), Velocity({ x: 0, y: -5 })),\n  scuttleAll: () => {\n    world.query(IsShip).forEach((ship) => ship.destroy());\n  },\n}));\n\nexport function ShipControls() {\n  const { launchShip, scuttleAll } = useActions(shipActions);\n  return (\n    <div>\n      <button onClick={() => launchShip()}>Launch</button>\n      <button onClick={scuttleAll}>Scuttle all</button>\n    </div>\n  );\n}"}}
{"id": "koota-app-setup", "area": "koota", "kind": "setup", "prompt": "Start a new Vite + React 19 + TypeScript app that keeps its game state in koota. Give me `src/traits.ts`, `src/world.ts`, `src/main.tsx` and `src/App.tsx`: the App shows how many particles exist and has a button that spawns one particle at a random position.", "never_in_prompt": ["WorldProvider", "koota/react", "useWorld", "useQuery"], "pitfall": ["koota_world_setup_missing"], "good": ["koota_world_provider", "koota_world_module_scope", "koota_imports_koota_react"], "skills": [{"name": "koota-traits-and-entities", "match": ["createWorld()"]}, "koota-react-app-setup"], "packages": ["koota", "react"], "source": {"url": "https://github.com/pmndrs/koota/blob/v0.6.6/README.md", "raw": "https://raw.githubusercontent.com/pmndrs/koota/7d1329aa82e313e715f6b7afbb8350e028c313b5/README.md", "file": "koota@7d1329aa82e3/README.md", "quote": "The provider for the world context. A world must be created and passed in.", "licence": "ISC (pmndrs/koota LICENSE at the v0.6.6 tag, 7d1329a; the repository carries no separate docs licence)"}, "examples": {"pitfall": "src/traits.ts\n```ts\nimport { trait } from 'koota';\nexport const Position = trait({ x: 0, y: 0 });\n```\n\nsrc/main.tsx\n```tsx\nimport { createRoot } from 'react-dom/client';\nimport { App } from './App';\n\ncreateRoot(document.getElementById('root')!).render(<App />);\n```\n\nsrc/App.tsx\n```tsx\nimport { useMemo, useState } from 'react';\nimport { createWorld } from 'koota';\nimport { Position } from './traits';\n\nexport function App() {\n  const world = useMemo(() => createWorld(), []);\n  const [count, setCount] = useState(0);\n  const spawn = () => {\n    world.spawn(Position({ x: Math.random() * 800, y: Math.random() * 600 }));\n    setCount(world.query(Position).length);\n  };\n  return <button onClick={spawn}>Particles: {count}</button>;\n}\n```", "good": "src/traits.ts\n```ts\nimport { trait } from 'koota';\nexport const Position = trait({ x: 0, y: 0 });\n```\n\nsrc/world.ts\n```ts\nimport { createWorld } from 'koota';\nexport const world = createWorld();\n```\n\nsrc/main.tsx\n```tsx\nimport { StrictMode } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { WorldProvider } from 'koota/react';\nimport { world } from './world';\nimport { App } from './App';\n\ncreateRoot(document.getElementById('root')!).render(\n  <StrictMode>\n    <WorldProvider world={world}>\n      <App />\n    </WorldProvider>\n  </StrictMode>,\n);\n```\n\nsrc/App.tsx\n```tsx\nimport { createActions } from 'koota';\nimport { useActions, useQuery } from 'koota/react';\nimport { Position } from './traits';\n\nconst actions = createActions((world) => ({\n  spawnParticle: () => world.spawn(Position({ x: Math.random() * 800, y: Math.random() * 600 })),\n}));\n\nexport function App() {\n  const particles = useQuery(Position);\n  const { spawnParticle } = useActions(actions);\n  return <button onClick={() => spawnParticle()}>Particles: {particles.length}</button>;\n}\n```"}}
