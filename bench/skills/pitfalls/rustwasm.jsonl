// THE RUST -> WASM / C ABI PITFALL CASES (bench/skills/pitfall_harness.py), area `rustwasm`. Operator, 2026-09-30: "Yes to everything pending, queue it up lets go". Each quote is VERBATIM from a pinned copy under pitfalls/sources/: the wasm-bindgen guide at wasm-bindgen/wasm-bindgen@165586f854c8 (guide/src/**; MIT OR Apache-2.0, the repository's LICENSE-MIT and LICENSE-APACHE) and the cbindgen user guide at mozilla/cbindgen@2b757a22bab7 (docs.md; MPL-2.0, the repository's LICENSE). Rules: bench/skills/pitfall_rules/rustwasm.py (tree-sitter rust + tomllib; no Rust toolchain in the harness box, so typecheck none). Prompts never name the good pattern (never_in_prompt). `examples` are the rules' own test (--self-test), written for this harness.
{"id": "rustwasm-export-error-not-panic", "area": "rustwasm", "kind": "pitfall", "prompt": "Write src/lib.rs for a Rust crate compiled to WebAssembly with wasm-bindgen. Export `parse_rgb(hex: &str)` to JavaScript: it parses a CSS hex color like \"#ff8800\" (the leading # is optional) and gives back the packed 0xRRGGBB number. Bad input is a caller bug: anything that is not exactly six hex digits must fail with the message \"invalid hex color: <input>\".", "never_in_prompt": ["Result", "JsError", "JsValue", "Err("], "pitfall": ["rustwasm_export_panics"], "good": ["rustwasm_export_returns_result"], "skills": ["rustwasm-exported-errors-as-result"], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://wasm-bindgen.github.io/wasm-bindgen/reference/catch-unwind.html", "raw": "https://raw.githubusercontent.com/wasm-bindgen/wasm-bindgen/165586f854c852bcbc4d14d8a75a0a0e0d0abc12/guide/src/reference/catch-unwind.md", "file": "wasm-bindgen@165586f854c8/reference__catch-unwind.md", "quote": "By default, when a Rust function exported to JavaScript panics, Rust will abort\nand any allocated resources will be leaked.", "licence": "MIT OR Apache-2.0 (wasm-bindgen's LICENSE-MIT and LICENSE-APACHE at 165586f; the guide has no licence of its own)"}, "examples": {"pitfall": "use wasm_bindgen::prelude::*;\n\n#[wasm_bindgen]\npub fn parse_rgb(hex: &str) -> u32 {\n    let digits = hex.strip_prefix('#').unwrap_or(hex);\n    if digits.len() != 6 {\n        panic!(\"invalid hex color: {}\", hex);\n    }\n    u32::from_str_radix(digits, 16).expect(\"invalid hex color\")\n}", "good": "use wasm_bindgen::prelude::*;\n\n#[wasm_bindgen]\npub fn parse_rgb(hex: &str) -> Result<u32, JsError> {\n    let digits = hex.strip_prefix('#').unwrap_or(hex);\n    let bad = || JsError::new(&format!(\"invalid hex color: {hex}\"));\n    if digits.len() != 6 {\n        return Err(bad());\n    }\n    u32::from_str_radix(digits, 16).map_err(|_| bad())\n}"}}
{"id": "rustwasm-throwing-import-catch", "area": "rustwasm", "kind": "pitfall", "prompt": "In a Rust + wasm-bindgen crate, ./storage.js exports `loadSettings(key)`, which returns a string and throws when the key is missing or storage is blocked. Bind it in Rust and export `settings_or_default(key: &str) -> String` that returns the stored value, or \"{}\" whenever `loadSettings` throws. Give src/lib.rs.", "never_in_prompt": ["catch", "Result", "JsValue"], "pitfall": ["rustwasm_throwing_import_no_catch"], "good": ["rustwasm_throwing_import_catch"], "skills": ["rustwasm-import-catch"], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://wasm-bindgen.github.io/wasm-bindgen/reference/attributes/on-js-imports/catch.html", "raw": "https://raw.githubusercontent.com/wasm-bindgen/wasm-bindgen/165586f854c852bcbc4d14d8a75a0a0e0d0abc12/guide/src/reference/attributes/on-js-imports/catch.md", "file": "wasm-bindgen@165586f854c8/reference__attributes__on-js-imports__catch.md", "quote": "The `catch` attribute allows catching a JavaScript exception.", "licence": "MIT OR Apache-2.0 (wasm-bindgen's LICENSE-MIT and LICENSE-APACHE at 165586f; the guide has no licence of its own)"}, "examples": {"pitfall": "use wasm_bindgen::prelude::*;\n\n#[wasm_bindgen(module = \"/storage.js\")]\nextern \"C\" {\n    #[wasm_bindgen(js_name = loadSettings)]\n    fn load_settings(key: &str) -> String;\n}\n\n#[wasm_bindgen]\npub fn settings_or_default(key: &str) -> String {\n    let value = load_settings(key);\n    if value.is_empty() { \"{}\".to_string() } else { value }\n}", "good": "use wasm_bindgen::prelude::*;\n\n#[wasm_bindgen(module = \"/storage.js\")]\nextern \"C\" {\n    #[wasm_bindgen(catch, js_name = loadSettings)]\n    fn load_settings(key: &str) -> Result<String, JsValue>;\n}\n\n#[wasm_bindgen]\npub fn settings_or_default(key: &str) -> String {\n    load_settings(key).unwrap_or_else(|_| \"{}\".to_string())\n}"}}
{"id": "rustwasm-serde-to-jsvalue", "area": "rustwasm", "kind": "pitfall", "prompt": "Using wasm-bindgen and serde, export `word_stats(text: &str) -> JsValue` that hands JavaScript a plain object `{ total, counts, longest }` built from a Rust struct: `total: u32`, `counts: HashMap<String, u32>` (word -> occurrences) and `longest: Vec<String>` (the longest words). Give Cargo.toml and src/lib.rs.", "never_in_prompt": ["serde_wasm_bindgen", "serde-wasm-bindgen", "to_value"], "pitfall": ["rustwasm_serde_json_jsvalue"], "good": ["rustwasm_serde_wasm_bindgen"], "skills": ["rustwasm-serde-wasm-bindgen"], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://wasm-bindgen.github.io/wasm-bindgen/reference/arbitrary-data-with-serde.html", "raw": "https://raw.githubusercontent.com/wasm-bindgen/wasm-bindgen/165586f854c852bcbc4d14d8a75a0a0e0d0abc12/guide/src/reference/arbitrary-data-with-serde.md", "file": "wasm-bindgen@165586f854c8/reference__arbitrary-data-with-serde.md", "quote": "This can be done through the\n[`serde-wasm-bindgen`](https://docs.rs/serde-wasm-bindgen) crate.", "licence": "MIT OR Apache-2.0 (wasm-bindgen's LICENSE-MIT and LICENSE-APACHE at 165586f; the guide has no licence of its own)"}, "examples": {"pitfall": "Cargo.toml\n```toml\n[package]\nname = \"wordstats\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nwasm-bindgen = { version = \"0.2\", features = [\"serde-serialize\"] }\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\n```\nsrc/lib.rs\n```rust\nuse std::collections::HashMap;\nuse serde::Serialize;\nuse wasm_bindgen::prelude::*;\n\n#[derive(Serialize)]\nstruct Stats { total: u32, counts: HashMap<String, u32>, longest: Vec<String> }\n\nfn stats_of(text: &str) -> Stats {\n    let mut counts = HashMap::new();\n    for w in text.split_whitespace() { *counts.entry(w.to_lowercase()).or_insert(0) += 1; }\n    let max = text.split_whitespace().map(str::len).max().unwrap_or(0);\n    let longest = text.split_whitespace().filter(|w| w.len() == max).map(String::from).collect();\n    Stats { total: text.split_whitespace().count() as u32, counts, longest }\n}\n\n#[wasm_bindgen]\npub fn word_stats(text: &str) -> JsValue {\n    JsValue::from_serde(&stats_of(text)).unwrap()\n}\n```\n", "good": "Cargo.toml\n```toml\n[package]\nname = \"wordstats\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nwasm-bindgen = \"0.2\"\nserde = { version = \"1\", features = [\"derive\"] }\nserde-wasm-bindgen = \"0.6\"\n```\nsrc/lib.rs\n```rust\nuse std::collections::HashMap;\nuse serde::Serialize;\nuse wasm_bindgen::prelude::*;\n\n#[derive(Serialize)]\nstruct Stats { total: u32, counts: HashMap<String, u32>, longest: Vec<String> }\n\nfn stats_of(text: &str) -> Stats {\n    let mut counts = HashMap::new();\n    for w in text.split_whitespace() { *counts.entry(w.to_lowercase()).or_insert(0) += 1; }\n    let max = text.split_whitespace().map(str::len).max().unwrap_or(0);\n    let longest = text.split_whitespace().filter(|w| w.len() == max).map(String::from).collect();\n    Stats { total: text.split_whitespace().count() as u32, counts, longest }\n}\n\n#[wasm_bindgen]\npub fn word_stats(text: &str) -> Result<JsValue, JsValue> {\n    Ok(serde_wasm_bindgen::to_value(&stats_of(text))?)\n}\n```\n"}}
{"id": "rustwasm-web-sys-features", "area": "rustwasm", "kind": "pitfall", "prompt": "In a Rust + wasm-bindgen crate, export `draw_grid(canvas_id: &str, cells: u32)` that finds the <canvas> with that id in the page, gets its 2D rendering context and strokes a cells x cells grid over the whole canvas. Use the web-sys crate for the DOM and canvas APIs. Give Cargo.toml and src/lib.rs.", "never_in_prompt": ["features", "HtmlCanvasElement", "CanvasRenderingContext2d"], "pitfall": ["rustwasm_web_sys_features_missing"], "good": ["rustwasm_web_sys_features_enabled"], "skills": ["rustwasm-web-sys-features"], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://wasm-bindgen.github.io/wasm-bindgen/web-sys/cargo-features.html", "raw": "https://raw.githubusercontent.com/wasm-bindgen/wasm-bindgen/165586f854c852bcbc4d14d8a75a0a0e0d0abc12/guide/src/web-sys/cargo-features.md", "file": "wasm-bindgen@165586f854c8/web-sys__cargo-features.md", "quote": "every type defined in `web-sys`. To access that type, you must enable its\nfeature.", "licence": "MIT OR Apache-2.0 (wasm-bindgen's LICENSE-MIT and LICENSE-APACHE at 165586f; the guide has no licence of its own)"}, "examples": {"pitfall": "Cargo.toml\n```toml\n[package]\nname = \"grid\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nwasm-bindgen = \"0.2\"\nweb-sys = \"0.3\"\n```\nsrc/lib.rs\n```rust\nuse wasm_bindgen::prelude::*;\nuse wasm_bindgen::JsCast;\nuse web_sys::{CanvasRenderingContext2d, HtmlCanvasElement};\n\n#[wasm_bindgen]\npub fn draw_grid(canvas_id: &str, cells: u32) -> Result<(), JsValue> {\n    let document = web_sys::window().unwrap().document().unwrap();\n    let canvas: HtmlCanvasElement = document.get_element_by_id(canvas_id).unwrap().dyn_into()?;\n    let ctx: CanvasRenderingContext2d = canvas.get_context(\"2d\")?.unwrap().dyn_into()?;\n    let (w, h) = (canvas.width() as f64, canvas.height() as f64);\n    ctx.begin_path();\n    for i in 0..=cells {\n        let t = i as f64 / cells as f64;\n        ctx.move_to(t * w, 0.0); ctx.line_to(t * w, h);\n        ctx.move_to(0.0, t * h); ctx.line_to(w, t * h);\n    }\n    ctx.stroke();\n    Ok(())\n}\n```\n", "good": "Cargo.toml\n```toml\n[package]\nname = \"grid\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nwasm-bindgen = \"0.2\"\n\n[dependencies.web-sys]\nversion = \"0.3\"\nfeatures = [\"Window\", \"Document\", \"Element\", \"HtmlCanvasElement\", \"CanvasRenderingContext2d\"]\n```\nsrc/lib.rs\n```rust\nuse wasm_bindgen::prelude::*;\nuse wasm_bindgen::JsCast;\nuse web_sys::{CanvasRenderingContext2d, HtmlCanvasElement};\n\n#[wasm_bindgen]\npub fn draw_grid(canvas_id: &str, cells: u32) -> Result<(), JsValue> {\n    let document = web_sys::window().unwrap().document().unwrap();\n    let canvas: HtmlCanvasElement = document.get_element_by_id(canvas_id).unwrap().dyn_into()?;\n    let ctx: CanvasRenderingContext2d = canvas.get_context(\"2d\")?.unwrap().dyn_into()?;\n    let (w, h) = (canvas.width() as f64, canvas.height() as f64);\n    ctx.begin_path();\n    for i in 0..=cells {\n        let t = i as f64 / cells as f64;\n        ctx.move_to(t * w, 0.0); ctx.line_to(t * w, h);\n        ctx.move_to(0.0, t * h); ctx.line_to(w, t * h);\n    }\n    ctx.stroke();\n    Ok(())\n}\n```\n"}}
{"id": "rustwasm-ffi-struct-layout", "area": "rustwasm", "kind": "pitfall", "prompt": "A C program links this Rust library. The crate already has\n\n```rust\npub struct Vec2 { pub x: f32, pub y: f32 }\n```\n\nExport two functions the C side calls with the struct by value: `float vec2_length(Vec2 v)` and `Vec2 vec2_scale(Vec2 v, float k)`. Give src/lib.rs with the struct and both exports.", "never_in_prompt": ["repr", "#[repr(C)]"], "pitfall": ["rustwasm_ffi_struct_no_repr"], "good": ["rustwasm_ffi_struct_repr_c"], "skills": [{"name": "cbindgen-docs-type-definition", "match": ["repr(C)"]}], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://github.com/mozilla/cbindgen/blob/master/docs.md", "raw": "https://raw.githubusercontent.com/mozilla/cbindgen/2b757a22bab77981e5d414d554db7a5d6109e727/docs.md", "file": "cbindgen@2b757a22bab7/docs.md", "quote": "* `#[repr(C)]`: give this struct/union/enum the same layout and ABI C would", "licence": "MPL-2.0 (cbindgen's LICENSE at 2b757a2; docs.md has no licence of its own)"}, "examples": {"pitfall": "#[derive(Clone, Copy)]\npub struct Vec2 { pub x: f32, pub y: f32 }\n\n#[no_mangle]\npub extern \"C\" fn vec2_length(v: Vec2) -> f32 {\n    (v.x * v.x + v.y * v.y).sqrt()\n}\n\n#[no_mangle]\npub extern \"C\" fn vec2_scale(v: Vec2, k: f32) -> Vec2 {\n    Vec2 { x: v.x * k, y: v.y * k }\n}", "good": "#[repr(C)]\n#[derive(Clone, Copy)]\npub struct Vec2 { pub x: f32, pub y: f32 }\n\n#[no_mangle]\npub extern \"C\" fn vec2_length(v: Vec2) -> f32 {\n    (v.x * v.x + v.y * v.y).sqrt()\n}\n\n#[no_mangle]\npub extern \"C\" fn vec2_scale(v: Vec2, k: f32) -> Vec2 {\n    Vec2 { x: v.x * k, y: v.y * k }\n}"}}
{"id": "rustwasm-setup-wasm-crate", "area": "rustwasm", "kind": "setup", "prompt": "Set up a new Rust library crate `imgfx` that a browser app loads as WebAssembly through wasm-bindgen. It exports `grayscale(pixels: &mut [u8])`, which converts RGBA pixel data to grayscale in place (keep alpha). Give Cargo.toml and src/lib.rs.", "never_in_prompt": ["cdylib", "crate-type", "[lib]"], "pitfall": ["rustwasm_no_cdylib"], "good": ["rustwasm_wasm_crate_configured"], "skills": ["rustwasm-wasm-crate-setup", {"name": "rust-nomicon-ffi-async-callbacks-1", "match": ["cdylib"]}], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://wasm-bindgen.github.io/wasm-bindgen/examples/hello-world.html", "raw": "https://raw.githubusercontent.com/wasm-bindgen/wasm-bindgen/165586f854c852bcbc4d14d8a75a0a0e0d0abc12/guide/src/examples/hello-world.md", "file": "wasm-bindgen@165586f854c8/examples__hello-world.md", "quote": "Also of note is the `crate-type = [\"cdylib\"]` which is largely used for wasm\nfinal artifacts today.", "licence": "MIT OR Apache-2.0 (wasm-bindgen's LICENSE-MIT and LICENSE-APACHE at 165586f; the guide has no licence of its own)"}, "examples": {"pitfall": "Cargo.toml\n```toml\n[package]\nname = \"imgfx\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\nwasm-bindgen = \"0.2\"\n```\nsrc/lib.rs\n```rust\nuse wasm_bindgen::prelude::*;\n\n#[wasm_bindgen]\npub fn grayscale(pixels: &mut [u8]) {\n    for px in pixels.chunks_exact_mut(4) {\n        let y = (0.299 * px[0] as f32 + 0.587 * px[1] as f32 + 0.114 * px[2] as f32) as u8;\n        px[0] = y; px[1] = y; px[2] = y;\n    }\n}\n```\n", "good": "Cargo.toml\n```toml\n[package]\nname = \"imgfx\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\", \"rlib\"]\n\n[dependencies]\nwasm-bindgen = \"0.2\"\n```\nsrc/lib.rs\n```rust\nuse wasm_bindgen::prelude::*;\n\n#[wasm_bindgen]\npub fn grayscale(pixels: &mut [u8]) {\n    for px in pixels.chunks_exact_mut(4) {\n        let y = (0.299 * px[0] as f32 + 0.587 * px[1] as f32 + 0.114 * px[2] as f32) as u8;\n        px[0] = y; px[1] = y; px[2] = y;\n    }\n}\n```\n"}}
{"id": "rustwasm-setup-c-header", "area": "rustwasm", "kind": "setup", "prompt": "Set up a Rust library crate `ringbuf_c` that C programs link against. It exposes `rb_new(capacity: usize) -> *mut RingBuf`, `rb_push(rb, v: u8) -> bool`, `rb_pop(rb, out: *mut u8) -> bool` and `rb_free(rb)`, with `RingBuf` opaque to C. The C side includes a header `ringbuf.h` declaring these, and the header must stay in sync with the Rust code on every cargo build. Give every file the project needs.", "never_in_prompt": ["cbindgen", "build.rs", "build-dependencies", "no_mangle"], "pitfall": ["rustwasm_header_by_hand"], "good": ["rustwasm_cbindgen_configured", "rustwasm_c_exports_no_mangle"], "skills": ["rustwasm-cbindgen-build-rs", {"name": "cbindgen-docs-build-rs-configuration-1", "match": ["build-dependencies"]}], "packages": [], "example_lang": "rust", "typecheck": "none", "typecheck_why": "no Rust toolchain in the harness box (tsc/pyright only); checked by tree-sitter", "source": {"url": "https://github.com/mozilla/cbindgen/blob/master/docs.md", "raw": "https://raw.githubusercontent.com/mozilla/cbindgen/2b757a22bab77981e5d414d554db7a5d6109e727/docs.md", "file": "cbindgen@2b757a22bab7/docs.md", "quote": "While you could do this by hand, it's not a particularly good use of your time. It's also much more likely to be error-prone than machine-generated headers that are based on your actual Rust code.", "licence": "MPL-2.0 (cbindgen's LICENSE at 2b757a2; docs.md has no licence of its own)"}, "examples": {"pitfall": "Cargo.toml\n```toml\n[package]\nname = \"ringbuf_c\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\", \"staticlib\"]\n```\nsrc/lib.rs\n```rust\nuse std::collections::VecDeque;\n\npub struct RingBuf { items: VecDeque<u8>, cap: usize }\n\n#[no_mangle]\npub extern \"C\" fn rb_new(capacity: usize) -> *mut RingBuf {\n    Box::into_raw(Box::new(RingBuf { items: VecDeque::with_capacity(capacity), cap: capacity }))\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_push(rb: *mut RingBuf, v: u8) -> bool {\n    let rb = &mut *rb;\n    if rb.items.len() == rb.cap { return false; }\n    rb.items.push_back(v);\n    true\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_pop(rb: *mut RingBuf, out: *mut u8) -> bool {\n    match (*rb).items.pop_front() { Some(v) => { *out = v; true } None => false }\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_free(rb: *mut RingBuf) {\n    if !rb.is_null() { drop(Box::from_raw(rb)); }\n}\n```\nringbuf.h\n```c\n#ifndef RINGBUF_H\n#define RINGBUF_H\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\ntypedef struct RingBuf RingBuf;\n\nRingBuf *rb_new(size_t capacity);\nbool rb_push(RingBuf *rb, uint8_t v);\nbool rb_pop(RingBuf *rb, uint8_t *out);\nvoid rb_free(RingBuf *rb);\n\n#endif\n```\n", "good": "Cargo.toml\n```toml\n[package]\nname = \"ringbuf_c\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\", \"staticlib\"]\n\n[build-dependencies]\ncbindgen = \"0.29\"\n```\nbuild.rs\n```rust\nuse std::env;\n\nfn main() {\n    let crate_dir = env::var(\"CARGO_MANIFEST_DIR\").unwrap();\n    cbindgen::Builder::new()\n        .with_crate(crate_dir)\n        .with_language(cbindgen::Language::C)\n        .generate()\n        .expect(\"Unable to generate bindings\")\n        .write_to_file(\"ringbuf.h\");\n}\n```\nsrc/lib.rs\n```rust\nuse std::collections::VecDeque;\n\npub struct RingBuf { items: VecDeque<u8>, cap: usize }\n\n#[no_mangle]\npub extern \"C\" fn rb_new(capacity: usize) -> *mut RingBuf {\n    Box::into_raw(Box::new(RingBuf { items: VecDeque::with_capacity(capacity), cap: capacity }))\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_push(rb: *mut RingBuf, v: u8) -> bool {\n    let rb = &mut *rb;\n    if rb.items.len() == rb.cap { return false; }\n    rb.items.push_back(v);\n    true\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_pop(rb: *mut RingBuf, out: *mut u8) -> bool {\n    match (*rb).items.pop_front() { Some(v) => { *out = v; true } None => false }\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn rb_free(rb: *mut RingBuf) {\n    if !rb.is_null() { drop(Box::from_raw(rb)); }\n}\n```\n"}}
