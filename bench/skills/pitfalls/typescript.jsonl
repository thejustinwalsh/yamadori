// THE TYPESCRIPT PITFALL CASES (bench/skills/pitfall_harness.py). Operator, 2026-09-30: "Yes to everything pending, queue it up lets go" (the TypeScript handbook, the TSConfig reference and the 5.x / 6.0 release notes). Each quote is VERBATIM from microsoft/TypeScript-Website at 6556b08756b766fd41d0f887174cb0b042e5f72c, pinned under pitfalls/sources/TypeScript-Website@6556b08756b7 (MANIFEST.json: sha256 per file). The documentation is CC BY 4.0 (LICENSE); the repository's code is MIT (LICENSE-CODE), which does not cover the quoted text. Prompts never name the good pattern (never_in_prompt). Pure-TypeScript cases list no package (`packages: []`); the rules are bench/skills/pitfall_rules/typescript.py; `examples` are the rules' own test (--self-test), written for this harness.
{"id": "typescript-unknown-not-any", "area": "typescript", "kind": "pitfall", "prompt": "Write a TypeScript function `loadSettings(raw: string): Settings` that turns the text of a user-edited JSON settings file into `type Settings = { theme: 'light' | 'dark'; fontSize: number; recentFiles: string[] }`. The file is hand-edited, so a field that is missing or has the wrong kind of value falls back to its default ('light', 14, []), and text that is not valid JSON gives all the defaults. Export both the type and the function.", "never_in_prompt": ["unknown", "narrow", "typeof", "type guard", "any"], "pitfall": ["typescript_any_or_unchecked_parse"], "good": ["typescript_unknown_narrowed"], "skills": [{"name": "modern-practice-modern-vs-outdated-5", "match": ["unknown"]}, {"name": "typescript-types-runtime-checks-12", "match": ["Types are erased"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/docs/handbook/declaration-files/do-s-and-don-ts.html", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/documentation/copy/en/declaration-files/Do%27s%20and%20Don%27ts.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/declaration-files__Dos_and_Donts.md", "quote": "❌ **Don't** use `any` as a type unless you are in the process of migrating a JavaScript project to TypeScript.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "export type Settings = { theme: 'light' | 'dark'; fontSize: number; recentFiles: string[] };\nexport function loadSettings(raw: string): Settings {\n  let data: any = {};\n  try { data = JSON.parse(raw); } catch { data = {}; }\n  return {\n    theme: data.theme === 'dark' ? 'dark' : 'light',\n    fontSize: typeof data.fontSize === 'number' ? data.fontSize : 14,\n    recentFiles: Array.isArray(data.recentFiles) ? data.recentFiles : [],\n  };\n}", "good": "export type Settings = { theme: 'light' | 'dark'; fontSize: number; recentFiles: string[] };\nfunction isRecord(x: unknown): x is Record<string, unknown> {\n  return typeof x === 'object' && x !== null;\n}\nexport function loadSettings(raw: string): Settings {\n  let data: unknown;\n  try { data = JSON.parse(raw) as unknown; } catch { data = undefined; }\n  const o = isRecord(data) ? data : {};\n  const files = o['recentFiles'];\n  const size = o['fontSize'];\n  return {\n    theme: o['theme'] === 'dark' ? 'dark' : 'light',\n    fontSize: typeof size === 'number' ? size : 14,\n    recentFiles: Array.isArray(files) ? files.filter((f): f is string => typeof f === 'string') : [],\n  };\n}"}}
{"id": "typescript-union-not-enum", "area": "typescript", "kind": "pitfall", "prompt": "Write `order-status.ts` for an order-tracking service in TypeScript: the four order statuses (pending, paid, shipped, cancelled) as something other modules can import to type their fields and to compare against, a `statusLabel(status)` function returning a human-readable label for each one, and `canCancel(status)` which is true only for pending and paid orders.", "never_in_prompt": ["as const", "union", "keyof", "erasableSyntaxOnly", "enum", "literal type"], "pitfall": ["typescript_enum_declared"], "good": ["typescript_union_or_const_object"], "skills": [{"name": "modern-practice-modern-vs-outdated-5-2", "match": ["as const"]}, {"name": "modern-practice-modern-vs-outdated-6-2", "match": ["erasableSyntaxOnly"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/docs/handbook/enums.html", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/documentation/copy/en/reference/Enums.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/reference__Enums.md", "quote": "In modern TypeScript, you may not need an enum when an object with `as const` could suffice:", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "export enum OrderStatus { Pending = 'pending', Paid = 'paid', Shipped = 'shipped', Cancelled = 'cancelled' }\nexport function statusLabel(s: OrderStatus): string {\n  switch (s) {\n    case OrderStatus.Pending: return 'Awaiting payment';\n    case OrderStatus.Paid: return 'Paid';\n    case OrderStatus.Shipped: return 'On its way';\n    case OrderStatus.Cancelled: return 'Cancelled';\n  }\n}\nexport function canCancel(s: OrderStatus): boolean {\n  return s === OrderStatus.Pending || s === OrderStatus.Paid;\n}", "good": "export const OrderStatus = { Pending: 'pending', Paid: 'paid', Shipped: 'shipped', Cancelled: 'cancelled' } as const;\nexport type OrderStatus = (typeof OrderStatus)[keyof typeof OrderStatus];\nconst LABELS: Record<OrderStatus, string> = { pending: 'Awaiting payment', paid: 'Paid', shipped: 'On its way', cancelled: 'Cancelled' };\nexport function statusLabel(s: OrderStatus): string { return LABELS[s]; }\nexport function canCancel(s: OrderStatus): boolean {\n  return s === OrderStatus.Pending || s === OrderStatus.Paid;\n}"}}
{"id": "typescript-modules-not-namespace", "area": "typescript", "kind": "pitfall", "prompt": "My TypeScript web app needs one place for its form validation helpers: `isEmail(s)`, `isStrongPassword(s)` (at least `MIN_PASSWORD_LENGTH` characters, which is 12, with a digit and a letter) and `isPostcode(s)` for UK postcodes. The signup, checkout and profile forms, each in its own file, will all use them grouped as `Validation.isEmail(x)`, `Validation.isPostcode(x)` and so on. Write `validation.ts`, the file that defines the group.", "never_in_prompt": ["import * as", "ES module", "export function", "namespace"], "pitfall": ["typescript_namespace_declared"], "good": ["typescript_module_exports"], "skills": [{"name": "modern-practice-modern-vs-outdated-5", "match": ["namespace"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/docs/handbook/2/modules.html", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/documentation/copy/en/handbook-v2/Modules.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/handbook-v2__Modules.md", "quote": "While not deprecated, the majority of the features in namespaces exist in ES Modules and we recommend you use that to align with JavaScript's direction.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "validation.ts\n```ts\nexport namespace Validation {\n  export const MIN_PASSWORD_LENGTH = 12;\n  export function isEmail(s: string): boolean { return /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(s); }\n  export function isStrongPassword(s: string): boolean { return s.length >= MIN_PASSWORD_LENGTH && /\\d/.test(s) && /[a-z]/i.test(s); }\n  export function isPostcode(s: string): boolean { return /^[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}$/i.test(s); }\n}\n```", "good": "validation.ts\n```ts\nexport const MIN_PASSWORD_LENGTH = 12;\nexport function isEmail(s: string): boolean { return /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(s); }\nexport function isStrongPassword(s: string): boolean { return s.length >= MIN_PASSWORD_LENGTH && /\\d/.test(s) && /[a-z]/i.test(s); }\nexport function isPostcode(s: string): boolean { return /^[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}$/i.test(s); }\n// callers: import * as Validation from './validation';\n```"}}
{"id": "typescript-type-only-imports", "area": "typescript", "kind": "pitfall", "prompt": "In my React 19 + Vite + TypeScript app, write `src/components/SearchBox.tsx`: a controlled search input with a `placeholder` prop, an `onSearch(query: string)` callback called when the form is submitted, and an optional `icon` prop that accepts any renderable content shown before the input. Import React's own types for the props, the change event and the submit event, and annotate the handlers with them explicitly.", "never_in_prompt": ["import type", "type-only", "verbatimModuleSyntax", "type modifier", "isolatedModules"], "pitfall": ["typescript_type_import_unmarked"], "good": ["typescript_type_import_marked"], "skills": [{"name": "modern-practice-modern-vs-outdated-5-2", "match": ["verbatimModuleSyntax"]}], "packages": ["react"], "source": {"url": "https://www.typescriptlang.org/tsconfig/#verbatimModuleSyntax", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/tsconfig-reference/copy/en/options/verbatimModuleSyntax.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/tsconfig__options__verbatimModuleSyntax.md", "quote": "The rules are much simpler - any imports or exports without a `type` modifier are left around.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "import { useState, ChangeEvent, FormEvent, ReactNode } from 'react';\ntype Props = { placeholder: string; onSearch: (query: string) => void; icon?: ReactNode };\nexport function SearchBox({ placeholder, onSearch, icon }: Props) {\n  const [query, setQuery] = useState('');\n  const onChange = (e: ChangeEvent<HTMLInputElement>) => setQuery(e.target.value);\n  const onSubmit = (e: FormEvent<HTMLFormElement>) => { e.preventDefault(); onSearch(query); };\n  return <form onSubmit={onSubmit}>{icon}<input value={query} placeholder={placeholder} onChange={onChange} /></form>;\n}", "good": "import { useState, type ChangeEvent, type FormEvent, type ReactNode } from 'react';\ntype Props = { placeholder: string; onSearch: (query: string) => void; icon?: ReactNode };\nexport function SearchBox({ placeholder, onSearch, icon }: Props) {\n  const [query, setQuery] = useState('');\n  const onChange = (e: ChangeEvent<HTMLInputElement>) => setQuery(e.target.value);\n  const onSubmit = (e: FormEvent<HTMLFormElement>) => { e.preventDefault(); onSearch(query); };\n  return <form onSubmit={onSubmit}>{icon}<input value={query} placeholder={placeholder} onChange={onChange} /></form>;\n}"}}
{"id": "typescript-satisfies-config", "area": "typescript", "kind": "pitfall", "prompt": "Write `routes.ts` for a small TypeScript web app. Export a `Route` type: an entry is either a plain path string or an object `{ path: string; requiresAuth: boolean }`. Export a `routes` object for exactly the pages `home`, `profile` and `settings` (home and profile are plain strings, settings is an object that requires auth). A misspelled page name, a missing page or a wrongly shaped entry must be a compile-time error, and later in the same file `export const homeUpper = routes.home.toUpperCase();` and `export const settingsNeedsAuth = routes.settings.requiresAuth;` must compile with no casts and no runtime checks.", "never_in_prompt": ["satisfies"], "pitfall": ["typescript_widening_annotation_or_cast"], "good": ["typescript_uses_satisfies"], "skills": [{"name": "typescript-types-runtime-checks-12", "match": ["satisfies"]}, {"name": "modern-practice-modern-vs-outdated-5", "match": ["satisfies"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/docs/handbook/release-notes/typescript-4-9.html", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/documentation/copy/en/release-notes/TypeScript%204.9.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/release-notes__TypeScript_4.9.md", "quote": "The new `satisfies` operator lets us validate that the type of an expression matches some type, without changing the resulting type of that expression.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "export type Route = string | { path: string; requiresAuth: boolean };\ntype Page = 'home' | 'profile' | 'settings';\nexport const routes: Record<Page, Route> = {\n  home: '/', profile: '/profile', settings: { path: '/settings', requiresAuth: true },\n};\nexport const homeUpper = (routes.home as string).toUpperCase();\nexport const settingsNeedsAuth = (routes.settings as { path: string; requiresAuth: boolean }).requiresAuth;", "good": "export type Route = string | { path: string; requiresAuth: boolean };\ntype Page = 'home' | 'profile' | 'settings';\nexport const routes = {\n  home: '/', profile: '/profile', settings: { path: '/settings', requiresAuth: true },\n} satisfies Record<Page, Route>;\nexport const homeUpper = routes.home.toUpperCase();\nexport const settingsNeedsAuth = routes.settings.requiresAuth;"}}
{"id": "typescript-tsconfig-bundled-app", "area": "typescript", "kind": "setup", "prompt": "I'm starting a new browser app in TypeScript 5.9 (plain TypeScript, no UI framework) that Vite 7 builds: Vite transpiles and packages the code, and `tsc` only type-checks it in CI. Write the project's tsconfig.json, and the package.json scripts for dev, build and type-checking.", "never_in_prompt": ["bundler", "moduleResolution", "verbatimModuleSyntax", "isolatedModules", "strict", "preserve", "esnext", "noEmit"], "pitfall": ["typescript_legacy_module_resolution"], "good": ["typescript_bundler_tsconfig"], "skills": ["typescript-tsconfig-app-setup", {"name": "typescript-6-0-release-notes-moduleresolution", "match": ["bundler"]}, {"name": "modern-practice-modern-vs-outdated-5-2", "match": ["verbatimModuleSyntax"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/docs/handbook/release-notes/typescript-6-0.html", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/documentation/copy/en/release-notes/TypeScript%206.0.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/release-notes__TypeScript_6.0.md", "quote": "Users who were using `--moduleResolution node` should usually migrate to `--moduleResolution nodenext` if they plan on targeting Node.js directly, or `--moduleResolution bundler` if they plan on using a bundler or Bun.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "tsconfig.json\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"node\",\n    \"lib\": [\"ES2020\", \"DOM\"],\n    \"strict\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true\n  },\n  \"include\": [\"src\"]\n}\n```", "good": "tsconfig.json\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"noEmit\": true,\n    \"verbatimModuleSyntax\": true,\n    \"allowImportingTsExtensions\": true,\n    \"strict\": true,\n    \"skipLibCheck\": true,\n  },\n  \"include\": [\"src\"]\n}\n```\n\npackage.json\n```json\n{ \"scripts\": { \"dev\": \"vite\", \"build\": \"tsc && vite build\", \"typecheck\": \"tsc\" } }\n```"}}
{"id": "typescript-tsconfig-node-app", "area": "typescript", "kind": "setup", "prompt": "I'm starting a new Node.js 22 command-line tool in TypeScript 5.9. `tsc` compiles `src/` to `dist/`, and `node dist/index.js` runs it; the package is ESM (`\"type\": \"module\"` in package.json). Write the tsconfig.json and the package.json.", "never_in_prompt": ["nodenext", "NodeNext", "node16", "Node16", "node18", "moduleResolution", "verbatimModuleSyntax", "strict"], "pitfall": ["typescript_legacy_module_resolution"], "good": ["typescript_node_tsconfig"], "skills": ["typescript-tsconfig-app-setup", {"name": "typescript-6-0-release-notes-moduleresolution", "match": ["nodenext"]}, {"name": "modern-practice-modern-vs-outdated-5-2", "match": ["verbatimModuleSyntax"]}], "packages": [], "source": {"url": "https://www.typescriptlang.org/tsconfig/#module", "raw": "https://raw.githubusercontent.com/microsoft/TypeScript-Website/6556b08756b766fd41d0f887174cb0b042e5f72c/packages/tsconfig-reference/copy/en/options/module.md", "commit": "6556b08756b766fd41d0f887174cb0b042e5f72c", "file": "TypeScript-Website@6556b08756b7/tsconfig__options__module.md", "quote": "You very likely want `\"nodenext\"` for modern Node.js projects and `preserve` or `esnext` for code that will be bundled.", "licence": "CC-BY-4.0 (TypeScript-Website LICENSE: the documentation; the repository's code is MIT, LICENSE-CODE, which does not apply to this text; README.md at 6556b08)"}, "examples": {"pitfall": "tsconfig.json\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ES2022\",\n    \"moduleResolution\": \"node\",\n    \"outDir\": \"dist\",\n    \"rootDir\": \"src\",\n    \"strict\": true,\n    \"esModuleInterop\": true\n  }\n}\n```", "good": "tsconfig.json\n```json\n{\n  \"compilerOptions\": {\n    \"module\": \"nodenext\",\n    \"target\": \"es2023\",\n    \"types\": [\"node\"],\n    \"rootDir\": \"src\",\n    \"outDir\": \"dist\",\n    \"verbatimModuleSyntax\": true,\n    \"strict\": true,\n    \"sourceMap\": true\n  }\n}\n```\n\npackage.json\n```json\n{ \"name\": \"tool\", \"type\": \"module\", \"bin\": \"dist/index.js\", \"scripts\": { \"build\": \"tsc\" }, \"devDependencies\": { \"typescript\": \"^5.9.3\", \"@types/node\": \"^22.0.0\" } }\n```"}}
