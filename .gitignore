# Binaries are downloaded by scripts/setup.ps1, not committed (42 MB+).
bin/
llamacpp-prism/

# Runtime state
*.log
logs/
.venv/
__pycache__/
*.pyc

# The vector index is derived data -- rebuild with `index_code.py`.
index/
*.sqlite3
*.db

# Models live in textgen/user_data/models; far too large to track.
*.gguf


# Secrets -- never commit
caddy/.env
caddy/caddy.exe
caddy/data/
caddy/config/
.venv-laya/

# Live config carries machine-specific paths and GPU UUIDs; config.example.yaml is the committed
# one (scripts/make_config.py renders it). stack.env holds this machine's interpreter / CUDA / URL
# settings (scripts/install.ps1 writes it; start-stack.bat and watchdog.ps1 read it).
config.yaml
stack.env
engines/manifest.local.yaml

# Account registry and keys -- never commit
index/accounts/
.keys

# Non-destructive tidy: superseded backups, stale logs and pre-edit snapshots.
# Kept, not deleted -- see attic/README.txt.
attic/

# Downloaded third-party benchmark inputs: fetched, not authored here, and
# test5/test6 exceed GitHub's 100 MB file limit.
bench/data/test5.jsonl
bench/data/test6.jsonl
bench/data/LeetCodeDataset-train.jsonl
# Local rollback copies of the live config.
config.yaml.bak-*

# Manifest entries for models whose names are not public (docs/MODELS.md).
models/manifest.local.yaml

# rollback copies written by deploy scripts (privacy scan 2026-09-29: 14 were untracked clutter)
*.bak-*
# secrets backstop (privacy scan 2026-09-29): no key/cert/env file belongs in the public repo
*.key
*.pem
.env
**/.env

# Skills data is not repo content (operator, 2026-10-01: "none of our skills data, or things the user can make
# themselves through the exposed dashboard tools"): the skills (authored, ingested, replacements, retags), the
# documentation pages the pitfall harness downloads, and its generated gap reports. Each is rebuilt by the skills
# pipeline / the dashboard from its sources.
skills/
bench/skills/pitfalls/sources/
bench/skills/pitfalls/gaps/
