# Binaries are downloaded by scripts/setup.ps1, not committed (42 MB+).
bin/
llamacpp-prism/

# Runtime state
*.log
logs/
.venv/
__pycache__/
*.pyc

# The vector index is derived data -- rebuild with `index_code.py`.
index/
*.sqlite3
*.db

# Models live in textgen/user_data/models; far too large to track.
*.gguf

# Upstream reference, fetched by setup
config.example.yaml

# Secrets -- never commit
caddy/.env
caddy/caddy.exe
caddy/data/
caddy/config/
.venv-laya/

# Live config carries machine-specific paths; config.template.yaml is the
# committed one.
config.yaml

# Account registry and keys -- never commit
index/accounts/
.keys

# Non-destructive tidy: superseded backups, stale logs and pre-edit snapshots.
# Kept, not deleted -- see attic/README.txt.
attic/

# Downloaded third-party benchmark inputs: fetched, not authored here, and
# test5/test6 exceed GitHub's 100 MB file limit.
bench/data/test5.jsonl
bench/data/test6.jsonl
bench/data/LeetCodeDataset-train.jsonl
# Local rollback copies of the live config.
config.yaml.bak-*
